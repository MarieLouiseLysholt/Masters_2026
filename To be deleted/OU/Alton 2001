"""
Replication of Alaton, Djehiche & Stillberger (2002):
"On Modelling and Pricing Weather Derivatives"
Applied Mathematical Finance, 9(1), 1-20.

ROLLING CALIBRATION VERSION:
    For each region, produces one PKL per calibration end-year:
        alaton_models/alaton_model_{region}_calib_{year}.pkl

    Calibration window is always expanding from the earliest available data
    (1970) up to the calibration end year. No data after that year is seen.

    PKL naming matches backtest_comparison.py:
        alaton_model_{region}_calib_{calib_year}.pkl
        where calib_year = prediction_year - 1

    To predict 2015 → load calib_2014 PKL  (calibrated on 1970–2014)
    To predict 2016 → load calib_2015 PKL  (calibrated on 1970–2015)
    ...
    To predict 2024 → load calib_2023 PKL  (calibrated on 1970–2023)

Outputs:
    - alaton_models/alaton_model_{region}_calib_{year}.pkl  (one per region x year)
    - alaton_model_diagnostics.png   (diagnostic figure based on 1970–2014 calibration)
    - alaton_model_summary.csv       (cross-region parameter table for all calib years)
"""

import os
import numpy as np
import pandas as pd
from scipy import stats
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import warnings, pickle
warnings.filterwarnings("ignore")

np.random.seed(42)

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

REGIONS = [11, 24, 27, 28, 32, 44, 52, 53]

# Rolling calibration end years.
# calib_year = prediction_year - 1, so:
#   2014 → predict 2015
#   2023 → predict 2024
CALIB_YEARS   = range(2014, 2024)
DIAG_YEAR     = 2014          # which calibration window to use for the diagnostics figure
MIN_CALIB_OBS = 1000

PKL_FOLDER = "alaton_models"
os.makedirs(PKL_FOLDER, exist_ok=True)

OMEGA = 2 * np.pi / 365
MONTH_NAMES = ["Jan","Feb","Mar","Apr","May","Jun",
               "Jul","Aug","Sep","Oct","Nov","Dec"]
months = np.arange(1, 13)

BLUE, RED, GRAY = "#2563EB", "#DC2626", "#6B7280"
plt.rcParams.update({"font.size": 8,
                     "axes.spines.top": False,
                     "axes.spines.right": False})

MAX_LAG = 60

# ---------------------------------------------------------------------------
# Load raw data once
# ---------------------------------------------------------------------------

raw = pd.read_csv("EDA/region_avg.csv", parse_dates=["date"])

# ---------------------------------------------------------------------------
# Helper functions
# ---------------------------------------------------------------------------

def remove_feb29(df):
    return df[~((df.index.month == 2) & (df.index.day == 29))].copy()

def T_mean(t, A, B, C, phi):
    return A + B * t + C * np.sin(OMEGA * t + phi)

def sigma_est1(df):
    """Estimator 1: quadratic variation (eq. 3.16)."""
    result = {}
    for mo in months:
        sub = df[df.index.month == mo]["T"].values
        if len(sub) < 2:
            continue
        result[mo] = np.sqrt(np.mean(np.diff(sub)**2))
    return result

def sigma_est2(df, a_val):
    """Estimator 2: regression residuals (eq. 3.19)."""
    result = {}
    T  = df["T"].values
    Tm = df["Tm"].values
    for mo in months:
        idx   = np.where(df.index.month == mo)[0]
        pairs = idx[idx > 0]
        pairs = pairs[df.index.month[pairs - 1] == mo]
        if len(pairs) < 3:
            continue
        j, jm1  = pairs, pairs - 1
        T_tilde = T[j] - (Tm[j] - Tm[jm1])
        resid   = T_tilde - a_val * Tm[jm1] - (1 - a_val) * T[jm1]
        result[mo] = np.sqrt(np.sum(resid**2) / (len(j) - 2))
    return result

def estimate_a(df, sigma_by_month):
    """Martingale estimator (eq. 3.26)."""
    T    = df["T"].values
    Tm   = df["Tm"].values
    sig2 = np.array([sigma_by_month[df.index.month[i]]**2
                     for i in range(len(df))])
    num = den = 0.0
    for i in range(1, len(T)):
        Y_im1  = (Tm[i-1] - T[i-1]) / sig2[i-1]
        num   += Y_im1 * (T[i]   - Tm[i])
        den   += Y_im1 * (T[i-1] - Tm[i-1])
    return -np.log(num / den)

def compute_acf(x, max_lag):
    n, xc = len(x), x - x.mean()
    return np.array([
        np.dot(xc[:n-k], xc[k:]) / np.dot(xc, xc) if k > 0 else 1.0
        for k in range(max_lag + 1)
    ])

def calibrate_alaton(df_raw, calib_end_str):
    """
    Calibrate Alaton model on df_raw up to calib_end_str (expanding window
    from first observation in df_raw). Returns model dict or None if
    insufficient data.
    """
    df_calib = df_raw.loc[:calib_end_str].copy()
    if len(df_calib) < MIN_CALIB_OBS:
        return None

    t_arr = df_calib["t"].values
    T_arr = df_calib["T"].values

    # OLS seasonal mean (eq. 3.8 / 3.9)
    X_ols = np.column_stack([
        np.ones(len(t_arr)), t_arr,
        np.sin(OMEGA * t_arr), np.cos(OMEGA * t_arr),
    ])
    coeffs, _, _, _ = np.linalg.lstsq(X_ols, T_arr, rcond=None)
    a1, a2, a3, a4  = coeffs
    A   = a1
    B   = a2
    C   = np.sqrt(a3**2 + a4**2)
    phi = np.arctan(a4 / a3) - np.pi

    df_calib["Tm"] = T_mean(t_arr, A, B, C, phi)
    df_calib["X"]  = df_calib["T"] - df_calib["Tm"]

    # Monthly volatility (two-estimator mean, eq. 3.3)
    sig1  = sigma_est1(df_calib)
    a_est = estimate_a(df_calib, sig1)
    sig2  = sigma_est2(df_calib, a_est)

    sigma_monthly = {}
    for mo in months:
        if mo in sig1 and mo in sig2:
            sigma_monthly[mo] = (sig1[mo] + sig2[mo]) / 2
        elif mo in sig1:
            sigma_monthly[mo] = sig1[mo]

    # Residual diagnostics
    df_calib["sigma"] = df_calib.index.month.map(sigma_monthly)
    T_v  = df_calib["T"].values
    Tm_v = df_calib["Tm"].values
    cstd = (df_calib["sigma"].values
            * np.sqrt((1 - np.exp(-2*a_est)) / (2*a_est)))

    cond_mean     = np.full(len(T_v), np.nan)
    cond_mean[1:] = (T_v[:-1] - Tm_v[:-1]) * np.exp(-a_est) + Tm_v[1:]
    df_calib["resid"] = (T_v - cond_mean) / cstd
    e = df_calib["resid"].dropna().values

    _, ks_p = stats.kstest(e, lambda x: stats.norm.cdf(x, e.mean(), e.std()))

    ci_bound = 1.96 / np.sqrt(len(T_v))
    acf_X    = compute_acf(df_calib["X"].dropna().values, MAX_LAG)
    acf_e    = compute_acf(e, MAX_LAG)

    return {
        # Model parameters
        "A": A, "B": B, "C": C, "phi": phi,
        "a": a_est,
        "sigma_monthly": sigma_monthly,
        # Data — full series stored so backtest can access post-calib actuals
        "df":       df_raw,
        "df_calib": df_calib,
        "sig1": sig1, "sig2": sig2,
        # Metadata
        "model_name":  "Alaton (2002)",
        "calib_end":   calib_end_str,
        # Diagnostics (stored for the diag figure)
        "e":         e,
        "ks_p":      ks_p,
        "acf_X":     acf_X,
        "acf_e":     acf_e,
        "ci_bound":  ci_bound,
    }

# ---------------------------------------------------------------------------
# Main loop: region x calibration year
# ---------------------------------------------------------------------------

summary_rows = []
diag_data    = []   # collect DIAG_YEAR calibrations for the overview figure

for region in REGIONS:
    print(f"\n{'='*60}\n  Region {region}\n{'='*60}")

    # Prepare full regional series once
    df_raw = (raw[raw["region_code"] == region]
                .set_index("date")
                .rename(columns={"daily_avg_temperature": "T"})
                [["T"]]
                .dropna())
    df_raw      = remove_feb29(df_raw)
    df_raw["t"] = np.arange(1, len(df_raw) + 1)

    print(f"Full series: N={len(df_raw):,}  "
          f"({df_raw.index[0].date()} — {df_raw.index[-1].date()})")

    for calib_year in CALIB_YEARS:
        calib_end_str = f"{calib_year}-12-31"

        model = calibrate_alaton(df_raw, calib_end_str)
        if model is None:
            print(f"  {calib_year}: insufficient data, skipping.")
            continue

        model["region_code"] = region

        # Save PKL with convention expected by backtest_comparison.py
        pkl_path = os.path.join(
            PKL_FOLDER,
            f"alaton_model_{region}_calib_{calib_year}.pkl"
        )
        with open(pkl_path, "wb") as f:
            pickle.dump(model, f)

        sigma_arr = np.array([model["sigma_monthly"][mo] for mo in months])
        print(f"  {calib_year}: "
              f"N_calib={len(model['df_calib']):,}  "
              f"a={model['a']:.4f}  "
              f"trend={model['B']*365*10:.3f} C/dec  "
              f"sigma=[{sigma_arr.min():.3f},{sigma_arr.max():.3f}]  "
              f"-> {pkl_path}")

        summary_rows.append({
            "region":         region,
            "calib_year":     calib_year,
            "A":              round(model["A"], 4),
            "B_C_per_decade": round(model["B"]*365*10, 3),
            "C":              round(model["C"], 4),
            "phi":            round(model["phi"], 4),
            "a":              round(model["a"], 4),
            "half_life_days": round(np.log(2)/model["a"], 1),
            "sigma_min":      round(sigma_arr.min(), 3),
            "sigma_max":      round(sigma_arr.max(), 3),
            "ks_p":           round(model["ks_p"], 4),
            "normal_rejected_5pct": model["ks_p"] < 0.05,
        })

        # Collect the DIAG_YEAR calibration for the overview figure
        if calib_year == DIAG_YEAR:
            diag_data.append({
                "region":         region,
                "df_calib":       model["df_calib"],
                "sig1":           model["sig1"],
                "sig2":           model["sig2"],
                "sigma_monthly":  model["sigma_monthly"],
                "e":              model["e"],
                "ks_p":           model["ks_p"],
                "acf_X":          model["acf_X"],
                "acf_e":          model["acf_e"],
                "ci_bound":       model["ci_bound"],
                "A":              model["A"],
                "B":              model["B"],
                "C":              model["C"],
                "phi":            model["phi"],
                "a_est":          model["a"],
            })

# ---------------------------------------------------------------------------
# Summary CSV
# ---------------------------------------------------------------------------

summary = pd.DataFrame(summary_rows).set_index(["region", "calib_year"])
summary.to_csv("alaton_model_summary.csv")
print(f"\nSaved -> alaton_model_summary.csv")
print(summary.to_string())

# ---------------------------------------------------------------------------
# Diagnostics figure (based on DIAG_YEAR calibration window)
# 4 panel rows x N_regions columns:
#   Row 0 — monthly sigma (bar chart)
#   Row 1 — residual distribution (log scale)
#   Row 2 — ACF(X_t) deseasonalised residuals
#   Row 3 — ACF(e_t) standardised residuals
# ---------------------------------------------------------------------------

N    = len(diag_data)
lags = np.arange(MAX_LAG + 1)

if N > 0:
    fig, axes = plt.subplots(4, N, figsize=(3.0 * N, 13))
    if N == 1:
        axes = axes.reshape(4, 1)

    start_year = diag_data[0]["df_calib"].index[0].year
    fig.suptitle(
        f"Alaton (2002) — Calibration Overview Across All Regions "
        f"({start_year}–{DIAG_YEAR})",
        fontsize=12, fontweight="bold", y=1.005
    )

    ROW_LABELS = [
        "Monthly σ",
        "Residual dist (log)",
        r"ACF($X_t$)",
        r"ACF($e_t$)",
    ]

    for col, d in enumerate(diag_data):
        region = d["region"]

        # Row 0: monthly sigma
        ax   = axes[0, col]
        x_mo = np.arange(12)
        w    = 0.32
        ax.bar(x_mo - w/2, [d["sig1"].get(m, 0)          for m in months],
               width=w, color=GRAY, alpha=0.6, label="Est 1")
        ax.bar(x_mo + w/2, [d["sigma_monthly"].get(m, 0) for m in months],
               width=w, color=RED,  alpha=0.8, label="Mean")
        ax.set_title(f"R{region}", fontweight="bold", fontsize=9)
        ax.set_xticks(x_mo)
        ax.set_xticklabels([m[0] for m in MONTH_NAMES], fontsize=6)
        ax.tick_params(labelsize=6)
        if col == 0:
            ax.set_ylabel("σ (°C)", fontsize=8)
            ax.legend(fontsize=5, frameon=False)

        # Row 1: residual distribution (log scale)
        ax     = axes[1, col]
        e      = d["e"]
        x_grid = np.linspace(np.percentile(e, 0.5), np.percentile(e, 99.5), 300)
        ax.hist(e, bins=60, density=True, color=GRAY, alpha=0.4)
        ax.plot(x_grid, stats.norm.pdf(x_grid, e.mean(), e.std()),
                color=RED, lw=1.5)
        ax.set_yscale("log")
        ax.set_ylim(1e-4, 2)
        ax.tick_params(labelsize=6)
        ax.text(0.97, 0.97, f"KS p={d['ks_p']:.3f}",
                transform=ax.transAxes, ha="right", va="top", fontsize=6,
                bbox=dict(boxstyle="round,pad=0.2", facecolor="white", alpha=0.8))
        if col == 0:
            ax.set_ylabel("Density (log)", fontsize=8)

        # Row 2: ACF(X_t)
        ax = axes[2, col]
        ax.bar(lags[1:], d["acf_X"][1:], width=0.8, color=GRAY)
        ax.axhline( d["ci_bound"], color=RED, ls="--", lw=0.8)
        ax.axhline(-d["ci_bound"], color=RED, ls="--", lw=0.8)
        ax.axhline(0, color="k", lw=0.4)
        ax.tick_params(labelsize=6)
        if col == 0:
            ax.set_ylabel("ACF", fontsize=8)

        # Row 3: ACF(e_t)
        ax = axes[3, col]
        ax.bar(lags[1:], d["acf_e"][1:], width=0.8, color=BLUE)
        ax.axhline( d["ci_bound"], color=RED, ls="--", lw=0.8)
        ax.axhline(-d["ci_bound"], color=RED, ls="--", lw=0.8)
        ax.axhline(0, color="k", lw=0.4)
        ax.set_xlabel("Lag", fontsize=7)
        ax.tick_params(labelsize=6)
        if col == 0:
            ax.set_ylabel("ACF", fontsize=8)

    # Row label annotations
    for row, label in enumerate(ROW_LABELS):
        axes[row, 0].annotate(
            label, xy=(-0.38, 0.5), xycoords="axes fraction",
            fontsize=7, fontweight="bold", rotation=90,
            va="center", ha="center")

    fig.tight_layout()
    fig.savefig("alaton_model_diagnostics.png", bbox_inches="tight", dpi=150)
    plt.close(fig)
    print("Saved -> alaton_model_diagnostics.png")

# ---------------------------------------------------------------------------
# Parameter evolution plots (one figure per region)
# Shows how A, B, C, a evolve as the calibration window expands year by year
# ---------------------------------------------------------------------------

for region in REGIONS:
    rows = [r for r in summary_rows if r["region"] == region]
    if not rows:
        continue

    years = [r["calib_year"] for r in rows]
    fig, axes = plt.subplots(2, 2, figsize=(10, 6))
    fig.suptitle(
        f"Region {region} — Parameter evolution (expanding window)",
        fontweight="bold"
    )

    for ax, key, label in zip(
        axes.flat,
        ["A", "B_C_per_decade", "C", "a"],
        ["A (intercept, °C)", "Trend (°C/decade)", "C (amplitude, °C)",
         "a (mean reversion)"]
    ):
        vals = [r[key] for r in rows]
        ax.plot(years, vals, color=BLUE, lw=1.5, marker="o", ms=4)
        ax.set_title(label, fontsize=9)
        ax.set_xlabel("Calibration end year", fontsize=8)
        ax.tick_params(labelsize=7)

    fig.tight_layout()
    fig.savefig(f"alaton_param_evolution_region{region}.png",
                bbox_inches="tight", dpi=150)
    plt.close(fig)
    print(f"Saved -> alaton_param_evolution_region{region}.png")

print(f"\nDone.  {len(summary_rows)} PKLs written across "
      f"{len(REGIONS)} regions x {len(list(CALIB_YEARS))} calibration years.")