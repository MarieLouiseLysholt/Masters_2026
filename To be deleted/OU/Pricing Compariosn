# ===========================================================================
# HELPERS
# ===========================================================================

def _doy_noleap(date):
    doy = date.timetuple().tm_yday
    if date.year % 4 == 0 and (date.year % 100 != 0 or date.year % 400 == 0):
        if date.month > 2:
            doy -= 1
    return max(1, min(365, doy))

def _daily_cdd(temps):
    return np.maximum(0.0, temps - BASE_TEMP)

def _cumulative_cdd(temps):
    return float(_daily_cdd(np.asarray(temps, dtype=float)).sum())

# ===========================================================================
# UNIFIED PRICING ENGINE
# ===========================================================================

def _block_bootstrap(resid, n_sim, n_days):
    """
    Circular block bootstrap of residuals.
    Preserves autocorrelation structure of forecast errors.
    """
    n_r = len(resid)
    nb  = int(np.ceil(n_days / BLOCK_L))
    pad = np.concatenate([resid, resid[:BLOCK_L]])
    st  = np.random.randint(0, n_r, size=(n_sim, nb))
    eps = np.empty((n_sim, nb * BLOCK_L))
    for b in range(nb):
        for s in range(n_sim):
            eps[s, b*BLOCK_L:(b+1)*BLOCK_L] = pad[st[s,b]: st[s,b]+BLOCK_L]
    return eps[:, :n_days]


def simulate_cdd_paths(fcst_vec, resid):
    """
    Core of Section 4.6 Monte Carlo.

    Generates N_SIM CDD realisations by adding block-bootstrapped
    OOS residuals to the model's deterministic forecast:

        T_sim[s, d] = fcst_vec[d] + eps[s, d]
        CDD_sim[s]  = sum_d max(0, T_sim[s,d] − T_ref)

    fcst_vec : (n_days,) mean forecast for the pricing window
    resid    : (N_resid,) all OOS residuals for this model
    """
    n   = len(fcst_vec)
    eps = _block_bootstrap(resid, N_SIM, n)
    T   = fcst_vec[np.newaxis, :] + eps          # (N_SIM, n_window_days)
    return _daily_cdd(T).sum(axis=1)             # (N_SIM,)


def price_call(cdd_dist, strike, ttm):
    """
    Price a CDD call option from a simulated CDD distribution.
    Barnor et al. (2026) Eqs 12–13:
      Payoff_s = TICK × max(CDD_s − K, 0)
      Price    = exp(−r × TTM) × mean(Payoff_s)
    Returns full Table 22 risk metrics.
    """
    payoffs = TICK * np.maximum(0.0, cdd_dist - strike)
    price   = float(np.exp(-R * ttm) * payoffs.mean())
    return {
        "mu_C":        float(cdd_dist.mean()),
        "sigma_C":     float(cdd_dist.std()),
        "strike":      float(strike),
        "price":       float(price),
        "payoff_mean": float(payoffs.mean()),
        "payoff_std":  float(payoffs.std()),
        "payoff_skew": float(stats.skew(payoffs)),
        "payoff_kurt": float(stats.kurtosis(payoffs)),
        "var5":        float(np.percentile(payoffs, 5)),
        "_cdd":        cdd_dist,
        "_pay":        payoffs,
    }


def row_metrics(res, strike):
    return {
        "mu_C":        round(res["mu_C"],        2),
        "sigma_C":     round(res["sigma_C"],     2),
        "strike_ATM":  round(strike,             2),
        "price":       round(res["price"],       2),
        "payoff_mean": round(res["payoff_mean"], 2),
        "payoff_std":  round(res["payoff_std"],  2),
        "payoff_skew": round(res["payoff_skew"], 3),
        "payoff_kurt": round(res["payoff_kurt"], 3),
        "var5":        round(res["var5"],        2),
    }


def _safe_kde(data, x_grid):
    if len(data) < 5 or np.std(data) < 1e-6:
        return None
    try:
        return stats.gaussian_kde(data, bw_method="scott")(x_grid)
    except Exception:
        return None

# ===========================================================================
# LOAD DATA
# ===========================================================================

print("=" * 70)
print(f"  Section 4.6 — CDD Call Option Pricing  (T_ref = {BASE_TEMP}°C)")
print("  Unified engine: block-bootstrap(OOS residuals) + forecast")
print("  Loading bk_forecasts.csv …")
print("=" * 70)

fcst_df = pd.read_csv(FCST_CSV, parse_dates=["date"])
fcst_df["doy"]      = fcst_df["date"].apply(lambda d: _doy_noleap(pd.Timestamp(d)))
fcst_df["residual"] = fcst_df["actual"] - fcst_df["forecast"]

print(f"  Forecast rows: {len(fcst_df):,}")
print(f"  Models found:  {sorted(fcst_df['model'].unique())}\n")

# ===========================================================================
# MAIN PRICING LOOP
# ===========================================================================

summary_rows  = []   # Table 22: pooled risk metrics per model × region × horizon
yearly_rows   = []   # per-year prices (for evolution plots)
accuracy_rows = []   # Extension: per-year pricing error vs realized payoff

for region in REGIONS:
    reg_fcst = fcst_df[fcst_df["region"] == region].copy()
    print(f"\n{'─'*60}\n  Region {region}\n{'─'*60}")

    for h_name, h_cfg in HORIZONS.items():
        print(f"\n  ▶  {h_cfg['label']}")

        # ── ATM strike: mean actual CDD per OOS year (deduplicated) ──────────
        # NOTE: strike construction is not stated in the paper.
        # We set K = mean(realized CDD over OOS years) as an ATM approximation.
        sv = []
        for yr, g in reg_fcst.groupby("year"):
            w = (g[(g["doy"] >= h_cfg["start"]) & (g["doy"] <= h_cfg["end"])]
                 .drop_duplicates(subset=["date"]))
            if not w.empty:
                sv.append(_cumulative_cdd(w["actual"].values))
        strike = float(np.mean(sv)) if sv else 0.0

        # ── Per-year realized actual payoffs (Extension) ──────────────────────
        realized_payoffs = {}
        for yr, g in reg_fcst.groupby("year"):
            w = (g[(g["doy"] >= h_cfg["start"]) & (g["doy"] <= h_cfg["end"])]
                 .drop_duplicates(subset=["date"]))
            if not w.empty:
                cdd_actual = _cumulative_cdd(w["actual"].values)
                realized_payoffs[yr] = float(TICK * max(0.0, cdd_actual - strike))

        showcase = {}

        for mname in MODEL_ORDER:
            mod = reg_fcst[reg_fcst["model"] == mname]
            if mod.empty:
                continue

            # Window rows: DOYs within the pricing window
            wnd   = mod[(mod["doy"] >= h_cfg["start"]) & (mod["doy"] <= h_cfg["end"])]
            resid = mod["residual"].dropna().values

            if wnd.empty or len(resid) < BLOCK_L * 3:
                continue

            # Pooled mean forecast per DOY (used for showcase distribution)
            mean_f = wnd.groupby("doy")["forecast"].mean().sort_index().values
            if not np.isfinite(mean_f).any():
                print(f"    {mname:<14s} — all forecasts NaN, skipping")
                continue

            # ── Pooled showcase (mean forecast across all OOS years) ──────────
            cs  = simulate_cdd_paths(mean_f, resid)
            res = price_call(cs, strike, h_cfg["TTM"])
            showcase[mname] = res
            summary_rows.append({
                "region": region, "horizon": h_name, "model": mname,
                "method": "block_bootstrap_unified", "n_paths": N_SIM,
                **row_metrics(res, strike),
            })
            print(f"    {mname:<14s} [BB]  "
                  f"μC={res['mu_C']:7.1f}  σC={res['sigma_C']:5.1f}  "
                  f"K={strike:7.1f}  P=€{res['price']:8.2f}")

            # ── Per-year LOO pricing (Extension: pricing accuracy) ────────────
            for yr in OOS_YEARS:
                yw = wnd[wnd["year"] == yr].sort_values("doy")
                if yw.empty: continue
                yf = yw["forecast"].values
                if not np.isfinite(yf).any(): continue

                # Leave-one-out residuals: exclude current year
                loor = mod[mod["year"] != yr]["residual"].dropna().values
                if len(loor) < BLOCK_L * 3:
                    loor = resid

                cy = simulate_cdd_paths(yf, loor)
                ry = price_call(cy, strike, h_cfg["TTM"])

                yearly_rows.append({
                    "region": region, "horizon": h_name,
                    "model": mname, "year": yr,
                    "price_EUR": round(ry["price"], 2),
                })

                if yr in realized_payoffs:
                    accuracy_rows.append({
                        "region":          region,
                        "horizon":         h_name,
                        "model":           mname,
                        "year":            yr,
                        "model_price":     round(ry["price"], 2),
                        "realized_payoff": round(realized_payoffs[yr], 2),
                        "pricing_error":   round(ry["price"] - realized_payoffs[yr], 2),
                        "mu_C":            round(float(cy.mean()), 2),
                        "sigma_C":         round(float(cy.std()), 2),
                    })

        # ── Distribution figure (Fig 12/13 style) ────────────────────────────
        plottable = {mn: r for mn, r in showcase.items()
                     if r["sigma_C"] > 1e-6 and np.isfinite(r["_cdd"]).any()}
        if not plottable:
            print(f"    [no plottable distributions for {h_name}]")
            continue

        fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 5))
        fig.suptitle(
            f"Region {region}  |  {h_cfg['label']}\n"
            f"CDD Call Option  K(ATM)={strike:.1f}°·d  "
            f"Tick=€{TICK}  r={R*100:.0f}%  T_ref={BASE_TEMP}°C  {N_SIM:,} paths\n"
            "Unified engine: block-bootstrap(OOS residuals) + model forecast",
            fontsize=10, fontweight="bold",
        )
        p_cdd, p_pay = [], []
        for mn, res in showcase.items():
            col = MODEL_COLORS.get(mn, "grey")
            c_  = res["_cdd"]; py_ = res["_pay"]
            if res["sigma_C"] > 1e-6 and np.isfinite(c_).any():
                ax1.hist(c_, bins=60, density=True, alpha=0.28, color=col, edgecolor="none")
                kx  = np.linspace(c_.min(), c_.max(), 400)
                kde = _safe_kde(c_, kx)
                if kde is not None:
                    ax1.plot(kx, kde, color=col, lw=2)
            else:
                ax1.axvline(float(np.nanmean(c_)), color=col, lw=1.5, alpha=0.7)
            pos = py_[py_ > 0]
            if len(pos) > 10 and np.std(pos) > 1e-6:
                ax2.hist(py_, bins=60, density=True, alpha=0.28, color=col, edgecolor="none")
                kp  = np.linspace(pos.min(), pos.max(), 400)
                kde = _safe_kde(pos, kp)
                if kde is not None:
                    ax2.plot(kp, kde, color=col, lw=2)
            p_cdd.append(mpatches.Patch(color=col, alpha=0.75,
                label=f"{mn}  μ={res['mu_C']:.0f}  σ={res['sigma_C']:.1f}"))
            p_pay.append(mpatches.Patch(color=col, alpha=0.75,
                label=f"{mn}  P=€{res['price']:.0f}"))
        ax1.axvline(strike, color="black", ls="--", lw=1.8)
        p_cdd.insert(0, mpatches.Patch(color="black", label=f"Strike K={strike:.1f}"))
        for ax, patches, xl, ttl in [
            (ax1, p_cdd, "Cumulative CDD  (°C·days)", "Distribution of CDD Sums"),
            (ax2, p_pay, "Call Payoff  (€)",           "Distribution of CDD Call Payoffs"),
        ]:
            ax.set_xlabel(xl, fontsize=11); ax.set_ylabel("Density", fontsize=11)
            ax.set_title(ttl, fontsize=11)
            ax.legend(handles=patches, fontsize=7.5, loc="upper right", framealpha=0.85)
            ax.grid(axis="y", alpha=0.25); ax.spines[["top","right"]].set_visible(False)
        plt.tight_layout()
        f_ = OUT_DIR / f"dist_region{region}_{h_name}.png"
        fig.savefig(f_, dpi=150, bbox_inches="tight"); plt.close(fig)
        print(f"    → {f_.name}")

# ===========================================================================
# EXTENSION: PRICING ACCURACY VS REALIZED PAYOFF
# (Not in Section 4.6 of the paper — added as our own evaluation)
# ===========================================================================

acc_df = pd.DataFrame(accuracy_rows)

if not acc_df.empty:
    print("\n" + "=" * 90)
    print("PRICING ACCURACY  [Extension beyond Section 4.6]")
    print(f"Pricing Error = Model Price − Realized Payoff  (T_ref={BASE_TEMP}°C  CDD)")
    print("Positive bias = overpricing  |  Negative bias = underpricing")
    print("=" * 90)

    acc_summary = (
        acc_df.groupby(["horizon", "model"])["pricing_error"]
        .agg(
            bias  = "mean",
            mae   = lambda x: np.mean(np.abs(x)),
            rmse  = lambda x: np.sqrt(np.mean(x**2)),
            std   = "std",
            n_obs = "count",
        )
        .round(2)
        .reset_index()
    )

    print(f"\n{'Horizon':>10}  {'Model':>14}  {'Bias (€)':>10}  "
          f"{'MAE (€)':>9}  {'RMSE (€)':>10}  {'Std':>8}  {'N':>4}")
    print("-" * 75)
    for _, r in acc_summary.sort_values(["horizon", "bias"]).iterrows():
        sign = "↑" if r["bias"] > 0 else "↓"
        print(f"{r['horizon']:>10}  {r['model']:>14}  "
              f"{r['bias']:>+10.2f}{sign}  {r['mae']:>9.2f}  "
              f"{r['rmse']:>10.2f}  {r['std']:>8.2f}  {int(r['n_obs']):>4d}")

    acc_summary.to_csv(OUT_DIR / "pricing_accuracy_summary.csv", index=False)
    acc_df.to_csv(OUT_DIR / "pricing_accuracy_yearly.csv", index=False)

    # ── Pricing bias bar chart ────────────────────────────────────────────────
    fig, axes = plt.subplots(1, 2, figsize=(16, 6), sharey=False)
    fig.suptitle(
        "Pricing Accuracy: Mean Pricing Bias per Model  [Extension]\n"
        f"Bias = Mean(Model Price − Realized Payoff)  |  "
        f"CDD Call Option  T_ref={BASE_TEMP}°C\n"
        "Positive = overpricing  |  Negative = underpricing  |  "
        "Error bars = ±1 SD",
        fontsize=11, fontweight="bold",
    )
    for ax, (h_name, h_cfg) in zip(axes, HORIZONS.items()):
        sub = (acc_summary[acc_summary["horizon"] == h_name]
               .set_index("model").reindex(MODEL_ORDER).dropna(subset=["bias"]))
        colors = [MODEL_COLORS.get(m, "grey") for m in sub.index]
        bars   = ax.bar(sub.index, sub["bias"], color=colors, alpha=0.85, width=0.6)
        ax.errorbar(sub.index, sub["bias"], yerr=sub["std"],
                    fmt="none", color="black", capsize=5, lw=1.5)
        for bar, v in zip(bars, sub["bias"]):
            va     = "bottom" if v >= 0 else "top"
            offset = max(5, sub["std"].max() * 0.02) * (1 if v >= 0 else -1)
            ax.text(bar.get_x()+bar.get_width()/2, v + offset,
                    f"{v:+.0f}", ha="center", va=va, fontsize=8, fontweight="bold")
        ax.axhline(0, color="black", lw=1.2)
        ax.set_xlabel("Model", fontsize=11)
        ax.set_ylabel("Mean Pricing Bias  (€)", fontsize=11)
        ax.set_title(h_cfg["label"], fontsize=11)
        ax.tick_params(axis="x", rotation=30)
        ax.grid(axis="y", alpha=0.3)
        ax.spines[["top","right"]].set_visible(False)
    plt.tight_layout()
    f_ = OUT_DIR / "pricing_bias_by_model.png"
    fig.savefig(f_, dpi=150, bbox_inches="tight"); plt.close(fig)
    print(f"\n  → {f_.name}")

    # ── Forecast MAE vs |pricing bias| scatter ────────────────────────────────
    forecast_mae = {
        mn: float(fcst_df[fcst_df["model"]==mn]["residual"].abs().mean())
        for mn in MODEL_ORDER
        if not fcst_df[fcst_df["model"]==mn].empty
    }
    fig, axes = plt.subplots(1, 2, figsize=(14, 6))
    fig.suptitle(
        "Forecast Accuracy vs Pricing Accuracy  [Extension]\n"
        "Paper's key claim: better temperature forecasting → less pricing bias\n"
        f"CDD Call Option  T_ref={BASE_TEMP}°C",
        fontsize=11, fontweight="bold",
    )
    for ax, (h_name, h_cfg) in zip(axes, HORIZONS.items()):
        sub = acc_summary[acc_summary["horizon"] == h_name]
        for _, row in sub.iterrows():
            mn     = row["model"]
            fc_mae = forecast_mae.get(mn, np.nan)
            if np.isnan(fc_mae): continue
            col = MODEL_COLORS.get(mn, "grey")
            ax.scatter(fc_mae, abs(row["bias"]), color=col, s=120, zorder=5,
                       edgecolors="white", lw=0.8)
            ax.annotate(mn, (fc_mae, abs(row["bias"])),
                        textcoords="offset points", xytext=(6, 4),
                        fontsize=8, color=col)
        ax.set_xlabel("Mean Absolute Forecast Error  (°C)", fontsize=11)
        ax.set_ylabel("|Mean Pricing Bias|  (€)", fontsize=11)
        ax.set_title(h_cfg["label"], fontsize=11)
        ax.grid(alpha=0.25)
        ax.spines[["top","right"]].set_visible(False)
    plt.tight_layout()
    f_ = OUT_DIR / "forecast_vs_pricing_accuracy.png"
    fig.savefig(f_, dpi=150, bbox_inches="tight"); plt.close(fig)
    print(f"  → {f_.name}")

    # ── Per-region per-year price vs realized payoff ───────────────────────────
    for region in REGIONS:
        for h_name, h_cfg in HORIZONS.items():
            sub = acc_df[(acc_df["region"]==region)&(acc_df["horizon"]==h_name)]
            if sub.empty: continue
            fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 8), sharex=True)
            fig.suptitle(
                f"Region {region}  |  {h_cfg['label']}\n"
                f"Per-Year Model Price vs Realized Payoff  "
                f"(CDD  T_ref={BASE_TEMP}°C  K=ATM)  [Extension]",
                fontsize=11, fontweight="bold",
            )
            for mname in MODEL_ORDER:
                ms = sub[sub["model"]==mname].sort_values("year")
                if ms.empty: continue
                col = MODEL_COLORS.get(mname, "grey")
                ax1.plot(ms["year"], ms["model_price"], marker="o", lw=1.8, ms=5,
                         color=col, label=mname)
                ax2.plot(ms["year"], ms["pricing_error"], marker="s", lw=1.5, ms=4,
                         color=col, label=mname)
            real_yrs = sorted(sub["year"].unique())
            real_pay = [sub[sub["year"]==y]["realized_payoff"].iloc[0]
                        for y in real_yrs if not sub[sub["year"]==y].empty]
            ax1.plot(real_yrs, real_pay, color="black", lw=2.5, ls="-",
                     marker="D", ms=6, label="Realized Payoff", zorder=10)
            ax1.set_ylabel("Option Price  (€)", fontsize=11)
            ax1.set_title("Model Price vs Realized Payoff", fontsize=11)
            ax1.legend(fontsize=7.5, ncol=2, framealpha=0.85)
            ax1.grid(alpha=0.25); ax1.spines[["top","right"]].set_visible(False)
            ax2.axhline(0, color="black", lw=1.2, ls="--")
            ax2.set_xlabel("OOS Year", fontsize=11)
            ax2.set_ylabel("Pricing Error  (€)", fontsize=11)
            ax2.set_title("Pricing Error = Model Price − Realized Payoff", fontsize=11)
            ax2.grid(alpha=0.25); ax2.spines[["top","right"]].set_visible(False)
            ax2.xaxis.set_major_locator(mticker.MaxNLocator(integer=True))
            plt.tight_layout()
            f_ = OUT_DIR / f"pricing_accuracy_region{region}_{h_name}.png"
            fig.savefig(f_, dpi=150, bbox_inches="tight"); plt.close(fig)
    print("  → Per-region pricing accuracy charts saved.")

