def build_pairwise_dm_summary(dm_long: pd.DataFrame, models: list
                              ) -> pd.DataFrame:
    """
    Compact main-text summary of pairwise pricing DM results.

    A win is a significant pairwise comparison where the row model has lower
    pricing loss than the column model (DM < 0). A loss is significant DM > 0.
    Counts are across all index x contract x horizon panels and peers.
    """
    rows = []
    total_panels = (
        dm_long[["index", "contract", "horizon"]]
        .drop_duplicates()
        .shape[0]
    )
    max_comparisons = total_panels * max(0, len(models) - 1)

    for model in models:
        sub = dm_long[dm_long["row_model"] == model].copy()
        sig = sub[sub["significant_5pct"]].copy()
        wins = sig[sig["dm_stat"] < 0]
        losses = sig[sig["dm_stat"] > 0]

        row = {
            "model": model,
            "label": LABELS.get(model, model),
            "significant_wins": int(len(wins)),
            "significant_losses": int(len(losses)),
            "net_wins": int(len(wins) - len(losses)),
            "win_share_pct": (
                100.0 * len(wins) / max_comparisons
                if max_comparisons > 0 else np.nan
            ),
            "loss_share_pct": (
                100.0 * len(losses) / max_comparisons
                if max_comparisons > 0 else np.nan
            ),
        }
        for idx in INDEX_TYPES:
            row[f"{idx}_wins"] = int((wins["index"] == idx).sum())
            row[f"{idx}_losses"] = int((losses["index"] == idx).sum())
        for h_name in HORIZONS:
            row[f"{h_name}_wins"] = int((wins["horizon"] == h_name).sum())
            row[f"{h_name}_losses"] = int((losses["horizon"] == h_name).sum())
        rows.append(row)

    out = pd.DataFrame(rows)
    return out.sort_values(
        ["net_wins", "significant_wins", "significant_losses"],
        ascending=[False, False, True],
    )


