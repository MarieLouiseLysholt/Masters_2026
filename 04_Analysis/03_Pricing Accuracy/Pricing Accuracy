                            records.append({
                                "model":           model,
                                "region":          region,
                                "year":            year,
                                "index":           index_type,
                                "contract":        contract_type,
                                "horizon":         h_name,
                                "strike":          round(strike, 2),
                                "sim_idx_mean":    round(float(np.mean(idx_dist)), 2),
                                "sim_idx_std":     round(float(np.std(idx_dist, ddof=1)), 2),
                                "model_price":     round(model_price, 4),
                                "realised_idx":    round(r_idx, 2)
                                                   if not np.isnan(r_idx) else None,
                                "realised_payoff": round(r_payoff, 4)
                                                   if not np.isnan(r_payoff) else None,
                                "pricing_error":   round(pricing_error, 4)
                                                   if not np.isnan(pricing_error) else None,
                            })

                            print(f"    [{done:>4}/{total}] {year} "
                                  f"{index_type} {contract_type} {h_name}: "
                                  f"K={strike:.1f}  price={model_price:.2f}  "
                                  f"realised={r_payoff:.2f}  "
                                  f"error={pricing_error:+.2f}")

    df = pd.DataFrame(records)

    # Summary
    print("\n" + "=" * 80)
    print("  SUMMARY -- Bias, MAE, RMSE by (Model, Index, Contract, Horizon)")
    print("=" * 80)
    print(f"  {'Model':<16} {'Index':<6} {'Contract':<8} {'Horizon':<8} "
          f"{'N':>4} {'Bias':>10} {'MAE':>10} {'RMSE':>10}")
    print("  " + "-" * 74)

    for (mod, idx, ct, hor), grp in df.groupby(
            ["model", "index", "contract", "horizon"]):
        errors = grp["pricing_error"].dropna()
        if errors.empty:
            continue
        bias = float(errors.mean())
        mae  = float(errors.abs().mean())
        rmse = float(np.sqrt((errors ** 2).mean()))
        print(f"  {mod:<16} {idx:<6} {ct:<8} {hor:<8} {len(errors):>4} "
              f"{bias:>10.3f} {mae:>10.3f} {rmse:>10.3f}")

    print("=" * 80)
    print("  Positive bias = systematic overpricing")
    print("  Negative bias = systematic underpricing")

    OUTPUT_CSV.parent.mkdir(parents=True, exist_ok=True)
    df.to_csv(OUTPUT_CSV, index=False)
    print(f"\n[SAVE] {OUTPUT_CSV}")

    print("\nRendering publication tables ...")
    models_present = _active_models(df)
    if not models_present:
        print("  No models with priced contracts — skipping figures.")
    else:
        print(f"  Models present : {models_present}")
        render_metrics_pngs(df, models_present)
        render_dm_pngs(df, models_present)
        export_dm_csvs(df, models_present)
        dm_pairwise = build_pricing_pairwise_dm_long(df, models_present)
        dm_pairwise_csv = PNG_DIR / "csv_pricing_pairwise_dm_long.csv"
        dm_pairwise_out = dm_pairwise.copy()
        dm_pairwise_out["row_model"] = dm_pairwise_out["row_model"].map(
            lambda m: LABELS.get(m, m)
        )
        dm_pairwise_out["col_model"] = dm_pairwise_out["col_model"].map(
            lambda m: LABELS.get(m, m)
        )
        dm_pairwise_out.to_csv(dm_pairwise_csv, index=False)
        print(f"  -> {dm_pairwise_csv.name}")
        render_pairwise_dm_matrix_pngs(dm_pairwise, models_present)
        dm_summary = build_pairwise_dm_summary(dm_pairwise, models_present)
        dm_summary_csv = PNG_DIR / "csv_pricing_pairwise_dm_summary.csv"
        dm_summary_out = dm_summary.copy()
        dm_summary_out["model"] = dm_summary_out["label"]
        dm_summary_out = dm_summary_out.rename(columns={
            "H1_wins": "Q1_wins",
            "H1_losses": "Q1_losses",
            "H2_wins": "Q2_wins",
            "H2_losses": "Q2_losses",
        })
        dm_summary_out.to_csv(dm_summary_csv, index=False)
        print(f"  -> {dm_summary_csv.name}")
        render_pairwise_dm_summary_png(dm_summary)
        sens = build_pricing_sensitivity_table(df, models_present)
        sens_csv = PNG_DIR / "csv_pricing_sensitivity_hba.csv"
        sens.to_csv(sens_csv, index=False)
        print(f"  -> {sens_csv.name}")
        render_sensitivity_pngs(sens, models_present)
        dm_hba = build_pricing_dm_vs_baseline(df, models_present)
        dm_hba_csv = PNG_DIR / "csv_pricing_dm_vs_hba.csv"
        dm_hba_out = dm_hba.copy()
        dm_hba_out["baseline"] = dm_hba_out["baseline"].map(
            lambda m: LABELS.get(m, m)
        )
        dm_hba_out["model"] = dm_hba_out["model"].map(
            lambda m: LABELS.get(m, m)
        )
        dm_hba_out.to_csv(dm_hba_csv, index=False)
        print(f"  -> {dm_hba_csv.name}")
        render_pricing_dm_vs_baseline_pngs(dm_hba, models_present)
        print(f"\n[SAVE] PNGs and CSVs in {PNG_DIR}")

    return df


