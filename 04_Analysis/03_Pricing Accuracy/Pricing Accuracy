"""
pricing.py
----------
Prices temperature derivatives from saved bootstrap path files.

For each (model, region, OOS year, index type, contract type, horizon):
  1. Load saved .npy paths (generated by generate_paths.py)
     plus the companion saved date grid (_dates.csv)
  2. Slice paths to the horizon window on the shared no-leap calendar
  3. Compute simulated index distribution from sliced paths
  4. Set strike = mean realised index over 1970 to oos_year-1 (expanding)
  5. Compute option payoffs, discount to get model price
  6. Compute realised index and payoff from actual temperatures
  7. Report per (model, region, year, index, contract, horizon):
       model price, realised payoff, pricing error
  8. Aggregate: bias, MAE, RMSE per (model, index, contract, horizon)

File naming convention (must match generate_paths.py):
    paths_region{R}_{Y}_{MODEL}.npy
    paths_region{R}_{Y}_{MODEL}_dates.csv

Contract types:
    Both call and put are priced for each of CDD, HDD, and CAT.
    Call payoff: TICK * max(index - K, 0)
    Put  payoff: TICK * max(K - index, 0)

Horizons (no-leap DOY, inclusive):
    H1 : Jan 1  - Mar 31  (DOY  1- 90)  immediate purchase
    H2 : Apr 1  - Jun 30  (DOY 91-181)  3-month forward purchase

Strike:
    Expanding window -- mean realised index over 1970 to oos_year-1.
    Ensures no future information enters the strike construction.

Usage:
    python pricing.py
"""

import os
import numpy as np
import pandas as pd
from pathlib import Path

# =============================================================================
# CONFIG
# =============================================================================

REGIONS   = [11, 24, 27, 28, 32, 44, 52, 53]
OOS_YEARS = list(range(2015, 2025))
ROOT      = Path(__file__).resolve().parents[2]
SCRIPT_DIR = Path(__file__).resolve().parent

MODELS = ["HBA", "Alaton", "Benth", "ARMA", "XGB", "WaveletFNN", "LSTM", "FeedForwardNN"]

T_REF     = 10.0    # degC
TICK      = 20      # EUR per index unit
RISK_FREE = 0.01    # annualised risk-free rate

HORIZONS = {
    "H1": (1,   90),    # Jan 1  - Mar 31  (immediate purchase)
    "H2": (91,  181),   # Apr 1  - Jun 30  (3-month forward purchase)
}

INDEX_TYPES    = ["CDD", "HDD", "CAT"]
CONTRACT_TYPES = ["call", "put"]           # both priced for every index type

STRIKE_HISTORY_START = 1970               # expanding: 1970 to oos_year-1

PATHS_DIR  = ROOT / "04_Analysis" / "01_Bootstrap Paths" / "bootstrap_paths"
TEMP_CSV   = ROOT / "02_Data" / "01_Temprature" / "region_avg.csv"
OUTPUT_CSV = SCRIPT_DIR / "pricing_results.csv"


# =============================================================================
# CALENDAR HELPER
# =============================================================================

def _doy_noleap(ts: pd.Timestamp) -> int:
    doy = ts.timetuple().tm_yday
    if ts.is_leap_year and ts.month > 2:
        doy -= 1
    return doy


def _window_ttm(horizon_window: tuple) -> float:
    start_doy, end_doy = horizon_window
    return ((start_doy + end_doy) / 2.0) / 365.0


# =============================================================================
# DATA LOADING
# =============================================================================

def load_temp(temp_csv: str) -> pd.DataFrame:
    df = pd.read_csv(temp_csv, parse_dates=["date"])
    df.columns = df.columns.str.lower().str.strip()
    reg_col  = next(c for c in ["region_code", "region", "reg"] if c in df.columns)
    temp_col = next(c for c in ["daily_avg_temperature", "temp", "temperature"]
                    if c in df.columns)
    df = df.rename(columns={reg_col: "region", temp_col: "temp"})
    df = df[~((df["date"].dt.month == 2) & (df["date"].dt.day == 29))].copy()
    df["year"] = df["date"].dt.year
    df["doy"]  = df["date"].map(lambda d: _doy_noleap(pd.Timestamp(d)))
    return df[["date", "region", "year", "doy", "temp"]].sort_values(["region", "date"])


def load_paths(paths_dir: str, region: int, year: int, model: str):
    stem      = os.path.join(paths_dir, f"paths_region{region}_{year}_{model}")
    npy_path  = f"{stem}.npy"
    date_path = f"{stem}_dates.csv"
    if not os.path.exists(npy_path):
        print(f"  [SKIP] Not found: {os.path.basename(npy_path)}")
        return None
    if not os.path.exists(date_path):
        print(f"  [SKIP] Not found: {os.path.basename(date_path)}")
        return None
    paths      = np.load(npy_path)
    path_dates = pd.DatetimeIndex(
        pd.read_csv(date_path, parse_dates=["date"])["date"])
    if paths.shape[1] != len(path_dates):
        print(f"  [SKIP] {model} R{region} {year}: shape mismatch")
        return None
    return paths, path_dates


# =============================================================================
# INDEX HELPERS
# =============================================================================

def daily_index(temp: np.ndarray, index_type: str) -> np.ndarray:
    if index_type == "CDD":
        return np.maximum(temp - T_REF, 0.0)
    elif index_type == "HDD":
        return np.maximum(T_REF - temp, 0.0)
    elif index_type == "CAT":
        return temp.copy()
    raise ValueError(f"Unknown index: {index_type}")


def path_index(paths, path_dates, index_type, horizon_window):
    start_doy, end_doy = horizon_window
    doys = np.array([_doy_noleap(pd.Timestamp(d)) for d in path_dates])
    mask = (doys >= start_doy) & (doys <= end_doy)
    if not mask.any():
        raise ValueError(f"No path days in DOY {horizon_window}")
    sliced = paths[:, mask]
    if index_type == "CDD":
        return np.maximum(sliced - T_REF, 0.0).sum(axis=1)
    elif index_type == "HDD":
        return np.maximum(T_REF - sliced, 0.0).sum(axis=1)
    elif index_type == "CAT":
        return sliced.sum(axis=1)


def compute_historical_window_index(temp_df, region, horizon_window,
                                    index_type, year_start, year_end):
    start_doy, end_doy = horizon_window
    expected = end_doy - start_doy + 1
    df_r = temp_df[
        (temp_df["region"] == region) &
        (temp_df["year"].between(year_start, year_end)) &
        (temp_df["doy"].between(start_doy, end_doy))
    ].copy()
    df_r["idx"] = daily_index(df_r["temp"].values, index_type)
    results = {yr: float(g["idx"].sum())
               for yr, g in df_r.groupby("year") if len(g) == expected}
    return pd.Series(results)


def compute_strike(temp_df, region, horizon_window, index_type, predict_year):
    """
    Expanding strike: mean realised index over 1970 to predict_year-1.
    Strictly ex-ante -- no information from the evaluated year enters.
    """
    hist = compute_historical_window_index(
        temp_df, region, horizon_window, index_type,
        STRIKE_HISTORY_START, predict_year - 1)
    if hist.empty:
        raise ValueError(
            f"No strike history for R{region} {index_type} {horizon_window}")
    return float(hist.mean())


# =============================================================================
# PRICING AND PAYOFF
# =============================================================================

def price_option(index_dist, strike, tick, contract_type, ttm, risk_free):
    if contract_type == "call":
        payoffs = tick * np.maximum(index_dist - strike, 0.0)
    else:
        payoffs = tick * np.maximum(strike - index_dist, 0.0)
    price = np.exp(-risk_free * ttm) * float(np.mean(payoffs))
    return price, payoffs


def realised_payoff(temp_df, region, horizon_window, index_type,
                    predict_year, strike, tick, contract_type, ttm, risk_free):
    start_doy, end_doy = horizon_window
    expected = end_doy - start_doy + 1
    df_r = temp_df[
        (temp_df["region"] == region) &
        (temp_df["year"] == predict_year) &
        (temp_df["doy"].between(start_doy, end_doy))
    ].sort_values("date")
    if len(df_r) != expected:
        return float("nan"), float("nan")
    r_idx = float(daily_index(df_r["temp"].values, index_type).sum())
    if contract_type == "call":
        raw = tick * max(r_idx - strike, 0.0)
    else:
        raw = tick * max(strike - r_idx, 0.0)
    return r_idx, float(np.exp(-risk_free * ttm) * raw)


# =============================================================================
# MAIN
# =============================================================================

def main():
    print("=" * 72)
    print("  DERIVATIVE PRICING -- All Models")
    print(f"  Models   : {MODELS}")
    print(f"  Regions  : {REGIONS}  |  Years: {OOS_YEARS}")
    print(f"  Indices  : {INDEX_TYPES}  |  Contracts: {CONTRACT_TYPES}")
    print(f"  Horizons : {list(HORIZONS.keys())}")
    print(f"  T_ref    : {T_REF} degC  |  Tick: {TICK} EUR  |  r: {RISK_FREE}")
    print(f"  Strike   : expanding window (1970 to oos_year-1)")
    print("=" * 72)

    temp_df = load_temp(TEMP_CSV)
    print(f"[TEMP] {len(temp_df):,} rows, "
          f"years {temp_df['year'].min()}-{temp_df['year'].max()}\n")

    records = []
    total   = (len(MODELS) * len(REGIONS) * len(OOS_YEARS)
               * len(INDEX_TYPES) * len(CONTRACT_TYPES) * len(HORIZONS))
    done    = 0

    for model in MODELS:
        print(f"\n{'='*72}\n  Model: {model}\n{'='*72}")

        for region in REGIONS:
            print(f"\n  -- Region {region}")

            region_paths = {}
            for year in OOS_YEARS:
                loaded = load_paths(PATHS_DIR, region, year, model)
                if loaded is not None:
                    region_paths[year] = loaded

            for year in OOS_YEARS:
                if year not in region_paths:
                    done += len(INDEX_TYPES) * len(CONTRACT_TYPES) * len(HORIZONS)
                    continue
                paths, path_dates = region_paths[year]

                for index_type in INDEX_TYPES:
                    for contract_type in CONTRACT_TYPES:
                        for h_name, h_window in HORIZONS.items():
                            done += 1
                            ttm = _window_ttm(h_window)

                            try:
                                strike = compute_strike(
                                    temp_df, region, h_window,
                                    index_type, year)
                            except Exception as e:
                                print(f"    [{done:>4}/{total}] {year} "
                                      f"{index_type} {contract_type} "
                                      f"{h_name}: strike error -- {e}")
                                continue

                            try:
                                idx_dist = path_index(
                                    paths, path_dates, index_type, h_window)
                            except Exception as e:
                                print(f"    [{done:>4}/{total}] {year} "
                                      f"{index_type} {contract_type} "
                                      f"{h_name}: index error -- {e}")
                                continue

                            model_price, _ = price_option(
                                idx_dist, strike, TICK,
                                contract_type, ttm, RISK_FREE)

                            r_idx, r_payoff = realised_payoff(
                                temp_df, region, h_window, index_type, year,
                                strike, TICK, contract_type, ttm, RISK_FREE)

                            pricing_error = (
                                model_price - r_payoff
                                if not np.isnan(r_payoff) else float("nan"))

                            records.append({
                                "model":           model,
                                "region":          region,
                                "year":            year,
                                "index":           index_type,
                                "contract":        contract_type,
                                "horizon":         h_name,
                                "strike":          round(strike, 2),
                                "sim_idx_mean":    round(float(np.mean(idx_dist)), 2),
                                "sim_idx_std":     round(float(np.std(idx_dist, ddof=1)), 2),
                                "model_price":     round(model_price, 4),
                                "realised_idx":    round(r_idx, 2)
                                                   if not np.isnan(r_idx) else None,
                                "realised_payoff": round(r_payoff, 4)
                                                   if not np.isnan(r_payoff) else None,
                                "pricing_error":   round(pricing_error, 4)
                                                   if not np.isnan(pricing_error) else None,
                            })

                            print(f"    [{done:>4}/{total}] {year} "
                                  f"{index_type} {contract_type} {h_name}: "
                                  f"K={strike:.1f}  price={model_price:.2f}  "
                                  f"realised={r_payoff:.2f}  "
                                  f"error={pricing_error:+.2f}")

    df = pd.DataFrame(records)

    # Summary
    print("\n" + "=" * 80)
    print("  SUMMARY -- Bias, MAE, RMSE by (Model, Index, Contract, Horizon)")
    print("=" * 80)
    print(f"  {'Model':<16} {'Index':<6} {'Contract':<8} {'Horizon':<8} "
          f"{'N':>4} {'Bias':>10} {'MAE':>10} {'RMSE':>10}")
    print("  " + "-" * 74)

    for (mod, idx, ct, hor), grp in df.groupby(
            ["model", "index", "contract", "horizon"]):
        errors = grp["pricing_error"].dropna()
        if errors.empty:
            continue
        bias = float(errors.mean())
        mae  = float(errors.abs().mean())
        rmse = float(np.sqrt((errors ** 2).mean()))
        print(f"  {mod:<16} {idx:<6} {ct:<8} {hor:<8} {len(errors):>4} "
              f"{bias:>10.3f} {mae:>10.3f} {rmse:>10.3f}")

    print("=" * 80)
    print("  Positive bias = systematic overpricing")
    print("  Negative bias = systematic underpricing")

    OUTPUT_CSV.parent.mkdir(parents=True, exist_ok=True)
    df.to_csv(OUTPUT_CSV, index=False)
    print(f"\n[SAVE] {OUTPUT_CSV}")

    return df


if __name__ == "__main__":
    df = main()
