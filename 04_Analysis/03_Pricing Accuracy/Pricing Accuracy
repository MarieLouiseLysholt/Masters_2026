def build_pricing_dm_vs_baseline(df: pd.DataFrame, models: list,
                                 baseline: str = SENSITIVITY_BASELINE
                                 ) -> pd.DataFrame:
    """
    Benchmark-focused DM tests for pricing errors.

    DM is computed on squared pricing error, matched by (region, year).
    Negative DM means the row model has lower loss than the baseline.
    Positive DM means the row model has higher loss than the baseline.
    BH adjustment is applied within each (index, contract, horizon) panel.
    """
    if baseline not in models:
        raise ValueError(f"DM baseline {baseline!r} is not present.")

    rows = []
    for h_name in HORIZONS:
        for idx in INDEX_TYPES:
            for ct in CONTRACT_TYPES:
                pivot = _dm_pair_pivot(df, idx, ct, h_name)
                panel_rows = []
                p_values = []
                if baseline not in pivot.columns:
                    continue
                for model in models:
                    if model == baseline or model not in pivot.columns:
                        continue
                    matched = pivot[[model, baseline]].dropna()
                    if len(matched) < 10:
                        dm, p = np.nan, np.nan
                    else:
                        dm, p = _dm_stat(matched[model].values,
                                         matched[baseline].values, h=1)
                    panel_rows.append({
                        "baseline": baseline,
                        "index": idx,
                        "contract": ct,
                        "horizon": h_name,
                        "model": model,
                        "n_matched": int(len(matched)),
                        "dm_stat": dm,
                        "p_raw": p,
                    })
                    p_values.append(p)

                adj = _bh_correct(np.array(p_values, dtype=float))
                for row, p_adj in zip(panel_rows, adj):
                    dm = row["dm_stat"]
                    row["p_adj"] = p_adj
                    row["significant_5pct"] = (
                        bool(np.isfinite(p_adj) and p_adj < 0.05)
                    )
                    if not np.isfinite(dm):
                        row["direction"] = "n/a"
                    elif dm < 0:
                        row["direction"] = "lower pricing loss"
                    else:
                        row["direction"] = "higher pricing loss"
                    row["significant_improvement"] = (
                        bool(row["significant_5pct"] and np.isfinite(dm)
                             and dm < 0)
                    )
                    row["significant_deterioration"] = (
                        bool(row["significant_5pct"] and np.isfinite(dm)
                             and dm > 0)
                    )
                    rows.append(row)

    return pd.DataFrame(rows)


