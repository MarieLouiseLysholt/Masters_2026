def _build_forecast_horizon_rmse(forecast_csv: Path, models: list) -> pd.DataFrame:
    """
    Forecast RMSE on the same index/horizon objects used for pricing.
    This makes the sensitivity comparison like with like: H1/H2 index
    errors against H1/H2 option-pricing errors.
    """
    fc = pd.read_csv(forecast_csv, parse_dates=["date"])
    fc = fc[fc["model"].isin(models)].copy()
    fc = fc[fc["year"].isin(OOS_YEARS)].copy()
    fc = fc.dropna(subset=["actual", "forecast"])
    fc["doy"] = fc["date"].map(lambda d: _doy_noleap(pd.Timestamp(d)))

    rows = []
    for h_name, h_window in HORIZONS.items():
        start_doy, end_doy = h_window
        h = fc[fc["doy"].between(start_doy, end_doy)].copy()
        if h.empty:
            continue
        for (model, region, year), grp in h.groupby(["model", "region", "year"]):
            actual = grp["actual"].values.astype(float)
            forecast = grp["forecast"].values.astype(float)
            for idx in INDEX_TYPES:
                actual_idx = float(daily_index(actual, idx).sum())
                forecast_idx = float(daily_index(forecast, idx).sum())
                rows.append({
                    "model": model,
                    "region": int(region),
                    "year": int(year),
                    "index": idx,
                    "horizon": h_name,
                    "forecast_error": forecast_idx - actual_idx,
                })

    idx_err = pd.DataFrame(rows)
    if idx_err.empty:
        return pd.DataFrame(columns=["model", "index", "horizon",
                                     "forecast_rmse"])

    return (
        idx_err.groupby(["model", "index", "horizon"])["forecast_error"]
        .apply(lambda s: float(np.sqrt(np.mean(np.square(s.astype(float))))))
        .reset_index(name="forecast_rmse")
    )


def build_pricing_sensitivity_table(df: pd.DataFrame, models: list,
                                    baseline: str = SENSITIVITY_BASELINE
                                    ) -> pd.DataFrame:
    """
    Compare percentage RMSE improvement in index forecasting with percentage
    RMSE improvement in derivative pricing, both relative to the same baseline.

    improvement_delta = forecast_improvement - pricing_improvement

    A positive delta means forecast RMSE improves more than price RMSE.
    A negative delta means price RMSE improves more than forecast RMSE.
    """
    if baseline not in models:
        raise ValueError(f"Sensitivity baseline {baseline!r} is not present.")

    f_rmse = _build_forecast_horizon_rmse(FORECAST_CSV, models)
    p_rmse = (
        df.dropna(subset=["pricing_error"])
        .groupby(["model", "index", "contract", "horizon"])["pricing_error"]
        .apply(lambda s: float(np.sqrt(np.mean(np.square(s.astype(float))))))
        .reset_index(name="pricing_rmse")
    )

    rows = []
    for h_name in HORIZONS:
        for idx in INDEX_TYPES:
            base_f = f_rmse[
                (f_rmse["model"] == baseline) &
                (f_rmse["index"] == idx) &
                (f_rmse["horizon"] == h_name)
            ]
            if base_f.empty:
                continue
            base_f_val = float(base_f["forecast_rmse"].iloc[0])
            for ct in CONTRACT_TYPES:
                base_p = p_rmse[
                    (p_rmse["model"] == baseline) &
                    (p_rmse["index"] == idx) &
                    (p_rmse["contract"] == ct) &
                    (p_rmse["horizon"] == h_name)
                ]
                if base_p.empty:
                    continue
                base_p_val = float(base_p["pricing_rmse"].iloc[0])
                for model in models:
                    if model == baseline:
                        continue
                    f_row = f_rmse[
                        (f_rmse["model"] == model) &
                        (f_rmse["index"] == idx) &
                        (f_rmse["horizon"] == h_name)
                    ]
                    p_row = p_rmse[
                        (p_rmse["model"] == model) &
                        (p_rmse["index"] == idx) &
                        (p_rmse["contract"] == ct) &
                        (p_rmse["horizon"] == h_name)
                    ]
                    if f_row.empty or p_row.empty:
                        continue
                    f_val = float(f_row["forecast_rmse"].iloc[0])
                    p_val = float(p_row["pricing_rmse"].iloc[0])
                    f_imp = ((base_f_val - f_val) / base_f_val
                             if base_f_val > 0 else np.nan)
                    p_imp = ((base_p_val - p_val) / base_p_val
                             if base_p_val > 0 else np.nan)
                    delta = (f_imp - p_imp
                             if np.isfinite(f_imp) and np.isfinite(p_imp)
                             else np.nan)
                    rows.append({
                        "baseline": baseline,
                        "index": idx,
                        "contract": ct,
                        "horizon": h_name,
                        "model": model,
                        "forecast_rmse_baseline": base_f_val,
                        "forecast_rmse_model": f_val,
                        "pricing_rmse_baseline": base_p_val,
                        "pricing_rmse_model": p_val,
                        "forecast_improvement": f_imp,
                        "pricing_improvement": p_imp,
                        "improvement_delta": delta,
                    })

    return pd.DataFrame(rows)


def _draw_econ_table(ax, cell_text, col_labels, row_labels,
                     fontsize=8,
                     col_width_scale=1.0, row_height_scale=1.35,
                     header_top_edge=False):
    """Plain B&W table matching the pricing-bias table layout."""
    ax.axis("off")
    n_rows = len(cell_text)
    tbl = ax.table(
        cellText=cell_text,
        colLabels=col_labels,
        rowLabels=row_labels,
        loc="center",
        cellLoc="center",
    )
    tbl.auto_set_font_size(False)
    tbl.set_fontsize(fontsize)
    tbl.scale(col_width_scale, row_height_scale)

    header_edges = "TB" if header_top_edge else ""
    for (row, col), cell in tbl.get_celld().items():
        cell.set_facecolor("white")
        cell.set_edgecolor("black")
        cell.set_linewidth(0.8)
        cell.visible_edges = ""
        if row == 0:
            cell.visible_edges = header_edges
            cell.set_text_props(fontweight="normal",
                                ha="left" if col == -1 else "center",
                                fontfamily="Times New Roman")
        else:
            if row == n_rows:
                cell.visible_edges = "B"
            ha = "left" if col == -1 else "right"
            cell.set_text_props(ha=ha, fontweight="normal",
                                fontfamily="Times New Roman")
    return tbl


def _add_section_banners(ax, tbl, fig, sections, fontsize=9,
                         cmidrule_offset=0.012, banner_offset=0.022,
                         rule_inset=0.006):
    """Draw grouped column labels and partial rules above a matplotlib table."""
    fig.canvas.draw()
    cells = tbl.get_celld()
    if (0, 0) not in cells:
        return
    y_top = cells[(0, 0)].get_y() + cells[(0, 0)].get_height()
    cmidrule_y = y_top + cmidrule_offset
    banner_y = y_top + banner_offset
    header_bottom = cells[(0, 0)].get_y()

    for label, cols in sections:
        if not cols:
            continue
        x_starts = [cells[(0, c)].get_x() for c in cols]
        widths = [cells[(0, c)].get_width() for c in cols]
        x0_full = min(x_starts)
        x1_full = max(x_starts[i] + widths[i] for i in range(len(cols)))
        xc = (x0_full + x1_full) / 2
        x0 = x0_full + rule_inset
        x1 = x1_full - rule_inset

        ax.text(xc, banner_y, label, ha="center", va="bottom",
                fontsize=fontsize, fontfamily="Times New Roman",
                transform=ax.transAxes)
        ax.plot([x0, x1], [cmidrule_y, cmidrule_y],
                color="black", linewidth=0.7,
                transform=ax.transAxes, clip_on=False)
        ax.plot([x0, x1], [header_bottom, header_bottom],
                color="black", linewidth=0.7,
                transform=ax.transAxes, clip_on=False)


