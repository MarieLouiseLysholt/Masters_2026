def render_revenue_predictions(cells):
    """
    Per-region subplots; black bold = actual revenue, coloured = each model's
    predicted revenue across the holdout years.
    """
    regions = sorted(cells["region"].unique())
    n_reg   = len(regions)
    ncols   = 4
    nrows   = int(np.ceil(n_reg / ncols))

    cmap_models = plt.get_cmap("tab10")
    model_list  = [m for m in MODELS if m in cells["model"].unique()]
    colours     = {m: cmap_models(i % 10) for i, m in enumerate(model_list)}

    fig, axes = plt.subplots(nrows, ncols,
                             figsize=(4.0 * ncols, 2.8 * nrows),
                             sharex=True)
    axes = np.array(axes).reshape(-1)

    for ax, region in zip(axes, regions):
        sub = cells[cells["region"] == region]
        act = (sub.drop_duplicates(subset=["year"])
                  .sort_values("year"))
        ax.plot(act["year"].values, act["R_act"].values,
                color="black", lw=2.0, marker="o", ms=4.5,
                zorder=10, label="Actual")
        for m in model_list:
            sm = sub[sub["model"] == m].sort_values("year")
            if sm.empty:
                continue
            ax.plot(sm["year"].values, sm["R_hat"].values,
                    color=colours[m], lw=1.0, alpha=0.85,
                    marker="x", ms=3.5,
                    label=LABELS.get(m, m))
        ax.set_title(REGION_NAMES.get(int(region), str(region)),
                     fontsize=9, fontfamily="Times New Roman")
        ax.tick_params(axis="both", which="both", direction="out",
                       length=3, width=0.7, labelsize=8)
        ax.grid(axis="y", alpha=0.20, lw=0.5)
        for sp in ("top", "right"):
            ax.spines[sp].set_visible(False)
        for sp in ("bottom", "left"):
            ax.spines[sp].set_linewidth(0.7)

    for ax in axes[n_reg:]:
        ax.axis("off")

    fig.supxlabel("Holdout year", fontsize=10, fontfamily="Times New Roman")
    fig.supylabel("Revenue (EUR/ha)", fontsize=10,
                  fontfamily="Times New Roman")

    handles, labels = axes[0].get_legend_handles_labels()
    fig.legend(handles, labels, loc="lower center",
               ncol=min(len(labels), 5), frameon=True, fontsize=8.5,
               bbox_to_anchor=(0.5, -0.02), edgecolor="black")

    plt.tight_layout(rect=[0.02, 0.05, 1.0, 1.0])
    _save(fig, "P04_revenue_predictions_over_years")


