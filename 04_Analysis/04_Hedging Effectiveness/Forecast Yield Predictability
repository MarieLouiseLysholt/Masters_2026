def _fmt(v, dec=3):
    try:
        if pd.isna(v) or not np.isfinite(float(v)):
            return "—"
        return f"{float(v):.{dec}f}"
    except (TypeError, ValueError):
        return "—"


def _draw_table(ax, cell_text, col_labels, row_labels,
                fontsize=9, col_width=1.0, row_height=1.5,
                data_align="right"):
    ax.axis("off")
    n_rows = len(cell_text)
    tbl = ax.table(cellText=cell_text, colLabels=col_labels,
                   rowLabels=row_labels, loc="center", cellLoc="center")
    tbl.auto_set_font_size(False)
    tbl.set_fontsize(fontsize)
    tbl.scale(col_width, row_height)
    for (row, col), cell in tbl.get_celld().items():
        cell.set_facecolor("white")
        cell.set_edgecolor("black")
        cell.set_linewidth(0.8)
        cell.visible_edges = ""
        if row == 0:
            cell.visible_edges = "TB"
            cell.set_text_props(fontweight="normal",
                                ha="left" if col == -1 else "center",
                                fontfamily="Times New Roman")
        else:
            if row == n_rows:
                cell.visible_edges = "B"
            ha = "left" if col == -1 else data_align
            cell.set_text_props(ha=ha, fontfamily="Times New Roman")
    return tbl


def _save(fig, stem):
    p = OUT_DIR / f"{stem}.png"
    fig.savefig(p, dpi=DPI, bbox_inches="tight", facecolor="white")
    plt.close(fig)
    print(f"  -> {p.name}")


def render_selection(sel_df):
    cell = []
    for _, r in sel_df.iterrows():
        cell.append([
            r["itype"],
            r["window"],
            FORM_LABELS.get(r["form"], r["form"]),
            _fmt(r["bic_form"], 2),
            _fmt(r["adj_r2_form"], 3),
        ])
    col_labels = ["Index", "Window", "Best form", "BIC", "Adj R²"]
    row_labels = [REGION_NAMES.get(int(r["region"]), str(r["region"]))
                  for _, r in sel_df.iterrows()]
    fig, ax = plt.subplots(figsize=(10, 0.5 + 0.32 * len(cell)))
    _draw_table(ax, cell, col_labels, row_labels, fontsize=9)
    _save(fig, "P01_yield_model_per_region_BIC")


def render_per_model(model_df):
    cell = []
    for _, r in model_df.iterrows():
        cell.append([
            _fmt(r["RMSE"],          1),
            _fmt(r["MAE"],           1),
            _fmt(r["ME"],            1),
            _fmt(r["MAPE_pct"],      1),
            _fmt(r["RMSE_pct_rbar"], 1),
        ])
    col_labels = ["RMSE (EUR/ha)", "MAE (EUR/ha)", "ME (EUR/ha)",
                  "MAPE (%)", "RMSE (% R̄)"]
    row_labels = [LABELS.get(r["model"], r["model"]) for _, r in model_df.iterrows()]
    fig, ax = plt.subplots(figsize=(10, 0.5 + 0.32 * len(cell)))
    _draw_table(ax, cell, col_labels, row_labels, fontsize=9)
    _save(fig, "P02_forecast_accuracy_per_model")


def render_rmse_matrix(mr):
    models  = [m for m in MODELS if m in mr["model"].unique()]
    regions = sorted(mr["region"].unique())
    cell = []
    for m in models:
        row = []
        for r in regions:
            v = mr[(mr["model"] == m) & (mr["region"] == r)]["RMSE"].values
            row.append(_fmt(v[0], 1) if len(v) else "—")
        cell.append(row)
    row_labels = [LABELS.get(m, m) for m in models]
    # Wrap long region names onto two lines so column headers don't overlap.
    region_label_wrap = {
