def render_rmse_matrix_year(cells):
    """
    Model × year RMSE matrix. Each cell is the RMSE of revenue across the
    8 regions for that (model, year) — i.e., sqrt(mean((R_hat - R_act)^2))
    over regions in that holdout year for that model.
    """
    models = [m for m in MODELS if m in cells["model"].unique()]
    years  = sorted(cells["year"].unique())
    cell = []
    for m in models:
        row = []
        for y in years:
            sub = cells[(cells["model"] == m) & (cells["year"] == y)]
            if sub.empty:
                row.append("—")
            else:
                err = sub["R_hat"].values - sub["R_act"].values
                rmse = float(np.sqrt(np.mean(err ** 2)))
                row.append(_fmt(rmse, 1))
        cell.append(row)
    row_labels = [LABELS.get(m, m) for m in models]
    col_labels = [str(int(y)) for y in years]
    fig, ax = plt.subplots(figsize=(1.6 + 0.85 * len(years),
                                    0.55 + 0.32 * len(row_labels)))
    _draw_table(ax, cell, col_labels, row_labels, fontsize=8.5,
                data_align="center")
    _save(fig, "P06_forecast_rmse_matrix_year")


