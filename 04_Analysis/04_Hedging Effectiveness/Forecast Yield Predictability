def _slug(name):
    keep = []
    for ch in name:
        if ch.isalnum():
            keep.append(ch)
        elif ch in (" ", "-", "_"):
            keep.append("_")
    return "".join(keep).strip("_")


def render_revenue_tables_per_region(cells):
    regions    = sorted(cells["region"].unique())
    model_list = [m for m in MODELS if m in cells["model"].unique()]

    for region in regions:
        sub = cells[cells["region"] == region]
        years = sorted(sub["year"].unique())

        act = (sub.drop_duplicates(subset=["year"])
                  .set_index("year")["R_act"])

        cell_text  = []
        for y in years:
            row = [_fmt(float(act.loc[y]), 0)]
            for m in model_list:
                v = sub[(sub["model"] == m) & (sub["year"] == y)]["R_hat"].values
                row.append(_fmt(float(v[0]), 0) if len(v) else "—")
            cell_text.append(row)

        col_labels = ["Actual"] + [LABELS.get(m, m) for m in model_list]
        row_labels = [str(int(y)) for y in years]

        fig_w = max(11, 1.5 + 0.95 * len(col_labels))
        fig, ax = plt.subplots(figsize=(fig_w, 0.55 + 0.32 * len(years)))
        _draw_table(ax, cell_text, col_labels, row_labels, fontsize=9)
        rname = REGION_NAMES.get(int(region), str(region))
        fz    = frozen[region]
        title = (f"{rname}  —  Index: {fz['itype']} {fz['label']}   "
                 f"Form: {FORM_LABELS.get(fz['form'], fz['form'])}   "
                 f"In-sample R²: {fz['r2']:.3f}")
        _ = title  # title text retained for caption use; not drawn on figure
        slug  = _slug(rname)
        _save(fig, f"P05_revenue_table_R{int(region)}_{slug}")


