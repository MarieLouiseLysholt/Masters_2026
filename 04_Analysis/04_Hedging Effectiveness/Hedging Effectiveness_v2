def _fmt(v, dec=3):
    try:
        if pd.isna(v) or not np.isfinite(float(v)):
            return "—"
        return f"{float(v):.{dec}f}"
    except (TypeError, ValueError):
        return "—"


def _stars_render(p):
    if pd.isna(p) or not np.isfinite(p):
        return ""
    if p < 0.01: return "***"
    if p < 0.05: return "**"
    if p < 0.10: return "*"
    return ""


def _wilcoxon_p(values):
    arr = np.asarray(values, dtype=float)
    arr = arr[~np.isnan(arr)]
    arr = arr[arr != 0]
    if len(arr) < 5:
        return np.nan
    try:
        _, p = wilcoxon(arr, alternative="two-sided")
        return float(p)
    except Exception:
        return np.nan


def _he_pair(rev_u, rev_h):
    rev_u = np.asarray(rev_u, dtype=float)
    rev_h = np.asarray(rev_h, dtype=float)
    var_u = float(np.var(rev_u))
    he_var = (1 - np.var(rev_h) / var_u) if var_u > 1e-8 else np.nan
    target = float(np.mean(rev_u))
    sv_u = float(np.mean(np.minimum(rev_u - target, 0.0) ** 2))
    sv_h = float(np.mean(np.minimum(rev_h - target, 0.0) ** 2))
    he_sv = (1 - sv_h / sv_u) if sv_u > 1e-8 else np.nan
    return he_var, he_sv


def _avg_he_per_region(sub):
    he_vars, he_svs = [], []
    for r in sub["region"].unique():
        reg = sub[sub["region"] == r]
        if len(reg) >= 2:
            hv, hs = _he_pair(reg["act_rev_u"].values, reg["act_rev_h"].values)
            if not np.isnan(hv): he_vars.append(hv)
            if not np.isnan(hs): he_svs.append(hs)
    return (float(np.mean(he_vars)) if he_vars else np.nan,
            float(np.mean(he_svs))  if he_svs  else np.nan)


def _draw_econ_table(ax, cell_text, col_labels, row_labels,
                     fontsize=9, col_width_scale=1.0, row_height_scale=1.5):
    ax.axis("off")
    n_rows = len(cell_text)
    tbl = ax.table(cellText=cell_text, colLabels=col_labels,
                   rowLabels=row_labels, loc="center", cellLoc="center")
    tbl.auto_set_font_size(False)
    tbl.set_fontsize(fontsize)
    tbl.scale(col_width_scale, row_height_scale)
    for (row, col), cell in tbl.get_celld().items():
        cell.set_facecolor("white")
        cell.set_edgecolor("black")
        cell.set_linewidth(0.8)
        cell.visible_edges = ""
        if row == 0:
            cell.visible_edges = "TB"
            cell.set_text_props(fontweight="normal",
                                ha="left" if col == -1 else "center",
                                fontfamily="Times New Roman")
        else:
            if row == n_rows:
                cell.visible_edges = "B"
            ha = "left" if col == -1 else "right"
            cell.set_text_props(ha=ha, fontweight="normal",
                                fontfamily="Times New Roman")
    return tbl


