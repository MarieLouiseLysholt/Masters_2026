    def _he_metrics(rev_u_r, rev_h_r):
        var_u  = float(np.var(rev_u_r))
        he_var = (1 - np.var(rev_h_r) / var_u) if var_u > 1e-8 else np.nan
        target = float(np.mean(rev_u_r))
        sv_u   = float(np.mean(np.minimum(rev_u_r - target, 0.0) ** 2))
        sv_h   = float(np.mean(np.minimum(rev_h_r - target, 0.0) ** 2))
        he_sv  = (1 - sv_h / sv_u) if sv_u > 1e-8 else np.nan
        return he_var, he_sv

    def _significance(delta_rev):
        d      = delta_rev[delta_rev != 0]
        mean_d = float(np.mean(delta_rev))
        if len(d) < 5:
            return mean_d, np.nan, np.nan, np.nan, np.nan
        t_stat, t_pval = ttest_1samp(delta_rev, 0.0)
        try:
            w_stat, w_pval = wilcoxon(d, alternative="two-sided")
        except Exception:
            w_stat, w_pval = np.nan, np.nan
        return mean_d, float(t_stat), float(t_pval), float(w_stat), float(w_pval)

    def _stars(p):
        if np.isnan(p): return ""
        if p < 0.01:    return "***"
        if p < 0.05:    return "**"
        if p < 0.10:    return "*"
        return ""

