# ---------------- T05 / T06 — R² decomposition ------------------------------
#
# Question: even with a strong forecaster (LSTM has the best CRPS), can
# hedging effectiveness be high if the underlying instrument-yield link is
# weak? Decompose predictive R² into:
#
#   (a) Forecast skill        : R²(act_idx, forecast_idx_mean)
#                                — how well the model predicts the index.
#                                  Model-specific.
#
#   (b) End-to-end predictive : R²(act_yield_detrended,
#                                   quad_model(forecast_idx_mean))
#                                — how well the model's forecast translates
#                                  into a useful yield prediction.
#                                  Model-specific.
#
#   (c) Ceiling (perfect fc.) : R²(act_yield_detrended,
#                                   quad_model(act_idx))
#                                — the best (b) any forecaster could achieve
#                                  given the instrument-yield mapping.
#                                  Model-INDEPENDENT.
#
# If (c) is small, (b) is bounded above by it regardless of (a). That is the
# instrument-yield bottleneck: a strong forecaster cannot rescue a weak
# instrument.
# ---------------------------------------------------------------------------


def _r2(y_true, y_pred):
    y_true = np.asarray(y_true, dtype=float)
    y_pred = np.asarray(y_pred, dtype=float)
    mask   = np.isfinite(y_true) & np.isfinite(y_pred)
    y_true = y_true[mask]
    y_pred = y_pred[mask]
    if len(y_true) < 3:
        return np.nan
    ss_res = float(np.sum((y_true - y_pred) ** 2))
    ss_tot = float(np.sum((y_true - y_true.mean()) ** 2))
    if ss_tot < 1e-12:
        return np.nan
    return 1.0 - ss_res / ss_tot


def render_r2_decomposition(df):
    models = [m for m in MODELS if m in df["model"].unique()]
    cell_text = []
    for m in models:
        sub = df[df["model"] == m]
        r2_idx     = _r2(sub["act_idx"].values,
                         sub["forecast_idx_mean"].values)
        r2_yield   = _r2(sub["act_yield_detrended"].values,
                         sub["pred_yield_forecast"].values)
        r2_ceiling = _r2(sub["act_yield_detrended"].values,
                         sub["pred_yield_perfect"].values)
        cell_text.append([
            _fmt(r2_idx,     3),
            _fmt(r2_yield,   3),
            _fmt(r2_ceiling, 3),
        ])
    col_labels = [
        "Forecast R² (index)",
        "End-to-end R² (yield)",
        "Ceiling R² (perfect forecast)",
    ]
    row_labels = [LABELS.get(m, m) for m in models]
    fig, ax = plt.subplots(figsize=(11, 0.5 + 0.32 * len(models)))
    _draw_econ_table(ax, cell_text, col_labels, row_labels, fontsize=9)
