def _strip_one(ax, pos, values, jitter=0.12, dot_size=14):
    arr = np.asarray(values, dtype=float)
    arr = arr[~np.isnan(arr)]
    n = len(arr)
    if n == 0:
        return
    rng = np.random.default_rng(42 + pos)
    x = rng.uniform(pos - jitter, pos + jitter, size=n)
    ax.scatter(x, arr, s=dot_size, color="#444444",
               alpha=0.55 if n >= 10 else 0.85,
               linewidths=0, zorder=3)
    mean_v = float(np.mean(arr))
    if n >= 5:
        sd = float(np.std(arr, ddof=1))
        cap_w = jitter * 0.55
        ax.plot([pos, pos], [mean_v - sd, mean_v + sd],
                color="black", lw=1.4, zorder=5, solid_capstyle="butt")
        ax.plot([pos - cap_w, pos + cap_w], [mean_v - sd, mean_v - sd],
                color="black", lw=1.0, zorder=5)
        ax.plot([pos - cap_w, pos + cap_w], [mean_v + sd, mean_v + sd],
                color="black", lw=1.0, zorder=5)
    ax.scatter(pos, mean_v, s=60, color="white", marker="D",
               zorder=6, linewidths=1.0, edgecolors="black")


def _strip_axis(ax, group_labels, data_list, ylabel, xlabel,
                jitter=0.12, zero_line=True):
    for i, vals in enumerate(data_list, 1):
        _strip_one(ax, i, vals, jitter=jitter)
    if zero_line:
        ax.axhline(0, color="black", lw=0.7, ls="--", alpha=0.5)
    ax.set_xticks(range(1, len(group_labels) + 1))
    long_lbl = max(len(g) for g in group_labels) > 6
    ax.set_xticklabels(group_labels,
                       rotation=30 if long_lbl else 0,
                       ha="right" if long_lbl else "center",
                       fontfamily="Times New Roman")
    ax.set_xlim(0.5, len(group_labels) + 0.5)
    ax.set_ylabel(ylabel, fontfamily="Times New Roman")
    ax.set_xlabel(xlabel, fontfamily="Times New Roman")
    for sp in ("top", "right"):
        ax.spines[sp].set_visible(False)
    for sp in ("bottom", "left"):
        ax.spines[sp].set_linewidth(0.8)
    ax.tick_params(axis="both", which="both", direction="out", length=3,
                   width=0.8)
    ax.legend(handles=[
        Line2D([0], [0], marker="o", color="w", markerfacecolor="#444444",
               markersize=5, alpha=0.7, label="Observation"),
        Line2D([0], [0], marker="D", color="black", markerfacecolor="white",
               markeredgecolor="black", markeredgewidth=1.0,
               markersize=6, label="Mean ± 1 SD"),
    ], loc="best", frameon=True, fontsize=8, edgecolor="black")


