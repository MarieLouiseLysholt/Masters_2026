def render_r2_ceiling_by_region(df):
    """
    Per-region instrument-yield ceiling, model-independent.
    Uses one row per region: pools the realised index and detrended yield
    across all (model, OOS year) observations within that region. Since the
    realised index and actual yield do not vary across models, this is just
    n_models duplicates -- but that does not affect R², so we collapse to
    one observation per (region, year) by taking the first model.
    """
    regions = sorted(df["region"].unique())
    cell_text = []
    for r in regions:
        sub = df[df["region"] == r]
        # Collapse to one row per OOS year (drop model duplication).
        sub = sub.drop_duplicates(subset=["oos_year"])
        r2_ceiling = _r2(sub["act_yield_detrended"].values,
                         sub["pred_yield_perfect"].values)
        # Linear instrument-yield correlation as a complementary view.
        if len(sub) >= 3:
            rho, _ = pearsonr(sub["act_idx"].values,
                              sub["act_yield_detrended"].values)
        else:
            rho = np.nan
        cell_text.append([
            str(len(sub)),
            _fmt(rho,        3),
            _fmt(rho ** 2 if np.isfinite(rho) else np.nan, 3),
            _fmt(r2_ceiling, 3),
        ])
    col_labels = ["n", "ρ (idx, yield)", "ρ²", "Ceiling R² (quad model)"]
    row_labels = [REGION_NAMES.get(int(r), str(r)) for r in regions]
    fig, ax = plt.subplots(figsize=(9.5, 0.5 + 0.32 * len(regions)))
    _draw_econ_table(ax, cell_text, col_labels, row_labels, fontsize=9)
    _save_fig(fig, "T06_he_r2_ceiling_by_region")


