# MAIN
# =============================================================================

def main():
    print("=" * 60)
    print("  CRPS Analysis — Forecast Probabilistic Accuracy")
    print("=" * 60)
    print(f"  Models : {MODEL_ORDER}")
    print(f"  Regions: {REGIONS}")
    print(f"  Years  : {OOS_YEARS[0]}-{OOS_YEARS[-1]}")
    print(f"  Indices: {INDEX_TYPES}")
    print(f"  Source : {PATHS_DIR}")
    print()

    print("Computing CRPS per (model, region, year, month, index) ...")
    df = compute_all_crps()
    print(f"\n  Computed {len(df):,} CRPS values "
          f"({len(df) // len(INDEX_TYPES):,} cells x {len(INDEX_TYPES)} indices).")

    raw_path = OUTPUT_DIR / "csv_crps_raw.csv"
    df.to_csv(raw_path, index=False)
    print(f"  -> {raw_path.name}")

    print("\nWriting per-model summary CSV ...")
    write_summary_csv(df)

    print("\nRendering per-index CRPS tables ...")
    for idx in INDEX_TYPES:
        render_crps_per_index(df, idx)

    print("\nDone.")


if __name__ == "__main__":
    main()
