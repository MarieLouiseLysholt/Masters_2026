# ===========================================================================
# [F1] COMPAT UNPICKLER — fixes pandas StringDtype across pandas versions
# ===========================================================================

class _CompatUnpickler(pickle.Unpickler):
    """
    Handles pandas StringDtype pickle incompatibility that surfaces as:
        NotImplementedError: (<StringDtype(storage='python', na_value=nan)>, ...)
    This occurs when a PKL was saved with pandas 1.x or early 2.x and is
    loaded under a newer pandas release that changed the StringDtype internals.
    The unpickler intercepts the StringDtype constructor call and falls back
    to the default (no-arg) form when the saved kwargs are rejected.
    """
    def find_class(self, module, name):
        if module == "pandas.core.arrays.string_" and name == "StringDtype":
            import pandas as pd
            def _make_string_dtype(*args, **kwargs):
                try:
                    return pd.StringDtype(*args, **kwargs)
                except (TypeError, NotImplementedError):
                    return pd.StringDtype()
            return _make_string_dtype
        return super().find_class(module, name)


def _compat_load(path):
    """Drop-in replacement for pickle.load() with pandas version compatibility."""
    with open(path, "rb") as f:
        return _CompatUnpickler(f).load()


