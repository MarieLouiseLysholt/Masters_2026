def _run_arma_only_update():
    """
    Re-generate ARMA forecasts only and update bk_forecasts.csv in place.
    Preserves rows for all other models. Drops + replaces all ARMA rows.
    """
    OUTPUT_CSV.parent.mkdir(parents=True, exist_ok=True)
    print("=" * 70)
    print("  generate_bk_forecasts.py — ARMA-ONLY UPDATE")
    print(f"  PKL dir: {ARMA_DIR}")
    print(f"  OOS    : {OOS_START}-{OOS_END}  ({len(TEST_YEARS)} yrs x {len(REGIONS)} regions)")
    print(f"  Output : {OUTPUT_CSV}")
    print("=" * 70)

    if OUTPUT_CSV.exists():
        existing = pd.read_csv(OUTPUT_CSV, parse_dates=["date"])
        kept = existing[existing["model"] != "ARMA"].copy()
        print(f"  Loaded existing CSV: {len(existing):,} rows total, "
              f"keeping {len(kept):,} non-ARMA rows.")
    else:
        kept = pd.DataFrame(columns=["region","year","date","actual","model","forecast"])
        print("  No existing CSV — starting fresh (ARMA only).")

    new_rows = []
    for region in REGIONS:
        print(f"\n  -- Region {region}")
        df = load_region(region)
        for test_year in TEST_YEARS:
            calib_year = test_year - 1
            df_train, df_test = get_train_test_for_year(df, test_year)
            if len(df_train) < 365 or len(df_test) == 0:
                print(f"    [{test_year}] insufficient data, skipping")
                continue

            test_dates = df_test["date"].tolist()
            T_actual   = df_test["T"].values.astype(float)
            if len(T_actual) < 365:
                T_actual = np.pad(T_actual, (0, 365 - len(T_actual)),
                                  constant_values=np.nan)
                test_dates += [test_dates[-1] + pd.Timedelta(days=i+1)
                               for i in range(365 - len(test_dates))]
            else:
                T_actual = T_actual[:365]; test_dates = test_dates[:365]

            arma_payload = _safe_load("ARMA", load_arma, region, calib_year)
            if arma_payload is None:
                f_arma = np.full(365, np.nan)
            else:
                try:
                    f_arma = forecast_arma(arma_payload, test_dates)
                except Exception as e:
                    print(f"    [{test_year}] forecast error: "
                          f"{type(e).__name__}: {e}")
                    f_arma = np.full(365, np.nan)

            n_finite = int(np.isfinite(f_arma).sum())
            print(f"    [{test_year}] calib={calib_year}  finite={n_finite}/365")

            for d, T_hat, T_act in zip(test_dates, f_arma, T_actual):
                new_rows.append([region, test_year, d, T_act, "ARMA", T_hat])

    new_df = pd.DataFrame(new_rows,
                          columns=["region","year","date","actual","model","forecast"])
    out = pd.concat([kept, new_df], ignore_index=True)
    out.to_csv(OUTPUT_CSV, index=False)
    print("\n" + "=" * 70)
    print(f"  Done. {len(new_rows):,} new ARMA rows added.")
    print(f"  Final CSV: {len(out):,} rows total -> {OUTPUT_CSV}")
    print("=" * 70)


