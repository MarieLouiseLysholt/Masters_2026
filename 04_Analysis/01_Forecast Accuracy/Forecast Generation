                wavelet_payload = _safe_load("WaveletFNN",    load_wavelet_fnn,    region, calib_year)
                lstm_payload    = _safe_load("LSTM",          load_lstm,           region, calib_year)
                ffnn_payload    = _safe_load("FeedForwardNN", load_feedforward_nn, region, calib_year)
                knn_payload     = _safe_load("KNN",           load_paper_knn,      region, calib_year)
                svm_payload     = _safe_load("SVM",           load_paper_svm,      region, calib_year)
                arma_payload    = _safe_load("ARMA",          load_arma,           region, calib_year)
                calib_ctx          = compute_calib_context(df_train)
                extended_calib_ctx = compute_wavelet_calib_context(region, calib_year, df_train)
                ffnn_calib_ctx     = compute_ffnn_calib_context(region, calib_year)
                print(f"loaded: hba={hba_params is not None}, alaton={alaton_params is not None}, "
                      f"benth={benth_params is not None}, arma={arma_payload is not None}, "
                      f"xgb={xgb_payload is not None}, "
                      f"wavelet={wavelet_payload is not None}, lstm={lstm_payload is not None}, "
                      f"ffnn={ffnn_payload is not None}, knn={knn_payload is not None}, "
                      f"svm={svm_payload is not None}")
                _loaded_calib = calib_year
            else:
                print(f"  [{test_year}]", end="  ", flush=True)

            def _safe_forecast(label, fn):
                try: return fn()
                except Exception as e:
                    print(f"    !! {label} FORECAST ERROR (region={region} year={test_year}): {type(e).__name__}: {e}")
                    return np.full(365, np.nan)

            f_hba    = _safe_forecast("HBA",    lambda: forecast_hba(hba_params, test_dates))                if hba_params    else np.full(365, np.nan)
            f_alaton = _safe_forecast("Alaton", lambda: forecast_alaton(alaton_params, df_train, test_dates)) if alaton_params else np.full(365, np.nan)
            f_benth  = _safe_forecast("Benth",  lambda: forecast_benth(benth_params, df_train, test_dates))  if benth_params  else np.full(365, np.nan)
            f_arma   = _safe_forecast("ARMA",   lambda: forecast_arma(arma_payload, test_dates))             if arma_payload  else np.full(365, np.nan)
            f_xgb    = _safe_forecast("XGB",    lambda: forecast_paper_xgb(xgb_payload, test_dates, extended_calib_ctx)) if (xgb_payload and extended_calib_ctx) else np.full(365, np.nan)
            if wavelet_payload and extended_calib_ctx:
                f_wavelet = _safe_forecast("WaveletFNN", lambda: forecast_wavelet_fnn(wavelet_payload, test_dates, extended_calib_ctx))
            else:
                f_wavelet = np.full(365, np.nan)
            f_lstm = _safe_forecast("LSTM",          lambda: forecast_lstm(lstm_payload, test_dates, calib_ctx))                if lstm_payload else np.full(365, np.nan)
            f_ffnn = _safe_forecast("FeedForwardNN", lambda: forecast_feedforward_nn(ffnn_payload, test_dates, ffnn_calib_ctx)) if ffnn_payload else np.full(365, np.nan)
            f_knn  = _safe_forecast("KNN", lambda: forecast_paper_xgb(knn_payload, test_dates, extended_calib_ctx)) if (knn_payload and extended_calib_ctx) else np.full(365, np.nan)
            f_svm  = _safe_forecast("SVM", lambda: forecast_paper_xgb(svm_payload, test_dates, extended_calib_ctx)) if (svm_payload and extended_calib_ctx) else np.full(365, np.nan)

            forecasts = {"HBA": f_hba, "Alaton": f_alaton, "Benth": f_benth, "ARMA": f_arma,
                         "XGB": f_xgb, "WaveletFNN": f_wavelet, "LSTM": f_lstm,
                         "FeedForwardNN": f_ffnn, "KNN": f_knn, "SVM": f_svm}

            finite_counts = ", ".join(f"{m}={int(np.isfinite(v).sum())}/365" for m, v in forecasts.items())
            print(f"    finite forecasts: {finite_counts}")

            for m, f_arr in forecasts.items():
                for d, T_hat, T_act in zip(test_dates, f_arr, T_actual):
                    all_rows.append([region, test_year, d, T_act, m, T_hat])

            _write_checkpoint(all_rows, OUTPUT_CSV)

    print("\n" + "="*70)
    print(f"  Done. {len(all_rows):,} rows written to:")
    print(f"  {OUTPUT_CSV}")
    print("="*70)

if __name__ == "__main__":
    main()