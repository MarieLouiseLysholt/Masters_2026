class WaveletFeatureTransformer(BaseEstimator, TransformerMixin):
    def __init__(self, n_wavelets=3, wavelet="mexican_hat", include_original=True):
        self.n_wavelets = n_wavelets; self.wavelet = wavelet; self.include_original = include_original
    def fit(self, X, y=None):
        X = self._to_numpy(X); self.n_features_in_ = X.shape[1]; return self
    def transform(self, X):
        X = self._to_numpy(X); n_samples, n_features = X.shape
        t = np.linspace(-1.0, 1.0, n_samples); features = []
        if self.include_original: features.append(X)
        for j in range(n_features):
            x = X[:, j]
            for i in range(self.n_wavelets):
                shift = 0.0 if self.n_wavelets == 1 else -0.75 + i * (1.5 / (self.n_wavelets - 1))
                scale = 0.25 + 0.20 * i; tau = (t - shift) / scale
                if self.wavelet == "mexican_hat":   psi = (1.0 - tau**2) * np.exp(-0.5 * tau**2)
                elif self.wavelet == "morlet":       psi = np.cos(5.0 * tau) * np.exp(-0.5 * tau**2)
                else: raise ValueError(f"Unknown wavelet: {self.wavelet}")
                features.append((x * psi).reshape(-1, 1))
        X_out = np.hstack(features).astype(float)
        if not np.isfinite(X_out).all(): raise ValueError("WaveletFeatureTransformer produced NaN/inf.")
        return X_out
    @staticmethod
    def _to_numpy(X):
        if isinstance(X, pd.DataFrame): X = X.to_numpy()
        return np.asarray(X, dtype=float)

