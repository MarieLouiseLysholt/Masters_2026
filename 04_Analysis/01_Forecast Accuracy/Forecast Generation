def _extract_feature_cols(payload, default_cols=None):
    if isinstance(payload, dict):
        for key in ["feature_cols","features","input_features","covariate_cols","past_covariate_cols"]:
            if key in payload: return list(payload[key])
    return default_cols

def _extract_working_df(payload, calib_ctx):
    if isinstance(payload, dict) and "working_df" in payload: return payload["working_df"]
    return calib_ctx["working_df"]

def _extract_trend_ctx(payload, calib_ctx):
    if isinstance(payload, dict):
        return (payload.get("trend_intercept", calib_ctx["trend_intercept"]),
                payload.get("trend_slope",     calib_ctx["trend_slope"]),
                payload.get("fourier_coefs",   calib_ctx["fourier_coefs"]),
                payload.get("n_harmonics",     calib_ctx["n_harmonics"]),
                payload.get("n_calib_days",    calib_ctx["n_calib_days"]))
    return (calib_ctx["trend_intercept"], calib_ctx["trend_slope"],
            calib_ctx["fourier_coefs"], calib_ctx["n_harmonics"], calib_ctx["n_calib_days"])

def alaton_seasonal_mean(t_idx, A, B, C, phi):
    return A + B * t_idx + C * np.sin(OMEGA * t_idx + phi)

def benth_seasonal_mean(doy, a0, a1, t0):
    return a0 + a1 * np.cos((2 * np.pi / 365.0) * (doy - t0))

def forecast_hba(hba_params, test_dates):
    df_calib = hba_params.get("df_calib", hba_params.get("df"))
    if df_calib is None:
        print(f"    !! HBA: no df_calib/df key. Keys: {list(hba_params.keys())}"); return np.full(len(test_dates), np.nan)
    dfc = df_calib.copy()
    if isinstance(dfc.index, pd.DatetimeIndex): idx_dates = pd.DatetimeIndex(dfc.index)
    elif "date" in dfc.columns: idx_dates = pd.to_datetime(dfc["date"])
    else:
        print(f"    !! HBA: df_calib has no DatetimeIndex or date column. Columns: {list(dfc.columns)}"); return np.full(len(test_dates), np.nan)
    temp_col = next((c for c in ["T","TAVG_imptd","daily_avg_temperature"] if c in dfc.columns), None)
    if temp_col is None:
        print(f"    !! HBA: no temperature column. Columns: {list(dfc.columns)}"); return np.full(len(test_dates), np.nan)
    doy = np.array([_doy_noleap(d) for d in idx_dates])
    vals = pd.Series(dfc[temp_col].values, index=doy).groupby(level=0).mean().to_dict()
    global_mean = float(np.nanmean(dfc[temp_col].values))
    return np.array([vals.get(_doy_noleap(d), global_mean) for d in test_dates], dtype=float)

def forecast_alaton(alaton_params, df_train, test_dates):
    A, B, C, phi = [float(alaton_params[k]) for k in ("A","B","C","phi")]
    a = float(alaton_params["a"]); exp_a = np.exp(-a)
    df_calib = alaton_params["df_calib"].copy()
    T_prev = float(df_train.iloc[-1]["T"])
    if "t" in df_calib.columns: t_last = float(df_calib["t"].iloc[-1])
    elif "t_idx" in df_calib.columns: t_last = float(df_calib["t_idx"].iloc[-1])
    else: raise KeyError("Alaton PKL must contain df_calib[t] or df_calib[t_idx].")
    forecasts = np.empty(len(test_dates), dtype=float)
    for i in range(len(test_dates)):
        T_m_prev = alaton_seasonal_mean(np.array([t_last + i]),     A, B, C, phi)[0]
        T_m_curr = alaton_seasonal_mean(np.array([t_last + i + 1]), A, B, C, phi)[0]
        T_curr = T_m_curr + exp_a * (T_prev - T_m_prev)
        forecasts[i] = T_curr; T_prev = T_curr
    return forecasts

def forecast_arma(arma_params, test_dates):
    """
    ARMA forecast — absolute temperature space.

    The ARMA PKL stores 'forecast_temp_365': a 365-element array of
    absolute temperature forecasts. NO trend/seasonal reconstruction is
    needed — the model already operates in T space.

    Date-keyed lookup via 'forecast_dates' handles the Feb-29 mismatch
    between PKL dates (Feb-29 retained) and test_dates (Feb-29 stripped).
    """
    n = len(test_dates)

    forecast_temp = arma_params.get("forecast_temp_365")
    if forecast_temp is None:
        print(f"    !! ARMA: 'forecast_temp_365' not found. "
              f"Available keys: {list(arma_params.keys())}")
        return np.full(n, np.nan)

    forecast_temp  = np.asarray(forecast_temp, dtype=float).reshape(-1)
    forecast_dates = arma_params.get("forecast_dates", None)

    if forecast_dates is not None:
        # Date-keyed lookup: immune to Feb-29 calendar mismatch
        date_to_T = dict(zip(pd.DatetimeIndex(forecast_dates), forecast_temp))
        out = np.array(
            [float(date_to_T.get(pd.Timestamp(d), np.nan)) for d in test_dates],
            dtype=float
        )
    else:
        # Positional fallback (no forecast_dates stored)
        out = np.full(n, np.nan, dtype=float)
        for i in range(min(n, len(forecast_temp))):
            out[i] = forecast_temp[i]

    return out

def forecast_benth(benth_params, df_train, test_dates):
    if all(k in benth_params for k in ["a0","a1","t0","slope","intercept"]):
        a0,a1,t0 = float(benth_params["a0"]),float(benth_params["a1"]),float(benth_params["t0"])
        slope,intercept = float(benth_params["slope"]),float(benth_params["intercept"])
    else:
        a0,a1,t0 = float(benth_params["a"]),float(benth_params["b1"]),float(benth_params["g1"])
        alpha = float(benth_params["alpha"])
        slope = np.exp(-alpha) if np.isfinite(alpha) else np.nan; intercept = 0.0
    T_prev = float(df_train.iloc[-1]["T"]); doy_prev = int(df_train.iloc[-1]["doy"])
    de_prev = T_prev - benth_seasonal_mean(doy_prev, a0, a1, t0)
    forecasts = np.empty(len(test_dates), dtype=float)
    for i, d in enumerate(test_dates):
        doy_curr = _doy_noleap(d); seas_curr = benth_seasonal_mean(doy_curr, a0, a1, t0)
        de_curr = slope * de_prev + intercept; T_curr = seas_curr + de_curr
        forecasts[i] = T_curr; de_prev = de_curr
    return forecasts

