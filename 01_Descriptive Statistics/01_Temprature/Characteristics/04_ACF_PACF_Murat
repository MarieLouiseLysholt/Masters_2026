"""
Murat-style ACF plots for daily temperature per region.
One panel per region, arranged in a 2-column grid. Main panel shows lags
0–MAIN_NLAGS days, exposing the annual seasonal sine-wave structure.
"""

import sys
import warnings
from pathlib import Path
import numpy as np
import pandas as pd
import matplotlib
import matplotlib.pyplot as plt
from statsmodels.tsa.stattools import acf

try:
    sys.stdout.reconfigure(encoding="utf-8")
except (AttributeError, OSError):
    pass
warnings.filterwarnings("ignore")


def _find_root(start, target="02_Data"):
    c = Path(start).resolve()
    for _ in range(12):
        if (c / target).exists():
            return c
        c = c.parent
    raise FileNotFoundError


ROOT      = _find_root(Path(__file__).resolve().parent)
DATA_PATH = ROOT / "02_Data" / "01_Temprature" / "region_avg.csv"
OUT_DIR   = ROOT / "99_Thesis Graphs" / "04_Data Tests"
OUT_DIR.mkdir(parents=True, exist_ok=True)

REGION_NAMES = {
    11: "Île-de-France",           24: "Centre-Val de Loire",
    27: "Bourgogne-Franche-Comté", 28: "Normandie",
    32: "Hauts-de-France",         44: "Grand Est",
    52: "Pays de la Loire",        53: "Bretagne",
}

MAIN_NLAGS = 8000    # main panel x-range (~22 years)

matplotlib.rcParams.update({
    "font.family": "serif",
    "font.serif":  ["Times New Roman", "Times", "DejaVu Serif"],
    "axes.spines.top":   False,
    "axes.spines.right": False,
})


def compute_acf(series: np.ndarray) -> np.ndarray:
    nlags = min(MAIN_NLAGS, len(series) - 1)
    return acf(series, nlags=nlags, fft=True, missing="drop")


def plot_acf(ax, vals, xmax, ci_n):
    lags = np.arange(len(vals))
    if xmax < len(vals):
        lags = lags[:xmax + 1]
        vals = vals[:xmax + 1]
    ax.vlines(lags, 0, vals, colors="black", linewidth=0.4)
    ax.axhline(0, color="black", linewidth=0.5)
    if ci_n:
        ci = 1.96 / np.sqrt(ci_n)
        ax.axhline( ci, color="steelblue", linestyle="--", linewidth=0.6)
        ax.axhline(-ci, color="steelblue", linestyle="--", linewidth=0.6)
    ax.set_xlim(0, xmax)
    ax.set_ylim(-1.0, 1.0)


def make_figure():
    raw = pd.read_csv(DATA_PATH, parse_dates=["date"]).sort_values("date")
    regions = sorted(raw["region_code"].unique())

    n = len(regions)
    n_cols = 2
    n_rows = (n + n_cols - 1) // n_cols

    fig, axes = plt.subplots(
        n_rows, n_cols, figsize=(11, 2.0 * n_rows),
        gridspec_kw={"hspace": 0.55, "wspace": 0.20},
    )
    axes_flat = axes.flatten()

    for i, region in enumerate(regions):
        s = (raw[raw["region_code"] == region]
             .dropna(subset=["daily_avg_temperature"])
             .sort_values("date")["daily_avg_temperature"]
             .values.astype(float))
        a_vals = compute_acf(s)

        ax = axes_flat[i]
        plot_acf(ax, a_vals, MAIN_NLAGS, ci_n=len(s))
        ax.set_ylabel("ACF", fontsize=9)
        ax.set_xlabel("Lag (days)", fontsize=8)
        ax.set_title(REGION_NAMES[region], fontsize=10, loc="left",
                     fontweight="bold")
        ax.tick_params(labelsize=7)

        print(f"  region {region}: n={len(s)}, lag-1 ACF={a_vals[1]:.3f}, "
              f"lag-365 ACF={a_vals[365]:.3f}")

    for j in range(n, len(axes_flat)):
        axes_flat[j].axis("off")

    fig.suptitle("Autocorrelation — daily mean temperature (1970–2024)",
                 fontsize=11, y=0.995)
    out = OUT_DIR / "Figure_ACF_Murat.png"
    fig.savefig(out, dpi=200, bbox_inches="tight", facecolor="white")
    plt.close(fig)
    print(f"\nSaved: {out}")


if __name__ == "__main__":
    make_figure()
