"""
Table X: Unit root tests of the daily average temperature time series
Replicates Table 5.4 from Benth & Šaltytė Benth (2012)

ADF:  Augmented Dickey-Fuller
      H0: unit root (r=1)  vs  H1: stationary (r<1)
      Lag selection: Schwarz information criterion (BIC)
      Critical value 5%: -2.8621

KPSS: Kwiatkowski-Phillips-Schmidt-Shin
      H0: stationary (r<1)  vs  H1: unit root (r=1)
      Bandwidth: Newey-West method
      Critical value 5%: 0.463
"""

import numpy as np
import pandas as pd
import warnings
from pathlib import Path
from statsmodels.tsa.stattools import adfuller, kpss

warnings.filterwarnings("ignore", category=UserWarning, message=".*InterpolationWarning.*")
warnings.filterwarnings("ignore", message=".*outside of the range.*")

# ── Config ────────────────────────────────────────────────────────────────────
ROOT = Path(__file__).resolve().parents[1]
SCRIPT_DIR = Path(__file__).resolve().parent
DATA_PATH = ROOT / "02_Data" / "01_Temprature" / "region_avg.csv"

REGION_NAMES = {
    11: "Île-de-France",
    24: "Centre-Val de Loire",
    27: "Bourgogne-Franche-Comté",
    28: "Normandie",
    32: "Hauts-de-France",
    44: "Grand Est",
    52: "Pays de la Loire",
    53: "Bretagne",
}

# ── Load and pivot ────────────────────────────────────────────────────────────
df = pd.read_csv(DATA_PATH, parse_dates=["date"])
all_codes = sorted(df["region_code"].unique())
region_labels = {code: REGION_NAMES.get(code, f"Region {code}") for code in all_codes}

pivot = (
    df.pivot(index="date", columns="region_code", values="daily_avg_temperature")
    .sort_index()
    .rename(columns=region_labels)
)

# ── Run tests ─────────────────────────────────────────────────────────────────
rows = []
for col in pivot.columns:
    series = pivot[col].dropna().values

    # ADF: BIC lag selection, constant + trend included (standard for DAT)
    adf_stat, adf_p, adf_lags, _, _, _ = adfuller(series, autolag="BIC", regression="ct")

    # KPSS: Newey-West bandwidth, trend-stationary null (consistent with ADF)
    # nlags='auto' uses Newey-West bandwidth selection
    kpss_stat, kpss_p, kpss_lags, kpss_crit = kpss(series, regression="ct", nlags="auto")

    rows.append({
        "Region":    col,
        "ADF":       adf_stat,
        "P value":   adf_p,
        "Lags":      adf_lags,
        "KPSS":      kpss_stat,
        "Bandwidth": kpss_lags,
    })

results = pd.DataFrame(rows).set_index("Region")

# ── Print ─────────────────────────────────────────────────────────────────────
cw, nw = 12, 28
header = (f"{'Region':<{nw}}"
          f"{'ADF':>{cw}}{'P value':>{cw}}{'Lags':>{cw}}"
          f"{'KPSS':>{cw}}{'Bandwidth':>{cw}}")
sep = "-" * len(header)

print(header)
print(sep)

for region, row in results.iterrows():
    print(
        f"{region:<{nw}}"
        f"{row['ADF']:>{cw}.4f}"
        f"{row['P value']:>{cw}.4f}"
        f"{int(row['Lags']):>{cw}}"
        f"{row['KPSS']:>{cw}.4f}"
        f"{int(row['Bandwidth']):>{cw}}"
    )

print(sep)
print(f"{'Critical values 5%:':<{nw}}"
      f"{-2.8621:>{cw}.4f}"
      f"{'':>{cw}}"
      f"{'':>{cw}}"
      f"{0.4630:>{cw}.4f}")
print("\nADF augmented Dickey-Fuller, KPSS Kwiatkowski-Phillips-Schmidt-Shin")
print("ADF H0: unit root | KPSS H0: stationary")
print(f"Sample: {pivot.index.min().date()} to {pivot.index.max().date()}")

# ── Save ──────────────────────────────────────────────────────────────────────
out_path = SCRIPT_DIR / "unit_root_tests.csv"
results.round(4).to_csv(out_path)
print(f"\nSaved to: {out_path}")
