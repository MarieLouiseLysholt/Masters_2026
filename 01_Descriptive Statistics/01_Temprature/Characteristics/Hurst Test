"""
Table X: Hurst exponent of daily temperature – before and after seasonal removal

Estimation: hurst package, kind='change' (correct for level series like temperature)
Significance: two-sided t-test of H vs 0.5, SE derived from the log-log OLS
              regression underlying the R/S estimator (Koutsoyiannis 2003)

Seasonal mean: Alaton et al. (2002) / Benth eq. 5.18
    S(t) = A + B*t + c1*sin(2*pi*t/365) + c2*cos(2*pi*t/365)
"""

import numpy as np
import pandas as pd
from pathlib import Path
from hurst import compute_Hc
from scipy import stats

# ── Config ────────────────────────────────────────────────────────────────────
ROOT = Path(__file__).resolve().parents[1]
SCRIPT_DIR = Path(__file__).resolve().parent
DATA_PATH = ROOT / "02_Data" / "01_Temprature" / "region_avg.csv"

REGION_NAMES = {
    11: "Île-de-France",
    24: "Centre-Val de Loire",
    27: "Bourgogne-Franche-Comté",
    28: "Normandie",
    32: "Hauts-de-France",
    44: "Grand Est",
    52: "Pays de la Loire",
    53: "Bretagne",
}

# ── Load and pivot ────────────────────────────────────────────────────────────
df = pd.read_csv(DATA_PATH, parse_dates=["date"])
all_codes = sorted(df["region_code"].unique())
region_labels = {code: REGION_NAMES.get(code, f"Region {code}") for code in all_codes}

pivot = (
    df.pivot(index="date", columns="region_code", values="daily_avg_temperature")
    .sort_index()
    .rename(columns=region_labels)
    .loc["1991-01-01":"2010-12-31"]
)

# ── Alaton seasonal model ─────────────────────────────────────────────────────
def get_residuals(series):
    n = len(series)
    t = np.arange(n)
    X = np.column_stack([
        np.ones(n),
        t,
        np.sin(2 * np.pi * t / 365),
        np.cos(2 * np.pi * t / 365),
    ])
    coeffs, _, _, _ = np.linalg.lstsq(X, series.values, rcond=None)
    return pd.Series(series.values - X @ coeffs, index=series.index)

# ── Hurst + significance test ─────────────────────────────────────────────────
def hurst_with_test(series: np.ndarray):
    """
    Returns H, t-statistic, and p-value for H != 0.5.
    kind='change' is correct for level series (temperature).
    SE is derived from the log-log OLS regression underlying R/S.
    """
    H, _, data = compute_Hc(series, kind="change", simplified=False)
    log_n  = np.log(np.array(data[0]))
    log_rs = np.log(np.array(data[1]))
    _, _, _, _, se = stats.linregress(log_n, log_rs)
    t_stat = (H - 0.5) / se
    p_val  = 2 * stats.t.sf(abs(t_stat), df=len(log_n) - 2)
    return H, t_stat, p_val

# ── Compute for all regions ───────────────────────────────────────────────────
rows = []
for col in pivot.columns:
    raw = pivot[col].dropna()
    res = get_residuals(raw)

    H_b, t_b, p_b = hurst_with_test(raw.values)
    H_a, t_a, p_a = hurst_with_test(res.values)

    rows.append({
        "Region":      col,
        "H (before)":  H_b,
        "t (before)":  t_b,
        "p (before)":  p_b,
        "H (after)":   H_a,
        "t (after)":   t_a,
        "p (after)":   p_a,
    })

results = pd.DataFrame(rows).set_index("Region")

# ── Print ─────────────────────────────────────────────────────────────────────
cw, nw = 11, 28

print(f"{'Region':<{nw}}"
      f"{'H':>{cw}}{'t-stat':>{cw}}{'p-value':>{cw}}"
      f"{'H':>{cw}}{'t-stat':>{cw}}{'p-value':>{cw}}")
print(f"{'':<{nw}}"
      f"{'— Before —':^{cw*3}}"
      f"{'— After —':^{cw*3}}")
print("-" * (nw + cw * 6))

for region, row in results.iterrows():
    print(
        f"{region:<{nw}}"
        f"{row['H (before)']:>{cw}.4f}"
        f"{row['t (before)']:>{cw}.3f}"
        f"{row['p (before)']:>{cw}.4f}"
        f"{row['H (after)']:>{cw}.4f}"
        f"{row['t (after)']:>{cw}.3f}"
        f"{row['p (after)']:>{cw}.4f}"
    )

print("-" * (nw + cw * 6))
print("H estimated via R/S analysis, kind='change' (Koutsoyiannis 2003).")
print("t-statistic tests H = 0.5 (two-sided).")
print(f"Sample: {pivot.index.min().date()} to {pivot.index.max().date()}")

# ── Save ──────────────────────────────────────────────────────────────────────
out_path = SCRIPT_DIR / "hurst_exponents.csv"
results.round(4).to_csv(out_path)
print(f"\nSaved to: {out_path}")
