# Panel 5: standardised residuals
ax5 = fig.add_subplot(gs[2, 1])
ax5.plot(df_res.index[-3 * 365:], df_res["e"].iloc[-3 * 365:], color=BLUE, lw=0.5)
ax5.axhline(0, color="k", lw=0.5)
