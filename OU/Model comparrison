"""
Backtesting comparison replicating Section 4 of:
    Schiller, Seidler & Wimmer (2012):
    "Temperature Models for Pricing Weather Derivatives"

Models: Index Modelling (IM), Alaton (2002), Benth (2007)
Contracts: 12 standard HDD/CDD contracts (Table 3)
Metrics: MRE, MSRE, Mann-Whitney U test, scatter regression (Figures 5-6)

Two valuation times per contract-year:
    (a) 180 days before measurement period start
    (b) Midpoint of measurement period (first half known, second half predicted)
"""

import numpy as np
import pandas as pd
from scipy import stats
from scipy.stats import norminvgauss, mannwhitneyu
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import pickle, warnings
from itertools import combinations

warnings.filterwarnings("ignore")
np.random.seed(42)

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

REGIONS    = [11])
N_SIMS     = 10_000   # MC paths per valuation  (paper: 100,000)
N_HIST     = 20       # max years of estimation history  (paper uses 30; limited by data start 2000)
N_HIST_MIN = 8        # minimum history to enter backtest
MIN_INDEX  = 50     # exclude contracts with Y_actual < 50 degree-days (paper Sec. 4.1, fn. 4)
T_REF      = 18     # reference temperature deg C (EU CME standard, matching Schiller 2012)
OMEGA      = 2 * np.pi / 365
TEST_START = 2010     # first out-of-sample year (paper tests 1983-2005; thesis window 2015-2024)

CONTRACTS = [
    ("Summer",    "CDD",  5,  1,  9, 30),
    ("May",       "CDD",  5,  1,  5, 31),
    ("June",      "CDD",  6,  1,  6, 30),
    ("July",      "CDD",  7,  1,  7, 31),
    ("August",    "CDD",  8,  1,  8, 31),
    ("September", "CDD",  9,  1,  9, 30),
    ("Winter",    "HDD", 11,  1,  3, 31),
    ("November",  "HDD", 11,  1, 11, 30),
    ("December",  "HDD", 12,  1, 12, 31),
    ("January",   "HDD",  1,  1,  1, 31),
    ("February",  "HDD",  2,  1,  2, 28),
    ("March",     "HDD",  3,  1,  3, 31),
]

BLUE, RED, GRAY = "#2563EB", "#DC2626", "#6B7280"
COLORS = {"HBA": GRAY, "Alaton": BLUE, "Benth": RED}
LABELS = {"HBA": "Burn Analysis (HBA)", "Alaton": "Alaton (2002)", "Benth": "Benth (2007)"}
plt.rcParams.update({"font.size": 9, "axes.spines.top": False, "axes.spines.right": False})

# ---------------------------------------------------------------------------
# Load models  (region-specific, set globals used by predict functions)
# ---------------------------------------------------------------------------

# These module-level names are re-assigned at the start of each region iteration.
# The predict functions reference them by name at call time, so this is safe.
alaton = benth = None
df = None
_NIG_A = _NIG_B = _NIG_LOC = _NIG_SCALE = None
_NIG_MEAN = _NIG_STD = _B_ALPHA = _B_SIGDOY = None
_B_A = _B_B = _B_B1 = _B_G1 = _B_DF = None

def date_to_t(date):
    """
    Map a calendar date to the absolute integer t used in the Benth model.
    t=0 for the first day in the calibration dataset (after removing Feb 29).
    For dates within the stored df, look up directly.
    For dates beyond the stored data, extrapolate by counting non-Feb29 days.
    """
    date = pd.Timestamp(date)
    if date in _B_DF.index:
        return int(_B_DF.loc[date, "t"])
    # Extrapolate: count non-Feb29 days from dataset start to target date
    dr = pd.date_range(_B_DF.index[0], date, freq="D")
    dr = dr[~((dr.month == 2) & (dr.day == 29))]
    return len(dr) - 1

def date_range_to_t(dates):
    """Vectorised version of date_to_t for a DatetimeIndex."""
    return np.array([date_to_t(d) for d in dates])

# ---------------------------------------------------------------------------
# Benth seasonality function  (eq. 2, 2007 paper)
# s(t) = a + b*t + b1*cos(2*pi*(t - g1)/365)
# where t is the ABSOLUTE day count, not DOY.
# ---------------------------------------------------------------------------

def benth_s_vec(t_abs_arr):
    """Vectorised s(t) for an array of absolute t values."""
    return _B_A + _B_B * t_abs_arr + _B_B1 * np.cos(2 * np.pi * (t_abs_arr - _B_G1) / 365)

def benth_doy(date):
    doy  = date.timetuple().tm_yday
    leap = (date.year % 4 == 0 and (date.year % 100 != 0 or date.year % 400 == 0))
    if leap and date.month > 2: doy -= 1
    return max(1, min(365, doy))



# ---------------------------------------------------------------------------
# Period helpers
# ---------------------------------------------------------------------------

def period_dates(contract, year):
    _, _, sm, sd, em, ed = contract
    start    = pd.Timestamp(year=year, month=sm, day=sd)
    end_year = year + 1 if sm > em else year
    return start, pd.Timestamp(year=end_year, month=em, day=ed)

def get_temps(df_, contract, year):
    s, e = period_dates(contract, year)
    return df_.loc[(df_.index >= s) & (df_.index <= e), "T"]

def is_complete(series, contract, year, thr=0.85):
    s, e = period_dates(contract, year)
    return len(series) >= thr * ((e - s).days + 1)

def hdd_cdd(temps, itype):
    if itype == "HDD": return float(np.maximum(T_REF - temps.values, 0).sum())
    return float(np.maximum(temps.values - T_REF, 0).sum())

def nearest(df_, ts):
    if ts in df_.index: return ts
    return df_.index[df_.index.get_indexer([ts], method="nearest")[0]]

# ---------------------------------------------------------------------------
# Burn Analysis (HBA)  -- plain historical mean, no trend (Section 3.1)
# KEY distinction vs Index Modelling: forecast = Y_bar, not beta0+beta1*(n+1)
# ---------------------------------------------------------------------------

def hba_predict(contract, year, timing):
    _, itype, *_ = contract
    s, e  = period_dates(contract, year)
    n_d   = (e - s).days + 1
    mid_d = nearest(df, s + pd.Timedelta(days=n_d // 2 - 1))

    Y_full, Y_sec = [], []
    for yr in range(year - N_HIST - 5, year):
        temps = get_temps(df, contract, yr)
        if not is_complete(temps, contract, yr): continue
        sy, ey    = period_dates(contract, yr)
        nd_yr     = (ey - sy).days + 1
        mid_yr    = sy + pd.Timedelta(days=nd_yr // 2 - 1)
        t_sec     = temps[temps.index > mid_yr]
        if len(t_sec) == 0: continue
        Y_full.append(hdd_cdd(temps, itype))
        Y_sec.append(hdd_cdd(t_sec, itype))

    if len(Y_full) < 5: return None

    if timing == "180":
        return float(np.mean(Y_full[-N_HIST:]))          # HBA: plain mean
    else:  # mid
        hi = hdd_cdd(df.loc[(df.index >= s) & (df.index <= mid_d), "T"], itype)
        return hi + float(np.mean(Y_sec[-N_HIST:]))      # HBA: plain mean of second-half history

# ---------------------------------------------------------------------------
# Alaton simulation  (Gaussian OU, exact one-day step)
# ---------------------------------------------------------------------------

def alaton_predict(contract, year, timing):
    _, itype, *_ = contract
    s, e  = period_dates(contract, year)
    n_d   = (e - s).days + 1
    a     = float(alaton["a"])
    A, B, C, phi = alaton["A"], alaton["B"], alaton["C"], alaton["phi"]
    sm    = alaton["sigma_monthly"]
    rng   = np.random.default_rng()

    def Tm(t_arr): return A + B*t_arr + C*np.sin(OMEGA*t_arr + phi)

    if timing == "180":
        v0      = nearest(df, s - pd.Timedelta(days=180))
        T0, t0  = float(df.loc[v0, "T"]), int(df.loc[v0, "t"])
        total   = 180 + n_d
        dates   = pd.date_range(v0, periods=total, freq="D")
        tm      = Tm(np.arange(t0, t0 + total))
        sig     = np.array([sm[d.month] for d in dates])
        cstd    = sig * np.sqrt((1 - np.exp(-2*a)) / (2*a))
        noise   = rng.standard_normal((N_SIMS, total))
        P       = np.empty((N_SIMS, total)); P[:, 0] = T0
        for i in range(1, total):
            P[:, i] = tm[i] + np.exp(-a)*(P[:, i-1] - tm[i-1]) + cstd[i]*noise[:, i]
        paths = P[:, -n_d:]
        hi    = 0.0
    else:
        mid_d   = nearest(df, s + pd.Timedelta(days=n_d // 2 - 1))
        T0, t0  = float(df.loc[mid_d, "T"]), int(df.loc[mid_d, "t"]) + 1
        rem     = n_d - n_d // 2
        dates   = pd.date_range(mid_d + pd.Timedelta(days=1), periods=rem, freq="D")
        tm      = Tm(np.arange(t0, t0 + rem))
        sig     = np.array([sm[d.month] for d in dates])
        cstd    = sig * np.sqrt((1 - np.exp(-2*a)) / (2*a))
        noise   = rng.standard_normal((N_SIMS, rem))
        P       = np.empty((N_SIMS, rem)); P[:, 0] = T0
        for i in range(1, rem):
            P[:, i] = tm[i] + np.exp(-a)*(P[:, i-1] - tm[i-1]) + cstd[i]*noise[:, i]
        paths = P
        hi    = hdd_cdd(df.loc[(df.index >= s) & (df.index <= mid_d), "T"], itype)

    idx = np.maximum(T_REF - paths, 0).sum(1) if itype == "HDD" \
          else np.maximum(paths - T_REF, 0).sum(1)
    return hi + float(idx.mean())

# ---------------------------------------------------------------------------
# Benth simulation  (NIG Levy-OU, 2007: linear trend + Fourier variance)
# ---------------------------------------------------------------------------

def benth_predict(contract, year, timing):
    _, itype, *_ = contract
    s, e  = period_dates(contract, year)
    n_d   = (e - s).days + 1
    rng   = np.random.default_rng()

    if timing == "180":
        v0    = nearest(df, s - pd.Timedelta(days=180))
        T0    = float(df.loc[v0, "T"])
        total = 180 + n_d
        dates = pd.date_range(v0, periods=total, freq="D")

        # Absolute t values for each forecast date -- needed for linear trend b*t
        t_abs = date_range_to_t(dates)
        sv    = benth_s_vec(t_abs)                         # s(t) with linear trend

        # Seasonal sigma from DOY (Fourier fitted, stored as 365-element array)
        doys  = np.array([benth_doy(d) for d in dates])
        sigv  = _B_SIGDOY[doys - 1]

        eps   = (norminvgauss.rvs(_NIG_A, _NIG_B, loc=_NIG_LOC, scale=_NIG_SCALE,
                                  size=(N_SIMS, total), random_state=rng)
                 - _NIG_MEAN) / _NIG_STD
        P     = np.empty((N_SIMS, total)); P[:, 0] = T0
        for i in range(1, total):
            P[:, i] = sv[i] + _B_ALPHA*(P[:, i-1] - sv[i-1]) + sigv[i]*eps[:, i]
        paths = P[:, -n_d:]
        hi    = 0.0

    else:  # mid-measurement
        mid_d = nearest(df, s + pd.Timedelta(days=n_d // 2 - 1))
        T0    = float(df.loc[mid_d, "T"])
        rem   = n_d - n_d // 2
        dates = pd.date_range(mid_d + pd.Timedelta(days=1), periods=rem, freq="D")

        # Absolute t values for forecast dates
        t_abs = date_range_to_t(dates)
        sv    = benth_s_vec(t_abs)                         # s(t) with linear trend

        doys  = np.array([benth_doy(d) for d in dates])
        sigv  = _B_SIGDOY[doys - 1]

        eps   = (norminvgauss.rvs(_NIG_A, _NIG_B, loc=_NIG_LOC, scale=_NIG_SCALE,
                                  size=(N_SIMS, rem), random_state=rng)
                 - _NIG_MEAN) / _NIG_STD

        # Initial X0 = T0 - s(t_mid) using the correct absolute t for mid_d
        t_mid = date_to_t(mid_d)
        s_mid = float(benth_s_vec(np.array([t_mid]))[0])
        X0    = T0 - s_mid

        P     = np.empty((N_SIMS, rem))
        P[:, 0] = sv[0] + _B_ALPHA*X0 + sigv[0]*eps[:, 0]
        for i in range(1, rem):
            P[:, i] = sv[i] + _B_ALPHA*(P[:, i-1] - sv[i-1]) + sigv[i]*eps[:, i]
        paths = P
        hi    = hdd_cdd(df.loc[(df.index >= s) & (df.index <= mid_d), "T"], itype)

    idx = np.maximum(T_REF - paths, 0).sum(1) if itype == "HDD" \
          else np.maximum(paths - T_REF, 0).sum(1)
    return hi + float(idx.mean())

# ---------------------------------------------------------------------------
# Backtest loop  (over all regions)
# ---------------------------------------------------------------------------

records = []

for region in REGIONS:
    print(f"\n{'='*60}\n  Region {region}\n{'='*60}")

    # ── Load region-specific models ──────────────────────────────────────────
    with open(f"alaton_models/alaton_model_{region}.pkl", "rb") as f:
        alaton = pickle.load(f)
    with open(f"benth_models/ou_levy_model_{region}.pkl", "rb") as f:
        benth = pickle.load(f)

    # Temperature data (use Alaton's full df as ground truth)
    df       = alaton["df"][["T"]].copy().sort_index()
    t_origin = df.index[0]
    df["t"]  = (df.index - t_origin).days + 1   # absolute day count, Alaton only

    # ── Re-initialise Benth globals for this region ───────────────────────────
    _NIG_A, _NIG_B, _NIG_LOC, _NIG_SCALE = benth["nig_params"]
    _NIG_MEAN  = float(norminvgauss.mean(_NIG_A, _NIG_B, loc=_NIG_LOC, scale=_NIG_SCALE))
    _NIG_STD   = float(norminvgauss.std (_NIG_A, _NIG_B, loc=_NIG_LOC, scale=_NIG_SCALE))
    # Paper Section 3.3: use Alaton's a for Benth for a fair comparison
    _B_ALPHA   = float(np.exp(-alaton["a"]))
    _B_SIGDOY  = np.array(benth["sigma_doy"])
    _B_A       = float(benth["a"])
    _B_B       = float(benth["b"])
    _B_B1      = float(benth["b1"])
    _B_G1      = float(benth["g1"])
    _B_DF      = benth["df"].copy()

    print(f"N={len(df):,}  Benth: a={_B_A:.4f}  b={_B_B:.6f}  "
          f"warming={_B_B*365*10:.3f}C/decade")

    # Sanity check: s(t) at summer and winter dates vs observed mean T
    for label, date_str in [("2015-01-15", "2015-01-15"), ("2015-07-15", "2015-07-15"),
                             ("2020-01-15", "2020-01-15"), ("2020-07-15", "2020-07-15")]:
        test_date = pd.Timestamp(date_str)
        if test_date in _B_DF.index:
            t_abs  = int(_B_DF.loc[test_date, "t"])
            s_val  = float(benth_s_vec(np.array([t_abs]))[0])
            t_obs  = float(df.loc[test_date, "T"])
            print(f"  s({label})={s_val:.2f}C  observed={t_obs:.2f}C  diff={s_val-t_obs:+.2f}C")

    for contract in CONTRACTS:
        cname, itype, *_ = contract
        n_ok = 0
        print(f"  {cname} ({itype}) ...", end=" ", flush=True)
        for year in sorted(y for y in df.index.year.unique() if y >= TEST_START):
            s_act = get_temps(df, contract, year)
            if not is_complete(s_act, contract, year, thr=0.95): continue
            hist  = sum(1 for yr in range(year - N_HIST - 10, year)
                        if is_complete(get_temps(df, contract, yr), contract, yr))
            if hist < N_HIST_MIN: continue
            Y = hdd_cdd(s_act, itype)
            if Y < MIN_INDEX: continue

            for timing in ["180", "mid"]:
                for mk, fn in [("HBA",    hba_predict),
                               ("Alaton", alaton_predict),
                               ("Benth",  benth_predict)]:
                    pred = fn(contract, year, timing)
                    if pred and pred > 0:
                        d = (pred - Y) / Y
                        records.append({"region": region, "year": year,
                                        "contract": cname, "itype": itype,
                                        "model": mk, "timing": timing,
                                        "Y_actual": Y, "Y_pred": pred,
                                        "delta": d, "delta_sq": d**2})
            n_ok += 1
        print(n_ok)

res = pd.DataFrame(records)
print(f"\nTotal evaluations: {len(res):,}")

# ---------------------------------------------------------------------------
