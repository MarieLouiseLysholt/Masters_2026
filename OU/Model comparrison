        alaton = pickle.load(f)
    with open(f"benth_models/ou_levy_model_{region}.pkl", "rb") as f:
        benth = pickle.load(f)

    # NN-OU: load if available, skip gracefully if PKL not yet generated
    _nn_pkl_path = f"{NN_PKL_DIR}/ou_nn_region_{region}_calib_end_2014-12-31.pkl"
    _nn_available = False
    try:
        with open(_nn_pkl_path, "rb") as f:
            nn_pkl = pickle.load(f)
        # Reconstruct CalibNetFlexible from stored architecture + weights
        arch = nn_pkl["nn_architecture"]
        _in_dim = arch["hidden"]   # placeholder; will be computed from window + doy features
        _doy_harm = nn_pkl["doy_harmonics"]
        _win      = nn_pkl["window"]
        _in_dim   = _win + 2 * _doy_harm    # window residuals + DOY sin/cos features
        _model = CalibNetFlexible(
            in_dim     = _in_dim,
            hidden     = arch["hidden"],
            activation = arch["activation"],
            n_layers   = arch["n_layers"],
            kappa_max  = arch["kappa_max"],
        )
        _model.load_state_dict(nn_pkl["nn_state_dict"])
        _model.eval()

        _NN_MODEL        = _model
        # beta not stored in PKL — recompute from calibration data using same
        # OLS design matrix as the notebook (K harmonics, linear trend)
        _k_harm  = int(nn_pkl.get("k_harmonics", 3))
        _df_calib = alaton["df"].loc[:nn_pkl["calib_end"]].copy()
        _dates_c  = pd.Series(_df_calib.index)
        _n        = len(_df_calib)
        _doy_c    = _dates_c.dt.dayofyear.values.astype(float)
        _t_c      = np.arange(_n) / 365.0
        _parts    = [np.ones(_n), _t_c]
        for _k in range(1, _k_harm + 1):
            _parts.append(np.sin(2 * np.pi * _k * _doy_c / 365.0))
            _parts.append(np.cos(2 * np.pi * _k * _doy_c / 365.0))
        _X_ols   = np.column_stack(_parts)
        _beta, *_ = np.linalg.lstsq(_X_ols, _df_calib["T"].values, rcond=None)
        _NN_BETA         = _beta
        _NN_XMEAN        = float(nn_pkl["x_mean"])
        _NN_XSTD         = float(nn_pkl["x_std"])
        _NN_VOLMULT      = float(nn_pkl["vol_multiplier"])
        _NN_TDFREE       = float(nn_pkl["student_t_df"])
        _NN_WINDOW       = int(nn_pkl["window"])
        _NN_DOYHARMONICS = int(nn_pkl["doy_harmonics"])
        _NN_KHARMONICS   = _k_harm
        # Data start: first date in the temperature series (used to compute t-offset)
        _NN_DATASTART    = alaton["df"].index[0]
        _nn_available    = True
        print(f"  NN-OU loaded: hidden={arch['hidden']}  layers={arch['n_layers']}  "
              f"activation={arch['activation']}  vol_mult={_NN_VOLMULT:.3f}  "
              f"t_df={_NN_TDFREE:.1f}")
    except FileNotFoundError:
        print(f"  NN-OU PKL not found ({_nn_pkl_path}) — skipping NN for this region")

    # Temperature data (use Alaton's full df as ground truth)
    df       = alaton["df"][["T"]].copy().sort_index()
    t_origin = df.index[0]
    df["t"]  = (df.index - t_origin).days + 1   # absolute day count, Alaton only

    # ── Re-initialise Benth globals for this region ───────────────────────────
    _NIG_A, _NIG_B, _NIG_LOC, _NIG_SCALE = benth["nig_params"]
    _NIG_MEAN  = float(norminvgauss.mean(_NIG_A, _NIG_B, loc=_NIG_LOC, scale=_NIG_SCALE))
    _NIG_STD   = float(norminvgauss.std (_NIG_A, _NIG_B, loc=_NIG_LOC, scale=_NIG_SCALE))
    # Paper Section 3.3: use Alaton's a for Benth for a fair comparison
    _B_ALPHA   = float(np.exp(-alaton["a"]))
    _B_SIGDOY  = np.array(benth["sigma_doy"])
    _B_A       = float(benth["a"])
    _B_B       = float(benth["b"])
    _B_B1      = float(benth["b1"])
    _B_G1      = float(benth["g1"])
    _B_DF      = benth["df"].copy()

    print(f"N={len(df):,}  Benth: a={_B_A:.4f}  b={_B_B:.6f}  "
          f"warming={_B_B*365*10:.3f}C/decade")

    # Sanity check: s(t) at summer and winter dates vs observed mean T
    for label, date_str in [("2015-01-15", "2015-01-15"), ("2015-07-15", "2015-07-15"),
                             ("2020-01-15", "2020-01-15"), ("2020-07-15", "2020-07-15")]:
        test_date = pd.Timestamp(date_str)
        if test_date in _B_DF.index:
            t_abs  = int(_B_DF.loc[test_date, "t"])
            s_val  = float(benth_s_vec(np.array([t_abs]))[0])
            t_obs  = float(df.loc[test_date, "T"])
            print(f"  s({label})={s_val:.2f}C  observed={t_obs:.2f}C  diff={s_val-t_obs:+.2f}C")

    for contract in CONTRACTS:
        cname, itype, *_ = contract
        n_ok = 0
        print(f"  {cname} ({itype}) ...", end=" ", flush=True)
        for year in sorted(y for y in df.index.year.unique() if y >= TEST_START):
            s_act = get_temps(df, contract, year)
            if not is_complete(s_act, contract, year, thr=0.95): continue
            hist  = sum(1 for yr in range(year - N_HIST - 10, year)
                        if is_complete(get_temps(df, contract, yr), contract, yr))
            if hist < N_HIST_MIN: continue
            Y = hdd_cdd(s_act, itype)
            if Y < MIN_INDEX: continue

            for timing in ["180", "mid"]:
                model_fns = [("HBA",    hba_predict),
                             ("Alaton", alaton_predict),
                             ("Benth",  benth_predict)]
                if _nn_available:
                    model_fns.append(("NN-OU", nn_predict))

                for mk, fn in model_fns:
                    pred = fn(contract, year, timing)
                    if pred and pred > 0:
                        d = (pred - Y) / Y
                        records.append({"region": region, "year": year,
                                        "contract": cname, "itype": itype,
                                        "model": mk, "timing": timing,
                                        "Y_actual": Y, "Y_pred": pred,
                                        "delta": d, "delta_sq": d**2})
            n_ok += 1
        print(n_ok)

res = pd.DataFrame(records)
