print(f"\n# Table 4 -- MRE and MSRE")
print(f"  {'Model':<22} {'MRE 180':>10} {'MRE mid':>9} {'MSRE 180':>10} {'MSRE mid':>10} {'N':>5}")
print("  " + "-" * 68)
for itype in ["HDD", "CDD"]:
    print(f"\n  {itype}")
    for m in ["HBA", "Alaton", "Benth"]:
        rows = {t: res[(res.itype == itype) & (res.timing == t) & (res.model == m)]
                for t in ["180", "mid"]}
        n = len(rows["180"])
        if n == 0: continue
        print(f"  {LABELS[m]:<22}"
              f" {rows['180']['delta'].mean():>9.2%}"
              f" {rows['mid']['delta'].mean():>9.2%}"
              f" {rows['180']['delta_sq'].mean():>9.2%}"
              f" {rows['mid']['delta_sq'].mean():>9.2%}"
              f" {n:>5}")

# ---------------------------------------------------------------------------
# Table 5 -- Mann-Whitney U test
# ---------------------------------------------------------------------------

def mw_pval(x, y):
    _, p = mannwhitneyu(x, y, alternative="less")
    return p

def stars(p):
    return "***" if p < 0.001 else "**" if p < 0.01 else "*" if p < 0.05 else ""

print(f"\n# Table 5 -- Mann-Whitney U  (H1: row MSRE < col MSRE)")
for timing in ["180", "mid"]:
    print(f"\n  {'180 days ahead' if timing == '180' else 'Mid period'}")
    sub = res[res.timing == timing]
    for mx in ["HBA", "Alaton", "Benth"]:
        row = f"  {LABELS[mx]:<22}"
        for my in ["HBA", "Alaton", "Benth"]:
            if mx == my: row += f"  {'—':>10}"; continue
            p = mw_pval(sub[sub.model == mx]["delta_sq"].values,
                        sub[sub.model == my]["delta_sq"].values)
            row += f"  {p:>7.4f}{stars(p):<3}"
        print(row)

# ---------------------------------------------------------------------------
# Figure 5 -- scatter delta_mid vs delta_180
# ---------------------------------------------------------------------------

print(f"\n# Figure 5 -- Regression: delta_mid = a*delta_180 + b")
reg = {}
for m in ["HBA", "Alaton", "Benth"]:
    d180 = res[(res.timing == "180") & (res.model == m)].set_index(["region","year","contract"])["delta"]
    dmid = res[(res.timing == "mid")  & (res.model == m)].set_index(["region","year","contract"])["delta"]
    mg   = pd.concat([d180.rename("d180"), dmid.rename("dmid")], axis=1).dropna()
    sl, ic, r, pv, _ = stats.linregress(mg["d180"], mg["dmid"])
    reg[m] = (mg["d180"].values, mg["dmid"].values, sl, ic, r)
    print(f"  {LABELS[m]:<22}  a={sl:.4f}{stars(pv):<3}  b={ic:.4f}  R2={r**2:.4f}  n={len(mg)}")

