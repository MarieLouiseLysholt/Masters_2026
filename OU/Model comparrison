# ---------------------------------------------------------------------------
# CalibNetFlexible  (must match the architecture used in the notebook)
# ---------------------------------------------------------------------------

class CalibNetFlexible(nn.Module):
    """Time-varying kappa / sigma OU calibration network.
    Matches the notebook's CalibNetFlexible: arbitrary depth, activation choice.
    """
    ACTIVATIONS = {
        "tanh":       nn.Tanh,
        "relu":       nn.ReLU,
        "leakyrelu":  lambda: nn.LeakyReLU(0.1),
        "elu":        nn.ELU,
    }

    def __init__(self, in_dim: int, hidden: int = 32,
                 activation: str = "leakyrelu", n_layers: int = 1,
                 kappa_max: float = 0.5):
        super().__init__()
        self.kappa_max = kappa_max
        act_cls = self.ACTIVATIONS.get(activation, nn.LeakyReLU)
        layers: list = [nn.Linear(in_dim, hidden), act_cls()]
        for _ in range(n_layers - 1):
            layers += [nn.Linear(hidden, hidden), act_cls()]
        layers.append(nn.Linear(hidden, 2))
        self.net      = nn.Sequential(*layers)
        self.softplus = nn.Softplus()

    def forward(self, x):
        raw   = self.net(x)
        kappa = self.kappa_max * torch.sigmoid(raw[:, 0]) + 1e-6
        sigma = self.softplus(raw[:, 1])               + 1e-6
        return kappa, sigma

def date_to_t(date):
    """
    Map a calendar date to the absolute integer t used in the Benth model.
    t=0 for the first day in the calibration dataset (after removing Feb 29).
    For dates within the stored df, look up directly.
    For dates beyond the stored data, extrapolate by counting non-Feb29 days.
    """
    date = pd.Timestamp(date)
    if date in _B_DF.index:
        return int(_B_DF.loc[date, "t"])
    # Extrapolate: count non-Feb29 days from dataset start to target date
    dr = pd.date_range(_B_DF.index[0], date, freq="D")
    dr = dr[~((dr.month == 2) & (dr.day == 29))]
    return len(dr) - 1

def date_range_to_t(dates):
    """Vectorised version of date_to_t for a DatetimeIndex."""
    return np.array([date_to_t(d) for d in dates])

# ---------------------------------------------------------------------------
# Benth seasonality function  (eq. 2, 2007 paper)
# s(t) = a + b*t + b1*cos(2*pi*(t - g1)/365)
# where t is the ABSOLUTE day count, not DOY.
# ---------------------------------------------------------------------------

def benth_s_vec(t_abs_arr):
    """Vectorised s(t) for an array of absolute t values."""
    return _B_A + _B_B * t_abs_arr + _B_B1 * np.cos(2 * np.pi * (t_abs_arr - _B_G1) / 365)

def benth_doy(date):
    doy  = date.timetuple().tm_yday
    leap = (date.year % 4 == 0 and (date.year % 100 != 0 or date.year % 400 == 0))
    if leap and date.month > 2: doy -= 1
    return max(1, min(365, doy))



# ---------------------------------------------------------------------------
# Period helpers
# ---------------------------------------------------------------------------

def period_dates(contract, year):
    _, _, sm, sd, em, ed = contract
    start    = pd.Timestamp(year=year, month=sm, day=sd)
    end_year = year + 1 if sm > em else year
    return start, pd.Timestamp(year=end_year, month=em, day=ed)

def get_temps(df_, contract, year):
    s, e = period_dates(contract, year)
    return df_.loc[(df_.index >= s) & (df_.index <= e), "T"]

def is_complete(series, contract, year, thr=0.85):
    s, e = period_dates(contract, year)
    return len(series) >= thr * ((e - s).days + 1)

def hdd_cdd(temps, itype):
    if itype == "HDD": return float(np.maximum(T_REF - temps.values, 0).sum())
    return float(np.maximum(temps.values - T_REF, 0).sum())

def nearest(df_, ts):
    if ts in df_.index: return ts
    return df_.index[df_.index.get_indexer([ts], method="nearest")[0]]

# ---------------------------------------------------------------------------
# Burn Analysis (HBA)  -- plain historical mean, no trend (Section 3.1)
# KEY distinction vs Index Modelling: forecast = Y_bar, not beta0+beta1*(n+1)
# ---------------------------------------------------------------------------

def hba_predict(contract, year, timing):
    _, itype, *_ = contract
    s, e  = period_dates(contract, year)
    n_d   = (e - s).days + 1
    mid_d = nearest(df, s + pd.Timedelta(days=n_d // 2 - 1))

    Y_full, Y_sec = [], []
    for yr in range(year - N_HIST - 5, year):
        temps = get_temps(df, contract, yr)
        if not is_complete(temps, contract, yr): continue
        sy, ey    = period_dates(contract, yr)
        nd_yr     = (ey - sy).days + 1
        mid_yr    = sy + pd.Timedelta(days=nd_yr // 2 - 1)
        t_sec     = temps[temps.index > mid_yr]
        if len(t_sec) == 0: continue
        Y_full.append(hdd_cdd(temps, itype))
        Y_sec.append(hdd_cdd(t_sec, itype))

    if len(Y_full) < 5: return None

    if timing == "180":
        return float(np.mean(Y_full[-N_HIST:]))          # HBA: plain mean
    else:  # mid
        hi = hdd_cdd(df.loc[(df.index >= s) & (df.index <= mid_d), "T"], itype)
        return hi + float(np.mean(Y_sec[-N_HIST:]))      # HBA: plain mean of second-half history

# ---------------------------------------------------------------------------
# Alaton simulation  (Gaussian OU, exact one-day step)
# ---------------------------------------------------------------------------

def alaton_predict(contract, year, timing):
    _, itype, *_ = contract
    s, e  = period_dates(contract, year)
    n_d   = (e - s).days + 1
    a     = float(alaton["a"])
    A, B, C, phi = alaton["A"], alaton["B"], alaton["C"], alaton["phi"]
    sm    = alaton["sigma_monthly"]
    rng   = np.random.default_rng()

    def Tm(t_arr): return A + B*t_arr + C*np.sin(OMEGA*t_arr + phi)

    if timing == "180":
        v0      = nearest(df, s - pd.Timedelta(days=180))
        T0, t0  = float(df.loc[v0, "T"]), int(df.loc[v0, "t"])
        total   = 180 + n_d
        dates   = pd.date_range(v0, periods=total, freq="D")
        tm      = Tm(np.arange(t0, t0 + total))
        sig     = np.array([sm[d.month] for d in dates])
        cstd    = sig * np.sqrt((1 - np.exp(-2*a)) / (2*a))
        noise   = rng.standard_normal((N_SIMS, total))
        P       = np.empty((N_SIMS, total)); P[:, 0] = T0
        for i in range(1, total):
            P[:, i] = tm[i] + np.exp(-a)*(P[:, i-1] - tm[i-1]) + cstd[i]*noise[:, i]
        paths = P[:, -n_d:]
        hi    = 0.0
    else:
        mid_d   = nearest(df, s + pd.Timedelta(days=n_d // 2 - 1))
        T0, t0  = float(df.loc[mid_d, "T"]), int(df.loc[mid_d, "t"]) + 1
        rem     = n_d - n_d // 2
        dates   = pd.date_range(mid_d + pd.Timedelta(days=1), periods=rem, freq="D")
        tm      = Tm(np.arange(t0, t0 + rem))
        sig     = np.array([sm[d.month] for d in dates])
        cstd    = sig * np.sqrt((1 - np.exp(-2*a)) / (2*a))
        noise   = rng.standard_normal((N_SIMS, rem))
        P       = np.empty((N_SIMS, rem)); P[:, 0] = T0
        for i in range(1, rem):
            P[:, i] = tm[i] + np.exp(-a)*(P[:, i-1] - tm[i-1]) + cstd[i]*noise[:, i]
        paths = P
        hi    = hdd_cdd(df.loc[(df.index >= s) & (df.index <= mid_d), "T"], itype)

    idx = np.maximum(T_REF - paths, 0).sum(1) if itype == "HDD" \
          else np.maximum(paths - T_REF, 0).sum(1)
    return hi + float(idx.mean())

# ---------------------------------------------------------------------------
# Benth simulation  (NIG Levy-OU, 2007: linear trend + Fourier variance)
# ---------------------------------------------------------------------------

def benth_predict(contract, year, timing):
    _, itype, *_ = contract
    s, e  = period_dates(contract, year)
    n_d   = (e - s).days + 1
    rng   = np.random.default_rng()

    if timing == "180":
        v0    = nearest(df, s - pd.Timedelta(days=180))
        T0    = float(df.loc[v0, "T"])
        total = 180 + n_d
        dates = pd.date_range(v0, periods=total, freq="D")

        # Absolute t values for each forecast date -- needed for linear trend b*t
        t_abs = date_range_to_t(dates)
        sv    = benth_s_vec(t_abs)                         # s(t) with linear trend

        # Seasonal sigma from DOY (Fourier fitted, stored as 365-element array)
        doys  = np.array([benth_doy(d) for d in dates])
        sigv  = _B_SIGDOY[doys - 1]

        eps   = (norminvgauss.rvs(_NIG_A, _NIG_B, loc=_NIG_LOC, scale=_NIG_SCALE,
                                  size=(N_SIMS, total), random_state=rng)
                 - _NIG_MEAN) / _NIG_STD
        P     = np.empty((N_SIMS, total)); P[:, 0] = T0
        for i in range(1, total):
            P[:, i] = sv[i] + _B_ALPHA*(P[:, i-1] - sv[i-1]) + sigv[i]*eps[:, i]
        paths = P[:, -n_d:]
        hi    = 0.0

    else:  # mid-measurement
        mid_d = nearest(df, s + pd.Timedelta(days=n_d // 2 - 1))
        T0    = float(df.loc[mid_d, "T"])
        rem   = n_d - n_d // 2
        dates = pd.date_range(mid_d + pd.Timedelta(days=1), periods=rem, freq="D")

        # Absolute t values for forecast dates
        t_abs = date_range_to_t(dates)
        sv    = benth_s_vec(t_abs)                         # s(t) with linear trend

        doys  = np.array([benth_doy(d) for d in dates])
        sigv  = _B_SIGDOY[doys - 1]

        eps   = (norminvgauss.rvs(_NIG_A, _NIG_B, loc=_NIG_LOC, scale=_NIG_SCALE,
                                  size=(N_SIMS, rem), random_state=rng)
                 - _NIG_MEAN) / _NIG_STD

        # Initial X0 = T0 - s(t_mid) using the correct absolute t for mid_d
        t_mid = date_to_t(mid_d)
        s_mid = float(benth_s_vec(np.array([t_mid]))[0])
        X0    = T0 - s_mid

        P     = np.empty((N_SIMS, rem))
        P[:, 0] = sv[0] + _B_ALPHA*X0 + sigv[0]*eps[:, 0]
        for i in range(1, rem):
            P[:, i] = sv[i] + _B_ALPHA*(P[:, i-1] - sv[i-1]) + sigv[i]*eps[:, i]
        paths = P
        hi    = hdd_cdd(df.loc[(df.index >= s) & (df.index <= mid_d), "T"], itype)

    idx = np.maximum(T_REF - paths, 0).sum(1) if itype == "HDD" \
          else np.maximum(paths - T_REF, 0).sum(1)
    return hi + float(idx.mean())

# ---------------------------------------------------------------------------
# NN-OU simulation  (CalibNet Model C: time-varying κ/σ + vol correction + Student-t)
# ---------------------------------------------------------------------------

def _nn_seasonal(dates_idx):
    """Reconstruct s(t) for a DatetimeIndex using stored beta.
    FIX: t is measured as calendar days from _NN_DATASTART / 365, exactly
    matching how beta was calibrated. This prevents the trend from restarting
    at zero on each forecast call (bug in the notebook's simulate_final_modelC).
    """
    n   = len(dates_idx)
    doy = dates_idx.dayofyear.values.astype(float)
    t   = np.array([(d - _NN_DATASTART).days for d in dates_idx]) / 365.0
    parts = [np.ones(n), t]
    for k in range(1, _NN_KHARMONICS + 1):
        parts.append(np.sin(2 * np.pi * k * doy / 365.0))
        parts.append(np.cos(2 * np.pi * k * doy / 365.0))
    return np.column_stack(parts) @ _NN_BETA

def _nn_doy_features(dates_idx):
    """DOY Fourier features fed into the NN at each step."""
    doy = dates_idx.dayofyear.values.astype(float)
    feats = []
    for k in range(1, _NN_DOYHARMONICS + 1):
        feats.append(np.sin(2 * np.pi * k * doy / 365.0))
        feats.append(np.cos(2 * np.pi * k * doy / 365.0))
    return np.column_stack(feats).astype(np.float32)

def _nn_kappa_sigma_sequence(dates_idx, init_window_xz):
    """Pre-compute deterministic kappa(t) / sigma(t) sequence for the forecast window.

    FIX: Rather than updating the rolling history with per-path realisations
    (which collapses all paths to the same NN input after step 1), we advance
    the window with the zero-mean OU expectation: x_{t+1} = (1-kappa)*x_t.
    This gives a single deterministic parameter trajectory, which is the correct
    interpretation — kappa and sigma are market parameters, not path-specific.
    """
    total      = len(dates_idx)
    doy_feats  = _nn_doy_features(dates_idx)
    kappa_seq  = np.empty(total, dtype=np.float32)
    sigma_seq  = np.empty(total, dtype=np.float32)
    rolling    = init_window_xz.copy()  # shape (WINDOW,)

    _NN_MODEL.eval()
    with torch.no_grad():
        for i in range(total):
            inp   = np.concatenate([rolling[-_NN_WINDOW:], doy_feats[i]])[None, :]
            inp_t = torch.tensor(inp, dtype=torch.float32)
            k_t, s_t = _NN_MODEL(inp_t)
            kappa_seq[i] = float(k_t.item())
            sigma_seq[i] = float(s_t.item()) * _NN_VOLMULT
            # Advance with OU expectation (zero-mean residual drift)
            x_next = rolling[-1] * (1.0 - kappa_seq[i])
            rolling = np.append(rolling, np.float32(x_next))

    return kappa_seq, sigma_seq

def nn_predict(contract, year, timing):
    """NN-OU Model C: CalibNet + volatility correction + Student-t innovations."""
    _, itype, *_ = contract
    s, e  = period_dates(contract, year)
    n_d   = (e - s).days + 1

    # Student-t scale: standardise to unit variance (E[t^2] = df/(df-2))
    t_scale = float(np.sqrt((_NN_TDFREE - 2.0) / _NN_TDFREE))

    def build_init_window(anchor_date):
        """Build initial rolling window of standardised residuals ending at anchor_date."""
        w_dates  = pd.date_range(anchor_date - pd.Timedelta(days=_NN_WINDOW - 1),
                                 periods=_NN_WINDOW, freq="D")
        hist_T   = np.array([float(df.loc[nearest(df, d), "T"]) for d in w_dates])
        hist_s   = _nn_seasonal(w_dates)
        return ((hist_T - hist_s - _NN_XMEAN) / _NN_XSTD).astype(np.float32)

    if timing == "180":
        v0    = nearest(df, s - pd.Timedelta(days=180))
        T0    = float(df.loc[v0, "T"])
        total = 180 + n_d
        dates = pd.date_range(v0, periods=total, freq="D")

        s_fut            = _nn_seasonal(dates)
        init_xz          = build_init_window(v0)
        kappa_seq, sig_seq = _nn_kappa_sigma_sequence(dates, init_xz)

        x0z  = float((T0 - s_fut[0] - _NN_XMEAN) / _NN_XSTD)
        eps  = (np.random.standard_t(df=_NN_TDFREE, size=(N_SIMS, total))
                * t_scale).astype(np.float32)

        Xz          = np.empty((N_SIMS, total), dtype=np.float32)
        Xz[:, 0]    = x0z
        for i in range(1, total):
            Xz[:, i] = Xz[:, i-1] * (1.0 - kappa_seq[i]) + sig_seq[i] * eps[:, i]

        paths = Xz[:, -n_d:] * _NN_XSTD + _NN_XMEAN + s_fut[-n_d:]
        hi    = 0.0

    else:  # mid-measurement
        mid_d = nearest(df, s + pd.Timedelta(days=n_d // 2 - 1))
        T0    = float(df.loc[mid_d, "T"])
        rem   = n_d - n_d // 2
        dates = pd.date_range(mid_d + pd.Timedelta(days=1), periods=rem, freq="D")

        s_fut  = _nn_seasonal(dates)
        s_mid  = float(_nn_seasonal(pd.DatetimeIndex([mid_d]))[0])
        init_xz = build_init_window(mid_d)
        kappa_seq, sig_seq = _nn_kappa_sigma_sequence(dates, init_xz)

        x0z  = float((T0 - s_mid - _NN_XMEAN) / _NN_XSTD)
        eps  = (np.random.standard_t(df=_NN_TDFREE, size=(N_SIMS, rem))
                * t_scale).astype(np.float32)

        Xz       = np.empty((N_SIMS, rem), dtype=np.float32)
        Xz[:, 0] = x0z * (1.0 - kappa_seq[0]) + sig_seq[0] * eps[:, 0]
        for i in range(1, rem):
            Xz[:, i] = Xz[:, i-1] * (1.0 - kappa_seq[i]) + sig_seq[i] * eps[:, i]

        paths = Xz * _NN_XSTD + _NN_XMEAN + s_fut
        hi    = hdd_cdd(df.loc[(df.index >= s) & (df.index <= mid_d), "T"], itype)

    idx = np.maximum(T_REF - paths, 0).sum(1) if itype == "HDD" \
          else np.maximum(paths - T_REF, 0).sum(1)
    return hi + float(idx.mean())

