    for mx in active_models:
        row = f"  {LABELS[mx]:<26}"
        for my in active_models:
            if mx == my: row += f"  {'—':>10}"; continue
            p = mw_pval(sub[sub.model == mx]["delta_sq"].values,
                        sub[sub.model == my]["delta_sq"].values)
            row += f"  {p:>7.4f}{stars(p):<3}"
        print(row)

