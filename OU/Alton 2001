# Panel 8: ACF of X_t (deseasonalised)
def compute_acf(x, max_lag):
    n, xc = len(x), x - x.mean()
    return np.array([
        np.dot(xc[:n-k], xc[k:]) / np.dot(xc, xc) if k > 0 else 1.0
        for k in range(max_lag + 1)
    ])

MAX_LAG  = 60
ci_bound = 1.96 / np.sqrt(len(T))
