# Simulation function
# Exact discrete-time solution (from eq. 3.7, one-day steps):
#   T_i = (T_{i-1} - T^m_{i-1})*exp(-a) + T^m_i + sigma_i*sqrt((1-exp(-2a))/(2a))*Z_i

def simulate_alaton(model, n_days, n_paths=1000, T0=None, t_start=1, seed=None):
    """
    Simulate temperature paths using the calibrated Gaussian-OU model.
    Returns T_paths: ndarray of shape (n_paths, n_days).

    Parameters
    ----------
    t_start : int  -- integer day index corresponding to the first simulation day (for T^m_t)
    """
    if seed is not None:
        np.random.seed(seed)

    A, B, C, phi    = model["A"], model["B"], model["C"], model["phi"]
    a               = model["a"]
    sigma_monthly   = model["sigma_monthly"]

    if T0 is None:
        T0 = T_mean(t_start)

    t_vec   = np.arange(t_start, t_start + n_days)
    Tm_vec  = A + B * t_vec + C * np.sin(OMEGA * t_vec + phi)

    # Map month index for each simulation day
    # We approximate calendar month from day-of-year cycling
    base_date = pd.Timestamp("2000-01-01") + pd.Timedelta(days=int(t_start - 1))
    dates_sim = pd.date_range(base_date, periods=n_days, freq="D")
    months_sim = dates_sim.month
    sig_vec    = np.array([sigma_monthly[m] for m in months_sim])

    cond_std_vec = sig_vec * np.sqrt((1 - np.exp(-2*a)) / (2*a))
    noise        = np.random.standard_normal((n_paths, n_days))

    T_paths        = np.zeros((n_paths, n_days))
    T_paths[:, 0]  = T0
    for i in range(1, n_days):
        X_prev         = T_paths[:, i-1] - Tm_vec[i-1]
        T_paths[:, i]  = Tm_vec[i] + np.exp(-a) * X_prev + cond_std_vec[i] * noise[:, i]

    return T_paths


# Simulation validation
# Use t_start at dataset midpoint so T^m mean matches full-sample mean (B*t trend effect)
t_mid = int(df_calib["t"].median())
paths = simulate_alaton(model, n_days=365, n_paths=5000, t_start=t_mid, seed=0)
print(f"\n# Simulation check (5000 paths x 365 days, t_start={t_mid})")
print(f"  Mean={paths.mean():.2f}C  (data: {df_calib['T'].mean():.2f}C)")
print(f"  Std={paths.std():.2f}C   (data: {df_calib['T'].std():.2f}C)")