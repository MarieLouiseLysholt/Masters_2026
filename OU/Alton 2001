"""
Replication of Alaton, Djehiche & Stillberger (2002):
"On Modelling and Pricing Weather Derivatives"
Applied Mathematical Finance, 9(1), 1-20.

Model (eq. 3.6):
    dT_t = [dT^m_t/dt + a(T^m_t - T_t)] dt + sigma_t dW_t

Mean temperature (eq. 3.8):
    T^m_t = A + B*t + C*sin(omega*t + phi),   omega = 2*pi/365

Volatility (eq. 3.3):
    sigma_t = sigma_mu,  piecewise constant per calendar month

Exact discrete-time solution for simulation (from eq. 3.7, one-day steps):
    T_i = (T_{i-1} - T^m_{i-1})*exp(-a) + T^m_i + sigma_i*sqrt((1-exp(-2a))/(2a))*Z_i
"""

import numpy as np
import pandas as pd
from scipy import stats
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import matplotlib.gridspec as gridspec
import warnings, pickle
warnings.filterwarnings("ignore")

np.random.seed(42)


# Data loading -- region 11 from KNN-weighted regional average CSV

raw    = pd.read_csv("EDA/region_avg_knn_weighted.csv", parse_dates=["date"])
df_raw = (raw[raw["region_code"] == 11]
            .set_index("date")
            .rename(columns={"daily_avg_temperature_knn_weighted": "T"})
            [["T"]]
            .dropna())

# Integer time index t = 1, 2, ... (paper uses t=1 for Jan 1)
# t is assigned over the FULL dataset so that the trend B*t is correctly
# evaluated at any future date when the comparison script simulates 2015-2024.
df_raw = df_raw.copy()
df_raw["t"] = np.arange(1, len(df_raw) + 1)

# Calibration cutoff: parameters estimated on 2000-2014 only to avoid
# look-ahead bias when backtesting 2015-2024 in model_comparison.py.
CALIB_END = "2014-12-31"
df_calib  = df_raw.loc[:CALIB_END].copy()

print(f"Full data:  N = {len(df_raw):,} obs  ({df_raw.index[0].date()} to {df_raw.index[-1].date()})")
print(f"Calib data: N = {len(df_calib):,} obs  ({df_calib.index[0].date()} to {df_calib.index[-1].date()})")
print(f"T (calib): mean={df_calib['T'].mean():.2f}C  std={df_calib['T'].std():.2f}C  "
      f"range=[{df_calib['T'].min():.1f}, {df_calib['T'].max():.1f}]C")


# Section 3.1 / 3.4.1 -- Mean temperature T^m_t
# Paper fits Y_t = a1 + a2*t + a3*sin(omega*t) + a4*cos(omega*t) via OLS (eq. 3.9/3.10)
# Then recovers: A=a1, B=a2, C=sqrt(a3^2+a4^2), phi=arctan(a4/a3)-pi  (eq. 3.11-3.14)

OMEGA = 2 * np.pi / 365
t_arr = df_calib["t"].values     # calibration window only
T_arr = df_calib["T"].values

# Design matrix for OLS
X_ols = np.column_stack([
    np.ones(len(t_arr)),
    t_arr,
    np.sin(OMEGA * t_arr),
    np.cos(OMEGA * t_arr),
])
coeffs, _, _, _ = np.linalg.lstsq(X_ols, T_arr, rcond=None)
a1, a2, a3, a4 = coeffs

A   = a1
B   = a2
C   = np.sqrt(a3**2 + a4**2)
phi = np.arctan(a4 / a3) - np.pi   # eq. 3.14: arctan is single-argument (returns in (-pi/2, pi/2))

def T_mean(t):
    """T^m_t = A + B*t + C*sin(omega*t + phi)  (eq. 3.8)"""
    return A + B * t + C * np.sin(OMEGA * t + phi)

df_calib["Tm"] = T_mean(t_arr)
df_calib["X"]  = df_calib["T"] - df_calib["Tm"]   # deseasonalised deviations

print(f"\n# Mean temperature (eq. 3.8 / 3.9)")
print(f"  A={A:.4f}C  B={B:.6f}C/day  C={C:.4f}C  phi={phi:.4f} rad")
print(f"  Trend over 25 yrs: {B*365*25:.2f}C")


# Section 3.4.2 -- Monthly volatility sigma (piecewise constant, eq. 3.3)
# Two estimators per month; final value = mean of both (Table 1 approach)
#
# Estimator 1 -- quadratic variation (eq. 3.16):
#   sigma^2_mu = (1/N_mu) * sum( (T_{j+1} - T_j)^2 )
#
# Estimator 2 -- regression residuals (eq. 3.19), requires a:
#   sigma^2_mu = 1/(N_mu - 2) * sum( (T~_j - a*T^m_{j-1} - (1-a)*T_{j-1})^2 )
#   where T~_j = T_j - (T^m_j - T^m_{j-1})
#
# Because estimator 2 requires a, and a (eq. 3.26) requires sigma, we:
#   (1) compute sigma from estimator 1
#   (2) estimate a using those sigma values
#   (3) recompute sigma from estimator 2 using estimated a
#   (4) take the mean of estimator 1 and estimator 2

months = np.arange(1, 13)

def sigma_est1(df):
    """Estimator 1: quadratic variation (eq. 3.16)."""
    result = {}
    for mo in months:
        sub = df[df.index.month == mo]["T"].values
        if len(sub) < 2:
            continue
        result[mo] = np.sqrt(np.mean(np.diff(sub)**2))
    return result

def sigma_est2(df, a_val):
    """Estimator 2: regression residuals (eq. 3.19)."""
    result = {}
    T  = df["T"].values
    Tm = df["Tm"].values
    t  = df["t"].values
    for mo in months:
        idx = np.where(df.index.month == mo)[0]
        # Need pairs (j-1, j) both in the month
        pairs = idx[idx > 0]
        pairs = pairs[df.index.month[pairs - 1] == mo]
        if len(pairs) < 3:
            continue
        j     = pairs
        jm1   = j - 1
        T_tilde = T[j] - (Tm[j] - Tm[jm1])         # T~_j = T_j - (T^m_j - T^m_{j-1})
        resid   = T_tilde - a_val * Tm[jm1] - (1 - a_val) * T[jm1]
        result[mo] = np.sqrt(np.sum(resid**2) / (len(j) - 2))
    return result

# Step 1: sigma from estimator 1
sig1 = sigma_est1(df_calib)

# Step 2: estimate a using martingale estimator (eq. 3.26) with sigma from step 1
# Y_{i-1} = (T^m_{i-1} - T_{i-1}) / sigma^2_{i-1}
# a_hat = -log( sum(Y_{i-1}*(T_i - T^m_i)) / sum(Y_{i-1}*(T_{i-1} - T^m_{i-1})) )

def estimate_a(df, sigma_by_month):
    T  = df["T"].values
    Tm = df["Tm"].values
    sig2 = np.array([sigma_by_month[df.index.month[i]]**2
                     for i in range(len(df))])

    num = 0.0
    den = 0.0
    for i in range(1, len(T)):
        Y_im1  = (Tm[i-1] - T[i-1]) / sig2[i-1]
        num   += Y_im1 * (T[i]   - Tm[i])
        den   += Y_im1 * (T[i-1] - Tm[i-1])

    return -np.log(num / den)

a_est = estimate_a(df_calib, sig1)

# Step 3: sigma from estimator 2
sig2 = sigma_est2(df_calib, a_est)

# Step 4: final sigma = mean of both estimators (paper Table 1 approach)
sigma_monthly = {}
for mo in months:
    if mo in sig1 and mo in sig2:
        sigma_monthly[mo] = (sig1[mo] + sig2[mo]) / 2
    elif mo in sig1:
        sigma_monthly[mo] = sig1[mo]

MONTH_NAMES = ["Jan","Feb","Mar","Apr","May","Jun",
               "Jul","Aug","Sep","Oct","Nov","Dec"]

print(f"\n# Monthly volatility sigma (eq. 3.3, Table 1)")
print(f"  {'Month':<6} {'Est1':>6} {'Est2':>6} {'Mean':>6}")
for mo in months:
    print(f"  {MONTH_NAMES[mo-1]:<6} {sig1.get(mo, np.nan):>6.3f} "
          f"{sig2.get(mo, np.nan):>6.3f} {sigma_monthly[mo]:>6.3f}")

print(f"\n# Mean-reversion parameter a (eq. 3.26)")
print(f"  a={a_est:.4f}  half-life={np.log(2)/a_est:.1f} days")


# Map sigma to each observation
df_calib["sigma"] = df_calib.index.month.map(sigma_monthly)


# Residual diagnostics
# From eq. 3.7 the conditional distribution is Gaussian; check standardised residuals
# T_i | T_{i-1} ~ N( (T_{i-1}-T^m_{i-1})*exp(-a) + T^m_i , sigma^2_i*(1-exp(-2a))/(2a) )

cond_std = df_calib["sigma"].values * np.sqrt((1 - np.exp(-2*a_est)) / (2*a_est))
T  = df_calib["T"].values
Tm = df_calib["Tm"].values

cond_mean = np.full(len(T), np.nan)
cond_mean[1:] = (T[:-1] - Tm[:-1]) * np.exp(-a_est) + Tm[1:]

df_calib["resid"] = (T - cond_mean) / cond_std   # standardised residuals

e = df_calib["resid"].dropna().values

print(f"\n# Standardised residuals (Gaussian check)")
print(f"  mean={e.mean():.4f}  std={e.std():.4f}")
print(f"  skewness={stats.skew(e):.4f}  excess kurtosis={stats.kurtosis(e):.4f}")
_, ks_p = stats.kstest(e, lambda x: stats.norm.cdf(x, e.mean(), e.std()))
print(f"  KS p-value vs Normal: {ks_p:.4f}  -> Normal "
      f"{'not rejected' if ks_p > 0.05 else 'REJECTED'} at 5%")


# Model summary and save

print(f"\n# Model summary")
print(f"  T^m_t = {A:.4f} + {B:.6f}*t + {C:.4f}*sin(2*pi/365*t + {phi:.4f})")
print(f"  a={a_est:.4f}  half-life={np.log(2)/a_est:.1f} days")
sigma_arr = np.array([sigma_monthly[mo] for mo in months])
print(f"  sigma: min={sigma_arr.min():.3f}  max={sigma_arr.max():.3f}C  "
      f"(monthly, piecewise constant)")
print(f"  Noise: Gaussian (standard Wiener process)")

model = {
    "A": A, "B": B, "C": C, "phi": phi,
    "a": a_est,
    "sigma_monthly": sigma_monthly,   # dict: month -> sigma
    "df": df_raw,                     # FULL 2000-2024 data for comparison script ground truth
    "df_calib": df_calib,             # 2000-2014 calibration window (diagnostics)
    "sig1": sig1, "sig2": sig2,
    "model_name": "Alaton (2002)",
    "region_code": 11,
    "calib_end": CALIB_END,
}

with open("alaton_model.pkl", "wb") as f:
    pickle.dump(model, f)
print("Saved -> alaton_model.pkl")


