def run_recursive_forecast(pkl_path: Path, prediction_year: int) -> pd.DataFrame:
    """
    Load PKL and run recursive walk-forward forecasting for the full year.
    Returns DataFrame indexed by date: month, day, doy, de_trend_seas, forecast_actual
    """
    with open(pkl_path, "rb") as f:
        pkg = pickle.load(f)

    model         = pkg["fitted_model"]
    scaler        = pkg["scaler"]
    trend_int     = float(pkg["trend_intercept"])
    trend_slope   = float(pkg["trend_slope"])
    fourier_coefs = pkg["fourier_coefs"]
    n_harmonics   = int(pkg.get("n_harmonics", N_HARMONICS))
    n_calib_days  = int(pkg["n_calib_days"])

    wdf_key = "working_df" if "working_df" in pkg else "training_df"
    work_df = pkg[wdf_key].copy()

    if "diff_yday" not in work_df.columns:
        dts = work_df["de_trend_seas"]
        work_df["diff_yday"] = (dts - dts.shift(-1)).fillna(0.0)

    all_dates = pd.date_range(f"{prediction_year}-01-01",
                               f"{prediction_year}-12-31")
    all_dates = all_dates[~((all_dates.month == 2) & (all_dates.day == 29))]

    rows      = []
    prev_pdtn = float(work_df["de_trend_seas"].iloc[0])

    for i, date in enumerate(all_dates):
        d  = doy_noleap(date)
        t  = float(n_calib_days + i)
        ts = compute_trend_seasonal(
            np.array([t]), np.array([d]),
            trend_int, trend_slope, fourier_coefs, n_harmonics
        )[0]

        feat     = create_feat(work_df, prev_pdtn)
        X        = scaler.transform(feat)
        pred_res = float(model.predict(X)[0])
        fc_val   = float(ts + pred_res)

        rows.append({
            "date":            date,
            "month":           date.month,
            "day":             date.day,
            "doy":             d,
            "de_trend_seas":   pred_res,
            "forecast_actual": fc_val,
        })

        doy_mask = work_df["dayofyear"] == d
        doy_avg  = float(work_df.loc[doy_mask, "dts_doyavge"].iloc[0]) if doy_mask.any() else 0.0
        doy_var  = float(work_df.loc[doy_mask, "dts_doyvar"].iloc[0])  if doy_mask.any() else 0.0

        new_row = pd.DataFrame({
            "dayofyear":     [d],
            "pdtn_doy":      [1 if d == 365 else d + 1],
            "de_trend_seas": [pred_res],
            "dts_doyavge":   [doy_avg],
            "dts_doyvar":    [doy_var],
            "diff_yday":     [pred_res - prev_pdtn],
        }, index=[date])

        work_df   = pd.concat([new_row, work_df]).head(365 * 5 + 8)
        prev_pdtn = pred_res

    return pd.DataFrame(rows).set_index("date")


def load_all_xgb_forecasts(var: str) -> pd.DataFrame:
    """Run recursive forecasting for all regions x OOS years."""
    pkl_dir = TEMP_PKL_DIR   if var == "temp"   else PRECIP_PKL_DIR
    prefix  = "paper_xgb_region" if var == "temp" else "paper_xgb_precip_region"

    records = []
    for reg in REGIONS:
        print(f"    XGB {var} — region {REGION_NAMES.get(reg, reg)}...")
        for oos_yr in OOS_YEARS:
            calib_yr = oos_yr - 1
            pkl_path = pkl_dir / f"{prefix}_{reg}_calib_{calib_yr}.pkl"
            if not pkl_path.exists():
                print(f"      [WARN] Missing: {pkl_path}")
                continue
            try:
                fc = run_recursive_forecast(pkl_path, oos_yr)
                fc["region"] = reg
                fc["year"]   = oos_yr
                records.append(fc.reset_index())
            except Exception as e:
                print(f"      [ERROR] region {reg}, year {oos_yr}: {e}")

    if not records:
        raise ValueError(f"No {var} forecasts loaded. Check PKL directory paths.")
    return pd.concat(records, ignore_index=True)


