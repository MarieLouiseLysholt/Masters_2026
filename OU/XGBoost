# 5. BUILD ACCUMULATION INDICES
# =============================================================================

def months_in_period_list(start_m: int, end_m: int) -> list:
    mths = []
    m = start_m
    while True:
        mths.append(m)
        if m == end_m:
            break
        m = m % 12 + 1
        if len(mths) > 12:
            break
    return mths


def get_cal_year(m: int, i: int, start_m: int, harvest_yr: int) -> int:
    if start_m > 6 and m > 6:
        return harvest_yr - 1
    if start_m > 6 and m <= 6 and i > 0:
        return harvest_yr
    return harvest_yr


def build_actual_index(actual_df: pd.DataFrame, region: int,
                        start_m: int, end_m: int, years: list) -> pd.Series:
    rdf  = actual_df[actual_df["region"] == region]
    mths = months_in_period_list(start_m, end_m)
    out  = {}
    for yr in years:
        total = 0.0
        valid = True
        for i, m in enumerate(mths):
            cal_yr = get_cal_year(m, i, start_m, yr)
            vals   = rdf[(rdf["year"] == cal_yr) & (rdf["month"] == m)]["value"]
            if len(vals) == 0:
                valid = False
                break
            total += float(vals.sum())
        if valid:
            out[yr] = total
    return pd.Series(out, name="actual_index")


def build_forecast_index(actual_df: pd.DataFrame, forecast_df: pd.DataFrame,
                          region: int, start_m: int, end_m: int,
                          oos_years: list) -> pd.Series:
    """
    Autumn months (cal_yr < harvest_yr): use actual observed data.
    Current-year months (cal_yr == harvest_yr): use XGBoost forecast.
    """
    rdf_act = actual_df[actual_df["region"] == region]
    rdf_fc  = forecast_df[forecast_df["region"] == region]
    mths    = months_in_period_list(start_m, end_m)
    out     = {}
    for yr in oos_years:
        total = 0.0
        valid = True
        for i, m in enumerate(mths):
            cal_yr = get_cal_year(m, i, start_m, yr)
            if cal_yr < yr:
                vals = rdf_act[(rdf_act["year"] == cal_yr) &
                               (rdf_act["month"] == m)]["value"]
            else:
                vals = rdf_fc[(rdf_fc["year"] == yr) &
                              (rdf_fc["month"] == m)]["forecast_actual"]
            if len(vals) == 0:
                valid = False
                break
            total += float(vals.sum())
        if valid:
            out[yr] = total
    return pd.Series(out, name="forecast_index")


