# 6. CALIBRATION STATS
# =============================================================================

def compute_calibration_stats(y_calib: np.ndarray, idx_calib: np.ndarray,
                               seed: int = RANDOM_SEED) -> dict:
    rng    = np.random.default_rng(seed)
    n      = len(y_calib)
    bi     = rng.integers(0, n, size=N_BOOTSTRAP)
    y_b    = y_calib[bi]
    i_b    = idx_calib[bi]
    rev_b  = y_b * WHEAT_PRICE

    strike = float(np.mean(idx_calib))
    corr   = float(np.corrcoef(y_calib, idx_calib)[0, 1])
    opt    = "call" if corr < 0 else "put"

    payouts = (np.maximum(i_b - strike, 0) if opt == "call"
               else np.maximum(strike - i_b, 0))
    premium = float(np.mean(payouts) / (1 + RISK_FREE_RATE))

    cov     = np.cov(rev_b, payouts)
    vp      = cov[1, 1]
    z       = max(float(-cov[0, 1] / vp) if vp > 1e-12 else 0.0, 0.0)

    return {"strike": strike, "corr": corr, "opt": opt, "premium": premium, "z": z}


def oos_payout(actual_idx: float, strike: float, opt: str) -> float:
    if opt == "call":
        return max(float(actual_idx) - strike, 0.0)
    return max(strike - float(actual_idx), 0.0)


