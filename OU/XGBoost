# 7. OPTION 1 — FORECAST-CONDITIONAL HEDGING
# =============================================================================

def run_option1(oos_matrix: dict) -> pd.DataFrame:
    records = []
    for reg in REGIONS:
        d = oos_matrix.get(reg)
        if d is None:
            continue
        rname  = REGION_NAMES.get(reg, str(reg))
        y_arr  = d["y_oos"]
        aT     = d["actual_T_oos"]
        aR     = d["actual_R_oos"]
        fcT    = d["forecast_T"]
        fcR    = d["forecast_R"]
        cs_T   = d["calib_stats_T"]
        cs_R   = d["calib_stats_R"]

        n   = len(y_arr)
        rev = y_arr * WHEAT_PRICE

        pay_T = np.array([oos_payout(aT[i], cs_T["strike"], cs_T["opt"]) for i in range(n)])
        pay_R = np.array([oos_payout(aR[i], cs_R["strike"], cs_R["opt"]) for i in range(n)])

        rev_aT = rev + cs_T["z"] * pay_T - cs_T["z"] * cs_T["premium"]
        rev_aR = rev + cs_R["z"] * pay_R - cs_R["z"] * cs_R["premium"]

        # Hedge when forecast says bad year
        flag_T = np.array(
            [(fcT[i] < cs_T["strike"]) if cs_T["opt"] == "put" else (fcT[i] > cs_T["strike"])
             for i in range(n)], dtype=float)
        flag_R = np.array(
            [(fcR[i] < cs_R["strike"]) if cs_R["opt"] == "put" else (fcR[i] > cs_R["strike"])
             for i in range(n)], dtype=float)

        rev_cT = rev + flag_T * (cs_T["z"] * pay_T - cs_T["z"] * cs_T["premium"])
        rev_cR = rev + flag_R * (cs_R["z"] * pay_R - cs_R["z"] * cs_R["premium"])

        sd_bare = np.std(rev, ddof=1)
        he = lambda rv: (sd_bare - np.std(rv, ddof=1)) / sd_bare * 100 if sd_bare > 0 else 0.0

        records.append({
            "region":       reg,
            "region_name":  rname,
            "HE_always_T":  he(rev_aT),
            "HE_always_R":  he(rev_aR),
            "HE_cond_T":    he(rev_cT),
            "HE_cond_R":    he(rev_cR),
            "hedge_rate_T": float(np.mean(flag_T)) * 100,
            "hedge_rate_R": float(np.mean(flag_R)) * 100,
            "_oos_years":   d["oos_years"],
            "_flag_T":      flag_T.tolist(),
            "_flag_R":      flag_R.tolist(),
            "_fcT":         fcT.tolist(),
            "_fcR":         fcR.tolist(),
            "_aT":          aT.tolist(),
            "_aR":          aR.tolist(),
            "_sT":          cs_T["strike"],
            "_sR":          cs_R["strike"],
        })
    return pd.DataFrame(records)


# =============================================================================
# 8. OPTION 2 — HEDGE ON FORECAST RESIDUALS
# =============================================================================

def run_option2(oos_matrix: dict) -> pd.DataFrame:
    records = []
    for reg in REGIONS:
        d = oos_matrix.get(reg)
        if d is None:
            continue
        rname = REGION_NAMES.get(reg, str(reg))
        y_arr = d["y_oos"]
        aT    = d["actual_T_oos"]
        aR    = d["actual_R_oos"]
        fcT   = d["forecast_T"]
        fcR   = d["forecast_R"]
        cs_T  = d["calib_stats_T"]
        cs_R  = d["calib_stats_R"]

        n   = len(y_arr)
        rev = y_arr * WHEAT_PRICE

        eps_T = aT - fcT
        eps_R = aR - fcR

        corr_T = float(np.corrcoef(y_arr, eps_T)[0, 1]) if np.std(eps_T) > 1e-9 else 0.0
        corr_R = float(np.corrcoef(y_arr, eps_R)[0, 1]) if np.std(eps_R) > 1e-9 else 0.0
        opt_T  = "call" if corr_T < 0 else "put"
        opt_R  = "call" if corr_R < 0 else "put"

        rng     = np.random.default_rng(RANDOM_SEED + reg)
        bi      = rng.integers(0, n, size=N_BOOTSTRAP)
        eps_T_b = eps_T[bi]
        eps_R_b = eps_R[bi]
        rev_b   = y_arr[bi] * WHEAT_PRICE

        pay_T_b = (np.maximum(eps_T_b, 0) if opt_T == "call" else np.maximum(-eps_T_b, 0))
        pay_R_b = (np.maximum(eps_R_b, 0) if opt_R == "call" else np.maximum(-eps_R_b, 0))
        prem_T  = float(np.mean(pay_T_b) / (1 + RISK_FREE_RATE))
        prem_R  = float(np.mean(pay_R_b) / (1 + RISK_FREE_RATE))

        def _z(r_b, p_b):
            cov = np.cov(r_b, p_b)
            vp  = cov[1, 1]
            return max(float(-cov[0, 1] / vp), 0.0) if vp > 1e-12 else 0.0

        z_T = _z(rev_b, pay_T_b)
        z_R = _z(rev_b, pay_R_b)

        pay_T_oos = np.array([max(eps_T[i], 0) if opt_T == "call" else max(-eps_T[i], 0)
                              for i in range(n)])
        pay_R_oos = np.array([max(eps_R[i], 0) if opt_R == "call" else max(-eps_R[i], 0)
                              for i in range(n)])

        # Pelka baseline on OOS for comparison
        pay_raw_T = np.array([oos_payout(aT[i], cs_T["strike"], cs_T["opt"]) for i in range(n)])
        pay_raw_R = np.array([oos_payout(aR[i], cs_R["strike"], cs_R["opt"]) for i in range(n)])
        rev_raw_T   = rev + cs_T["z"] * pay_raw_T - cs_T["z"] * cs_T["premium"]
        rev_raw_R   = rev + cs_R["z"] * pay_raw_R - cs_R["z"] * cs_R["premium"]
        rev_resid_T = rev + z_T * pay_T_oos - z_T * prem_T
        rev_resid_R = rev + z_R * pay_R_oos - z_R * prem_R

        sd_bare = np.std(rev, ddof=1)
        he = lambda rv: (sd_bare - np.std(rv, ddof=1)) / sd_bare * 100 if sd_bare > 0 else 0.0

        records.append({
            "region":           reg,
            "region_name":      rname,
            "HE_always_T":      he(rev_raw_T),
            "HE_always_R":      he(rev_raw_R),
            "HE_resid_T":       he(rev_resid_T),
            "HE_resid_R":       he(rev_resid_R),
            "corr_yield_eps_T": corr_T,
            "corr_yield_eps_R": corr_R,
            "rmse_T":           float(np.sqrt(np.mean(eps_T**2))),
            "rmse_R":           float(np.sqrt(np.mean(eps_R**2))),
        })
    return pd.DataFrame(records)


# =============================================================================
# 9. OPTION 3 — XGB-INFORMED STRIKE SETTING
# =============================================================================

def run_option3(oos_matrix: dict) -> pd.DataFrame:
    records = []
    for reg in REGIONS:
        d = oos_matrix.get(reg)
        if d is None:
            continue
        rname  = REGION_NAMES.get(reg, str(reg))
        y_arr  = d["y_oos"]
        aT     = d["actual_T_oos"]
        aR     = d["actual_R_oos"]
        fcT    = d["forecast_T"]
        fcR    = d["forecast_R"]
        cs_T   = d["calib_stats_T"]
        cs_R   = d["calib_stats_R"]

        n   = len(y_arr)
        rev = y_arr * WHEAT_PRICE

        # OOS forecast errors for premium bootstrapping
        eps_T = aT - fcT
        eps_R = aR - fcR

        # Pelka static baseline
        pay_s_T = np.array([oos_payout(aT[i], cs_T["strike"], cs_T["opt"]) for i in range(n)])
        pay_s_R = np.array([oos_payout(aR[i], cs_R["strike"], cs_R["opt"]) for i in range(n)])
        rev_aT  = rev + cs_T["z"] * pay_s_T - cs_T["z"] * cs_T["premium"]
        rev_aR  = rev + cs_R["z"] * pay_s_R - cs_R["z"] * cs_R["premium"]

        # Adaptive strike = XGB forecast for that year
        rng        = np.random.default_rng(RANDOM_SEED + reg)
        pay_ad_T   = np.zeros(n)
        pay_ad_R   = np.zeros(n)
        prem_ad_T  = np.zeros(n)
        prem_ad_R  = np.zeros(n)

        for i in range(n):
            sT = fcT[i]
            sR = fcR[i]
            pay_ad_T[i] = oos_payout(aT[i], sT, cs_T["opt"])
            pay_ad_R[i] = oos_payout(aR[i], sR, cs_R["opt"])

            # Premium: forecast + bootstrap error
            err_b_T = rng.choice(eps_T, size=N_BOOTSTRAP, replace=True)
            err_b_R = rng.choice(eps_R, size=N_BOOTSTRAP, replace=True)
            sim_T   = sT + err_b_T
            sim_R   = sR + err_b_R

            prem_ad_T[i] = (np.mean(np.maximum(sim_T - sT, 0)) if cs_T["opt"] == "call"
                            else np.mean(np.maximum(sT - sim_T, 0))) / (1 + RISK_FREE_RATE)
            prem_ad_R[i] = (np.mean(np.maximum(sim_R - sR, 0)) if cs_R["opt"] == "call"
                            else np.mean(np.maximum(sR - sim_R, 0))) / (1 + RISK_FREE_RATE)

        rev_adT = rev + cs_T["z"] * pay_ad_T - cs_T["z"] * prem_ad_T
        rev_adR = rev + cs_R["z"] * pay_ad_R - cs_R["z"] * prem_ad_R

        sd_bare = np.std(rev, ddof=1)
        he = lambda rv: (sd_bare - np.std(rv, ddof=1)) / sd_bare * 100 if sd_bare > 0 else 0.0

        records.append({
            "region":              reg,
            "region_name":         rname,
            "HE_always_T":         he(rev_aT),
            "HE_always_R":         he(rev_aR),
            "HE_adap_strike_T":    he(rev_adT),
            "HE_adap_strike_R":    he(rev_adR),
            "mean_prem_static_T":  cs_T["premium"],
            "mean_prem_static_R":  cs_R["premium"],
            "mean_prem_adap_T":    float(np.mean(prem_ad_T)),
            "mean_prem_adap_R":    float(np.mean(prem_ad_R)),
            "mean_strike_static_T": cs_T["strike"],
            "mean_strike_static_R": cs_R["strike"],
            "mean_strike_adap_T":   float(np.mean(fcT)),
            "mean_strike_adap_R":   float(np.mean(fcR)),
        })
    return pd.DataFrame(records)


# =============================================================================
# 10. OPTION 4 — XGB-PRICED PREMIUM
# =============================================================================

def run_option4(oos_matrix: dict) -> pd.DataFrame:
    records = []
    for reg in REGIONS:
        d = oos_matrix.get(reg)
        if d is None:
            continue
        rname = REGION_NAMES.get(reg, str(reg))
        y_arr = d["y_oos"]
        aT    = d["actual_T_oos"]
        aR    = d["actual_R_oos"]
        fcT   = d["forecast_T"]
        fcR   = d["forecast_R"]
        cs_T  = d["calib_stats_T"]
        cs_R  = d["calib_stats_R"]

        n   = len(y_arr)
        rev = y_arr * WHEAT_PRICE

        eps_T = aT - fcT
        eps_R = aR - fcR

        # OOS payouts — same for both (same static strike)
        pay_T = np.array([oos_payout(aT[i], cs_T["strike"], cs_T["opt"]) for i in range(n)])
        pay_R = np.array([oos_payout(aR[i], cs_R["strike"], cs_R["opt"]) for i in range(n)])

        # XGB premium: simulate index as avg forecast + bootstrap error
        rng = np.random.default_rng(RANDOM_SEED + reg)
        avg_fcT = float(np.mean(fcT))
        avg_fcR = float(np.mean(fcR))
        err_b_T = rng.choice(eps_T, size=N_BOOTSTRAP, replace=True)
        err_b_R = rng.choice(eps_R, size=N_BOOTSTRAP, replace=True)
        sim_T   = avg_fcT + err_b_T
        sim_R   = avg_fcR + err_b_R

        p_xgb_T = (np.mean(np.maximum(sim_T - cs_T["strike"], 0)) if cs_T["opt"] == "call"
                   else np.mean(np.maximum(cs_T["strike"] - sim_T, 0))) / (1 + RISK_FREE_RATE)
        p_xgb_R = (np.mean(np.maximum(sim_R - cs_R["strike"], 0)) if cs_R["opt"] == "call"
                   else np.mean(np.maximum(cs_R["strike"] - sim_R, 0))) / (1 + RISK_FREE_RATE)

        rev_pelka_T = rev + cs_T["z"] * pay_T - cs_T["z"] * cs_T["premium"]
        rev_pelka_R = rev + cs_R["z"] * pay_R - cs_R["z"] * cs_R["premium"]
        rev_xgb_T   = rev + cs_T["z"] * pay_T - cs_T["z"] * p_xgb_T
        rev_xgb_R   = rev + cs_R["z"] * pay_R - cs_R["z"] * p_xgb_R

        sd_bare = np.std(rev, ddof=1)
        he = lambda rv: (sd_bare - np.std(rv, ddof=1)) / sd_bare * 100 if sd_bare > 0 else 0.0

        records.append({
            "region":           reg,
            "region_name":      rname,
            "HE_pelka_T":       he(rev_pelka_T),
            "HE_pelka_R":       he(rev_pelka_R),
            "HE_xgb_prem_T":    he(rev_xgb_T),
            "HE_xgb_prem_R":    he(rev_xgb_R),
            "prem_pelka_T":     cs_T["premium"],
            "prem_pelka_R":     cs_R["premium"],
            "prem_xgb_T":       float(p_xgb_T),
            "prem_xgb_R":       float(p_xgb_R),
            "prem_delta_T_pct": (p_xgb_T - cs_T["premium"]) / cs_T["premium"] * 100
                                 if cs_T["premium"] > 0 else 0.0,
            "prem_delta_R_pct": (p_xgb_R - cs_R["premium"]) / cs_R["premium"] * 100
                                 if cs_R["premium"] > 0 else 0.0,
            "rmse_T":           float(np.sqrt(np.mean(eps_T**2))),
            "rmse_R":           float(np.sqrt(np.mean(eps_R**2))),
        })
    return pd.DataFrame(records)


