def doy_noleap(d: pd.Timestamp) -> int:
    doy = d.timetuple().tm_yday
    if d.year % 4 == 0 and (d.year % 100 != 0 or d.year % 400 == 0):
        if d.month > 2:
            doy -= 1
    return max(1, min(365, doy))


def compute_trend_seasonal(t_idx, doy, trend_intercept, trend_slope,
                            fourier_coefs, n_harmonics=N_HARMONICS):
    trend = trend_intercept + trend_slope * t_idx
    cols  = [np.ones(len(np.atleast_1d(doy)))]
    for k in range(1, n_harmonics + 1):
        cols.append(np.sin(2 * np.pi * k * np.atleast_1d(doy) / 365.0))
        cols.append(np.cos(2 * np.pi * k * np.atleast_1d(doy) / 365.0))
    return np.column_stack(cols) @ fourier_coefs + np.atleast_1d(trend)


