def sep(char="=", n=80): print(char * n)

def print_he_table(label: str, df: pd.DataFrame, cols: list, col_labels: list):
    print(f"\n{label}")
    print("-" * 80)
    print(f"{'':35s}" + "".join(f"{l:>11s}" for l in col_labels))
    print("-" * 80)
    for _, row in df.iterrows():
        line = f"{row['region_name']:35s}"
        for c in cols:
            line += f"{row[c]:>10.1f}%"
        print(line)
    print("-" * 80)
    avg_line = f"{'Average':35s}" + "".join(f"{df[c].mean():>10.1f}%" for c in cols)
    print(avg_line)


