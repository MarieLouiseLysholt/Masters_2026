def load_actual_weather(path: str, value_candidates: list) -> pd.DataFrame:
    df = pd.read_csv(path, parse_dates=["date"])
    region_col = next((c for c in df.columns
                       if c.lower() in ("region_code", "region", "reg")), None)
    if region_col is None:
        raise ValueError(f"No region column in {path}. Columns: {df.columns.tolist()}")
    df = df.rename(columns={region_col: "region"})
    df["region"] = pd.to_numeric(df["region"], errors="coerce").astype(int)
    df = df[df["region"].isin(REGIONS)].copy()

    value_col = next((c for c in value_candidates if c in df.columns), None)
    if value_col is None:
        remaining = [c for c in df.columns if c not in ["date", "region"]]
        value_col = remaining[-1]
        print(f"    [WARN] Guessing value column: '{value_col}'")
    df = df.rename(columns={value_col: "value"})
    df["year"]  = df["date"].dt.year
    df["month"] = df["date"].dt.month
    return df[["date", "region", "year", "month", "value"]]


def load_yields_detrended() -> pd.DataFrame:
    df = pd.read_csv(YIELD_PATH)
    year_col   = next(c for c in df.columns if c.lower() in ("year","annee","an","yr"))
    region_col = next(c for c in df.columns if c.lower() in ("region_code","region","reg","nuts2"))
    value_col  = next(c for c in df.columns if c.lower() in ("yield","yield_tha","rendement"))
    out = df[[year_col, region_col, value_col]].copy()
    out.columns = ["year", "region", "raw_yield"]
    out["region"] = pd.to_numeric(out["region"], errors="coerce").astype(int)
    out = out[out["region"].isin(REGIONS)].copy()
    out["yield_tha"] = pd.to_numeric(out["raw_yield"], errors="coerce") / YIELD_UNIT_DIVISOR

    records = []
    for reg in REGIONS:
        sub = out[out["region"] == reg].sort_values("year").copy()
        if len(sub) < 3:
            continue
        slope, _, _, _, _ = stats.linregress(sub["year"], sub["yield_tha"])
        sub["yield_detrended"] = sub["yield_tha"] + slope * (2024 - sub["year"])
        records.append(sub)
    return pd.concat(records, ignore_index=True)[["year", "region", "yield_detrended"]]


def load_best_periods() -> dict:
    """Parse T_period and R_period columns from pelka_table1_tailored.csv."""
    df = pd.read_csv(PELKA_PATH)
    periods = {}
    for _, row in df.iterrows():
        reg = int(row["region"])

        def parse_period(p_str):
            parts = str(p_str).split("--")
            if len(parts) == 1:
                # Try en-dash or hyphen variants
                for sep in ["\u2013", "-"]:
                    if sep in str(p_str):
                        parts = str(p_str).split(sep)
                        break
            sm = int(parts[0].strip())
            em = int(parts[1].strip())
            # Count months with wrap-around
            mths = []
            m = sm
            while True:
                mths.append(m)
                if m == em:
                    break
                m = m % 12 + 1
                if len(mths) > 12:
                    break
            return sm, em, len(mths)

        periods[reg] = {
            "T": parse_period(row["T_period"]),
            "R": parse_period(row["R_period"]),
        }
    return periods


