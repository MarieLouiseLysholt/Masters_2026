"""
Replication of the Index Modelling approach from:
    Schiller, Seidler & Wimmer (2012):
    "Temperature Models for Pricing Weather Derivatives"
    Quantitative Finance, iFirst, September 2010.

Method (Section 3.1 / Eq. 1-2):
    For a contract with measurement period [tau1, tau2] priced for year n+1,
    compute the historical index values Y_1, ..., Y_n from past n years.

    Fit a linear trend:
        Y_i = beta_0 + beta_1 * i + eps_i    (eq. 1)

    Estimate parameters via OLS:
        beta_1 = sum((i - (n+1)/2) * (Y_i - Y_bar)) / sum((i - (n+1)/2)^2)
        beta_0 = Y_bar - (n+1)/2 * beta_1

    Predict next year's index:
        Y_hat_{n+1} = beta_0 + beta_1 * (n+1)

    Variance of prediction error (eq. 2):
        Var(Y_hat_{n+1} - Y_{n+1}) = (n+2)(n+1)(n-2) / (n(n-1)(n-4)) * s^2
        where s^2 = 1/(n-2) * sum((Y_i - Y_hat_i)^2)

Index definitions:
    HDD_t = max(T_ref - T_t, 0)          (Heating Degree Day)
    CDD_t = max(T_t - T_ref, 0)          (Cooling Degree Day)
    HDD / CDD index over [tau1, tau2] = sum of daily values

Reference temperature:
    T_ref = 18.0 C  (European equivalent of 65 F used in the paper)

Data source:
    EDA/region_avg_knn_weighted.csv  --  region_code == 11
    Column: daily_avg_temperature_knn_weighted -> T

Consistency note:
    The saved artefact (index_model.pkl) uses the same keys as alaton_model.pkl
    and ou_levy_model.pkl so that model_comparison.py can load all three uniformly:
        model["df"]           -- full temperature DataFrame with column "T"
        model["region_code"]  -- 11
        model["model_name"]   -- "Index (Schiller 2012)"
"""

import numpy as np
import pandas as pd
from scipy import stats
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import matplotlib.gridspec as gridspec
import warnings
import pickle

warnings.filterwarnings("ignore")
np.random.seed(42)


# Configuration

T_REF       = 10.0   # Reference temperature in Celsius (65 F equivalent)
REGION_CODE = 11     # Same region used in Alaton / Benth replication

# Contract specifications  (Table 3 of the paper, adapted to Celsius / EU context)
# Each entry: (name, index_type, start_month, start_day, end_month, end_day)
CONTRACTS = [
    ("Summer",    "CDD",  5,  1,  9, 30),
    ("May",       "CDD",  5,  1,  5, 31),
    ("June",      "CDD",  6,  1,  6, 30),
    ("July",      "CDD",  7,  1,  7, 31),
    ("August",    "CDD",  8,  1,  8, 31),
    ("September", "CDD",  9,  1,  9, 30),
    ("Winter",    "HDD", 11,  1,  3, 31),
    ("November",  "HDD", 11,  1, 11, 30),
    ("December",  "HDD", 12,  1, 12, 31),
    ("January",   "HDD",  1,  1,  1, 31),
    ("February",  "HDD",  2,  1,  2, 28),
    ("March",     "HDD",  3,  1,  3, 31),
]


# Data loading -- identical pattern to alaton_temperature_model.py / ou_levy_temperature_model.py

raw    = pd.read_csv("EDA/region_avg_knn_weighted.csv", parse_dates=["date"])
df_raw = (raw[raw["region_code"] == REGION_CODE]
            .set_index("date")
            .rename(columns={"daily_avg_temperature_knn_weighted": "T"})
            [["T"]]
            .dropna()
            .sort_index())

print(f"N = {len(df_raw):,} obs  ({df_raw.index[0].date()} to {df_raw.index[-1].date()})")
print(f"T: mean={df_raw['T'].mean():.2f}C  std={df_raw['T'].std():.2f}C  "
      f"range=[{df_raw['T'].min():.1f}, {df_raw['T'].max():.1f}]C")

# Calibration cutoff: summary fits and diagnostics use 2000-2014 only,
# matching the Alaton and Benth calibration windows.
# Note: the Index Model has no globally-fitted parameters so there is no
# look-ahead bias -- this split is for presentation consistency only.
# The comparison script uses rolling history (year < test_year) regardless.
CALIB_END = "2014-12-31"
df_calib  = df_raw.loc[:CALIB_END].copy()
print(f"Calib window: {df_calib.index[0].date()} to {df_calib.index[-1].date()}  "
      f"({len(df_calib):,} obs)")


# Index helpers

def compute_hdd(temps: pd.Series) -> float:
    """Sum of max(T_ref - T_t, 0) over the series."""
    return float(np.maximum(T_REF - temps, 0).sum())


def compute_cdd(temps: pd.Series) -> float:
    """Sum of max(T_t - T_ref, 0) over the series."""
    return float(np.maximum(temps - T_REF, 0).sum())


def compute_index(temps: pd.Series, index_type: str) -> float:
    if index_type == "HDD":
        return compute_hdd(temps)
    elif index_type == "CDD":
        return compute_cdd(temps)
    raise ValueError(f"Unknown index type: {index_type}")


def get_period_temps(df: pd.DataFrame, contract: tuple, year: int) -> pd.Series:
    """
    Return the temperature series for `contract` in `year`.
    Winter contracts (start_month > end_month, e.g. Nov-Mar) span the year
    boundary: start in `year`, end in `year + 1`.
    """
    name, idx_type, sm, sd, em, ed = contract
    start    = pd.Timestamp(year=year, month=sm, day=sd)
    end_year = year + 1 if sm > em else year
    end      = pd.Timestamp(year=end_year, month=em, day=ed)
    mask     = (df.index >= start) & (df.index <= end)
    return df.loc[mask, "T"]


# Core Index Modelling estimation  (eq. 1-2)

def fit_index_model(Y: np.ndarray) -> dict:
    """
    Given n historical index values Y[0..n-1], fit the linear trend model
        Y_i = beta_0 + beta_1 * i   (i = 1, ..., n)
    and produce a forecast for year n+1.
    """
    n     = len(Y)
    i_vec = np.arange(1, n + 1, dtype=float)
    Y_bar = Y.mean()
    i_bar = (n + 1) / 2                           # = mean of i_vec

    num   = np.sum((i_vec - i_bar) * (Y - Y_bar))
    denom = np.sum((i_vec - i_bar) ** 2)
    beta1 = num / denom
    beta0 = Y_bar - i_bar * beta1

    Y_hat = beta0 + beta1 * i_vec
    resid = Y - Y_hat
    s2    = np.sum(resid ** 2) / (n - 2)

    Y_pred = beta0 + beta1 * (n + 1)

    # Prediction variance  (paper eq. 2); requires n >= 5
    if n >= 5:
        pred_var = (n + 2) * (n + 1) * (n - 2) / (n * (n - 1) * (n - 4)) * s2
    else:
        pred_var = np.nan

    pred_std  = np.sqrt(pred_var) if not np.isnan(pred_var) else np.nan
    pred_lo95 = Y_pred - 1.96 * pred_std if not np.isnan(pred_std) else np.nan
    pred_hi95 = Y_pred + 1.96 * pred_std if not np.isnan(pred_std) else np.nan

    return {
        "n": n, "beta0": beta0, "beta1": beta1, "Y_bar": Y_bar,
        "s2": s2, "s": np.sqrt(s2),
        "Y_pred": Y_pred, "pred_var": pred_var, "pred_std": pred_std,
        "pred_lo95": pred_lo95, "pred_hi95": pred_hi95,
        "Y_hist": Y, "Y_hat": Y_hat, "i_vec": i_vec, "resid": resid,
    }


# Compute historical index series for every contract

# Summary fits use calibration window only (2000-2014)
all_years = np.arange(df_calib.index.year.min(), df_calib.index.year.max() + 1)

contract_results = {}

for contract in CONTRACTS:
    name, idx_type, sm, sd, em, ed = contract

    years_used, index_values = [], []

    for yr in all_years:
        series   = get_period_temps(df_calib, contract, yr)
        if len(series) == 0:
            continue
        start    = pd.Timestamp(year=yr, month=sm, day=sd)
        end_yr   = yr + 1 if sm > em else yr
        end      = pd.Timestamp(year=end_yr, month=em, day=ed)
        expected = (end - start).days + 1
        if len(series) < 0.85 * expected:
            continue                               # skip incomplete periods
        years_used.append(yr)
        index_values.append(compute_index(series, idx_type))

    Y_arr  = np.array(index_values)
    yr_arr = np.array(years_used)

    fit         = fit_index_model(Y_arr)
    fit["years"] = yr_arr
    contract_results[name] = {"contract": contract, "fit": fit}

    print(f"\n# {name:12s} ({idx_type})  n={fit['n']} years  ({yr_arr[0]}-{yr_arr[-1]})")
    print(f"  beta0={fit['beta0']:8.3f}  beta1={fit['beta1']:8.4f}  s={fit['s']:.3f}")
    print(f"  Forecast {yr_arr[-1]+1}: {fit['Y_pred']:.1f}  "
          f"95% PI: [{fit['pred_lo95']:.1f}, {fit['pred_hi95']:.1f}]")


# Summary table

print(f"\n# Summary")
print(f"  {'Contract':<12} {'Type':>4}  {'n':>4}  {'beta0':>8}  "
      f"{'beta1':>8}  {'s':>7}  {'Forecast':>9}  {'95% PI':>22}")
print("  " + "-" * 85)
for contract in CONTRACTS:
    name  = contract[0]
    itype = contract[1]
    res   = contract_results[name]["fit"]
    yr    = res["years"]
    pi    = f"[{res['pred_lo95']:7.1f}, {res['pred_hi95']:7.1f}]"
    print(f"  {name:<12} {itype:>4}  {res['n']:>4}  {res['beta0']:>8.2f}  "
          f"{res['beta1']:>8.4f}  {res['s']:>7.2f}  "
          f"{res['Y_pred']:>9.1f}  {pi:>22}  ({yr[0]}-{yr[-1]})")


# Convenience prediction function (used in model_comparison.py)

def predict_index(df: pd.DataFrame,
                  contract: tuple,
                  valuation_year: int,
                  n_history: int = 20) -> dict:
    """
    Predict the index for `valuation_year` using up to `n_history` years of
    complete seasons strictly before `valuation_year`.

    Returns a fit dict (same keys as fit_index_model) or None if < 5 obs.
    """
    name, idx_type, sm, sd, em, ed = contract
    years_used, index_values = [], []

    for yr in range(valuation_year - n_history - 5, valuation_year):
        series   = get_period_temps(df, contract, yr)
        if len(series) == 0:
            continue
        start    = pd.Timestamp(year=yr, month=sm, day=sd)
        end_yr   = yr + 1 if sm > em else yr
        end      = pd.Timestamp(year=end_yr, month=em, day=ed)
        expected = (end - start).days + 1
        if len(series) < 0.85 * expected:
            continue
        years_used.append(yr)
        index_values.append(compute_index(series, idx_type))

    if len(years_used) < 5:
        return None

    years_used   = years_used[-n_history:]
    index_values = index_values[-n_history:]
    fit          = fit_index_model(np.array(index_values))
    fit["years"] = np.array(years_used)
    return fit


# Save model artefact
# Keys mirror alaton_model.pkl and ou_levy_model.pkl for easy comparison loading:
#   model["df"], model["region_code"], model["model_name"]

index_model = {
    "model_name":       "Index (Schiller 2012)",
    "region_code":      REGION_CODE,
    "T_ref":            T_REF,
    "df":               df_raw,       # FULL 2000-2024 for comparison script ground truth
    "contracts":        CONTRACTS,
    "contract_results": contract_results,
    "calib_end":        CALIB_END,
}

with open("index_model.pkl", "wb") as f:
