# Figure 2: Residual diagnostics for Winter and Summer
fig2, axes2 = plt.subplots(2, 3, figsize=(16, 9))

for row, contract_name in enumerate(["Winter", "Summer"]):
    res   = contract_results[contract_name]["fit"]
    e     = res["resid"]
    yr    = res["years"]
    itype = contract_results[contract_name]["contract"][1]

    ax = axes2[row, 0]
    ax.bar(yr, e, color=GRAY, alpha=0.6, width=0.7)
    ax.axhline(0, color="k", lw=0.8, ls="--")
    ax.set_title(f"{contract_name} ({itype}) — Residuals over Time")
    ax.set_ylabel("Residual (°C·days)")
    ax.set_xlabel("Year")

    ax = axes2[row, 1]
    x_grid = np.linspace(e.min() - 0.5 * e.std(), e.max() + 0.5 * e.std(), 300)
    ax.hist(e, bins=max(8, len(e) // 4), density=True,
            color=GRAY, alpha=0.55, label="Empirical")
    ax.plot(x_grid, stats.norm.pdf(x_grid, e.mean(), e.std()),
            color=RED, lw=2, label="Normal fit")
    ax.set_title(f"{contract_name} ({itype}) — Residual Distribution")
    ax.set_xlabel("Residual (°C·days)")
    ax.legend(frameon=False, fontsize=8)

    ax = axes2[row, 2]
    (quantiles, values), (slope, intercept, r) = stats.probplot(e, dist="norm")
    ax.scatter(quantiles, values, color=GRAY, s=20, alpha=0.7, label="Residuals")
    ax.plot(quantiles, slope * np.array(quantiles) + intercept,
            color=RED, lw=2, label=f"Normal (r={r:.3f})")
    ax.set_title(f"{contract_name} ({itype}) — Normal Q-Q Plot")
    ax.set_xlabel("Theoretical quantiles")
    ax.set_ylabel("Sample quantiles")
    ax.legend(frameon=False, fontsize=8)

fig2.suptitle(
    "Index Modelling — Residual Diagnostics (Winter HDD & Summer CDD) | Region 11",
    fontsize=12, fontweight="bold"
)
fig2.tight_layout()
fig2.savefig("index_model_diagnostics.png", bbox_inches="tight", dpi=150)
print("Saved -> index_model_diagnostics.png")

