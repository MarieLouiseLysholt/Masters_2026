"""
Replication of Benth & Saltyte-Benth (2007):
"The Volatility of Temperature and Pricing of Weather Derivatives"
Quantitative Finance, 7:5, 553-561.

ROLLING CALIBRATION VERSION:
    For each region, produces one PKL per calibration end-year:
        benth_models/ou_levy_model_{region}_calib_{year}.pkl

    Calibration window is always expanding from the earliest available data
    (1970) up to the calibration end year. No data after that year is seen.

    PKL naming matches backtest_comparison.py:
        ou_levy_model_{region}_calib_{calib_year}.pkl
        where calib_year = prediction_year - 1

METHODOLOGY (1:1 with Benth & Saltyte-Benth 2007, Section 3):

    Step 1 — Fit s(t) by OLS (eq. 2, I1=0, J1=1):
                s(t) = a + b*t + b1*cos(2π(t-g1)/365)

    Step 2 — Fit AR(1) by plain OLS on residuals X = T - s(t) (p.555):
                T̃(t+1) = α * T̃(t) + σ(t) * ε(t)
                α_hat = Σ X(t-1)*X(t) / Σ X(t-1)²
                No weighting, no martingale estimator, no floor clip.
                Paper reports α = 0.823 for Stockholm.

    Step 3 — Estimate σ²(t) from AR(1) residuals (eq. 3, I2=J2=4):
                σ²(t) = c + Σ ci*sin(2iπt/365) + Σ dj*cos(2jπt/365)
                Fitted by nonlinear least squares on empirical daily variance.

Outputs:
    - benth_models/ou_levy_model_{region}_calib_{year}.pkl
    - ou_levy_model_diagnostics.png   (diagnostic figure, DIAG_YEAR calibration)
    - ou_levy_model_summary.csv       (cross-region parameter table)
    - benth_param_evolution_region{N}.png  (parameter stability per region)
"""

import os
import numpy as np
import pandas as pd
from scipy import stats, optimize
from scipy.stats import chi2, norminvgauss
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import warnings, pickle
warnings.filterwarnings("ignore")

np.random.seed(42)

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

REGIONS = [11, 24, 27, 28, 32, 44, 52, 53]

# Rolling calibration end years.
# calib_year = prediction_year - 1:
#   2014 → predict 2015 ... 2023 → predict 2024
CALIB_YEARS   = range(2014, 2024)
DIAG_YEAR     = 2014     # which calibration window to use for diagnostics figure
MIN_CALIB_OBS = 1000

PKL_FOLDER = "benth_models"
os.makedirs(PKL_FOLDER, exist_ok=True)

BLUE, RED, GRAY = "#2563EB", "#DC2626", "#6B7280"
plt.rcParams.update({"font.size": 8,
                     "axes.spines.top": False,
                     "axes.spines.right": False})

MAX_LAG = 100

# ---------------------------------------------------------------------------
# Load raw data once
# ---------------------------------------------------------------------------

raw = pd.read_csv("EDA/region_avg.csv", parse_dates=["date"])

# ---------------------------------------------------------------------------
# Helper functions
# ---------------------------------------------------------------------------

def remove_feb29(df):
    return df[~((df.index.month == 2) & (df.index.day == 29))].copy()

def doy_no_leap(date_idx):
    doys = []
    for d in date_idx:
        yd      = d.timetuple().tm_yday
        is_leap = (d.year % 4 == 0) and (d.year % 100 != 0 or d.year % 400 == 0)
        if d.month > 2 and is_leap:
            yd -= 1
        doys.append(max(1, min(365, yd)))
    return np.array(doys)

def seasonal_func(t, a, b, b1, g1):
    """s(t) = a + b*t + b1*cos(2π(t-g1)/365)  — eq. 2, I1=0, J1=1."""
    return a + b * t + b1 * np.cos(2 * np.pi * (t - g1) / 365)

def sigma2_fourier(t, c, c1, c2, c3, c4, d1, d2, d3, d4):
    """σ²(t) — eq. 3, I2=J2=4."""
    val = c
    for i, ci in enumerate([c1, c2, c3, c4], start=1):
        val = val + ci * np.sin(2 * i * np.pi * t / 365)
    for j, dj in enumerate([d1, d2, d3, d4], start=1):
        val = val + dj * np.cos(2 * j * np.pi * t / 365)
    return val

def pearson_chi2_normality(data, n_bins=50):
    mu, s  = data.mean(), data.std()
    edges  = stats.norm.ppf(np.linspace(0, 1, n_bins + 1), mu, s)
    edges[0], edges[-1] = -np.inf, np.inf
    obs, _ = np.histogram(data, bins=edges)
    exp    = np.full(n_bins, len(data) / n_bins)
    mask   = exp > 0
    stat   = np.sum((obs[mask] - exp[mask])**2 / exp[mask])
    return float(stat), float(1 - chi2.cdf(stat, mask.sum() - 3))

def estimate_hurst(data, min_bins=10):
    n   = len(data)
    Ks  = np.unique(np.logspace(0.5, np.log10(n // min_bins), 40).astype(int))
    res = []
    for K in Ks:
        N_bins = n // K
        if N_bins < min_bins:
            continue
        Xi  = data[:N_bins * K].reshape(N_bins, K).mean(axis=1)
        f_K = np.sqrt(np.mean(Xi**2))
        if f_K > 0:
            res.append((np.log(K), np.log(f_K)))
    if len(res) < 5:
        return None, None
    log_K, log_f = zip(*res)
    slope, _, r_val, _, _ = stats.linregress(log_K, log_f)
    return 1 + slope, r_val**2

def compute_acf(x, max_lag):
    n, xc = len(x), x - x.mean()
    return np.array([
        np.dot(xc[:n-k], xc[k:]) / np.dot(xc, xc) if k > 0 else 1.0
        for k in range(max_lag + 1)
    ])

# ---------------------------------------------------------------------------
# Core calibration function
# ---------------------------------------------------------------------------

def calibrate_benth(df_raw, calib_end_str):
    """
    Calibrate Benth (2007) model on df_raw up to calib_end_str.
    Expanding window from first observation — no data after calib_end_str seen.
    Returns model dict or None if insufficient data.

    Three-step procedure per paper Section 3:
        1. OLS fit of s(t)
        2. OLS AR(1) for alpha  ← plain regression, no weighting, no clip
        3. Nonlinear LS fit of σ²(t) on empirical daily variance
    """
    df_calib = df_raw.loc[:calib_end_str].copy()
    if len(df_calib) < MIN_CALIB_OBS:
        return None

    T_vals = df_calib["T"].values
    t_vals = df_calib["t"].values

    # ------------------------------------------------------------------
    # Step 1: Fit s(t) by OLS (paper eq. 2, I1=0, J1=1)
    # ------------------------------------------------------------------
    try:
        popt, _ = optimize.curve_fit(
            seasonal_func, t_vals, T_vals,
            p0=[T_vals.mean(), 1e-4, -8.0, 150.0],
            maxfev=50000)
    except RuntimeError:
        popt = np.array([T_vals.mean(), 1e-4, -8.0, 150.0])

    a_est, b_est, b1_est, g1_est = popt
    df_calib["s"] = seasonal_func(t_vals, *popt)
    df_calib["X"] = df_calib["T"] - df_calib["s"]

    # ------------------------------------------------------------------
    # Step 2: Plain OLS AR(1) on X = T - s(t)  (paper p.555)
    #   T̃(t+1) = α * T̃(t) + σ(t)*ε(t)
    #   α_hat = Σ X(t-1)*X(t) / Σ X(t-1)²
    #   No weighting by 1/σ², no martingale estimator, no floor clip.
    # ------------------------------------------------------------------
    X            = df_calib["X"].values
    X_lag, X_cur = X[:-1], X[1:]
    alpha_est    = float(np.dot(X_lag, X_cur) / np.dot(X_lag, X_lag))
    kappa_est    = -np.log(alpha_est)
    half_life    =  np.log(2) / kappa_est if kappa_est > 0 else np.inf
    eps_raw      = X_cur - alpha_est * X_lag

    # ------------------------------------------------------------------
    # Step 3: Fit σ²(t) on empirical daily variance (paper eq. 3, I2=J2=4)
    # ------------------------------------------------------------------
    df_res           = df_calib.iloc[1:].copy()
    df_res["eps"]    = eps_raw
    df_res["eps_sq"] = eps_raw ** 2
    df_res["doy"]    = doy_no_leap(df_res.index)

    doy_idx      = np.arange(1, 366)
    avg_eps2_doy = np.array([
        df_res.loc[df_res["doy"] == d, "eps_sq"].mean()
        if (df_res["doy"] == d).any() else np.nan
        for d in doy_idx])
    avg_eps2_doy = (pd.Series(avg_eps2_doy)
                     .interpolate(method="linear", limit_direction="both").values)

    try:
        popt_s2, _ = optimize.curve_fit(
            sigma2_fourier, doy_idx, avg_eps2_doy,
            p0=[avg_eps2_doy.mean()] + [0.0]*8,
            maxfev=100000)
    except RuntimeError:
        popt_s2 = np.array([avg_eps2_doy.mean()] + [0.0]*8)

    sigma2_doy_fit = np.maximum(sigma2_fourier(doy_idx, *popt_s2), 1e-4)
    sigma_doy      = np.sqrt(sigma2_doy_fit)

    # Standardised residuals e = eps / σ(doy)
    df_res["sigma"] = df_res["doy"].map(dict(zip(doy_idx, sigma_doy)))
    df_res["e"]     = df_res["eps"] / df_res["sigma"]

    # ------------------------------------------------------------------
    # Diagnostics
    # ------------------------------------------------------------------
    e             = df_res["e"].dropna().values
    e_mean, e_std = e.mean(), e.std()
    chi2_stat, chi2_pval = pearson_chi2_normality(e)

    # NIG fit and AIC comparison
    nig_params = norminvgauss.fit(e)
    ll_nig     = np.sum(norminvgauss.logpdf(e, *nig_params))
    ll_norm    = np.sum(stats.norm.logpdf(e, e_mean, e_std))
    aic_nig    = -2*ll_nig  + 2*4
    aic_norm   = -2*ll_norm + 2*2

    H_est, r2_hurst = estimate_hurst(df_calib["X"].values)
    ci_bound  = 1.96 / np.sqrt(len(eps_raw))
    acf_eps2  = compute_acf(eps_raw**2, MAX_LAG)
    acf_e2    = compute_acf(e**2,       MAX_LAG)

    return {
        # Model parameters
        "a": a_est, "b": b_est, "b1": b1_est, "g1": g1_est,
        "a0": a_est, "a1": b1_est, "t0": g1_est,   # backward compat
        "alpha": alpha_est, "k": kappa_est, "half_life": half_life,
        "sigma_doy": sigma_doy, "doy_idx": doy_idx,
        "sigma2_params": popt_s2,
        "nig_params": nig_params,
        "H": H_est, "r2_hurst": r2_hurst,
        # Data — full series stored so backtest can access post-calib actuals
        "df":       df_raw,
        "df_calib": df_calib,
        "df_res":   df_res,
        # Metadata
        "model_name": "Benth (2007)",
        "calib_end":  calib_end_str,
        # Diagnostics (for figures)
        "avg_eps2_doy":   avg_eps2_doy,
        "sigma2_doy_fit": sigma2_doy_fit,
        "e":         e,
        "e_mean":    e_mean,
        "e_std":     e_std,
        "chi2_pval": chi2_pval,
        "aic_norm":  aic_norm,
        "aic_nig":   aic_nig,
        "acf_eps2":  acf_eps2,
        "acf_e2":    acf_e2,
        "ci_bound":  ci_bound,
    }

# ---------------------------------------------------------------------------
# Main loop: region x calibration year
# ---------------------------------------------------------------------------

summary_rows = []
diag_data    = []

for region in REGIONS:
    print(f"\n{'='*60}\n  Region {region}\n{'='*60}")

    df_raw = (raw[raw["region_code"] == region]
                .set_index("date")
                .rename(columns={"daily_avg_temperature": "T"})
                [["T"]]
                .dropna())
    df_raw      = remove_feb29(df_raw)
    df_raw["t"] = np.arange(len(df_raw))   # Benth uses 0-indexed absolute t

    print(f"Full series: N={len(df_raw):,}  "
          f"({df_raw.index[0].date()} — {df_raw.index[-1].date()})")

    for calib_year in CALIB_YEARS:
        calib_end_str = f"{calib_year}-12-31"

        model = calibrate_benth(df_raw, calib_end_str)
        if model is None:
            print(f"  {calib_year}: insufficient data, skipping.")
            continue

        model["region_code"] = region

        pkl_path = os.path.join(
            PKL_FOLDER,
            f"ou_levy_model_{region}_calib_{calib_year}.pkl"
        )
        with open(pkl_path, "wb") as f:
            pickle.dump(model, f)

        sigma_arr = model["sigma_doy"]
        print(f"  {calib_year}: "
              f"N_calib={len(model['df_calib']):,}  "
              f"alpha={model['alpha']:.4f}  "
              f"half-life={model['half_life']:.1f}d  "
              f"trend={model['b']*365*10:.3f} C/dec  "
              f"H={model['H']:.3f}  "
              f"-> {pkl_path}")

        summary_rows.append({
            "region":              region,
            "calib_year":          calib_year,
            "a":                   round(model["a"], 4),
            "b_C_per_decade":      round(model["b"]*365*10, 3),
            "b1":                  round(model["b1"], 3),
            "g1":                  round(model["g1"], 1),
            "alpha":               round(model["alpha"], 4),
            "half_life_days":      round(model["half_life"], 1),
            "sigma_min":           round(sigma_arr.min(), 3),
            "sigma_max":           round(sigma_arr.max(), 3),
            "H":                   round(model["H"], 4) if model["H"] else None,
            "nig_preferred":       model["aic_nig"] < model["aic_norm"],
            "normal_rejected_5pct": model["chi2_pval"] < 0.05,
        })

        if calib_year == DIAG_YEAR:
            diag_data.append({
                "region":         region,
                "doy_idx":        model["doy_idx"],
                "avg_eps2_doy":   model["avg_eps2_doy"],
                "sigma2_doy_fit": model["sigma2_doy_fit"],
                "e":              model["e"],
                "e_mean":         model["e_mean"],
                "e_std":          model["e_std"],
                "nig_params":     model["nig_params"],
                "chi2_pval":      model["chi2_pval"],
                "aic_norm":       model["aic_norm"],
                "aic_nig":        model["aic_nig"],
                "acf_eps2":       model["acf_eps2"],
                "acf_e2":         model["acf_e2"],
                "ci_bound":       model["ci_bound"],
                "a_est":          model["a"],
                "b_est":          model["b"],
                "b1_est":         model["b1"],
                "g1_est":         model["g1"],
                "alpha_est":      model["alpha"],
                "half_life":      model["half_life"],
                "H_est":          model["H"],
            })

# ---------------------------------------------------------------------------
# Summary CSV
# ---------------------------------------------------------------------------

summary = pd.DataFrame(summary_rows).set_index(["region", "calib_year"])
summary.to_csv("ou_levy_model_summary.csv")
print(f"\nSaved -> ou_levy_model_summary.csv")
print(summary.to_string())

# ---------------------------------------------------------------------------
# Diagnostics figure (DIAG_YEAR calibration window)
# Row 0 — σ²(t): empirical vs Fourier fit
# Row 1 — residual distribution (log): Normal vs NIG
# Row 2 — ACF(ε²) before σ(t) correction
# Row 3 — ACF(e²) after  σ(t) correction
# ---------------------------------------------------------------------------

N    = len(diag_data)
lags = np.arange(MAX_LAG + 1)

if N > 0:
    fig, axes = plt.subplots(4, N, figsize=(3.0 * N, 13))
    if N == 1:
        axes = axes.reshape(4, 1)

    fig.suptitle(
        f"Benth (2007) — Calibration Overview Across All Regions "
        f"(full history–{DIAG_YEAR})\n"
        f"α estimated by plain OLS AR(1) per paper Section 3",
        fontsize=11, fontweight="bold", y=1.005
    )

    ROW_LABELS = [
        r"$\sigma^2(t)$ fit",
        "Residual dist (log)",
        r"ACF($\varepsilon^2$) before",
        r"ACF($e^2$) after",
    ]

    for col, d in enumerate(diag_data):
        region = d["region"]

        # Row 0: σ²(t)
        ax = axes[0, col]
        ax.bar(d["doy_idx"], d["avg_eps2_doy"],
               width=1, color=GRAY, alpha=0.4)
        ax.plot(d["doy_idx"], d["sigma2_doy_fit"],
                color=RED, lw=1.5)
        ax.set_title(f"R{region}", fontweight="bold", fontsize=9)
        ax.tick_params(labelsize=6)
        ax.set_xlabel("DOY", fontsize=7)
        if col == 0:
            ax.set_ylabel("°C²", fontsize=8)

        # Row 1: residual distribution (log scale)
        ax     = axes[1, col]
        e      = d["e"]
        x_grid = np.linspace(np.percentile(e, 0.5), np.percentile(e, 99.5), 300)
        ax.hist(e, bins=60, density=True, color=GRAY, alpha=0.4)
        ax.plot(x_grid,
                stats.norm.pdf(x_grid, d["e_mean"], d["e_std"]),
                color=RED, lw=1.4, ls="--", label="Normal")
        ax.plot(x_grid,
                norminvgauss.pdf(x_grid, *d["nig_params"]),
                color=BLUE, lw=1.4, label="NIG")
        ax.set_yscale("log")
        ax.set_ylim(1e-4, 2)
        ax.tick_params(labelsize=6)
        winner = "NIG" if d["aic_nig"] < d["aic_norm"] else "N"
        ax.text(0.97, 0.97,
                f"p={d['chi2_pval']:.3f}\n{winner}✓",
                transform=ax.transAxes, ha="right", va="top", fontsize=6,
                bbox=dict(boxstyle="round,pad=0.2",
                          facecolor="white", alpha=0.8))
        if col == 0:
            ax.set_ylabel("Density (log)", fontsize=8)
            ax.legend(fontsize=5, frameon=False)

        # Row 2: ACF(ε²) before correction
        ax = axes[2, col]
        ax.bar(lags[1:], d["acf_eps2"][1:], width=0.8, color=GRAY)
        ax.axhline( d["ci_bound"], color=RED, ls="--", lw=0.8)
        ax.axhline(-d["ci_bound"], color=RED, ls="--", lw=0.8)
        ax.axhline(0, color="k", lw=0.4)
        ax.tick_params(labelsize=6)
        if col == 0:
            ax.set_ylabel("ACF", fontsize=8)

        # Row 3: ACF(e²) after correction
        ax = axes[3, col]
        ax.bar(lags[1:], d["acf_e2"][1:], width=0.8, color=BLUE)
        ax.axhline( d["ci_bound"], color=RED, ls="--", lw=0.8)
        ax.axhline(-d["ci_bound"], color=RED, ls="--", lw=0.8)
        ax.axhline(0, color="k", lw=0.4)
        ax.set_xlabel("Lag", fontsize=7)
        ax.tick_params(labelsize=6)
        if col == 0:
            ax.set_ylabel("ACF", fontsize=8)

    for row, label in enumerate(ROW_LABELS):
        axes[row, 0].annotate(
            label, xy=(-0.38, 0.5), xycoords="axes fraction",
            fontsize=7, fontweight="bold", rotation=90,
            va="center", ha="center")

    fig.tight_layout()
    fig.savefig("ou_levy_model_diagnostics.png", bbox_inches="tight", dpi=150)
    plt.close(fig)
    print("Saved -> ou_levy_model_diagnostics.png")

# ---------------------------------------------------------------------------
# Parameter evolution plots (one per region)
# ---------------------------------------------------------------------------

for region in REGIONS:
    rows = [r for r in summary_rows if r["region"] == region]
    if not rows:
        continue

    years = [r["calib_year"] for r in rows]
    fig, axes = plt.subplots(2, 3, figsize=(13, 6))
    fig.suptitle(
        f"Region {region} — Benth parameter evolution (expanding window)",
        fontweight="bold"
    )

    for ax, key, label in zip(
        axes.flat,
        ["a", "b_C_per_decade", "b1", "alpha", "sigma_min", "H"],
        ["a (intercept, °C)", "Trend (°C/decade)", "b1 (amplitude, °C)",
         "alpha (AR coefficient)", "sigma min (°C)", "Hurst exponent H"]
    ):
        vals = [r[key] for r in rows]
        ax.plot(years, vals, color=BLUE, lw=1.5, marker="o", ms=4)
        ax.set_title(label, fontsize=9)
        ax.set_xlabel("Calibration end year", fontsize=8)
        ax.tick_params(labelsize=7)

    fig.tight_layout()
    fig.savefig(f"benth_param_evolution_region{region}.png",
                bbox_inches="tight", dpi=150)
    plt.close(fig)
    print(f"Saved -> benth_param_evolution_region{region}.png")

print(f"\nDone.  {len(summary_rows)} PKLs written across "
      f"{len(REGIONS)} regions x {len(list(CALIB_YEARS))} calibration years.")