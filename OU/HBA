"""
Burn Analysis (HBA) from:
    Schiller, Seidler & Wimmer (2012):
    "Temperature Models for Pricing Weather Derivatives"
    Quantitative Finance, iFirst, September 2010.

Method (Section 3.1):
    For a contract with measurement period [tau1, tau2] priced for year n+1,
    compute the historical index values Y_1, ..., Y_n from past n years.

    KEY DISTINCTION vs Index Modelling:
        Index Modelling fits eq. 1 (linear trend) and predicts beta_0 + beta_1*(n+1).
        HBA predicts the plain historical mean -- no trend extrapolation:
            Y_hat_{n+1} = Y_bar = (1/n) * sum(Y_i)

    Variance of prediction error (eq. 2 -- identical formula):
        Var(Y_hat_{n+1} - Y_{n+1}) = (n+2)(n+1)(n-2) / (n(n-1)(n-4)) * s^2
        where s^2 = 1/(n-2) * sum((Y_i - Y_bar)^2)   [residuals around mean, not trend]

Runs over all configured regions. Outputs:
  - hba_models/hba_model_{region}.pkl   (one per region, for model_comparison.py)
  - hba_model_diagnostics.png           (single overview figure across all regions)
  - hba_model_summary.csv               (cross-region parameter table)
"""

import os
import numpy as np
import pandas as pd
from scipy import stats
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import warnings
import pickle

warnings.filterwarnings("ignore")
np.random.seed(42)

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

REGIONS    = [11, 24, 27, 28, 32, 44, 52, 53]
CALIB_END  = "2010-12-31"
PKL_FOLDER = "Outputs/hba_models"
os.makedirs(PKL_FOLDER, exist_ok=True)

T_REF = 18.0

CONTRACTS = [
    ("Summer",    "CDD",  5,  1,  9, 30),
    ("May",       "CDD",  5,  1,  5, 31),
    ("June",      "CDD",  6,  1,  6, 30),
    ("July",      "CDD",  7,  1,  7, 31),
    ("August",    "CDD",  8,  1,  8, 31),
    ("September", "CDD",  9,  1,  9, 30),
    ("Winter",    "HDD", 11,  1,  3, 31),
    ("November",  "HDD", 11,  1, 11, 30),
    ("December",  "HDD", 12,  1, 12, 31),
    ("January",   "HDD",  1,  1,  1, 31),
    ("February",  "HDD",  2,  1,  2, 28),
    ("March",     "HDD",  3,  1,  3, 31),
]

BLUE, RED, GRAY = "#2563EB", "#DC2626", "#6B7280"
plt.rcParams.update({"font.size": 8, "axes.spines.top": False, "axes.spines.right": False})

# ---------------------------------------------------------------------------
# Load raw data once
# ---------------------------------------------------------------------------

raw = pd.read_csv("EDA/region_avg.csv", parse_dates=["date"])

# ---------------------------------------------------------------------------
# Helper functions  (identical to index_model.py except fit_hba below)
# ---------------------------------------------------------------------------

def compute_index(temps, index_type):
    if index_type == "HDD":
        return float(np.maximum(T_REF - temps, 0).sum())
    return float(np.maximum(temps - T_REF, 0).sum())

def get_period_temps(df, contract, year):
    _, idx_type, sm, sd, em, ed = contract
    start    = pd.Timestamp(year=year, month=sm, day=sd)
    end_year = year + 1 if sm > em else year
    end      = pd.Timestamp(year=end_year, month=em, day=ed)
    return df.loc[(df.index >= start) & (df.index <= end), "T"]

def fit_hba(Y):
    """
    Burn Analysis forecast: plain historical mean (no trend).

    KEY DISTINCTION vs fit_index_model:
        Index Modelling: beta1 = OLS slope, Y_pred = beta0 + beta1*(n+1)
        HBA:             Y_pred = Y_bar  (trend ignored)

    s² uses residuals around Y_bar (not a trend line).
    Prediction variance uses the same eq. 2 formula as Index Modelling.
    """
    n     = len(Y)
    i_vec = np.arange(1, n + 1, dtype=float)
    Y_bar = Y.mean()

    # HBA forecast -- plain mean, no trend
    Y_pred = Y_bar

    resid = Y - Y_bar                                  # around mean, not trend
    s2    = np.sum(resid**2) / (n - 2) if n > 2 else np.nan

    # Prediction variance (paper eq. 2); requires n >= 5
    if n >= 5 and not np.isnan(s2):
        pred_var = (n + 2) * (n + 1) * (n - 2) / (n * (n - 1) * (n - 4)) * s2
    else:
        pred_var = np.nan

    pred_std  = np.sqrt(pred_var) if not np.isnan(pred_var) else np.nan
    pred_lo95 = Y_pred - 1.96 * pred_std if not np.isnan(pred_std) else np.nan
    pred_hi95 = Y_pred + 1.96 * pred_std if not np.isnan(pred_std) else np.nan

    # Keep beta keys so model_comparison.py can load uniformly if needed
    return {
        "n": n, "Y_bar": Y_bar,
        "beta0": Y_bar, "beta1": 0.0,      # beta1=0 signals no trend
        "Y_pred": Y_pred, "Y_hat": np.full(n, Y_bar), "i_vec": i_vec,
        "s2": s2, "s": np.sqrt(s2) if not np.isnan(s2) else np.nan,
        "pred_var": pred_var, "pred_std": pred_std,
        "pred_lo95": pred_lo95, "pred_hi95": pred_hi95,
        "Y_hist": Y, "resid": resid,
    }

def predict_index(df, contract, valuation_year, n_history=20):
    """Rolling HBA prediction for model_comparison.py."""
    _, idx_type, sm, sd, em, ed = contract
    years_used, index_values = [], []
    for yr in range(valuation_year - n_history - 5, valuation_year):
        series = get_period_temps(df, contract, yr)
        if len(series) == 0:
            continue
        start    = pd.Timestamp(year=yr, month=sm, day=sd)
        end_yr   = yr + 1 if sm > em else yr
        end      = pd.Timestamp(year=end_yr, month=em, day=ed)
        if len(series) < 0.85 * ((end - start).days + 1):
            continue
        years_used.append(yr)
        index_values.append(compute_index(series, idx_type))
    if len(years_used) < 5:
        return None
    years_used   = years_used[-n_history:]
    index_values = index_values[-n_history:]
    fit          = fit_hba(np.array(index_values))
    fit["years"] = np.array(years_used)
    return fit

# ---------------------------------------------------------------------------
# Per-region calibration loop
# ---------------------------------------------------------------------------

summary_rows = []
diag_data    = []

for region in REGIONS:
    print(f"\n{'='*60}\n  Region {region}\n{'='*60}")

    df_raw = (raw[raw["region_code"] == region]
                .set_index("date")
                .rename(columns={"daily_avg_temperature": "T"})
                [["T"]]
                .dropna()
                .sort_index())
    df_calib  = df_raw.loc[:CALIB_END].copy()
    all_years = np.arange(df_calib.index.year.min(), df_calib.index.year.max() + 1)

    print(f"Full: N={len(df_raw):,}  Calib: N={len(df_calib):,}")
    if len(df_calib) < 1000:
        print(f"  WARNING: insufficient data, skipping.")
        continue

    # ── Fit HBA for each contract ─────────────────────────────────────────────
    contract_results = {}
    for contract in CONTRACTS:
        name, idx_type, sm, sd, em, ed = contract
        years_used, index_values = [], []
        for yr in all_years:
            series = get_period_temps(df_calib, contract, yr)
            if len(series) == 0:
                continue
            start  = pd.Timestamp(year=yr, month=sm, day=sd)
            end_yr = yr + 1 if sm > em else yr
            end    = pd.Timestamp(year=end_yr, month=em, day=ed)
            if len(series) < 0.85 * ((end - start).days + 1):
                continue
            years_used.append(yr)
            index_values.append(compute_index(series, idx_type))
        if len(years_used) < 5:
            continue
        fit          = fit_hba(np.array(index_values))
        fit["years"] = np.array(years_used)
        contract_results[name] = {"contract": contract, "fit": fit}
        print(f"  {name:<12} ({idx_type})  n={fit['n']}  "
              f"Y_bar={fit['Y_bar']:.1f}  s={fit['s']:.2f}  "
              f"95% PI: [{fit['pred_lo95']:.1f}, {fit['pred_hi95']:.1f}]")

    # ── Save pkl ──────────────────────────────────────────────────────────────
    model = {
        "model_name":       "HBA (Schiller 2012)",
        "region_code":      region,
        "T_ref":            T_REF,
        "df":               df_raw,
        "contracts":        CONTRACTS,
        "contract_results": contract_results,
        "calib_end":        CALIB_END,
    }
    pkl_path = os.path.join(PKL_FOLDER, f"hba_model_{region}.pkl")
    with open(pkl_path, "wb") as f:
        pickle.dump(model, f)
    print(f"Saved -> {pkl_path}")

    # ── Collect for overview figure ───────────────────────────────────────────
    diag_data.append({"region": region, "contract_results": contract_results})

    # ── Summary row ───────────────────────────────────────────────────────────
    winter = contract_results.get("Winter", {}).get("fit", {})
    summer = contract_results.get("Summer", {}).get("fit", {})
    summary_rows.append({
        "region":       region,
        "winter_Y_bar": round(winter.get("Y_bar", np.nan), 1),
        "winter_s":     round(winter.get("s",     np.nan), 2),
        "summer_Y_bar": round(summer.get("Y_bar", np.nan), 1),
        "summer_s":     round(summer.get("s",     np.nan), 2),
        "n_contracts":  len(contract_results),
    })

# ---------------------------------------------------------------------------
# Cross-region summary CSV
# ---------------------------------------------------------------------------

summary = pd.DataFrame(summary_rows).set_index("region")
summary.to_csv("hba_model_summary.csv")
print(f"\nSaved -> hba_model_summary.csv")
print(summary.to_string())

# ---------------------------------------------------------------------------
# Single overview figure
# 2 panel rows x N_regions columns:
#   Row 1 — Winter HDD: historical index values + mean forecast + 95% PI
#   Row 2 — Summer CDD: historical index values + mean forecast + 95% PI
# ---------------------------------------------------------------------------

N   = len(diag_data)
fig, axes = plt.subplots(2, N, figsize=(3.0 * N, 8))
fig.suptitle(
    "Burn Analysis (HBA) — Historical Index & Mean Forecast Across All Regions (2000–2014)",
    fontsize=12, fontweight="bold", y=1.005
)

ROW_CONTRACTS = ["Winter", "Summer"]

for col, d in enumerate(diag_data):
    region = d["region"]
    for row, cname in enumerate(ROW_CONTRACTS):
        ax  = axes[row, col]
        res = d["contract_results"].get(cname, {}).get("fit")
        if res is None:
            ax.set_visible(False)
            continue
        yr = res["years"]
        Y  = res["Y_hist"]
        ax.bar(yr, Y, color=GRAY, alpha=0.5, width=0.7)
        ax.axhline(res["Y_bar"],     color=RED,  lw=1.5, ls="--")
        ax.axhline(res["pred_lo95"], color=BLUE, lw=0.8, ls=":")
        ax.axhline(res["pred_hi95"], color=BLUE, lw=0.8, ls=":")
        ax.set_title(f"R{region}", fontweight="bold", fontsize=9)
        ax.tick_params(labelsize=6)
        ax.text(0.97, 0.97,
                f"μ={res['Y_bar']:.0f}\ns={res['s']:.1f}",
                transform=ax.transAxes, ha="right", va="top", fontsize=6,
                bbox=dict(boxstyle="round,pad=0.2", facecolor="white", alpha=0.8))
        if col == 0:
            itype = d["contract_results"][cname]["contract"][1]
            ax.set_ylabel(f"{cname}\n({itype} °C·days)", fontsize=8)

fig.tight_layout()
fig.savefig("hba_model_diagnostics.png", bbox_inches="tight", dpi=150)
plt.close(fig)
print("Saved -> hba_model_diagnostics.png")
print(f"\nDone. Calibrated {len(diag_data)}/{len(REGIONS)} regions.")