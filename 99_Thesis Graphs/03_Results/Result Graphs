def fig6_pooled_histogram(df):
    from scipy.stats import gaussian_kde, wilcoxon, ttest_1samp

    d        = df["delta_rev"].values
    mean_d   = float(np.mean(d))
    median_d = float(np.median(d))
    d_nz     = d[d != 0]

    try:
        _, w_p = wilcoxon(d_nz, alternative="two-sided")
    except Exception:
        w_p = np.nan
    _, t_p = ttest_1samp(d, 0.0)

    fig, ax = plt.subplots(figsize=(7.5, 4.5))
    ax.hist(d, bins=30, color=GREY, edgecolor="black",
            linewidth=0.6, density=True, zorder=2)
    x_grid = np.linspace(d.min() * 1.05, d.max() * 1.05, 400)
    ax.plot(x_grid, gaussian_kde(d)(x_grid), color="black", lw=1.5,
            zorder=3, label="Kernel density")
    ax.axvline(0,        color="black", lw=1.2, ls="--", alpha=0.7,
               label="Zero reference")
    ax.axvline(mean_d,   color="black", lw=1.2, ls="-",  alpha=0.9,
               label=f"Mean = {mean_d:+.2f}")
    ax.axvline(median_d, color="black", lw=1.0, ls=":",  alpha=0.7,
               label=f"Median = {median_d:+.2f}")

    ax.text(0.97, 0.95,
            f"$n$ = {len(d)}\n"
            f"Mean = {mean_d:+.2f} EUR/ha\n"
            f"Median = {median_d:+.2f} EUR/ha\n"
            f"$t$-test: $p$ = {t_p:.3f} {_stars(t_p)}\n"
            f"Wilcoxon: $p$ = {w_p:.3f} {_stars(w_p)}",
            transform=ax.transAxes, ha="right", va="top", fontsize=8.5,
            bbox=dict(boxstyle="round,pad=0.4", facecolor="white",
                      edgecolor="black", linewidth=0.8))
    ax.legend(loc="upper left", fontsize=8.5)
    ax.set_xlabel("$\\Delta Rev$ (EUR/ha)")
    ax.set_ylabel("Density")
    _save(fig, "fig6_pooled_histogram.png")


