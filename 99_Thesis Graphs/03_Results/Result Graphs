def fig8_year_heatmap(df):
    models = [m for m in MODELS if m in df["model"].unique()]
    years  = sorted(df["oos_year"].unique())
    matrix = np.full((len(models), len(years)), np.nan)
    for i, m in enumerate(models):
        for j, y in enumerate(years):
            sub = df[(df["model"] == m) & (df["oos_year"] == y)]
            if len(sub) > 0:
                matrix[i, j] = sub["delta_rev"].mean()

    vmax = np.nanmax(np.abs(matrix))
    fig, ax = plt.subplots(figsize=(8, 4.2))
    im = ax.imshow(matrix, aspect="auto", cmap="RdYlGn", vmin=-vmax, vmax=vmax)
    for i in range(len(models)):
        for j in range(len(years)):
            v = matrix[i, j]
            if not np.isnan(v):
                tc = "black" if abs(v) < vmax * 0.6 else "white"
                ax.text(j, i, f"{v:+.0f}", ha="center", va="center",
                        fontsize=7.5, color=tc)
    cbar = fig.colorbar(im, ax=ax, fraction=0.03, pad=0.02)
    cbar.set_label("Mean $\\Delta Rev$ (EUR/ha)", fontsize=9)
