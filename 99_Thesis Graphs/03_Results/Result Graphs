def tabhe_effectiveness():
    """
    Three minimal tables for hedging effectiveness results:
      - By model   (pooled across 8 regions × 6 years)
      - By region  (pooled across 7 models × 6 years)
      - By year    (pooled across 7 models × 8 regions)
    Columns: Mean ΔRev, Hit rate, HE_sv.
    """
    if not RAW_CSV.exists():
        print(f"  [SKIP] {RAW_CSV.name} not found")
        return
    df = pd.read_csv(RAW_CSV)

    def _stats(grp):
        d    = grp["delta_rev"].values
        hit  = grp["helped"].values
        he_sv_vals = []
        for _, rg in grp.groupby("region"):
            tgt  = float(np.mean(rg["act_rev_u"].values))
            sv_u = float(np.mean(np.minimum(rg["act_rev_u"].values - tgt, 0.0) ** 2))
            sv_h = float(np.mean(np.minimum(rg["act_rev_h"].values - tgt, 0.0) ** 2))
            if sv_u > 1e-8:
                he_sv_vals.append(1 - sv_h / sv_u)
        he_sv = f"{float(np.mean(he_sv_vals))*100:+.1f}%" if he_sv_vals else "-"
        return [
            f"{float(np.mean(d)):+.1f}",
            f"{float(np.mean(hit))*100:.1f}%",
            he_sv,
        ]

    col_labels = [r"Mean $\Delta Rev$ (EUR/ha)", "Hit rate", r"$HE_{sv}$"]
    col_labels_model = [r"Mean $\Delta Rev$ (EUR/ha)", "Wilcoxon $p$",
                        "Hit rate", r"$HE_{sv}$"]

    def _draw_table(ax, rows, cols, note=""):
        n_r = len(rows)
        n_c = len(cols)
        ax.set_axis_off()
        tbl = ax.table(
            cellText=[r[1:] for r in rows],
