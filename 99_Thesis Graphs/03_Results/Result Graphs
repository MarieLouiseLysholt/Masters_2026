            c.visible_edges = "B"

        for i in range(n_r):
            c = tbl[i + 1, -1]
            c.set_facecolor("white")
            c.set_text_props(fontweight="bold")
            c.visible_edges = "open"

        for i in range(n_r):
            for j in range(n_c):
                c = tbl[i + 1, j]
                c.set_facecolor("white")
                c.set_edgecolor("white")
                c.visible_edges = "open"

        ax.plot([0, 1], [0.88, 0.88], color="black", linewidth=1.2,
                transform=ax.transAxes, clip_on=False)
        ax.plot([0, 1], [0.08, 0.08], color="black", linewidth=0.8,
                transform=ax.transAxes, clip_on=False)

        if note:
            ax.text(0.0, 0.02, note, transform=ax.transAxes,
                    fontsize=7.5, va="top")

