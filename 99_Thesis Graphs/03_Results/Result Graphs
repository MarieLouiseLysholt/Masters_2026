def fig_basis_risk():
    """
    Two outputs using the in-sample calibration period (2000-2018) only,
    matching the data on which the yield model and contract were selected.

    fig_basis_risk_bars.png   -- Adjusted R² per region (horizontal bar)
    fig_basis_risk_scatter.png -- Scatter of detrended yield vs accumulated
                                  index per region with fitted quadratic curve

    Adjusted R² formula: 1 - (1 - R²) * (n-1) / (n-k-1)
    Quadratic model has k=2 regressors (I and I²), so df_resid = n-3.
    """
    if not RAW_CSV.exists():
        print(f"  [SKIP] {RAW_CSV.name} not found")
        return

    YIELD_CSV_PATH = ROOT / "EDA" / \
        "ble_tendre_hiver_yield_2000_2024_regions_mainland.csv"
    TEMP_CSV_PATH  = ROOT / "EDA" / "region_avg.csv"

    if not YIELD_CSV_PATH.exists() or not TEMP_CSV_PATH.exists():
        print("  [SKIP] Raw yield or temperature CSV not found")
        return

    CALIB_END = 2024    # full sample
    YIELD_T0  = 2000

    # Load yield
    yld = pd.read_csv(YIELD_CSV_PATH)
    yld.columns = [c.strip().lower() for c in yld.columns]
    rcol = next(c for c in ["reg", "region_code", "region"] if c in yld.columns)
    ycol = next(c for c in ["yield", "yield_t_ha", "rendement"] if c in yld.columns)
    tcol = next(c for c in ["year", "annee"] if c in yld.columns)
    yld  = yld.rename(columns={rcol: "region", ycol: "yield_t_ha", tcol: "year"})
    yld["year"]       = yld["year"].astype(int)
    yld["yield_t_ha"] = yld["yield_t_ha"].astype(float)
    if yld["yield_t_ha"].median() > 20:
        yld["yield_t_ha"] /= 10.0

    # Load temperature
    tmp = pd.read_csv(TEMP_CSV_PATH, parse_dates=["date"])
    tmp.columns = tmp.columns.str.lower().str.strip()
    rcol2 = next(c for c in ["region_code", "region", "reg"] if c in tmp.columns)
    tcol2 = next(c for c in ["daily_avg_temperature", "temp", "temperature"]
                 if c in tmp.columns)
    tmp   = tmp.rename(columns={rcol2: "region", tcol2: "T"})
    tmp   = tmp[~((tmp["date"].dt.month == 2) & (tmp["date"].dt.day == 29))].copy()
    tmp["year"] = tmp["date"].dt.year

    def _doy(ts):
        d = ts.timetuple().tm_yday
        if ts.is_leap_year and ts.month > 2:
            d -= 1
        return d
    tmp["doy"] = tmp["date"].apply(lambda d: _doy(pd.Timestamp(d)))

    def _acc_index(tmp_r, s, e, idx_type, base=10.0):
        win = tmp_r[(tmp_r["doy"] >= s) & (tmp_r["doy"] <= e)].copy()
        if idx_type == "CDD":
            win["idx"] = np.maximum(win["T"] - base, 0.0)
        elif idx_type == "HDD":
            win["idx"] = np.maximum(base - win["T"], 0.0)
        else:
            win["idx"] = win["T"]
        return win.groupby("year")["idx"].sum()

    MONTH_WINDOWS = {
        "Mar": (60, 90), "Apr": (91, 120), "May": (121, 151),
        "Jun": (152, 181), "Jul": (182, 212),
    }
    def _label_to_doy(label):
        parts = label.split("-")
        s = MONTH_WINDOWS[parts[0].strip()][0]
        e = MONTH_WINDOWS[parts[-1].strip()][1]
        return s, e

    df_raw = pd.read_csv(RAW_CSV)
    contract_info = df_raw.groupby("region").agg(
        best_index=("best_index", lambda x: x.mode().iloc[0]),
        win_label=("win_label",   lambda x: x.mode().iloc[0]),
    ).reset_index()

    results = []

    for _, row in contract_info.iterrows():
        region   = int(row["region"])
        idx_type = row["best_index"]
        win_lbl  = row["win_label"]
        try:
            s, e = _label_to_doy(win_lbl)
        except Exception:
            continue

        # Calibration period only
        yld_r = yld[yld["region"] == region][["year", "yield_t_ha"]].dropna()
        yld_r = yld_r[(yld_r["year"] >= 2000) & (yld_r["year"] <= CALIB_END)]
        tmp_r = tmp[tmp["region"] == region]

        if len(yld_r) < 6:
            continue

        # Additive detrend on calibration data
        y_vals = yld_r["yield_t_ha"].values
        t_vals = (yld_r["year"].values - YIELD_T0).astype(float)
        X_tr   = np.column_stack([np.ones(len(y_vals)), t_vals])
        coefs_tr, _, _, _ = np.linalg.lstsq(X_tr, y_vals, rcond=None)
        y_bar     = float(np.mean(y_vals))
        y_detrend = y_vals - X_tr @ coefs_tr + y_bar

        # Accumulated index — calibration years only
        idx_series = _acc_index(tmp_r, s, e, idx_type)
        idx_series = idx_series[(idx_series.index >= 2000) &
                                (idx_series.index <= CALIB_END)]

        merged = pd.DataFrame({
            "year":  yld_r["year"].values,
            "y_det": y_detrend,
        }).merge(idx_series.reset_index().rename(columns={"idx": "index"}),
                 on="year", how="inner").dropna()

        if len(merged) < 5:
            continue

        y = merged["y_det"].values
        I = merged["index"].values
        n = len(y)
        k = 2   # I and I² — two regressors

        # Fit quadratic
        Xq = np.column_stack([np.ones(n), I, I**2])
        c, _, _, _ = np.linalg.lstsq(Xq, y, rcond=None)
        y_hat  = Xq @ c
        ss_res = float(np.sum((y - y_hat)**2))
        ss_tot = float(np.sum((y - np.mean(y))**2))
        r2     = max(0.0, 1 - ss_res / ss_tot) if ss_tot > 0 else 0.0

        # Adjusted R²
        adj_r2 = 1 - (1 - r2) * (n - 1) / (n - k - 1) if n > k + 1 else r2

        results.append({
            "region":      region,
            "region_name": REGION_LABELS.get(region, str(region)),
            "adj_r2":      adj_r2,
            "y_det":       y,
            "index":       I,
            "idx_type":    idx_type,
            "win_lbl":     win_lbl,
            "coefs":       c,
            "n":           n,
        })

    if not results:
        print("  [SKIP] No results computed")
        return

    # ── Fig A: Adjusted R² bar chart ─────────────────────────────────────
    df_r2 = pd.DataFrame([{k: v for k, v in r.items()
                           if k not in ("y_det", "index", "coefs")}
                          for r in results]).sort_values("adj_r2")

    fig1, ax = plt.subplots(figsize=(7, 5))
    bars = ax.barh(df_r2["region_name"], df_r2["adj_r2"],
                   color=GREY, edgecolor="black", linewidth=0.8, height=0.6)
    for bar, v in zip(bars, df_r2["adj_r2"]):
        ax.text(v + 0.003, bar.get_y() + bar.get_height() / 2,
