def fig4_robustness(df):
    """
    Data-driven vs fixed agronomic windows.
    Reads robustness_results.csv if saved by hedging_effectiveness.py.
    Falls back to data-driven only if not available.
    """
    rows = [{
        "label":      "Data-driven\n(45 candidates)",
        "mean_delta": float(df["delta_rev"].mean()),
        "hit_rate":   float(df["helped"].mean()) * 100,
    }]

    if ROB_CSV.exists():
        rob = pd.read_csv(ROB_CSV)
        short = {
            "Fixed Mar-May CDD": "Fixed\nMar–May CDD",
            "Fixed May-Jun CDD": "Fixed\nMay–Jun CDD",
            "Fixed Apr-Jul CDD": "Fixed\nApr–Jul CDD",
        }
        for win, label in short.items():
            sub = rob[rob["window"] == win] if "window" in rob.columns else pd.DataFrame()
            if sub.empty:
                continue
            rows.append({
                "label":      label,
                "mean_delta": float(sub["delta_rev"].mean()),
                "hit_rate":   float(sub["helped"].mean()) * 100,
            })
    else:
        print("  [NOTE] robustness_results.csv not found -- showing data-driven only")

    rob_df = pd.DataFrame(rows)

    fig, axes = plt.subplots(1, 2, figsize=(9, 4.5))
    for ax, (col, ylabel) in zip(axes, [
        ("mean_delta", "$\\Delta Rev$ (EUR/ha)"),
        ("hit_rate",   "Hit rate (%)"),
    ]):
        vals = rob_df[col].values
        bars = ax.bar(rob_df["label"], vals,
                      color=GREY, edgecolor="black", linewidth=0.8, width=0.55)
        for bar, v in zip(bars, vals):
            if v < 0:
                bar.set_hatch("////")
        ax.axhline(0, color="black", lw=1.0, ls="--", alpha=0.6)
        span = max(abs(vals.max()), abs(vals.min())) or 1.0
        for bar, v in zip(bars, vals):
            ax.text(bar.get_x() + bar.get_width() / 2,
                    v + span * 0.03 * (1 if v >= 0 else -1),
                    f"{v:+.2f}" if col == "mean_delta" else f"{v:.1f}%",
                    ha="center", va="bottom" if v >= 0 else "top", fontsize=8.5)
        ax.set_ylabel(ylabel)
        ax.tick_params(axis="x", labelsize=8)

    plt.tight_layout()
    _save(fig, "fig4_robustness.png")


