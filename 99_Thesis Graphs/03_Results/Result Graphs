def tab2_pricing_accuracy():
    """
    Three stripped-down tables:
      - By model    (pooled across regions, years, indices, contracts, horizons)
      - By region   (pooled across models, years, indices, contracts, horizons)
      - By year     (pooled across models, regions, indices, contracts, horizons)
    Each shows: N, Mean bias, MAE, RMSE.
    Completely minimal styling -- top and bottom rules only.
    """
    pr = _load_pricing()
    if pr is None:
        return

    pr = pr.dropna(subset=["pricing_error"])

    def _stats(series):
        e = series.values
        return len(e), float(e.mean()), float(np.abs(e).mean()), float(np.sqrt((e**2).mean()))

    def _make_table(fig, ax, rows, col_labels, row_labels, note):
        n_r = len(rows)
        n_c = len(col_labels)
        ax.set_axis_off()
        tbl = ax.table(
            cellText=rows,
            rowLabels=row_labels,
            colLabels=col_labels,
            loc="center",
            cellLoc="center",
        )
        tbl.auto_set_font_size(False)
        tbl.set_fontsize(9.5)
        tbl.scale(1.0, 1.6)

        for j in range(n_c):
            c = tbl[0, j]
            c.set_facecolor("white")
            c.set_text_props(fontweight="bold")
            c.set_edgecolor("white")
            c.visible_edges = "B"

        for i in range(n_r):
            c = tbl[i + 1, -1]
            c.set_facecolor("white")
            c.set_text_props(fontweight="bold")
            c.visible_edges = "open"
            for j in range(n_c):
                d = tbl[i + 1, j]
                d.set_facecolor("white")
                d.set_edgecolor("white")
                d.visible_edges = "open"

        ax.plot([0, 1], [0.88, 0.88], color="black", linewidth=1.2, transform=ax.transAxes, clip_on=False)
        ax.plot([0, 1], [0.10, 0.10], color="black", linewidth=0.8, transform=ax.transAxes, clip_on=False)
        ax.text(0.0, 0.04, note, transform=ax.transAxes, fontsize=7.5, va="top")

    # ── By model ──────────────────────────────────────────────────────────
    models = [m for m in MODELS if m in pr["model"].unique()]
    rows, rlabels = [], []
    for m in models:
        n, bias, mae, rmse = _stats(pr[pr["model"] == m]["pricing_error"])
        rows.append([str(n), f"{bias:+.1f}", f"{mae:.1f}", f"{rmse:.1f}"])
        rlabels.append(_model_label(m))

    col_labels = ["N", "Bias (EUR)", "MAE (EUR)", "RMSE (EUR)"]
    fig, ax = plt.subplots(figsize=(8, 0.42 * len(models) + 0.9))
    _make_table(fig, ax, rows, col_labels, rlabels,
                "Pooled across 8 regions × 6 years × 3 indices × 2 contracts × 2 horizons. "
                "Bias = mean(model price − realised payoff).")
    _save(fig, "tab2a_pricing_by_model.png")

    # ── By region ─────────────────────────────────────────────────────────
    regions = sorted(pr["region"].unique())
    rows, rlabels = [], []
    for r in regions:
        n, bias, mae, rmse = _stats(pr[pr["region"] == r]["pricing_error"])
        rows.append([str(n), f"{bias:+.1f}", f"{mae:.1f}", f"{rmse:.1f}"])
        rlabels.append(REGION_LABELS.get(r, str(r)))

    fig, ax = plt.subplots(figsize=(8, 0.42 * len(regions) + 0.9))
    _make_table(fig, ax, rows, col_labels, rlabels,
                "Pooled across 7 models × 6 years × 3 indices × 2 contracts × 2 horizons.")
    _save(fig, "tab2b_pricing_by_region.png")

    # ── By year ───────────────────────────────────────────────────────────
    years = sorted(pr["year"].unique())
    rows, rlabels = [], []
    for y in years:
        n, bias, mae, rmse = _stats(pr[pr["year"] == y]["pricing_error"])
