def _stars(p):
    if pd.isna(p): return ""
    if p < 0.01:   return "***"
    if p < 0.05:   return "**"
    if p < 0.10:   return "*"
    return ""


def _save(fig, name):
    if name.startswith(("figp", "tab2", "tabp")):
        path = PRICING_PLOT_DIR / name
    else:
        path = HEDGING_PLOT_DIR / name
    fig.savefig(path, dpi=300, bbox_inches="tight", facecolor="white")
    plt.close(fig)
    print(f"  Saved: {path.parent.name}/{path.name}")


def _strip(ax, pos, values, jitter=0.12, dot_size=18, alpha=0.55):
    """Jittered strip of observations + mean ± 95% CI diamond."""
    n = len(values)
    if n == 0:
        return
    np.random.seed(42)
    x = np.random.uniform(pos - jitter, pos + jitter, size=n)
    ax.scatter(x, values, s=dot_size, color=DOT_COLOR,
               alpha=alpha if n >= 10 else 0.85,
               linewidths=0, zorder=3)
    mean_v = np.mean(values)
    if n >= 5:
        sd = np.std(values, ddof=1)
        ax.plot([pos, pos], [mean_v - sd, mean_v + sd],
                color="#cc0000", lw=2.5, zorder=5, solid_capstyle="butt")
        # Cap ticks at SD endpoints
        cap_w = jitter * 0.6
        ax.plot([pos - cap_w, pos + cap_w], [mean_v - sd, mean_v - sd],
                color="#cc0000", lw=1.8, zorder=5)
        ax.plot([pos - cap_w, pos + cap_w], [mean_v + sd, mean_v + sd],
                color="#cc0000", lw=1.8, zorder=5)
    ax.scatter(pos, mean_v, s=80, color="white",
               marker="D", zorder=6, linewidths=1.2,
               edgecolors="black")


H1_COLOR = "#2563eb"   # blue for H1 (Jan-Mar)
H2_COLOR = "#16a34a"   # green for H2 (Apr-Jun)


def _strip_horizon(ax, pos, values, horizons, jitter=0.12, dot_size=18, alpha=0.60):
    """
    Jittered strip where marker shape AND colour encode horizon:
      H1 -> circle (o), dark grey
      H2 -> triangle (^), mid grey
    Mean ± 1 SD whisker in red on top.
    """
    n = len(values)
    if n == 0:
        return
    np.random.seed(42)
    x = np.random.uniform(pos - jitter, pos + jitter, size=n)

    for marker, mask_val, col in [("o", "H1", H1_COLOR), ("^", "H2", H2_COLOR)]:
        mask = np.array([h == mask_val for h in horizons])
        if mask.any():
            ax.scatter(x[mask], values[mask],
                       s=dot_size, marker=marker, color=col,
                       alpha=alpha if n >= 10 else 0.85,
                       linewidths=0, zorder=3)

    mean_v = np.mean(values)
    if n >= 5:
        sd    = np.std(values, ddof=1)
        cap_w = jitter * 0.6
        ax.plot([pos, pos], [mean_v - sd, mean_v + sd],
                color="#cc0000", lw=2.5, zorder=5, solid_capstyle="butt")
        ax.plot([pos - cap_w, pos + cap_w], [mean_v - sd, mean_v - sd],
                color="#cc0000", lw=1.8, zorder=5)
        ax.plot([pos - cap_w, pos + cap_w], [mean_v + sd, mean_v + sd],
                color="#cc0000", lw=1.8, zorder=5)
    ax.scatter(pos, mean_v, s=80, color="white",
               marker="D", zorder=6, linewidths=1.2, edgecolors="black")


def _strip_axis_horizon(ax, groups, data_list, horizon_list,
                        ylabel, xlabel, zero_line=True, jitter=0.12):
    """Like _strip_axis but passes horizon arrays to _strip_horizon."""
    for i, (vals, horizons) in enumerate(zip(data_list, horizon_list), 1):
        _strip_horizon(ax, i, vals, horizons, jitter=jitter)
    if zero_line:
        ax.axhline(0, color="black", lw=1.0, ls="--", alpha=0.6)
    ax.set_xticks(range(1, len(groups) + 1))
    ax.set_xticklabels(
        groups,
        rotation=30 if max(len(g) for g in groups) > 6 else 0,
        ha="right" if max(len(g) for g in groups) > 6 else "center",
    )
    ax.set_ylabel(ylabel)
    ax.set_xlabel(xlabel)
    from matplotlib.lines import Line2D
    ax.legend(handles=[
        Line2D([0], [0], marker="o", color="w", markerfacecolor=H1_COLOR,
               markersize=5, alpha=0.85, label="H1 (Jan–Mar)"),
        Line2D([0], [0], marker="^", color="w", markerfacecolor=H2_COLOR,
               markersize=5, alpha=0.85, label="H2 (Apr–Jun)"),
        Line2D([0], [0], marker="D", color="#cc0000", markerfacecolor="white",
               markeredgecolor="black", markeredgewidth=1.2,
               markersize=6, label="Mean ± 1 SD"),
    ], loc="upper right", frameon=True, fontsize=8)


def _strip_axis(ax, groups, data_list, ylabel, xlabel,
                zero_line=True, jitter=0.12):
    for i, vals in enumerate(data_list, 1):
        _strip(ax, i, vals, jitter=jitter)
    if zero_line:
        ax.axhline(0, color="black", lw=1.0, ls="--", alpha=0.6)
    ax.set_xticks(range(1, len(groups) + 1))
    ax.set_xticklabels(
        groups,
        rotation=30 if max(len(g) for g in groups) > 6 else 0,
        ha="right" if max(len(g) for g in groups) > 6 else "center",
    )
    ax.set_ylabel(ylabel)
    ax.set_xlabel(xlabel)
    from matplotlib.lines import Line2D
    ax.legend(handles=[
        Line2D([0], [0], marker="o", color="w", markerfacecolor=DOT_COLOR,
               markersize=5, alpha=0.7, label="Observation"),
        Line2D([0], [0], marker="D", color="#cc0000", markerfacecolor="white", markeredgecolor="black", markeredgewidth=1.2,
               markersize=6, label="Mean ± 1 SD"),
    ], loc="upper right", frameon=True, fontsize=8)


