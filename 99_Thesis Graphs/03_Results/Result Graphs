def fig0_contract_selection(df):
    """
    Summary table: for each region, show the contract selected on pre-OOS
    data. Because the contract is fixed per region (not per year), we take
    the mode across models for each region to show the most common selection.
    Also shows mean |Spearman rho| and mean R² across models.
    """
    regions = sorted(df["region"].unique())
    rows    = []

    for r in regions:
        sub = df[df["region"] == r]
        # Mode of index type and window label across all model-year obs
        idx_mode = sub["best_index"].mode().iloc[0]
        win_mode = sub["win_label"].mode().iloc[0]
        instr    = sub["instrument"].mode().iloc[0]
        mean_rho = float(sub["win_corr"].mean())
        mean_r2  = float(sub["yield_r2"].mean())
        rows.append([
            REGION_LABELS.get(r, str(r)),
            idx_mode,
            win_mode,
            instr.capitalize(),
            f"{mean_rho:+.3f}",
            f"{mean_r2:.3f}",
        ])

    col_labels = ["Region", "Index", "Window",
                  "Instrument", r"Spearman $\rho$", r"$R^2$"]
    n_r = len(rows)
    n_c = len(col_labels)

    fig, ax = plt.subplots(figsize=(11, 0.48 * n_r + 1.2))
    ax.set_axis_off()

    tbl = ax.table(
        cellText=[r[1:] for r in rows],
        rowLabels=[r[0] for r in rows],
        colLabels=col_labels[1:],
        loc="center",
        cellLoc="center",
    )
    tbl.auto_set_font_size(False)
    tbl.set_fontsize(9.5)
    tbl.scale(1.0, 1.7)

    for j in range(n_c - 1):
        c = tbl[0, j]
        c.set_facecolor("black")
        c.set_text_props(color="white", fontweight="bold")
        c.set_edgecolor("white")

    for i in range(n_r):
        c = tbl[i + 1, -1]
        c.set_facecolor("#e8e8e8")
        c.set_text_props(fontweight="bold")
        c.set_edgecolor("#aaaaaa")

    for i in range(n_r):
        bg = "white" if i % 2 == 0 else "#f5f5f5"
        for j in range(n_c - 1):
            c = tbl[i + 1, j]
            c.set_facecolor(bg)
            c.set_edgecolor("#cccccc")

    _save(fig, "fig0_contract_selection.png")


