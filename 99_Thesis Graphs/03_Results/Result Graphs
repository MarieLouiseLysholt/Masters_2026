    ax.set_xlabel(r"Adjusted $R^2$ (quadratic yield-temperature model, 2000–2024)")
    ax.set_xlim(0, min(df_r2["adj_r2"].max() * 1.3, 1.0))
    ax.tick_params(axis="y", labelsize=8.5)
    ax.axvline(df_r2["adj_r2"].mean(), color="black", lw=1.0, ls="--", alpha=0.6,
               label=f"Mean adj. $R^2$ = {df_r2['adj_r2'].mean():.3f}")
    ax.legend(fontsize=8.5, loc="lower right")
    plt.tight_layout()
    _save(fig1, "fig_basis_risk_bars.png")

    # ── Fig B: Scatter plots per region ──────────────────────────────────
    n_reg  = len(results)
    ncols  = 4
    nrows  = (n_reg + ncols - 1) // ncols
    fig2, axes = plt.subplots(nrows, ncols,
