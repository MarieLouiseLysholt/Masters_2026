def load_yield(region):
    raw = pd.read_csv(YIELD_CSV)
    raw.columns = [c.strip().lower() for c in raw.columns]
    rcol = next((c for c in ["reg","region_code","region","nuts2","code"]
                 if c in raw.columns), None)
    ycol = next((c for c in ["yield","yield_t_ha","rendement","value"]
                 if c in raw.columns), None)
    tcol = next((c for c in ["year","annee","an"] if c in raw.columns), None)
    if any(x is None for x in [rcol, ycol, tcol]):
        raise ValueError(f"Cannot identify columns. Found: {list(raw.columns)}")
    df = raw[raw[rcol] == region][[tcol, ycol]].copy()
    df.columns = ["year", "yield_raw"]
    df["year"]       = df["year"].astype(int)
    df["yield_t_ha"] = df["yield_raw"].astype(float)
    if df["yield_t_ha"].median() > 20:
        df["yield_t_ha"] /= 10.0
    return df.sort_values("year").reset_index(drop=True)


def load_temperature(region):
    """Load full daily temperature series for one region."""
    raw = pd.read_csv(TEMP_CSV, parse_dates=["date"])
    raw = raw.rename(columns={"daily_avg_temperature": "T"})
    df  = raw[raw["region_code"] == region][["date","T"]].copy()
    df  = df[~((df["date"].dt.month==2)&(df["date"].dt.day==29))].copy()
    df["doy"]  = df["date"].apply(_doy_noleap)
    df["year"] = df["date"].dt.year
    return df.sort_values("date").reset_index(drop=True)


def compute_cdd_by_window(temp_df, start_doy, end_doy):
    """Compute actual cumulative CDD per year for a given DOY window."""
    win = temp_df[(temp_df["doy"] >= start_doy) &
                  (temp_df["doy"] <= end_doy)].copy()
    win["cdd"] = _daily_cdd(win["T"].values)
    return win.groupby("year")["cdd"].sum().rename("cCDD").reset_index()

# ===========================================================================
# PERIOD SELECTION  (Möllmann et al. 2019, Section 2b)
# ===========================================================================

def detrend_yield_log(yield_df):
    """
    Fit ln(Y_t) = a + b·(t − YIELD_T0) + ε_t and return residuals.
    Used for window selection only (no CDD term to avoid circularity).
    """
    df = yield_df.dropna(subset=["yield_t_ha"]).copy()
    df = df[df["yield_t_ha"] > 0]
    y  = np.log(df["yield_t_ha"].values)
    t  = (df["year"].values - YIELD_T0).astype(float)
    X  = np.column_stack([np.ones(len(y)), t])
    coefs, _, _, _ = np.linalg.lstsq(X, y, rcond=None)
    resid = y - X @ coefs
    return pd.Series(resid, index=df["year"].values)


def find_optimal_window(yield_calib, temp_calib):
    """
    Find the month-level window maximising |Spearman(cCDD, detrended_yield)|
    on calibration data.  (Möllmann et al. 2019, Section 2b)

    Searches all 21 start ≤ end combinations within March–August.
    Returns (best_start, best_end, best_label, best_corr).

    Note: selection criterion is correlation-based; evaluation is HE(SV)-based.
    This follows Möllmann et al.'s design and is acknowledged as a stated
    methodological choice in the thesis.
    """
    detrended = detrend_yield_log(yield_calib)

    best_corr  = 0.0
    best_start = MONTH_WINDOWS["May"][0]
    best_end   = MONTH_WINDOWS["Jun"][1]
    best_label = "May–Jun"

    for i, m_start in enumerate(MONTH_ORDER):
        for m_end in MONTH_ORDER[i:]:
            s = MONTH_WINDOWS[m_start][0]
            e = MONTH_WINDOWS[m_end][1]
            cdd_yr = compute_cdd_by_window(temp_calib, s, e)
            merged = (cdd_yr[cdd_yr["year"].isin(detrended.index)]
                      .set_index("year"))
            common = merged.index.intersection(detrended.index)
            if len(common) < 6:
                continue
            rho, _ = spearmanr(detrended.loc[common].values,
                               merged.loc[common, "cCDD"].values)
            if np.isnan(rho):
                continue
            if abs(rho) > abs(best_corr):
                best_corr  = rho
                best_start = s
                best_end   = e
                best_label = (f"{m_start}–{m_end}"
                              if m_start != m_end else m_start)

    return best_start, best_end, best_label, best_corr

# ===========================================================================
# YIELD MODEL  (Zhou et al. 2016 Model 5, with optimal window CDD)
# ===========================================================================

def fit_yield_model(yield_df, cdd_df):
    """
    OLS: ln(Y_t) = a + b·(t − YIELD_T0) + c·cCDD_t² + ε_t

    cdd_df has columns [year, cCDD] for the optimal window.
    """
    merged = pd.merge(yield_df, cdd_df, on="year", how="inner").dropna()
    if len(merged) < 6:
        return None
    y   = np.log(merged["yield_t_ha"].values)
    t   = (merged["year"].values - YIELD_T0).astype(float)
    cdd = merged["cCDD"].values
    X   = np.column_stack([np.ones(len(y)), t, cdd ** 2])
    coefs, _, _, _ = np.linalg.lstsq(X, y, rcond=None)
    resid = y - X @ coefs
    return {
        "a":     float(coefs[0]),
        "b":     float(coefs[1]),
        "c":     float(coefs[2]),
        "resid": resid,
        "r2":    float(1 - np.var(resid) / np.var(y)),
        "n":     len(merged),
    }


def simulate_revenue(yield_model, cdd_sim, oos_year):
    t_val    = float(oos_year - YIELD_T0)
    log_mean = (yield_model["a"]
                + yield_model["b"] * t_val
                + yield_model["c"] * cdd_sim ** 2)
    eps = np.random.choice(yield_model["resid"], size=N_SIM, replace=True)
    return np.exp(log_mean + eps) * WHEAT_PRICE

# ===========================================================================
# HEDGE RATIO OPTIMISATION  (Zhou et al. 2016, fixed K)
# ===========================================================================

def hedged_revenue(rev_sim, payoff_sim, n_contracts, option_price, ttm):
    """
    Hedged terminal revenue.

    Revenue is a terminal-period quantity (received at harvest).
    Premium V is paid at hedge initiation and carried to maturity at r.
    Payoff is received at maturity.

      Profit_t = Revenue_t − N·V·e^(r·TTM) + N·Payoff_t

    This is consistent with Zhou's variance algebra where the carried
    premium is a deterministic cost and drops out of the variance term.
    """
    return (rev_sim
            - n_contracts * option_price * np.exp(R_RATE * ttm)
            + n_contracts * payoff_sim)


def variance_hedge(rev_sim, cdd_sim, strike, ttm, corr):
    """N* = −cov(Revenue, Payoff) / var(Payoff)  [Johnson 1960 / Zhou eq. 3]"""
    V, pay = price_instrument(cdd_sim, strike, ttm, corr)
    var_p  = float(np.var(pay))
    if var_p < 1e-8:
        return 0.0, 0.0, V
    N_star = -float(np.cov(rev_sim, pay)[0, 1]) / var_p
    hedged = hedged_revenue(rev_sim, pay, N_star, V, ttm)
    var_u  = float(np.var(rev_sim))
    HE_var = float(1.0 - np.var(hedged) / var_u) if var_u > 1e-8 else 0.0
    return N_star, HE_var, V


def semivariance_hedge(rev_sim, cdd_sim, strike, ttm, corr):
    """1-D semi-variance minimisation over N (K fixed)."""
    target = float(np.mean(rev_sim))
    svar_u = _semivar(rev_sim, target)
    if svar_u < 1e-8:
        return 0.0, 0.0, 0.0
    V, pay = price_instrument(cdd_sim, strike, ttm, corr)

    def obj(N):
        return _semivar(hedged_revenue(rev_sim, pay, float(N), V, ttm), target)

    result = optimize.minimize_scalar(
        obj, bounds=(-5.0, 5.0), method="bounded",
        options={"xatol": 1e-8, "maxiter": 500},
    )
    # Warn if optimum hits boundary — implies bound may be constraining
    N_star = float(result.x)
    if abs(N_star) > 4.9:
        pass   # boundary hit: N_star may be economically unreliable
    hedged = hedged_revenue(rev_sim, pay, N_star, V, ttm)
    HE_sv  = float(1.0 - _semivar(hedged, target) / svar_u)
    return N_star, HE_sv, V

