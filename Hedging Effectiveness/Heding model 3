# 4.  CONTRACT DESIGN: QR STRIKE AND TICK (FULL PANEL)
# ==============================================================================

def estimate_contract_parameters(
    idx_all: pd.DataFrame,
    yield_df: pd.DataFrame,
    region: str,
    best_window: str,
    tau: float = QUANTILE_TAU,
) -> Dict:
    """
    Strike K and tick via tau-QR on full-panel actual index [CF15].
    K = (Q_tau(yield) - alpha_hat) / beta_hat  [CF15 eq. 4]
    tick = |beta_hat| * price * area            [SH13]
    """
    ac_col = f"{best_window}_act"
    merged = (
        idx_all[idx_all["region"] == region]
        .merge(yield_df[yield_df["region"] == region], on=["region", "year"])
        .dropna(subset=[ac_col, "yield_t_ha"])
    )
    if len(merged) < 5:
        return {"strike_K": np.nan, "beta_qr": np.nan,
                "tick_size": np.nan, "tau": tau, "n_obs": len(merged)}

    X = merged[ac_col].values
    y = merged["yield_t_ha"].values
    res = QuantReg(y, np.column_stack([np.ones(len(X)), X])).fit(
        q=tau, max_iter=2000, vcov="iid")
    a_hat, b_hat = res.params

    K = float(np.clip(
        (np.quantile(y, tau) - a_hat) / b_hat if abs(b_hat) > 1e-9 else np.mean(X),
        X.min(), X.max()
    ))
    return {
        "strike_K":   K,
        "beta_qr":    float(b_hat),
        "tick_size":  float(abs(b_hat) * CROP_PRICE_EUR_T * FARM_AREA_HA),
        "tau":        tau,
        "n_obs":      len(merged),
        "ci_beta_lo": float(res.conf_int()[1, 0]),
        "ci_beta_hi": float(res.conf_int()[1, 1]),
    }


# ==============================================================================
# 5.  OLS FIT FOR SIMULATED JOINT DISTRIBUTION
# ==============================================================================

def fit_ols_yield_index(
    idx_all: pd.DataFrame,
    yield_df: pd.DataFrame,
    region: str,
    best_window: str,
) -> Dict:
    """
    OLS: yield = alpha + beta * index_act + eps  (full panel, n=25).
    Residuals eps are bootstrapped in simulate_joint_distribution() to
    represent yield variance unexplained by temperature [VB04 sec. 4].
    """
    ac_col = f"{best_window}_act"
    merged = (
        idx_all[idx_all["region"] == region]
        .merge(yield_df[yield_df["region"] == region], on=["region", "year"])
        .dropna(subset=[ac_col, "yield_t_ha"])
    )
    X      = merged[ac_col].values
    y      = merged["yield_t_ha"].values
    X2     = np.column_stack([np.ones(len(X)), X])
    betas  = np.linalg.lstsq(X2, y, rcond=None)[0]
    resids = y - X2 @ betas
    return {
        "alpha":     float(betas[0]),
        "beta":      float(betas[1]),
        "residuals": resids,
        "n_obs":     len(merged),
        "r2":        float(1 - resids.var() / y.var()),
    }


