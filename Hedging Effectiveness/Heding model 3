# 11. EVOI
# ==============================================================================

def compute_evoi(
    actual_events: np.ndarray,
    p_hba: float, p_xgb: float,
    L: float, C: float,
    cl_grid: np.ndarray = CL_GRID,
) -> pd.DataFrame:
    """REV across C/L grid: XGBoost vs HBA hedge decisions [MU77; RI00]."""
    base = float(actual_events.mean())
    rows = []
    for cl in cl_grid:
        h_hba = int(p_hba >= cl)
        h_xgb = int(p_xgb >= cl)
        e_hba = -C if h_hba else -L * base
        e_xgb = -C if h_xgb else -L * base
        e_pft = -C * base
        denom = e_hba - e_pft
        rev   = (e_hba - e_xgb) / denom if abs(denom) > 1e-9 else np.nan
        rows.append({"cl_ratio": cl, "REV": rev, "E_hba": e_hba,
                     "E_xgb": e_xgb, "E_perfect": e_pft,
                     "p_hba": p_hba, "p_xgb": p_xgb,
                     "hedge_hba": h_hba, "hedge_xgb": h_xgb})
    return pd.DataFrame(rows)


