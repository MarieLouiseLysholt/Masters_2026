def hba_price(
    hist_idx: np.ndarray,
    strike: float,
    tick: float,
    option_type: str,
    loading: float = HBA_LOADING,
) -> Dict:
    """Historical Burn Analysis fair premium [JB05 ch.3; SH13]."""
    payoffs = (tick * np.maximum(hist_idx - strike, 0) if option_type == "call"
               else tick * np.maximum(strike - hist_idx, 0))
    return {
        "premium_hba": float(payoffs.mean() * (1 + loading)),
        "mean_payoff": float(payoffs.mean()),
        "std_payoff":  float(payoffs.std(ddof=1)),
        "n_years":     len(hist_idx),
    }


# ==============================================================================
# 7.  MONTE CARLO PRICING
# ==============================================================================

def block_bootstrap(
    residuals: np.ndarray, n_days: int, n_sims: int,
    b: int = BLOCK_LENGTH,
    rng: Optional[np.random.Generator] = None,
) -> np.ndarray:
    """Stationary block bootstrap [PR94]. Returns (n_sims, n_days)."""
    if rng is None:
        rng = np.random.default_rng(42)
    n_res = len(residuals)
    out   = np.empty((n_sims, n_days))
    for i in range(n_sims):
        path = []
        while len(path) < n_days:
            start = rng.integers(0, max(1, n_res - b + 1))
            path.extend(residuals[start: start + b].tolist())
        out[i] = path[:n_days]
    return out


def mc_price(
    forecast: np.ndarray,
    residuals: np.ndarray,
    strike: float,
    tick: float,
    option_type: str,
    index_type: str,
    n_sims: int = N_SIMS,
    b: int      = BLOCK_LENGTH,
    rf: float   = RISK_FREE,
    rng: Optional[np.random.Generator] = None,
) -> Dict:
    """
    MC option price: T_sim = T_forecast + eps*  [CD05; BKK26].
    Returns payoffs and idx_sims for downstream HE and EVOI.
    """
    n_days = len(forecast)
    eps    = block_bootstrap(residuals, n_days, n_sims, b, rng)
    T_sim  = forecast[np.newaxis, :] + eps

    if index_type == "HDD":
        idx = np.maximum(T_REF - T_sim, 0).sum(axis=1)
    elif index_type == "CDD":
        idx = np.maximum(T_sim - T_REF, 0).sum(axis=1)
    else:
        idx = T_sim.sum(axis=1)

    payoffs = (tick * np.maximum(idx - strike, 0) if option_type == "call"
               else tick * np.maximum(strike - idx, 0))

    return {
        "premium_mc":  float((1.0 / (1.0 + rf)) * payoffs.mean()),
        "mean_payoff": float(payoffs.mean()),
        "std_payoff":  float(payoffs.std(ddof=1)),
        "payoffs":     payoffs,
        "idx_sims":    idx,
        "n_sims":      n_sims,
    }


# ==============================================================================
# 8.  SIMULATED JOINT DISTRIBUTION
# ==============================================================================

def simulate_joint_distribution(
    idx_sims: np.ndarray,
    ols_alpha: float,
    ols_beta: float,
    ols_residuals: np.ndarray,
    strike: float,
    tick: float,
    option_type: str,
    premium: float,
    n_sims: int = N_SIMS,
    b: int      = BLOCK_LENGTH,
    rng: Optional[np.random.Generator] = None,
) -> Tuple[np.ndarray, np.ndarray]:
    """
    Simulate joint (rev_unhedged, rev_hedged) over 10,000 MC paths [VB04].

    yield_sim = ols_alpha + ols_beta * index_sim + eps*
    eps* drawn by scalar block-bootstrap from OLS yield residuals.
    rev = yield_sim * price * area.
    """
    if rng is None:
        rng = np.random.default_rng(99)
    n_res = len(ols_residuals)
    eps   = np.empty(n_sims)
    for i in range(n_sims):
        start  = rng.integers(0, max(1, n_res - b + 1))
        eps[i] = ols_residuals[start]

    yield_sim = ols_alpha + ols_beta * idx_sims + eps
    rev_u     = yield_sim * CROP_PRICE_EUR_T * FARM_AREA_HA

    payoffs = (tick * np.maximum(idx_sims - strike, 0) if option_type == "call"
               else tick * np.maximum(strike - idx_sims, 0))
    rev_h = rev_u + payoffs - premium

    return rev_u, rev_h


# ==============================================================================
# 9.  HEDGING EFFECTIVENESS: ES (PRIMARY), VaR, SD
# ==============================================================================
# ES SIGN CONVENTION:
#   Revenues are always positive (yield > 0, price > 0, area > 0).
#   Standard ES (negative tail mean) would be negative for positive revenues,
#   making the HE formula incoherent.
#
#   Solution: define ES as the EXPECTED SHORTFALL BELOW MEAN REVENUE.
#     loss = mean(rev) - rev  (positive when revenue is below average)
#     ES   = E[loss | loss >= VaR_alpha(loss)]  > 0 always  [RU00]
#
#   With this definition:
#     - Hedging raises the lower tail -> shortfalls shrink -> ES_h < ES_u
#     - HE_ES = 1 - ES_h / ES_u > 0 (correct direction)  [MOM19]
#
# VaR is defined identically as the alpha-quantile of the shortfall.

def _es(r: np.ndarray, alpha: float = ALPHA) -> float:
    """
    Expected Shortfall of revenue shortfall below mean.
    ES = E[mean(r) - r | mean(r) - r >= VaR_alpha(mean(r) - r)]
    Always positive. Better hedging -> lower ES. [RU00; MOM19]
    """
    loss   = r.mean() - r
    thresh = np.quantile(loss, alpha)
    tail   = loss[loss >= thresh]
    return float(tail.mean()) if len(tail) > 0 else np.nan


def _var(r: np.ndarray, alpha: float = ALPHA) -> float:
    """VaR of revenue shortfall below mean [alpha-quantile of loss]."""
    return float(np.quantile(r.mean() - r, alpha))


def hedging_effectiveness(
    rev_u: np.ndarray,
    rev_h: np.ndarray,
    alpha: float = ALPHA,
) -> Dict:
    """
    Three-metric hedging effectiveness framework [MOM19; VB04; RU00].

    HE_ES  = 1 - ES(hedged)  / ES(unhedged)   PRIMARY  [MOM19; RU00]
    HE_VaR = 1 - VaR(hedged) / VaR(unhedged)  secondary [VB04]
    HE_SD  = 1 - Var(hedged) / Var(unhedged)  secondary [Ederington 1979]

    All defined on shortfall (loss = mean - revenue) so that positive HE
    means risk reduction. Valid for always-positive revenue distributions.
    """
    es_u  = _es(rev_u, alpha);    es_h  = _es(rev_h, alpha)
    var_u = _var(rev_u, alpha);   var_h = _var(rev_h, alpha)
    sd_u  = float(rev_u.std(ddof=1));  sd_h = float(rev_h.std(ddof=1))

    return {
        "HE_ES":         1 - es_h  / es_u  if es_u  > 0 else np.nan,
        "HE_VaR":        1 - var_h / var_u  if var_u > 0 else np.nan,
        "HE_SD":         1 - (sd_h / sd_u)**2 if sd_u > 0 else np.nan,
        "ES_unhedged":   es_u,   "ES_hedged":  es_h,
        "VaR_unhedged":  var_u,  "VaR_hedged": var_h,
        "SD_unhedged":   sd_u,   "SD_hedged":  sd_h,
        "mean_unhedged": float(rev_u.mean()),
        "mean_hedged":   float(rev_h.mean()),
    }


# ==============================================================================
# 10. CARA
# ==============================================================================

def cara_ce(
    revenue: np.ndarray,
    payoffs: np.ndarray,
    lam: float,
) -> Dict:
    """CARA h* and CE revenue [VB04 eq. 8; BAB93]."""
    var_p  = np.var(payoffs, ddof=1)
    cov_rp = np.cov(revenue, payoffs)[0, 1]
    h_star = float(cov_rp / var_p) if var_p > 1e-10 else 0.0
    rev_h  = revenue + h_star * payoffs
    CE_u   = revenue.mean() - (lam / 2) * np.var(revenue, ddof=1)
    CE_h   = rev_h.mean()   - (lam / 2) * np.var(rev_h,   ddof=1)
    return {"h_star": h_star, "CE_unhedged": float(CE_u),
            "CE_hedged": float(CE_h), "CE_gain": float(CE_h - CE_u),
            "lambda": lam}


