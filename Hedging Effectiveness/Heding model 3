def select_best_window(
    idx_all: pd.DataFrame,
    yield_df: pd.DataFrame,
    region: str,
    windows: Dict[str, Tuple[str, int, int]] = CANDIDATE_WINDOWS,
    min_rho: float = MIN_RHO,
    min_days: int = MIN_WINDOW_DAYS,
    min_variance: float = MIN_INDEX_VAR,
    exclude_windows: Optional[List[str]] = None,
) -> Dict:
    """
    Select best (window, index_type) per region via Spearman rho with
    detrended yield over the full historical panel (n=25) [CF15; MOM19].
    Uses _act columns (actual observed temperatures from region_avg.csv).
    exclude_windows: list of window names to skip (used for straddle leg 2).
    """
    exclude_windows = exclude_windows or []
    merged = (
        idx_all[idx_all["region"] == region]
        .merge(yield_df[yield_df["region"] == region], on=["region", "year"])
        .dropna(subset=["yield_t_ha"])
    )

    rho_results = {}
    for wn, (it, d1, d2) in windows.items():
        if wn in exclude_windows:
            continue
        ac, nd = f"{wn}_act", f"{wn}_n_days"
        if ac not in merged.columns:
            continue
        sub = merged[[ac, nd, "yield_t_ha"]].dropna()
        if len(sub) < 5 or sub[nd].mean() < min_days or sub[ac].var() < min_variance:
            continue
        rho, pval = stats.spearmanr(sub[ac], sub["yield_t_ha"])
        rho_results[wn] = {
            "rho": float(rho), "abs_rho": float(abs(rho)),
            "p_value": float(pval), "index_type": it,
            "doy_start": d1, "doy_end": d2, "n_obs": len(sub),
        }

    if not rho_results:
        return {"best_window": None, "index_type": None, "doy_start": None,
                "doy_end": None, "rho": np.nan, "abs_rho": np.nan,
                "p_value": np.nan, "direction": 0, "n_obs": 0, "all_rhos": {}}

    best = max(rho_results, key=lambda k: rho_results[k]["abs_rho"])
    b    = rho_results[best]

    if b["abs_rho"] < min_rho:
        print(f"    [WARN] R{region}: |rho|={b['abs_rho']:.3f} ({best}) "
              f"< {min_rho}")

    all_rhos = {k: round(v["rho"], 3)
                for k, v in sorted(rho_results.items(),
                                   key=lambda x: -x[1]["abs_rho"])}
    return {
        "best_window": best, "index_type": b["index_type"],
        "doy_start": b["doy_start"], "doy_end": b["doy_end"],
        "rho": b["rho"], "abs_rho": b["abs_rho"],
        "p_value": b["p_value"], "direction": int(np.sign(b["rho"])),
        "n_obs": b["n_obs"], "all_rhos": all_rhos,
    }


def select_spring_cdd_window(
    idx_all: pd.DataFrame,
    yield_df: pd.DataFrame,
    region: str,
    windows: Dict[str, Tuple[str, int, int]] = CANDIDATE_WINDOWS,
    min_days: int = MIN_WINDOW_DAYS,
    min_variance: float = MIN_INDEX_VAR,
    exclude_windows: Optional[List[str]] = None,
) -> Dict:
    """
    Select best CDD spring/summer window (doy_start >= 91) for straddle leg 2.
    Excludes the primary window to prevent identical legs.
    Lower min_rho=0.05 since spring CDD signal may be weaker.
    """
    cdd_spring = {k: v for k, v in windows.items()
                  if v[0] == "CDD" and v[1] >= 91}
    return select_best_window(
        idx_all, yield_df, region,
        windows=cdd_spring, min_rho=0.05,
        min_days=min_days, min_variance=min_variance,
        exclude_windows=exclude_windows,
    )


