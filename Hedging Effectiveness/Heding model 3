            ols_alpha=ols["alpha"], ols_beta=ols["beta"],
            ols_residuals=ols["residuals"],
            strike=strike_K, tick=tick,
            option_type=opt_type, premium=premium,
            n_sims=N_SIMS, b=BLOCK_LENGTH, rng=rng2,
        )

        he = hedging_effectiveness(rev_u, rev_h, alpha=ALPHA)
        he["region"]     = region
        he["instrument"] = "single"
        he["ols_r2"]     = ols["r2"]
        he_records.append(he)

        payoffs_sim = (tick * np.maximum(mc["idx_sims"] - strike_K, 0)
                       if opt_type == "call"
                       else tick * np.maximum(strike_K - mc["idx_sims"], 0))
        for lam in LAMBDA_GRID:
            c = cara_ce(rev_u, payoffs_sim, lam)
            c["region"] = region
            cara_records.append(c)

        ce_base = [c["CE_gain"] for c in cara_records
                   if c["region"] == region and c["lambda"] == LAMBDA_BASE][-1]
        print(f"      R{region}: HE_ES={he['HE_ES']:+.3f}  "
              f"HE_VaR={he['HE_VaR']:+.3f}  HE_SD={he['HE_SD']:+.3f}  "
              f"R2={ols['r2']:.3f}  CE_gain(0.001)={ce_base:+,.0f} EUR")

    he_df   = pd.DataFrame(he_records)
    cara_df = pd.DataFrame(cara_records)

    # -- 15.9  EVOI ------------------------------------------------------------
    print("[8/9] EVOI cost-loss analysis [MU77; RI00]...")
    evoi_frames = []
    for _, row in ctr_df.iterrows():
        region   = row["region"]
        opt_type = row["option_type"]
        strike_K = row["strike_K"]
        tick     = row["tick_size"]
        if region not in mc_store:
            continue
        mc       = mc_store[region]
        ac_col   = f"{row['best_window']}_act"
        oos_act  = idx_oos[(idx_oos["region"] == region) &
                           idx_oos["year"].isin(OOS_YEARS)][ac_col].dropna().values
        hist_act = idx_all[idx_all["region"] == region][ac_col].dropna().values

        if opt_type == "call":
            events = (oos_act > strike_K).astype(float)
            p_hba  = float((hist_act > strike_K).mean())
            p_xgb  = float((mc["idx_sims"] > strike_K).mean())
        else:
            events = (oos_act < strike_K).astype(float)
            p_hba  = float((hist_act < strike_K).mean())
            p_xgb  = float((mc["idx_sims"] < strike_K).mean())

        loss_idx = oos_act[events == 1]
        L_val = (float(tick * abs(loss_idx.mean() - strike_K)) if len(loss_idx) > 0
                 else float(tick * abs(oos_act.mean() - strike_K) * 0.5))

        ev = compute_evoi(events, p_hba, p_xgb, L_val, mc["premium_mc"])
        ev["region"] = region
        evoi_frames.append(ev)
        max_rev = ev["REV"].max()
        opt_cl  = ev.loc[ev["REV"].idxmax(), "cl_ratio"]
        print(f"      R{region}: p_HBA={p_hba:.3f}  p_XGB={p_xgb:.3f}  "
              f"maxREV={max_rev:.3f} at C/L={opt_cl:.2f}")

    evoi_df = pd.concat(evoi_frames, ignore_index=True)

    # -- 15.10  Straddle -------------------------------------------------------
    print("[9/9] Two-index straddle [STU16; PRE24]...")
    straddle_records = []
    straddle_he_list = []

    for region in REGIONS:
        r_xgb     = xgb_df[xgb_df["region"] == region]
        residuals  = r_xgb["residual"].dropna().values
        price_yr   = max(OOS_YEARS)

        row_match = ctr_df[ctr_df["region"] == region]
        if row_match.empty or region not in mc_store:
            continue
        row     = row_match.iloc[0]
        mc_leg1 = mc_store[region]
        primary = row["best_window"]

        # Leg 2: best spring CDD, EXCLUDING the primary window to avoid
        # identical legs (fixes R32 which had CDD_MayJun in both legs)
        spring_sel = select_spring_cdd_window(
            idx_all, yield_df, region,
            exclude_windows=[primary],
        )
        if spring_sel["best_window"] is None:
            print(f"      [WARN] R{region}: no valid spring CDD -- skipping.")
            continue

        bwin2  = spring_sel["best_window"]
        d1_2   = spring_sel["doy_start"]
        d2_2   = spring_sel["doy_end"]
        idx_t2 = spring_sel["index_type"]

        ac_col2  = f"{bwin2}_act"
        cdd_hist = idx_all[idx_all["region"] == region][ac_col2].dropna().values
        k2       = float(np.quantile(cdd_hist, 1 - QUANTILE_TAU))
        tick2    = row["tick_size"]

        mask2 = ((r_xgb["year"] == price_yr) &
                 (r_xgb["doy"]  >= d1_2) & (r_xgb["doy"] <= d2_2))
        fc2   = r_xgb[mask2]["T_forecast"].values

        if len(fc2) < 5:
            print(f"      [WARN] R{region}: insufficient spring data.")
            continue

        mc_leg2  = mc_price(fc2, residuals, k2, tick2, "call", idx_t2,
                            N_SIMS, BLOCK_LENGTH, RISK_FREE, rng)
        straddle = price_straddle(mc_leg1, mc_leg2)
        straddle.update({
            "region": region, "window_l1": primary, "window_l2": bwin2,
            "K_leg1": row["strike_K"], "K_leg2": k2,
        })
        straddle_records.append({
            k: v for k, v in straddle.items()
            if k not in ("total_payoffs", "idx_sims_leg1", "idx_sims_leg2")
        })

        # Straddle HE via simulated joint distribution
        if region in ols_store:
            ols = ols_store[region]
            rev_u_st, _ = simulate_joint_distribution(
                idx_sims=mc_leg1["idx_sims"],
                ols_alpha=ols["alpha"], ols_beta=ols["beta"],
                ols_residuals=ols["residuals"],
                strike=row["strike_K"], tick=row["tick_size"],
                option_type=row["option_type"], premium=0.0,
                n_sims=N_SIMS, b=BLOCK_LENGTH, rng=rng3,
            )
            pay1 = (row["tick_size"] *
                    (np.maximum(mc_leg1["idx_sims"] - row["strike_K"], 0)
                     if row["option_type"] == "call"
                     else np.maximum(row["strike_K"] - mc_leg1["idx_sims"], 0)))
            pay2 = tick2 * np.maximum(mc_leg2["idx_sims"] - k2, 0)
            rev_h_st = rev_u_st + pay1 + pay2 - straddle["premium_straddle"]
            he_st = hedging_effectiveness(rev_u_st, rev_h_st, alpha=ALPHA)
            he_st["region"]     = region
            he_st["instrument"] = "straddle"
            he_st["ols_r2"]     = ols["r2"]
            straddle_he_list.append(he_st)

        print(f"      R{region}: total={straddle['premium_straddle']:>10,.0f}  "
              f"leg1={straddle['premium_leg1']:,.0f}[{primary}]  "
              f"leg2={straddle['premium_leg2']:,.0f}[{bwin2}]")

    straddle_df    = pd.DataFrame(straddle_records)
    straddle_he_df = pd.DataFrame(straddle_he_list)
    if not straddle_he_df.empty:
        he_df = pd.concat([he_df, straddle_he_df], ignore_index=True)

    # -- Export ----------------------------------------------------------------
    print("\n[Export] Writing CSV results...")
    rho_rows = []
    for rec in sel_records:
        for rank, (win, rho) in enumerate(rec["all_rhos"].items(), start=1):
            if rank > 5:
                break
            rho_rows.append({"region": rec["region"], "rank": rank,
                              "window": win, "rho": rho})

    export_tables = {
        "1_window_selection":      sel_df,
        "2_spearman_top5":         pd.DataFrame(rho_rows),
        "3_contract_design":       ctr_df,
        "4_hba_pricing":           hba_df,
        "5_mc_pricing": pd.DataFrame([
            {"region": r, "premium_mc": mc["premium_mc"],
             "mean_payoff": mc["mean_payoff"], "std_payoff": mc["std_payoff"]}
            for r, mc in mc_store.items()
        ]),
        "6_hedging_effectiveness": he_df,
        "7_cara_sensitivity":      cara_df,
        "8_straddle":              straddle_df,
    }
    for sheet, df in export_tables.items():
        p = OUT_DIR / f"{sheet}.csv"
        df.round(4).to_csv(p, index=False)
        print(f"    {p.name}")
    evoi_df.to_csv(OUT_DIR / "evoi_cost_loss.csv", index=False)
    print(f"    evoi_cost_loss.csv")

    # -- Plots -----------------------------------------------------------------
    print("[Plots] Generating figures...")
    plot_rev_curves(evoi_df, OUT_DIR / "evoi_rev_curves.png")
    plot_window_selection(sel_records, OUT_DIR / "window_selection.png")
    plot_he_comparison(he_df, OUT_DIR / "he_comparison.png")
    plot_cara_sensitivity(cara_df, OUT_DIR / "cara_sensitivity.png")

    # -- Terminal summary ------------------------------------------------------
    print_results_summary(
        sel_df, ctr_df, hba_df, mc_store,
        he_df, cara_df, evoi_df, straddle_df
    )

    print("=" * 72)
    print("  PHASE 2 COMPLETE")
    print(f"  Outputs: {OUT_DIR}")
    print("=" * 72)

    return {
        "selection": sel_df, "contracts": ctr_df, "hba": hba_df,
        "mc": {r: {k: v for k, v in mc.items()
                   if k not in ("payoffs", "idx_sims")}
               for r, mc in mc_store.items()},
        "he": he_df, "cara": cara_df, "evoi": evoi_df, "straddle": straddle_df,
    }


