def load_temperature(path: Path) -> pd.DataFrame:
    """
    Load daily actual temperatures from region_avg.csv.
    Columns: date, region_code, daily_avg_temperature
    Used for full-panel index computation (Spearman + QR, n=25).
    """
    df = pd.read_csv(path, parse_dates=["date"])
    df = df.rename(columns={"region_code": "region",
                             "daily_avg_temperature": "T_mean"})
    df["region"] = df["region"].astype(str)
    df["year"]   = df["date"].dt.year
    df["doy"]    = df["date"].dt.dayofyear
    print(f"      Temperature: {len(df):,} rows | "
          f"years {df['year'].min()}-{df['year'].max()}")
    return df


def load_yield(path: Path) -> pd.DataFrame:
    """
    Load AGRESTE annual yield. Columns: year, reg, prod, surf, yield, source.
    yield in quintaux/ha -> divided by 10 -> t/ha.
    Linear OLS detrend per region [VB04 sec. 3.1].
    """
    df = pd.read_csv(path)
    df = df.rename(columns={"reg": "region"})
    df["region"]   = df["region"].astype(str)
    df["yield_t_ha"] = df["yield"] / 10.0

    parts = []
    for region, grp in df.groupby("region"):
        grp = grp.sort_values("year").copy()
        if len(grp) < 3:
            parts.append(grp)
            continue
        x = grp["year"].values.astype(float)
        y = grp["yield_t_ha"].values
        trend = np.polyval(np.polyfit(x, y, 1), x)
        grp["yield_t_ha"] = y - trend + y.mean()
        parts.append(grp)

    out = pd.concat(parts, ignore_index=True)[["year", "region", "yield_t_ha"]]
    print(f"      Yield: {len(out)} rows | "
          f"years {out['year'].min()}-{out['year'].max()} | "
          f"mean {out['yield_t_ha'].mean():.2f} t/ha")
    return out


def load_xgb_forecasts(path: Path, model_name: str = "XGB") -> pd.DataFrame:
    """
    Load XGB OOS forecasts from bk_forecasts.csv.
    Columns: region, year, date, actual, model, forecast.
    Filters to model_name. Computes residual = actual - forecast.
    """
    df = pd.read_csv(path, parse_dates=["date"])
    avail = df["model"].unique().tolist()
    if model_name not in avail:
        raise ValueError(f"'{model_name}' not in {avail}")
    df = df[df["model"] == model_name].copy()
    df = df.rename(columns={"actual": "T_actual", "forecast": "T_forecast"})
    df["year"]     = df["date"].dt.year
    df["doy"]      = df["date"].dt.dayofyear
    df["region"]   = df["region"].astype(str)
    df["residual"] = df["T_actual"] - df["T_forecast"]
    print(f"      XGB forecasts: {len(df):,} rows | "
          f"years {df['year'].min()}-{df['year'].max()}")
    return df


# ==============================================================================
# 2.  INDEX COMPUTATION
# ==============================================================================
# HDD = sum max(T_REF - T, 0)  [OS05]
# CDD = sum max(T - T_REF, 0)  [OS05]
# CAT = sum T over window       [JB05]

def _accumulate(series: np.ndarray, idx_type: str) -> float:
    if idx_type == "HDD":
        return float(np.maximum(T_REF - series, 0).sum())
    elif idx_type == "CDD":
        return float(np.maximum(series - T_REF, 0).sum())
    return float(series.sum())


def compute_indices_from_actual(
    temp_df: pd.DataFrame,
    regions: List[str],
    years: List[int],
    windows: Dict[str, Tuple[str, int, int]] = CANDIDATE_WINDOWS,
) -> pd.DataFrame:
    """
    Compute all candidate indices from actual observed temperatures.
    Column naming: <win>_act, <win>_n_days.
    Used for: Spearman selection (n=25), QR design, HBA pricing.
    """
    records = []
    for region in regions:
        r = temp_df[temp_df["region"] == region].sort_values("date")
        for year in years:
            yr = r[r["year"] == year]
            if yr.empty:
                continue
            row = {"region": region, "year": year}
            for wn, (it, d1, d2) in windows.items():
                seg = yr[(yr["doy"] >= d1) & (yr["doy"] <= d2)]
                row[f"{wn}_act"]    = _accumulate(seg["T_mean"].values, it) if not seg.empty else np.nan
                row[f"{wn}_n_days"] = len(seg)
            records.append(row)
    return pd.DataFrame(records)


def compute_indices_from_forecasts(
    xgb_df: pd.DataFrame,
    regions: List[str],
    years: List[int],
    windows: Dict[str, Tuple[str, int, int]] = CANDIDATE_WINDOWS,
) -> pd.DataFrame:
    """
    Compute candidate indices from XGBoost OOS forecasts.
    Columns: <win>_fc (from T_forecast), <win>_act (from T_actual).
    Used for: MC pricing (via _fc) and EVOI event flags (via _act).
    """
    records = []
    for region in regions:
        r = xgb_df[xgb_df["region"] == region].sort_values("date")
        for year in years:
            yr = r[r["year"] == year]
            if yr.empty:
                continue
            row = {"region": region, "year": year}
            for wn, (it, d1, d2) in windows.items():
                seg = yr[(yr["doy"] >= d1) & (yr["doy"] <= d2)]
                if seg.empty:
                    row[f"{wn}_fc"]     = np.nan
                    row[f"{wn}_act"]    = np.nan
                    row[f"{wn}_n_days"] = 0
                else:
                    row[f"{wn}_fc"]     = _accumulate(seg["T_forecast"].values, it)
                    row[f"{wn}_act"]    = _accumulate(seg["T_actual"].values,   it)
                    row[f"{wn}_n_days"] = len(seg)
            records.append(row)
    return pd.DataFrame(records)


