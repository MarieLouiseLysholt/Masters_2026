def build_candidate_windows() -> Dict[str, Tuple[str, int, int]]:
    """Generate single-month and contiguous multi-month windows."""
    windows: Dict[str, Tuple[str, int, int]] = {}
    for idx_type, months in INDEX_MONTHS.items():
        for start in range(len(months)):
            for end in range(start, len(months)):
                month_slice = months[start:end + 1]
                label = "".join(month_slice)
                doy_start = MONTH_DAY_RANGES[month_slice[0]][0]
                doy_end = MONTH_DAY_RANGES[month_slice[-1]][1]
                windows[f"{idx_type}_{label}"] = (idx_type, doy_start, doy_end)
    return windows


