def _doy_noleap(date):
    doy = date.timetuple().tm_yday
    if date.year % 4 == 0 and (date.year % 100 != 0 or date.year % 400 == 0):
        if date.month > 2:
            doy -= 1
    return max(1, min(365, doy))

def _daily_cdd(T):
    return np.maximum(0.0, T - BASE_TEMP)

def _cumulative_cdd(T):
    return float(_daily_cdd(np.asarray(T, dtype=float)).sum())

def _semivar(x, target=None):
    tgt = float(np.mean(x)) if target is None else target
    return float(np.mean(np.minimum(x - tgt, 0.0) ** 2))

def _var_risk(x, alpha, target=None):
    """VaR_α = E[R] − q_α(R)  (downside deviation from mean)."""
    tgt = float(np.mean(x)) if target is None else target
    return float(tgt - np.quantile(x, alpha))

def _es_risk(x, alpha, target=None):
    """ES_α = E[R] − E[R | R ≤ q_α(R)]  (expected shortfall)."""
    tgt       = float(np.mean(x)) if target is None else target
    threshold = float(np.quantile(x, alpha))
    tail      = x[x <= threshold]
    return float(tgt - np.mean(tail)) if len(tail) > 0 else 0.0

def compute_he_metrics(rev_sim, hedged_rev):
    """
    Compute hedging effectiveness for six risk measures.
    All use the same hedged revenue vector (N* optimised for HE(SV)).

    All six metrics use the unhedged mean as the fixed reference target:
      risk_metric = f(portfolio, target=E[R_unhedged])

    This is consistent across metrics — they all ask:
    "How much does the portfolio fall below what you'd expect without hedging?"
    HE = 1 − risk(hedged) / risk(unhedged) measures the shift from no-hedge
    to hedge relative to the same benchmark for both portfolios.

    Returns dict with keys: HE_sd, HE_var5, HE_var10, HE_es5, HE_es10, HE_sv
    """
    mean_u = float(np.mean(rev_sim))   # fixed reference for all metrics
    out    = {}

    # SD — ratio of standard deviations (no mean reference needed)
    std_u = float(np.std(rev_sim))
    out["HE_sd"] = float(1 - np.std(hedged_rev) / std_u) if std_u > 1e-8 else 0.0

    # VaR_α = E[R_u] − q_α(portfolio)  — quantile shortfall from unhedged mean
    # ES_α  = E[R_u] − E[portfolio | portfolio ≤ q_α(portfolio)]
    for alpha, tag in [(0.05, "5"), (0.10, "10")]:
        var_u = _var_risk(rev_sim,    alpha, mean_u)
        var_h = _var_risk(hedged_rev, alpha, mean_u)
        out[f"HE_var{tag}"] = float(1 - var_h / var_u) if var_u > 1e-8 else 0.0

        es_u = _es_risk(rev_sim,    alpha, mean_u)
        es_h = _es_risk(hedged_rev, alpha, mean_u)
        out[f"HE_es{tag}"] = float(1 - es_h / es_u) if es_u > 1e-8 else 0.0

    # SV — same fixed target, consistent with Zhou et al. (2016) Section 6.4
    sv_u = _semivar(rev_sim,    mean_u)
    sv_h = _semivar(hedged_rev, mean_u)
    out["HE_sv"] = float(1 - sv_h / sv_u) if sv_u > 1e-8 else 0.0

    return out

