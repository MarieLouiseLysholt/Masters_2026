                for _, grp in resid_pool.groupby(resid_pool["date"].dt.year)
                if len(grp["residual"].dropna()) >= BLOCK_L
            ]
            if not resid_by_year:
                # Fallback: pool all window residuals from non-OOS years
                flat = resid_pool["residual"].dropna().values
                if len(flat) >= BLOCK_L * 3:
                    resid_by_year = [flat]
                else:
                    # Widen to all DOYs
                    flat2 = (mod_all[mod_all["date"].dt.year != oos_year]
                             ["residual"].dropna().values)
                    if len(flat2) < BLOCK_L * 3:
                        continue
                    resid_by_year = [flat2]

            # Simulate CDD and revenue
            cdd_sim = simulate_cdd_paths(fcst_vec, resid_by_year)
            rev_sim = simulate_revenue(ym, cdd_sim, oos_year)

            # Variance hedge
            try:
                N_var, HE_var, V_var = variance_hedge(rev_sim, cdd_sim, K, TTM, best_corr)
            except Exception:
                N_var = HE_var = V_var = np.nan

            # Semi-variance hedge + all risk metrics
            try:
                N_sv, HE_sv, V_sv = semivariance_hedge(rev_sim, cdd_sim, K, TTM, best_corr)
                _, pay_sv  = price_instrument(cdd_sim, K, TTM, best_corr)
                hedged_rev = hedged_revenue(rev_sim, pay_sv, N_sv, V_sv, TTM)
                he         = compute_he_metrics(rev_sim, hedged_rev)
            except Exception:
                N_sv = HE_sv = V_sv = np.nan
                he   = {k: np.nan for k in
                        ["HE_sd","HE_var5","HE_var10",
                         "HE_es5","HE_es10","HE_sv"]}

            def _r(v, d=4):
                return round(float(v), d) if not np.isnan(float(v)) else np.nan

            all_rows.append({
                "region":      region,
                "oos_year":    oos_year,
                "model":       mname,
                # Optimal window
                "win_label":   best_label,
                "win_start":   best_start,
