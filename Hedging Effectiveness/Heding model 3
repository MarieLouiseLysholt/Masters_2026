# PRICING ENGINE  (identical to pricing_comparison.py)
# ===========================================================================

def _block_bootstrap(resid_by_year, n_sim, n_days):
    """
    Block bootstrap that samples contiguous blocks strictly within each year,
    preventing artificial dependence at year join points.

    resid_by_year: list of 1-D arrays, one per calibration year.
    Each array contains the within-window residuals for that year ordered
    by DOY.  Blocks are sampled within a randomly chosen year, then
    concatenated across years to fill n_days.
    """
    years = [r for r in resid_by_year if len(r) >= BLOCK_L]
    if not years:
        # Fallback: pool all residuals (old behaviour, flagged in comments)
        pool = np.concatenate(resid_by_year)
        pad  = np.concatenate([pool, pool[:BLOCK_L]])
        n_r  = len(pool)
        nb   = int(np.ceil(n_days / BLOCK_L))
        st   = np.random.randint(0, n_r, size=(n_sim, nb))
        eps  = np.empty((n_sim, nb * BLOCK_L))
        for b in range(nb):
            for s in range(n_sim):
                eps[s, b*BLOCK_L:(b+1)*BLOCK_L] = pad[st[s,b]: st[s,b]+BLOCK_L]
        return eps[:, :n_days]

    nb  = int(np.ceil(n_days / BLOCK_L))
    eps = np.empty((n_sim, nb * BLOCK_L))
    for b in range(nb):
        for s in range(n_sim):
            # Draw a random year, then a random block start within that year
            yr  = years[np.random.randint(len(years))]
            n_r = len(yr)
            # Maximum valid start: leave room for a full block
            st  = np.random.randint(0, n_r - BLOCK_L + 1)
            eps[s, b*BLOCK_L:(b+1)*BLOCK_L] = yr[st: st + BLOCK_L]
    return eps[:, :n_days]


def simulate_cdd_paths(fcst_vec, resid_by_year):
    n   = len(fcst_vec)
    eps = _block_bootstrap(resid_by_year, N_SIM, n)
    T   = fcst_vec[np.newaxis, :] + eps
    return _daily_cdd(T).sum(axis=1)


def price_call(cdd_sim, strike, ttm):
    payoffs = TICK * np.maximum(0.0, cdd_sim - strike)
    price   = float(np.exp(-R_RATE * ttm) * payoffs.mean())
    return price, payoffs


def price_put(cdd_sim, strike, ttm):
    payoffs = TICK * np.maximum(0.0, strike - cdd_sim)
    price   = float(np.exp(-R_RATE * ttm) * payoffs.mean())
    return price, payoffs


def price_instrument(cdd_sim, strike, ttm, corr):
    """
    Select call or put based on the sign of the CDD-yield correlation.
      corr < 0: higher CDD hurts yield → buy CDD call (pays when CDD high)
      corr ≥ 0: lower CDD hurts yield → buy CDD put  (pays when CDD low)
    """
    if corr < 0:
        return price_call(cdd_sim, strike, ttm)
    else:
        return price_put(cdd_sim, strike, ttm)

