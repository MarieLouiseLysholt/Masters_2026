def price_straddle(mc_leg1: Dict, mc_leg2: Dict) -> Dict:
    """Cross-index cross-period straddle [STU16; PRE24]."""
    total = mc_leg1["payoffs"] + mc_leg2["payoffs"]
    return {
        "premium_straddle":  float(mc_leg1["premium_mc"] + mc_leg2["premium_mc"]),
        "premium_leg1":      float(mc_leg1["premium_mc"]),
        "premium_leg2":      float(mc_leg2["premium_mc"]),
        "total_payoffs":     total,
        "mean_total_payoff": float(total.mean()),
        "std_total_payoff":  float(total.std(ddof=1)),
        "idx_sims_leg1":     mc_leg1["idx_sims"],
        "idx_sims_leg2":     mc_leg2["idx_sims"],
    }


