    # ── Pairwise paired Wilcoxon signed-rank: are models different? ──────────
    # H0: median(HE_sv^A − HE_sv^B) = 0  (two-sided)
    # Observations are matched region × year pairs, so paired test is correct.
    # Mann-Whitney U would treat them as independent which they are not.
    models_present = [m for m in MODEL_ORDER if m in res_df["model"].values]

    # Build matched panel: each row = one region × year, columns = models
    panel = (res_df.pivot_table(index=["region","oos_year"],
                                columns="model", values="HE_sv")
             .reindex(columns=models_present))

    pairwise_rows = []
    for i, m1 in enumerate(models_present):
        for m2 in models_present[i+1:]:
            diff = (panel[m1] - panel[m2]).dropna().values
            if len(diff) < 10:
                p = np.nan
            else:
                try:
                    _, p = _wilcoxon(diff, alternative="two-sided")
                    p = round(float(p), 4)
                except Exception:
                    p = np.nan
            pairwise_rows.append({"model_a": m1, "model_b": m2,
                                  "p_value": p,
                                  "n_pairs": len(diff),
                                  "mean_diff": round(float(np.mean(diff)), 4)
                                              if len(diff) > 0 else np.nan,
                                  "significant": bool(p < 0.05)
                                                 if not np.isnan(p) else False})

    pairwise_df = pd.DataFrame(pairwise_rows)

    # Holm-Bonferroni correction across all pairwise comparisons
    # Orders raw p-values and adjusts threshold: reject H0 if p_i ≤ α/(m−i+1)
    valid = pairwise_df["p_value"].notna()
    if valid.sum() > 0:
        raw_p   = pairwise_df.loc[valid, "p_value"].values
        m       = len(raw_p)
        order   = np.argsort(raw_p)
        p_holm  = np.ones(m)
        for rank, idx in enumerate(order):
            p_holm[idx] = min(1.0, raw_p[idx] * (m - rank))
        # Enforce monotonicity
        for i in range(1, m):
            p_holm[order[i]] = max(p_holm[order[i]], p_holm[order[i-1]])
        pairwise_df.loc[valid, "p_holm"]        = p_holm.round(4)
        pairwise_df.loc[valid, "sig_holm"]      = p_holm < 0.05
        pairwise_df.loc[valid, "significant"]   = p_holm < 0.05   # override raw
    else:
        pairwise_df["p_holm"]   = np.nan
        pairwise_df["sig_holm"] = False

    pairwise_df.to_csv(OUT_DIR / "pairwise_wilcoxon_hesv.csv", index=False)

