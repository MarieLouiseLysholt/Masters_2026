def load_yield(region):
    raw = pd.read_csv(YIELD_CSV)
    raw.columns = [c.strip().lower() for c in raw.columns]
    rcol = next(c for c in ["reg", "region_code", "region"] if c in raw.columns)
    ycol = next(c for c in ["yield", "yield_t_ha", "rendement"] if c in raw.columns)
    tcol = next(c for c in ["year", "annee"] if c in raw.columns)
    df = raw[raw[rcol] == region][[tcol, ycol]].copy()
    df.columns = ["year", "yield_t_ha"]
    df["year"]       = df["year"].astype(int)
    df["yield_t_ha"] = df["yield_t_ha"].astype(float)
    if df["yield_t_ha"].median() > 20:
        df["yield_t_ha"] /= 10.0
    return df.sort_values("year").reset_index(drop=True)


def load_temperature(region):
    raw = pd.read_csv(TEMP_CSV, parse_dates=["date"])
    raw.columns = raw.columns.str.lower().str.strip()
    reg_col  = next(c for c in ["region_code", "region", "reg"] if c in raw.columns)
    temp_col = next(c for c in ["daily_avg_temperature", "temp", "temperature"]
                    if c in raw.columns)
    df = raw[raw[reg_col] == region][["date", temp_col]].copy()
    df = df.rename(columns={temp_col: "T"})
    df = df[~((df["date"].dt.month == 2) & (df["date"].dt.day == 29))].copy()
    df["doy"]  = df["date"].apply(lambda d: _doy_noleap(pd.Timestamp(d)))
    df["year"] = df["date"].dt.year
    return df.sort_values("date").reset_index(drop=True)


def load_paths(region: int, year: int, model: str):
    stem      = PATHS_DIR / f"paths_region{region}_{year}_{model}"
    npy_path  = stem.with_suffix(".npy")
    date_path = Path(str(stem) + "_dates.csv")
    if not npy_path.exists():
        print(f"  [SKIP] Path file not found: {npy_path.name}")
        return None
    if not date_path.exists():
        print(f"  [SKIP] Date file not found: {date_path.name}")
        return None
    paths      = np.load(npy_path)
    path_dates = pd.DatetimeIndex(
        pd.read_csv(date_path, parse_dates=["date"])["date"])
    if paths.shape[1] != len(path_dates):
        print(f"  [SKIP] R{region} {year}: path/date length mismatch")
        return None
    return paths, path_dates


def compute_index_by_window(temp_df, start_doy, end_doy, index_type):
    win = temp_df[(temp_df["doy"] >= start_doy) &
                  (temp_df["doy"] <= end_doy)].copy()
    T = win["T"].values
    if index_type == "CDD":
        win["idx"] = np.maximum(T - BASE_TEMP, 0.0)
    elif index_type == "HDD":
        win["idx"] = np.maximum(BASE_TEMP - T, 0.0)
    elif index_type == "CAT":
        win["idx"] = T
    else:
        raise ValueError(f"Unknown index_type: {index_type}")
    return win.groupby("year")["idx"].sum().rename("cIndex").reset_index()


# =============================================================================
# DETRENDING  --  Möllmann et al. (2019) additive method
# =============================================================================

def additive_detrend_yield(yield_df, oos_year):
    """
    Additive yield detrending following Möllmann et al. (2019):

        Y_t^detrend = Y_t - Y_hat_t^trend + Y_bar

    where Y_hat_t^trend = alpha_hat + beta_hat * (t - YIELD_T0) is a
    linear OLS trend fitted on calibration data (year < oos_year), and
    Y_bar is the calibration-period mean yield.

    Returns (detrended_df, trend_coefs, y_bar) where:
      - detrended_df has columns ["year", "yield_detrended"]
      - trend_coefs = [alpha_hat, beta_hat] for extrapolation to OOS years
      - y_bar = calibration mean yield

    Returns None if fewer than 6 calibration observations.
    """
    df = yield_df[yield_df["year"] < oos_year].copy()
    df = df[df["yield_t_ha"] > 0].dropna(subset=["yield_t_ha"])
    if len(df) < 6:
        return None

    y = df["yield_t_ha"].values
    t = (df["year"].values - YIELD_T0).astype(float)
    X = np.column_stack([np.ones(len(y)), t])
    coefs, _, _, _ = np.linalg.lstsq(X, y, rcond=None)

    y_bar     = float(np.mean(y))
    y_detrend = y - X @ coefs + y_bar

    out = df[["year"]].copy()
    out["yield_detrended"] = y_detrend
    return out.reset_index(drop=True), coefs, y_bar


def detrend_actual_yield(y_actual, oos_year, trend_coefs, y_bar):
    """
    Apply calibration trend coefficients to detrend a single actual yield
    observation in the OOS year, so it is on the same scale as the
    simulated detrended yields used for N* optimisation.

        Y_oos^detrend = Y_oos - Y_hat_oos^trend + Y_bar
    """
    t_oos     = float(oos_year - YIELD_T0)
    trend_oos = trend_coefs[0] + trend_coefs[1] * t_oos
    return float(y_actual - trend_oos + y_bar)


# =============================================================================
# CONTRACT SELECTION  --  fixed once per region before OOS period
# =============================================================================

def find_optimal_index_window(yield_detrended_df, temp_calib):
    """
    Select the (index_type, accumulation window) pair that maximises
    |Spearman rank correlation| between accumulated index and detrended
    yield over the calibration period.

    Searches 15 contiguous March-to-July windows x 3 index types = 45
    candidates. Called ONCE per region using all data prior to the OOS
    period; the selected contract is then held fixed across all OOS years.
    Follows Möllmann et al. (2019).
    """
    detrended = yield_detrended_df.set_index("year")["yield_detrended"]

    best_corr, best_index = 0.0, "CDD"
    best_start, best_end, best_label = 121, 181, "May-Jun"

    for index_type in INDEX_TYPES:
        for i, m_start in enumerate(MONTH_ORDER):
            for m_end in MONTH_ORDER[i:]:
                s = MONTH_WINDOWS[m_start][0]
                e = MONTH_WINDOWS[m_end][1]
                idx_yr = compute_index_by_window(temp_calib, s, e, index_type)
                merged = idx_yr[idx_yr["year"].isin(detrended.index)].set_index("year")
                common = merged.index.intersection(detrended.index)
                if len(common) < 6:
                    continue
                rho, _ = spearmanr(detrended.loc[common].values,
                                   merged.loc[common, "cIndex"].values)
                if np.isnan(rho):
                    continue
                if abs(rho) > abs(best_corr):
                    best_corr  = rho
                    best_index = index_type
                    best_start = s
                    best_end   = e
                    best_label = (f"{m_start}-{m_end}"
                                  if m_start != m_end else m_start)

    return best_index, best_start, best_end, best_label, best_corr


# =============================================================================
# YIELD MODEL  --  fixed quadratic levels specification
# =============================================================================
#
# Y_t^detrend = a + b*I_t + c*I_t^2 + eps_t
#
# Fixed quadratic form following Vedenov & Barnett (2004) and Zhou et al.
# (2016). No AIC model selection -- quadratic used throughout.
# Model is refitted each OOS year on the expanding calibration window.
# =============================================================================

def fit_yield_model(yield_detrended_df, index_df):
    """
    Fit the quadratic yield-temperature model on detrended yields (levels):

        Y_t^detrend = a + b*I_t + c*I_t^2 + eps_t

    Returns dict with 'coefs' [a, b, c], 'resid', 'r2', or None if
    fewer than 6 calibration observations.
    """
    merged = pd.merge(yield_detrended_df, index_df,
                      on="year", how="inner").dropna()
    if len(merged) < 6:
        return None

    y   = merged["yield_detrended"].values
    idx = merged["cIndex"].values

    X = np.column_stack([np.ones(len(y)), idx, idx ** 2])
    coefs, _, _, _ = np.linalg.lstsq(X, y, rcond=None)
    resid = y - X @ coefs

    return {
        "coefs": coefs,
        "resid": resid,
        "r2":    float(1 - np.var(resid) / np.var(y)),
    }


def simulate_revenue(yield_model, index_sim):
    """
    Simulate revenue (EUR/ha) from 10,000 temperature paths.

    For each simulated path i:
        Y_i^detrend = a + b*I_i + c*I_i^2 + eps_i
        eps_i ~ N(0, sigma^2)

    Revenue is computed on the detrended scale, consistent with the
    ex-post evaluation which also uses detrended actual yield.
    Yields are clipped at zero to prevent negative revenue.
    """
    coefs = yield_model["coefs"]
    sigma = float(np.std(yield_model["resid"], ddof=1))
    eps   = np.random.normal(0.0, sigma, size=len(index_sim))

    y_sim = coefs[0] + coefs[1] * index_sim + coefs[2] * index_sim ** 2 + eps
    y_sim = np.maximum(y_sim, 0.0)   # clip: no negative yield

    return y_sim * WHEAT_PRICE


# =============================================================================
# OPTION PRICING
# =============================================================================

def price_and_payoffs(index_sim, strike, ttm, corr):
    """Simulated payoffs and actuarially fair price (zero risk loading)."""
    if corr < 0:
        payoffs = TICK * np.maximum(0.0, index_sim - strike)
    else:
        payoffs = TICK * np.maximum(0.0, strike - index_sim)
    price = float(np.exp(-R_RATE * ttm) * payoffs.mean())
    return price, payoffs


def historical_premium(temp_df, start_doy, end_doy,
                       index_type, corr, K, TTM, oos_year):
    """
    Model-independent historical burn premium:
        V = exp(-r*T) * mean(realised payoffs over calibration years)
    All models face the same V within each region-year.
    """
    idx_hist  = compute_index_by_window(temp_df, start_doy, end_doy, index_type)
    idx_calib = idx_hist[idx_hist["year"] < oos_year]["cIndex"].values
    if len(idx_calib) == 0:
        return None
    if corr < 0:
        raw_pays = TICK * np.maximum(idx_calib - K, 0.0)
    else:
        raw_pays = TICK * np.maximum(K - idx_calib, 0.0)
    return float(np.exp(-R_RATE * TTM) * raw_pays.mean())


# =============================================================================
# HEDGED REVENUE
# =============================================================================

def hedged_rev(rev_u, payoffs, n_contracts, option_price, ttm):
    if abs(n_contracts) < 1e-10:
        return rev_u.copy()
    return (rev_u
            - n_contracts * option_price * np.exp(R_RATE * ttm)
            + n_contracts * payoffs)


# =============================================================================
# HEDGE RATIO  --  Johnson (1960) / Ederington (1979)
# =============================================================================

def johnson_nstar(rev_u, payoffs):
    """
    OLS minimum-variance hedge ratio:
        N* = -Cov(R_u, payoff) / Var(payoff),  floored at 0.

    If Var(payoff) is below a minimum threshold the simulated payoff
    distribution is degenerate (near-constant), meaning the contract
    offers no meaningful hedge in the simulation. N* is set to zero
    in this case to avoid division by a near-zero denominator producing
    an explosive and economically meaningless hedge ratio.
    This can occur when a model generates overconfident (low-variance)
    temperature paths that place almost all simulated outcomes on one
    side of the strike.
    """
    var_p = float(np.var(payoffs))
    if var_p < 1.0:          # payoff SD < EUR 1 -- degenerate distribution
        return 0.0
    cov_rp = float(np.cov(rev_u, payoffs)[0, 1])
    return max(0.0, -cov_rp / var_p)


