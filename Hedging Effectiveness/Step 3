def plot_revenue_distribution(
    rev_u, hedged_variants, V, TTM,
    best_index, best_label, best_start, best_end, best_corr,
    K, act_idx, act_rev_u, act_pay, region, oos_year,
):
    fig, ax = plt.subplots(figsize=(12, 6))

    all_vals = np.concatenate([rev_u] + [rh for rh, _ in hedged_variants.values()])
    x_min  = all_vals.min() * 0.98
    x_max  = all_vals.max() * 1.01
    x_grid = np.linspace(x_min, x_max, 600)

    kde_u = gaussian_kde(rev_u, bw_method="scott")
    y_u   = kde_u(x_grid)
    ymax  = y_u.max()

    ax.fill_between(x_grid, y_u, alpha=0.12, color="#93c5fd")
    ax.plot(x_grid, y_u, color="#2563eb", lw=2.2, label="Unhedged", zorder=5)

    mean_u = float(np.mean(rev_u))
    ax.axvline(mean_u, color="#2563eb", lw=1.0, ls="--", alpha=0.6,
               label=f"Unhedged mean = EUR {mean_u:.0f}/ha")

    for label, (rev_h, N_star) in hedged_variants.items():
        if N_star < 1e-6:
            continue
        kde_h = gaussian_kde(rev_h, bw_method="scott")
        y_h   = kde_h(x_grid)
        ymax  = max(ymax, y_h.max())
        ax.plot(x_grid, y_h, color="#16a34a", lw=1.6,
                label=f"{label}  (N*={N_star:.4f})", zorder=4, alpha=0.9)

    ax.annotate("", xy=(act_rev_u, 0), xytext=(act_rev_u, ymax * 0.14),
                arrowprops=dict(arrowstyle="->", color="#2563eb", lw=1.8))
    ax.text(act_rev_u, ymax * 0.16, f"Realised\nEUR {act_rev_u:.0f}/ha",
            ha="center", va="bottom", fontsize=8, color="#2563eb")

    instrument = "call" if best_corr < 0 else "put"
    ax.text(0.015, 0.975,
            f"Index: {best_index} {instrument}  |  Window: {best_label} "
            f"(DOY {best_start}-{best_end})  |  rho={best_corr:+.3f}\n"
            f"K={K:.0f}  |  Realised {best_index}={act_idx:.0f}  "
            f"|  Payoff=EUR {act_pay:.0f}/ha  |  V=EUR {V:.1f}/ha",
            transform=ax.transAxes, fontsize=8.5, va="top",
            bbox=dict(boxstyle="round,pad=0.4", facecolor="white",
                      alpha=0.88, edgecolor="#cccccc"))

    ax.set_xlabel("Revenue (EUR/ha)", fontsize=11)
    ax.set_ylabel("Density", fontsize=11)
    ax.legend(fontsize=8.5, framealpha=0.9, loc="upper left", ncol=2)
    ax.grid(axis="y", alpha=0.25)
    ax.spines[["top", "right"]].set_visible(False)
    plt.tight_layout()

    out = DIST_DIR / f"dist_region{region}_{oos_year}.png"
    fig.savefig(out, dpi=160, bbox_inches="tight")
    plt.close(fig)


# =============================================================================
# ROBUSTNESS  --  fixed agronomic windows
# =============================================================================

def run_fixed_window(yield_cache, temp_cache, paths_dir,
                     index_type, start_doy, end_doy, label, model):
    """
    Fixed-window robustness check: same contract for all regions and years.
    Uses additive detrending and quadratic yield model consistent with main loop.
    """
    rows = []
    for region in REGIONS:
        yield_df = yield_cache[region]
        temp_df  = temp_cache[region]

        for oos_year in OOS_YEARS:
            stem      = paths_dir / f"paths_region{region}_{oos_year}_{model}"
            npy_path  = stem.with_suffix(".npy")
            date_path = Path(str(stem) + "_dates.csv")
            if not npy_path.exists() or not date_path.exists():
                continue

            paths      = np.load(npy_path)
            path_dates = pd.DatetimeIndex(
                pd.read_csv(date_path, parse_dates=["date"])["date"])
            path_doys  = np.array(
                [_doy_noleap(pd.Timestamp(d)) for d in path_dates])

            result = additive_detrend_yield(yield_df, oos_year)
            if result is None:
                continue
            yield_detrended, trend_coefs, y_bar = result

            TTM = end_doy / 365.0

            idx_hist  = compute_index_by_window(temp_df, start_doy, end_doy, index_type)
            idx_calib = idx_hist[idx_hist["year"] < oos_year]
            if len(idx_calib) < 3:
                continue
            K = float(idx_calib["cIndex"].mean())

            # Spearman correlation for call/put direction
            temp_calib = temp_df[temp_df["year"] < oos_year].copy()
            idx_c      = compute_index_by_window(temp_calib, start_doy, end_doy, index_type)
            det_series = yield_detrended.set_index("year")["yield_detrended"]
            merged_c   = idx_c[idx_c["year"].isin(det_series.index)].set_index("year")
            common     = merged_c.index.intersection(det_series.index)
            if len(common) < 6:
                continue
            from scipy.stats import spearmanr as _sp
            corr, _ = _sp(det_series.loc[common].values,
                          merged_c.loc[common, "cIndex"].values)
            if np.isnan(corr):
                continue

            ym = fit_yield_model(yield_detrended, idx_calib)
            if ym is None:
                continue

            win_mask = (path_doys >= start_doy) & (path_doys <= end_doy)
            if not win_mask.any():
                continue
            window_temps = paths[:, win_mask]

            if index_type == "CDD":
                index_sim = np.maximum(window_temps - BASE_TEMP, 0.0).sum(axis=1)
            elif index_type == "HDD":
                index_sim = np.maximum(BASE_TEMP - window_temps, 0.0).sum(axis=1)
            elif index_type == "CAT":
                index_sim = window_temps.sum(axis=1)

            np.random.seed(42 + region * 1000 + oos_year)
            rev_u        = simulate_revenue(ym, index_sim)
            V_model, pay = price_and_payoffs(index_sim, K, TTM, corr)
            V_hist       = historical_premium(temp_df, start_doy, end_doy,
                                              index_type, corr, K, TTM, oos_year)
            V      = V_hist if V_hist is not None else V_model
            N_star = johnson_nstar(rev_u, pay)

            act_row = idx_hist[idx_hist["year"] == oos_year]
            if act_row.empty:
                continue
            act_idx = float(act_row["cIndex"].values[0])

            act_yield_row = yield_df[yield_df["year"] == oos_year]
            if act_yield_row.empty:
                continue
            act_rev_u = detrend_actual_yield(
                float(act_yield_row["yield_t_ha"].values[0]),
                oos_year, trend_coefs, y_bar) * WHEAT_PRICE

            act_pay = (float(TICK * max(0.0, act_idx - K)) if corr < 0
                       else float(TICK * max(0.0, K - act_idx)))

            if N_star < 1e-10:
                act_rev_h = act_rev_u
            else:
                act_rev_h = (act_rev_u
                             - N_star * V * np.exp(R_RATE * TTM)
                             + N_star * act_pay)

            rows.append({
                "window":    label,
                "region":    region,
                "oos_year":  oos_year,
                "N_sv":      round(N_star, 5),
                "act_rev_u": round(act_rev_u, 2),
                "act_rev_h": round(act_rev_h, 2),
                "delta_rev": round(act_rev_h - act_rev_u, 2),
                "helped":    (act_rev_h - act_rev_u) > 0,
            })

    return pd.DataFrame(rows)


