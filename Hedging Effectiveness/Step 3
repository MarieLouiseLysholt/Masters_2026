# =============================================================================
# MAIN LOOP
# =============================================================================

all_rows = []

for model in MODELS:
    print(f"\n{'='*72}\n  Model: {model}\n{'='*72}")

    for region in REGIONS:
        print(f"\n{'─'*65}\n  Region {region}\n{'─'*65}")

        yield_df = yield_cache[region]
        temp_df  = temp_cache[region]

        # ------------------------------------------------------------------
        # Step 1: select (index, window) ONCE using all pre-OOS data
        # ------------------------------------------------------------------
        first_oos   = OOS_YEARS[0]    # 2019
        temp_pre    = temp_df[temp_df["year"] < first_oos].copy()
        det_pre     = additive_detrend_yield(yield_df, first_oos)
        if det_pre is None:
            print(f"  [SKIP] R{region}: insufficient pre-OOS data for window selection")
            continue
        det_pre_df, _, _ = det_pre

        best_index, best_start, best_end, best_label, best_corr = \
            find_optimal_index_window(det_pre_df, temp_pre)

        TTM = best_end / 365.0
        print(f"  Contract fixed: {best_index} {best_label} "
              f"(DOY {best_start}-{best_end})  rho={best_corr:+.3f}  "
              f"{'call' if best_corr < 0 else 'put'}")

        # ------------------------------------------------------------------
        # Step 2: OOS loop -- detrend, fit model, simulate, evaluate
        # ------------------------------------------------------------------
        for oos_year in OOS_YEARS:

            loaded = load_paths(region, oos_year, model)
            if loaded is None:
                continue
            paths, path_dates = loaded
            path_doys = np.array([_doy_noleap(pd.Timestamp(d))
                                  for d in path_dates])

            # Additive detrend using expanding calibration window
            result = additive_detrend_yield(yield_df, oos_year)
            if result is None:
                continue
            yield_detrended, trend_coefs, y_bar = result

            # Historical index and strike
            idx_hist_full  = compute_index_by_window(
                temp_df, best_start, best_end, best_index)
            idx_calib_hist = idx_hist_full[idx_hist_full["year"] < oos_year]
            if len(idx_calib_hist) < 3:
                continue
            K = float(idx_calib_hist["cIndex"].mean())

            # Fit quadratic yield model on detrended yields
            ym = fit_yield_model(yield_detrended, idx_calib_hist)
            if ym is None:
                continue

            # Slice paths to selected window
            win_mask = (path_doys >= best_start) & (path_doys <= best_end)
            if not win_mask.any():
                print(f"  [SKIP] R{region} {oos_year}: no path days in "
                      f"DOY {best_start}-{best_end}")
                continue
            window_temps = paths[:, win_mask]

            if best_index == "CDD":
                index_sim = np.maximum(window_temps - BASE_TEMP, 0.0).sum(axis=1)
            elif best_index == "HDD":
                index_sim = np.maximum(BASE_TEMP - window_temps, 0.0).sum(axis=1)
            elif best_index == "CAT":
                index_sim = window_temps.sum(axis=1)

            # Simulate revenue and price contract
            np.random.seed(42 + region * 1000 + oos_year)
            rev_u = simulate_revenue(ym, index_sim)

            V_model, payoffs = price_and_payoffs(index_sim, K, TTM, best_corr)
            V_hist = historical_premium(temp_df, best_start, best_end,
                                        best_index, best_corr, K, TTM, oos_year)
            V = V_hist if V_hist is not None else V_model

            mean_rev = float(np.mean(rev_u))

            # Johnson (1960) hedge ratio
            N_star = johnson_nstar(rev_u, payoffs)

            # Realised outcomes -- detrend actual yield to same scale
            act_row = idx_hist_full[idx_hist_full["year"] == oos_year]
            if act_row.empty:
                continue
            act_idx = float(act_row["cIndex"].values[0])

            act_yield_row = yield_df[yield_df["year"] == oos_year]
            if act_yield_row.empty:
                continue

            # Detrend actual yield using calibration trend
            act_yield_detrended = detrend_actual_yield(
                float(act_yield_row["yield_t_ha"].values[0]),
                oos_year, trend_coefs, y_bar)
            act_rev_u = act_yield_detrended * WHEAT_PRICE

            if best_corr < 0:
                act_pay = float(TICK * max(0.0, act_idx - K))
            else:
                act_pay = float(TICK * max(0.0, K - act_idx))

            if N_star < 1e-10:
                act_rev_h = act_rev_u
            else:
                act_rev_h = (act_rev_u
                             - N_star * V * np.exp(R_RATE * TTM)
                             + N_star * act_pay)

            delta_rev = act_rev_h - act_rev_u
            helped    = act_rev_h > act_rev_u    # strict >

            # Distribution plot -- gated to XGB / Region 11 / 2020
            if model == "XGB" and region == 11 and oos_year == 2020:
                hedged_variants = {
                    "Johnson N*": (hedged_rev(rev_u, payoffs, N_star, V, TTM), N_star)
                }
                plot_revenue_distribution(
                    rev_u, hedged_variants, V, TTM,
                    best_index, best_label, best_start, best_end, best_corr,
                    K, act_idx, act_rev_u, act_pay, region, oos_year)

            print(f"  [{oos_year}] K={K:.1f} Act={act_idx:.1f} "
                  f"R2={ym['r2']:.3f} N*={N_star:.3f} "
                  f"DRev={delta_rev:+.1f}")

            all_rows.append({
                "model":        model,
                "region":       region,
                "oos_year":     oos_year,
                "best_index":   best_index,
                "win_label":    best_label,
                "win_corr":     round(best_corr, 3),
                "instrument":   "call" if best_corr < 0 else "put",
                "K":            round(K, 2),
                "TTM":          round(TTM, 4),
                "yield_r2":     round(ym["r2"], 3),
                "V":            round(V, 4),
                "V_model":      round(V_model, 4),
                "act_idx":      round(act_idx, 2),
                "act_pay":      round(act_pay, 2),
                "mean_rev_sim": round(mean_rev, 2),
                "N_star":       round(N_star, 5),
                "act_rev_u":    round(act_rev_u, 2),
                "act_rev_h":    round(act_rev_h, 2),
                "delta_rev":    round(delta_rev, 2),
                "helped":       int(helped),
            })


# =============================================================================
# AGGREGATE HEDGING EFFECTIVENESS
# =============================================================================

if not all_rows:
    print("\nNo results -- check PATHS_DIR and data paths.")
else:
    df = pd.DataFrame(all_rows)
    df.to_csv(OUT_DIR / "he_results_raw.csv", index=False)

    all_summary_rows = []
    all_region_rows  = []

    def _he_metrics(rev_u_r, rev_h_r):
        var_u  = float(np.var(rev_u_r))
        he_var = (1 - np.var(rev_h_r) / var_u) if var_u > 1e-8 else np.nan
        target = float(np.mean(rev_u_r))
        sv_u   = float(np.mean(np.minimum(rev_u_r - target, 0.0) ** 2))
        sv_h   = float(np.mean(np.minimum(rev_h_r - target, 0.0) ** 2))
        he_sv  = (1 - sv_h / sv_u) if sv_u > 1e-8 else np.nan
        return he_var, he_sv

    def _significance(delta_rev):
        d      = delta_rev[delta_rev != 0]
        mean_d = float(np.mean(delta_rev))
        if len(d) < 5:
            return mean_d, np.nan, np.nan, np.nan, np.nan
        t_stat, t_pval = ttest_1samp(delta_rev, 0.0)
        try:
            w_stat, w_pval = wilcoxon(d, alternative="two-sided")
        except Exception:
            w_stat, w_pval = np.nan, np.nan
        return mean_d, float(t_stat), float(t_pval), float(w_stat), float(w_pval)

    def _stars(p):
        if np.isnan(p): return ""
        if p < 0.01:    return "***"
        if p < 0.05:    return "**"
        if p < 0.10:    return "*"
        return ""

    for model in MODELS:
        df_m = df[df["model"] == model]
        if df_m.empty:
            continue

        print(f"\n{'='*80}\n  SUMMARY -- Model: {model}\n{'='*80}")
        print(f"  OOS {OOS_YEARS[0]}-{OOS_YEARS[-1]}  |  {len(REGIONS)} regions  "
              f"|  N* = Johnson (1960) OLS  |  EUR/ha")

        delta = df_m["delta_rev"].values
        mean_d, t_stat, t_pval, w_stat, w_pval = _significance(delta)

        print(f"\n  PRIMARY RESULTS")
        print(f"  {'Mean DeltaRev':<22}  {mean_d:>+9.2f}  EUR/ha")
        print(f"  {'Median DeltaRev':<22}  {float(np.median(delta)):>+9.2f}  EUR/ha")
        print(f"  {'Hit rate':<22}  {df_m['helped'].mean()*100:>8.1f}%  "
              f"(years where hedging improved revenue)")
        print(f"  {'Mean N*':<22}  {df_m['N_star'].mean():>9.4f}  contracts/ha")
        print(f"\n  SIGNIFICANCE TESTS  (H0: DeltaRev = 0,  n={len(delta)})")
        print(f"  {'t-test':<22}  t={t_stat:>+6.3f}  p={t_pval:.3f}  {_stars(t_pval)}")
        print(f"  {'Wilcoxon':<22}  W={w_stat:>7.1f}  p={w_pval:.3f}  "
              f"{_stars(w_pval)}   [primary]")
        print(f"  {'':22}  *** p<0.01  ** p<0.05  * p<0.10")

        region_he_var, region_he_sv = [], []
        for region in REGIONS:
            reg = df_m[df_m["region"] == region]
            if len(reg) < 2:
                continue
            he_var, he_sv = _he_metrics(reg["act_rev_u"].values,
                                         reg["act_rev_h"].values)
            if not np.isnan(he_var): region_he_var.append(he_var)
            if not np.isnan(he_sv):  region_he_sv.append(he_sv)

        HE_var = float(np.mean(region_he_var)) if region_he_var else np.nan
        HE_sv  = float(np.mean(region_he_sv))  if region_he_sv  else np.nan

        print(f"\n  SECONDARY METRICS")
        print(f"  {'HE_var':<22}  {HE_var*100:>+9.2f}%  1 - Var(R_h)/Var(R_u)")
        print(f"  {'HE_sv':<22}  {HE_sv*100:>+9.2f}%  1 - SV(R_h)/SV(R_u)")

        print(f"\n  Per-region breakdown -- {model}")
        print(f"  {'Region':>8}  {'Mean DRev':>10}  {'Wilcoxon p':>11}  "
              f"{'Hit rate':>9}  {'HE_var':>7}  {'HE_sv':>7}  "
              f"{'Mean N*':>8}  {'Mean rho':>8}")
        print("  " + "-" * 82)

        region_table_rows = []
        for region in REGIONS:
            reg = df_m[df_m["region"] == region]
            if len(reg) < 2:
                continue
            d_r = reg["delta_rev"].values
            he_var_r, he_sv_r = _he_metrics(reg["act_rev_u"].values,
                                             reg["act_rev_h"].values)
            _, _, _, w_r, wp_r = _significance(d_r)
            mean_rho = float(reg["win_corr"].mean())
            wp_str   = (f"{wp_r:.3f}{_stars(wp_r)}"
                        if not np.isnan(wp_r) else "n/a")
            print(f"  {region:>8}  {float(d_r.mean()):>+9.2f}  {wp_str:>11}  "
                  f"{float(reg['helped'].mean())*100:>8.1f}%  "
                  f"{he_var_r*100:>6.2f}%  {he_sv_r*100:>6.2f}%  "
                  f"{float(reg['N_star'].mean()):>8.4f}  {mean_rho:>+7.3f}")
            region_table_rows.append({
                "model":      model,
                "region":     region,
                "mean_delta": round(float(d_r.mean()), 2),
                "wilcoxon_p": round(wp_r, 4) if not np.isnan(wp_r) else np.nan,
                "hit_rate":   round(float(reg["helped"].mean()) * 100, 1),
                "HE_var_pct": round(he_var_r * 100, 2),
                "HE_sv_pct":  round(he_sv_r  * 100, 2),
                "mean_N":     round(float(reg["N_star"].mean()), 4),
                "mean_rho":   round(mean_rho, 3),
            })

        all_summary_rows.append({
            "model":        model,
            "mean_delta":   round(mean_d, 2),
            "median_delta": round(float(np.median(delta)), 2),
            "hit_rate":     round(float(df_m["helped"].mean()) * 100, 1),
            "mean_N":       round(float(df_m["N_star"].mean()), 4),
            "t_stat":       round(t_stat, 3) if not np.isnan(t_stat) else np.nan,
            "t_pval":       round(t_pval, 4) if not np.isnan(t_pval) else np.nan,
            "wilcoxon_W":   round(w_stat, 1) if not np.isnan(w_stat) else np.nan,
            "wilcoxon_p":   round(w_pval, 4) if not np.isnan(w_pval) else np.nan,
            "HE_var":       round(HE_var * 100, 2),
            "HE_sv":        round(HE_sv  * 100, 2),
        })
        all_region_rows.extend(region_table_rows)

        # Robustness
        print(f"\n  ROBUSTNESS CHECK -- {model}")
        rob_summaries = []

        rhe_var, rhe_sv = [], []
        for region in REGIONS:
            reg = df_m[df_m["region"] == region]
            if len(reg) < 2: continue
            he_var_r, he_sv_r = _he_metrics(reg["act_rev_u"].values,
                                             reg["act_rev_h"].values)
            if not np.isnan(he_var_r): rhe_var.append(he_var_r)
            if not np.isnan(he_sv_r):  rhe_sv.append(he_sv_r)
        _, _, _, w_rob, wp_rob = _significance(df_m["delta_rev"].values)
        rob_summaries.append({
            "window":     "Data-driven (45 candidates)",
            "mean_delta": round(mean_d, 2),
            "wilcoxon_p": round(wp_rob, 4) if not np.isnan(wp_rob) else np.nan,
            "hit_rate":   round(float(df_m["helped"].mean()) * 100, 1),
            "HE_var":     round(float(np.mean(rhe_var)) * 100, 2) if rhe_var else np.nan,
            "HE_sv":      round(float(np.mean(rhe_sv))  * 100, 2) if rhe_sv  else np.nan,
            "mean_N":     round(float(df_m["N_star"].mean()), 4),
        })

        for win_label, (idx_type, s_doy, e_doy) in ROBUSTNESS_WINDOWS.items():
            rob_df = run_fixed_window(yield_cache, temp_cache, PATHS_DIR,
                                      idx_type, s_doy, e_doy, win_label, model)
            if rob_df.empty:
                continue
            rhe_var, rhe_sv = [], []
            for region in REGIONS:
                reg = rob_df[rob_df["region"] == region]
                if len(reg) < 2: continue
                he_var_r, he_sv_r = _he_metrics(reg["act_rev_u"].values,
                                                 reg["act_rev_h"].values)
                if not np.isnan(he_var_r): rhe_var.append(he_var_r)
                if not np.isnan(he_sv_r):  rhe_sv.append(he_sv_r)
            _, _, _, w_r, wp_r = _significance(rob_df["delta_rev"].values)
            rob_summaries.append({
                "window":     win_label,
                "mean_delta": round(float(rob_df["delta_rev"].mean()), 2),
                "wilcoxon_p": round(wp_r, 4) if not np.isnan(wp_r) else np.nan,
                "hit_rate":   round(float(rob_df["helped"].mean()) * 100, 1),
                "HE_var":     round(float(np.mean(rhe_var)) * 100, 2) if rhe_var else np.nan,
                "HE_sv":      round(float(np.mean(rhe_sv))  * 100, 2) if rhe_sv  else np.nan,
                "mean_N":     round(float(rob_df["N_sv"].mean()), 4),
            })

        print(f"\n  {'Window':<35}  {'Mean DRev':>10}  {'Wilcoxon p':>11}  "
              f"{'Hit rate':>9}  {'HE_var':>7}  {'HE_sv':>7}  {'Mean N*':>8}")
        print("  " + "-" * 95)
        for r in rob_summaries:
            wp_str = (f"{r['wilcoxon_p']:.3f}{_stars(r['wilcoxon_p'])}"
                      if not np.isnan(r['wilcoxon_p']) else "n/a")
            print(f"  {r['window']:<35}  {r['mean_delta']:>+9.2f}  {wp_str:>11}  "
                  f"{r['hit_rate']:>8.1f}%  {r['HE_var']:>6.2f}%  "
                  f"{r['HE_sv']:>6.2f}%  {r['mean_N']:>8.4f}")

    pd.DataFrame(all_summary_rows).to_csv(OUT_DIR / "he_summary.csv", index=False)
    pd.DataFrame(all_region_rows).to_csv(OUT_DIR / "he_by_region.csv", index=False)
    print(f"\n  All outputs -> {OUT_DIR}")
    print("=" * 72)