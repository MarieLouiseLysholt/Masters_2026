# ─────────────────────────────────────────────────────────────────────────────
# NN ARCHITECTURE  (must exactly match CalibNetFlexible in model_comparison.py)
# ─────────────────────────────────────────────────────────────────────────────
class CalibNetFlexible(nn.Module):
    ACTIVATIONS = {
        "tanh":      nn.Tanh,
        "relu":      nn.ReLU,
        "leakyrelu": lambda: nn.LeakyReLU(0.1),
        "elu":       nn.ELU,
    }

    def __init__(self, in_dim: int, hidden: int = 32,
                 activation: str = "leakyrelu", n_layers: int = 1,
                 kappa_max: float = 0.5):
        super().__init__()
        self.kappa_max = kappa_max
        act_cls = self.ACTIVATIONS.get(activation, nn.LeakyReLU)
        layers = [nn.Linear(in_dim, hidden), act_cls()]
        for _ in range(n_layers - 1):
            layers += [nn.Linear(hidden, hidden), act_cls()]
        layers.append(nn.Linear(hidden, 2))
        self.net      = nn.Sequential(*layers)
        self.softplus = nn.Softplus()

    def forward(self, x):
        raw   = self.net(x)
        kappa = self.kappa_max * torch.sigmoid(raw[:, 0]) + 1e-6
        sigma = self.softplus(raw[:, 1]) + 1e-6
        return kappa, sigma


# ─────────────────────────────────────────────────────────────────────────────
# REGION MODEL CONTAINER  (replaces global variables in model_comparison.py)
# ─────────────────────────────────────────────────────────────────────────────
class RegionNNModel:
    """Holds all region-specific NN parameters needed for simulation."""
    def __init__(self, region, nn_pkl, alaton_pkl):
        arch         = nn_pkl["nn_architecture"]
        k_harm       = int(nn_pkl.get("k_harmonics", 3))
        window       = int(nn_pkl["window"])
        doy_harm     = int(nn_pkl["doy_harmonics"])
        in_dim       = window + 2 * doy_harm

        model = CalibNetFlexible(
            in_dim=in_dim, hidden=arch["hidden"],
            activation=arch["activation"], n_layers=arch["n_layers"],
            kappa_max=arch["kappa_max"],
        )
        model.load_state_dict(nn_pkl["nn_state_dict"])
        model.eval()

        # Recompute beta from calibration data (not stored in PKL, same as model_comparison.py)
        df_calib  = alaton_pkl["df"].loc[:nn_pkl["calib_end"]].copy()
        dates_c   = pd.Series(df_calib.index)
        n         = len(df_calib)
        doy_c     = dates_c.dt.dayofyear.values.astype(float)
        t_c       = np.arange(n) / 365.0
        parts     = [np.ones(n), t_c]
        for k in range(1, k_harm + 1):
            parts.append(np.sin(2 * np.pi * k * doy_c / 365.0))
            parts.append(np.cos(2 * np.pi * k * doy_c / 365.0))
        X_ols  = np.column_stack(parts)
        beta, *_ = np.linalg.lstsq(X_ols, df_calib["T"].values, rcond=None)

        self.region       = region
        self.model        = model
        self.x_mean       = float(nn_pkl["x_mean"])
        self.x_std        = float(nn_pkl["x_std"])
        self.vol_mult     = float(nn_pkl.get("vol_multiplier", nn_pkl.get("vol_mult", 1.0)))
        # student_t_df absent in new PKL format — use 0.0 as sentinel for Gaussian innovations
        self.t_df         = float(nn_pkl.get("student_t_df", 0.0))
        self.window       = window
        self.doy_harm     = doy_harm
        self.k_harm       = k_harm
        self.data_start   = alaton_pkl["df"].index[0]
        self.df_temp      = alaton_pkl["df"][["T"]].copy().sort_index()
        # Use stored seasonality_beta if available, otherwise use OLS-recomputed beta
        if "seasonality_beta" in nn_pkl:
            self.beta = np.array(nn_pkl["seasonality_beta"])
        else:
            self.beta = beta

    def seasonal(self, dates_idx: pd.DatetimeIndex) -> np.ndarray:
        """Reconstruct s(t) using OLS beta. t measured from data_start (fixes trend restart)."""
        n   = len(dates_idx)
        doy = dates_idx.dayofyear.values.astype(float)
        t   = np.array([(d - self.data_start).days for d in dates_idx]) / 365.0
        parts = [np.ones(n), t]
        for k in range(1, self.k_harm + 1):
            parts.append(np.sin(2 * np.pi * k * doy / 365.0))
            parts.append(np.cos(2 * np.pi * k * doy / 365.0))
        return np.column_stack(parts) @ self.beta

    def doy_features(self, dates_idx: pd.DatetimeIndex) -> np.ndarray:
        """DOY Fourier features fed into the NN input vector."""
        doy = dates_idx.dayofyear.values.astype(float)
        feats = []
        for k in range(1, self.doy_harm + 1):
            feats.append(np.sin(2 * np.pi * k * doy / 365.0))
            feats.append(np.cos(2 * np.pi * k * doy / 365.0))
        return np.column_stack(feats).astype(np.float32)

    def kappa_sigma_sequence(self, dates_idx: pd.DatetimeIndex,
                              init_window_xz: np.ndarray):
        """Deterministic κ(t)/σ(t) trajectory advancing with OU expectation."""
        total     = len(dates_idx)
        doy_feats = self.doy_features(dates_idx)
        kappa_seq = np.empty(total, dtype=np.float32)
        sigma_seq = np.empty(total, dtype=np.float32)
        rolling   = init_window_xz.copy()

        self.model.eval()
        with torch.no_grad():
            for i in range(total):
                inp   = np.concatenate([rolling[-self.window:], doy_feats[i]])[None, :]
                inp_t = torch.tensor(inp, dtype=torch.float32)
                k_t, s_t = self.model(inp_t)
                kappa_seq[i] = float(k_t.item())
                sigma_seq[i] = float(s_t.item()) * self.vol_mult
                # Advance with zero-mean OU expectation (not per-path mean)
                x_next  = rolling[-1] * (1.0 - kappa_seq[i])
                rolling = np.append(rolling, np.float32(x_next))

        return kappa_seq, sigma_seq

    def build_init_window(self, anchor_date: pd.Timestamp) -> np.ndarray:
        """Build rolling window of standardised residuals ending at anchor_date."""
        w_dates  = pd.date_range(
            anchor_date - pd.Timedelta(days=self.window - 1),
            periods=self.window, freq="D"
        )
        hist_T = np.array([
            float(self.df_temp.loc[
                self.df_temp.index[self.df_temp.index.get_indexer([d], method="nearest")[0]],
                "T"
            ]) for d in w_dates
        ])
        hist_s = self.seasonal(w_dates)
        return ((hist_T - hist_s - self.x_mean) / self.x_std).astype(np.float32)


# ─────────────────────────────────────────────────────────────────────────────
# DATA LOADING
# ─────────────────────────────────────────────────────────────────────────────
def load_yield_data() -> pd.DataFrame:
    """
    Load yield CSV. Compute surface-area-weighted average yield per region-year
    (multiple observations per region-year are possible in the source data).
    Returns DataFrame with columns [year, reg, yield_wt].
    """
    df = pd.read_csv(YIELD_CSV)
    df["weighted_yield"] = df["yield"] * df["surf"]
    agg = df.groupby(["year", "reg"]).agg(
        total_wt_yield=("weighted_yield", "sum"),
        total_surf=("surf", "sum"),
    ).reset_index()
    agg["yield_wt"] = agg["total_wt_yield"] / agg["total_surf"]
    agg = agg[agg["year"].between(OBS_START, OBS_END)].copy()
    return agg[["year", "reg", "yield_wt"]]


def _mm_fit(X: np.ndarray, y: np.ndarray, max_iter: int = 50,
             k: float = 1.345) -> np.ndarray:
    """
    MM-estimator via iteratively reweighted least squares (IRLS).
    Implements Huber M-estimation with bisquare tuning constant as used by
    Finger (2010) for crop yield detrending.

    Steps:
      1. Initial estimate via OLS
      2. Compute residuals; estimate robust scale via MAD
      3. Iterate: weight = Huber psi(r/scale) / (r/scale), refit WLS
    Returns beta coefficients.
    """
    beta = np.linalg.lstsq(X, y, rcond=None)[0]
    for _ in range(max_iter):
        resid = y - X @ beta
        scale = np.median(np.abs(resid)) / 0.6745   # MAD-based scale estimate
        if scale < 1e-10:
            break
        u     = resid / scale
        # Huber weights
        w     = np.where(np.abs(u) <= k, 1.0, k / np.abs(u))
        W     = np.diag(w)
        beta_new = np.linalg.lstsq(X.T @ W @ X, X.T @ W @ y, rcond=None)[0]
        if np.max(np.abs(beta_new - beta)) < 1e-8:
            beta = beta_new
            break
        beta = beta_new
    return beta


def _wald_test_quadratic(X_lin: np.ndarray, X_quad: np.ndarray,
                          y: np.ndarray) -> float:
    """
    Wald test p-value for the null hypothesis that the quadratic coefficient = 0.
    Uses OLS variance estimate (consistent with paper's model selection step).
    Returns p-value; reject H0 (prefer quadratic) if p < 0.05.
    """
    n, k  = X_quad.shape
    beta  = np.linalg.lstsq(X_quad, y, rcond=None)[0]
    resid = y - X_quad @ beta
    s2    = np.sum(resid**2) / (n - k)
    xtxi  = np.linalg.inv(X_quad.T @ X_quad)
    # Test last coefficient (quadratic term)
    se    = np.sqrt(s2 * xtxi[-1, -1])
    t_stat = beta[-1] / se if se > 1e-12 else 0.0
    p_val  = 2 * stats.t.sf(np.abs(t_stat), df=n - k)
    return float(p_val)


def detrend_yields(yield_series: pd.Series):
    """
    Remove deterministic trend using MM-estimator robust regression.
    Linear vs quadratic model selected per region via Wald test (paper Section 3.1,
    following Finger 2010 and Woodard & Garcia 2008).
    Deflates yields to last-year equivalents to isolate weather-driven variability.
    Returns (detrended_series, model_order, beta).
    """
    years  = yield_series.index.values.astype(float)
    y      = yield_series.values
    yr_c   = years - years.mean()   # centre for numerical stability

    X_lin  = np.column_stack([np.ones_like(yr_c), yr_c])
    X_quad = np.column_stack([np.ones_like(yr_c), yr_c, yr_c**2])

    # Wald test: is quadratic term significant at 5%?
    p_quad  = _wald_test_quadratic(X_lin, X_quad, y)
    use_quad = p_quad < 0.05
    X       = X_quad if use_quad else X_lin
    order   = "quadratic" if use_quad else "linear"

    beta    = _mm_fit(X, y)
    trend   = X @ beta

    # Deflate: express all years at final-year technology level
    yr_last = yr_c[-1]
    if use_quad:
        last_lvl = beta[0] + beta[1]*yr_last + beta[2]*yr_last**2
    else:
        last_lvl = beta[0] + beta[1]*yr_last

    detrended = y - trend + last_lvl
    return pd.Series(detrended, index=yield_series.index), order, beta


def load_temp_data() -> dict:
    """
    Load regional temperature CSV. Returns dict: region (int) -> DataFrame
    with DatetimeIndex and column "T".
    Handles both wide format (one col per region) and long format
    (date, region, temperature columns).
    """
    df_raw = pd.read_csv(TEMP_CSV)
    print(f"  [temp] columns: {list(df_raw.columns)}")
    print(f"  [temp] shape: {df_raw.shape}  |  sample:\n{df_raw.head(3).to_string()}\n")

    # Match by substring so "region_code", "daily_avg_temperature" etc. are caught
    reg_col  = next((c for c in df_raw.columns
                     if any(k in c.lower() for k in ("region", "reg_code", "reg"))), None)
    temp_col = next((c for c in df_raw.columns
                     if any(k in c.lower() for k in ("temperature", "temp", "tavg", "avg_temp"))), None)
    date_col = next((c for c in df_raw.columns
                     if any(k in c.lower() for k in ("date", "time", "day"))), None)

    out = {}

    if reg_col and temp_col and date_col:
        # Long format
        print(f"  [temp] LONG format  reg={reg_col}, temp={temp_col}, date={date_col}")
        df_raw[date_col] = pd.to_datetime(df_raw[date_col])
        for reg in REGIONS:
            sub = df_raw[df_raw[reg_col] == reg][[date_col, temp_col]].copy()
            if sub.empty:
                sub = df_raw[df_raw[reg_col].astype(str) == str(reg)][[date_col, temp_col]].copy()
            if not sub.empty:
                sub = sub.set_index(date_col).sort_index()
                sub.index.name = "date"
                out[reg] = sub.rename(columns={temp_col: "T"})
    else:
        # Wide format
        print(f"  [temp] WIDE format")
        date_col = date_col or df_raw.columns[0]
        df_raw[date_col] = pd.to_datetime(df_raw[date_col])
        df_raw = df_raw.set_index(date_col).sort_index()
        for reg in REGIONS:
            candidates = [str(reg), f"reg_{reg}", f"region_{reg}", f"r{reg}"]
            col = next((c for c in candidates if c in df_raw.columns), None)
            if col:
                out[reg] = df_raw[[col]].rename(columns={col: "T"})

    print(f"  [temp] loaded regions: {list(out.keys())}")
    return out


# ─────────────────────────────────────────────────────────────────────────────
# INDEX COMPUTATION
# ─────────────────────────────────────────────────────────────────────────────
def monthly_index(temp_df: pd.DataFrame, year: int, month: int,
                  t_ref: float, index_type: str) -> float:
    """Accumulated HDD or CDD for a single calendar month."""
    days  = monthrange(year, month)[1]
    start = pd.Timestamp(year, month, 1)
    end   = pd.Timestamp(year, month, days)
    mask  = (temp_df.index >= start) & (temp_df.index <= end)
    temps = temp_df.loc[mask, "T"].values
    if len(temps) == 0:
        return np.nan
    if index_type == "HDD":
        return float(np.sum(np.maximum(t_ref - temps, 0)))
    return float(np.sum(np.maximum(temps - t_ref, 0)))


def build_index_matrix(temp_df: pd.DataFrame, years: list, months: list,
                        t_ref: float, index_type: str) -> pd.DataFrame:
    """Matrix of shape (n_years × n_months) of accumulated indices."""
    return pd.DataFrame(
        {m: [monthly_index(temp_df, yr, m, t_ref, index_type) for yr in years]
         for m in months},
        index=years,
    )


# ─────────────────────────────────────────────────────────────────────────────
# BEST MONTH SELECTION  (paper Section 3.1)
# ─────────────────────────────────────────────────────────────────────────────
def select_best_month(yield_detrended: pd.Series, index_matrix: pd.DataFrame,
                       p_threshold: float = 0.10):
    """
    Compute Pearson r between de-trended yield and each monthly index.
    Select month with highest significant |r| (paper Section 3.1).
    Only months with p < p_threshold are considered (default 10%).

      r > 0  -> more index -> higher yield -> insure against low index  -> put option
      r < 0  -> more index -> lower yield  -> insure against high index -> call option

    Returns (best_month, r, option_type, all_corrs_dict).
    best_month is None if no month passes the significance filter.
    """
    common = yield_detrended.index.intersection(index_matrix.index)
    y      = yield_detrended.loc[common].values
    best_r, best_m = 0.0, None
    all_corrs = {}
    for m in index_matrix.columns:
        idx   = index_matrix.loc[common, m].values
        valid = ~np.isnan(idx)
        if valid.sum() < 8:
            continue
        # Skip if index is constant (e.g. CDD=0 all winter months) — undefined r
        if np.std(idx[valid]) < 1e-8:
            continue
        r, p = stats.pearsonr(y[valid], idx[valid])
        all_corrs[m] = (r, p)
        # Only consider months that pass the significance threshold
        if p < p_threshold and abs(r) > abs(best_r):
            best_r, best_m = r, m
    if best_m is None:
        return None, 0.0, "put", all_corrs
    option_type = "put" if best_r > 0 else "call"
    return best_m, best_r, option_type, all_corrs


# ─────────────────────────────────────────────────────────────────────────────
# NN-OU SIMULATION FOR A SINGLE MONTH
# ─────────────────────────────────────────────────────────────────────────────
def simulate_nn_month(nn_model: RegionNNModel, year: int, month: int,
                       n_sims: int, t_ref: float, index_type: str,
                       rng: np.random.Generator) -> np.ndarray:
    """
    Simulate n_sims temperature paths through `month` of `year` using NN-OU.
    Starting condition: actual observed temperatures in the window before month start.
    Returns array of shape (n_sims,) with accumulated HDD or CDD for the month.
    """
    days_in_month = monthrange(year, month)[1]
    start_date    = pd.Timestamp(year, month, 1)
    sim_dates     = pd.date_range(start_date, periods=days_in_month, freq="D")

    # Initial residual from last observed day before month start
    # t_df == 0 is sentinel for Gaussian innovations (new PKL format)
    use_gaussian = (nn_model.t_df < 2.1)
    t_scale = 1.0 if use_gaussian else float(np.sqrt((nn_model.t_df - 2.0) / nn_model.t_df))

    s_fut       = nn_model.seasonal(sim_dates)
    init_xz     = nn_model.build_init_window(start_date - pd.Timedelta(days=1))
    kappa_seq, sigma_seq = nn_model.kappa_sigma_sequence(sim_dates, init_xz)

    # Starting x0: residual from last observed temperature
    anchor      = start_date - pd.Timedelta(days=1)
    anchor_snap = nn_model.df_temp.index[
        nn_model.df_temp.index.get_indexer([anchor], method="nearest")[0]
    ]
    T0   = float(nn_model.df_temp.loc[anchor_snap, "T"])
    s0   = float(nn_model.seasonal(pd.DatetimeIndex([anchor_snap]))[0])
    x0z  = float((T0 - s0 - nn_model.x_mean) / nn_model.x_std)

    if use_gaussian:
        eps = rng.standard_normal(size=(n_sims, days_in_month)).astype(np.float32)
    else:
        eps = (rng.standard_t(df=nn_model.t_df, size=(n_sims, days_in_month))
               * t_scale).astype(np.float32)

    Xz       = np.empty((n_sims, days_in_month), dtype=np.float32)
    Xz[:, 0] = x0z * (1.0 - kappa_seq[0]) + sigma_seq[0] * eps[:, 0]
    for i in range(1, days_in_month):
        Xz[:, i] = Xz[:, i-1] * (1.0 - kappa_seq[i]) + sigma_seq[i] * eps[:, i]

    paths = Xz * nn_model.x_std + nn_model.x_mean + s_fut  # shape (n_sims, days)

    if index_type == "HDD":
        return np.sum(np.maximum(t_ref - paths, 0), axis=1)
    return np.sum(np.maximum(paths - t_ref, 0), axis=1)


# ─────────────────────────────────────────────────────────────────────────────
# FAIR PREMIUM  (NN-OU simulation averaged over observation years)
# ─────────────────────────────────────────────────────────────────────────────
def compute_fair_premium(nn_model: RegionNNModel, years: list, month: int,
                          strike: float, option_type: str,
                          n_sims: int, t_ref: float, index_type: str) -> float:
    """
    Fair premium = average across observation years of E[payoff | NN-OU simulation].
    Analogous to burn analysis average, but each year's expected payoff is estimated
    via Monte Carlo rather than observed historical payoff.

    Using a fixed seed per year ensures reproducibility.
    """
    annual_exp = []
    for yr in years:
        rng     = np.random.default_rng(seed=yr)   # reproducible per year
        indices = simulate_nn_month(nn_model, yr, month, n_sims, t_ref, index_type, rng)
        if option_type == "put":
            payoffs = np.maximum(strike - indices, 0)
        else:
            payoffs = np.maximum(indices - strike, 0)
        annual_exp.append(float(np.mean(payoffs)))
    return float(np.mean(annual_exp))


# ─────────────────────────────────────────────────────────────────────────────
# REALISED PAYOFFS from historical temperature data
# ─────────────────────────────────────────────────────────────────────────────
def realised_payoffs(index_series: np.ndarray, strike: float,
                      option_type: str) -> np.ndarray:
    """Actual payoff in each year based on realised temperature index."""
    if option_type == "put":
        return np.maximum(strike - index_series, 0)
    return np.maximum(index_series - strike, 0)


# ─────────────────────────────────────────────────────────────────────────────
# OPTIMAL HEDGE RATIO  (Johnson 1960 / Miranda 1991)
# ─────────────────────────────────────────────────────────────────────────────
def hedge_ratio_sd(revenue: np.ndarray, payoffs: np.ndarray) -> float:
    """
    z*_SD minimises Var(revenue + z*(payoff - premium)).
    Premium cancels in variance, so: z* = −Cov(revenue, payoff) / Var(payoff).
    Clamped to [0, ∞) — negative hedging is not considered.
    """
    cov_mat = np.cov(revenue, payoffs, ddof=1)
    var_p   = cov_mat[1, 1]
    if var_p < 1e-10:
        return 0.0
    return float(max(0.0, -cov_mat[0, 1] / var_p))


def hedge_ratio_var(revenue: np.ndarray, payoffs: np.ndarray,
                     premium: float, n_grid: int = 200) -> float:
    """
    z*_VaR minimises VaR90% of hedged revenue via grid search over z ∈ [0, 5].
    Equivalent to maximising the 10th percentile of the hedged revenue distribution.
    """
    z_grid   = np.linspace(0, 20, n_grid)   # upper bound raised from 5 to 20
    best_z   = 0.0
    best_p10 = np.inf   # we now minimise VaR (lower is better)
    # Minimise VaR90 = E[r] - Q10(r), i.e. maximise Q10(r) - E[r] shift
    # Equivalently: maximise Q10(hedged revenue) since E[hedged] ~ E[revenue] for fair premium
    for z in z_grid:
        hedged  = revenue + z * (payoffs - premium)
        var_val = float(np.mean(hedged) - np.percentile(hedged, 10))
        if var_val < best_p10:
            best_p10, best_z = var_val, z
    return best_z


# ─────────────────────────────────────────────────────────────────────────────
# HEDGING EFFECTIVENESS  (paper eq. 3)
# ─────────────────────────────────────────────────────────────────────────────
def hedging_effectiveness(revenue: np.ndarray, payoffs: np.ndarray,
                           premium: float, z_star: float):
    """
    Returns (HE_SD, HE_VaR90) as relative reductions.
    HE = (RM_without − RM_with) / RM_without
    VaR90% is defined as −10th percentile of revenue (shortfall measure).
    """
    hedged      = revenue + z_star * (payoffs - premium)
    sd_before   = float(np.std(revenue, ddof=1))
    sd_after    = float(np.std(hedged,  ddof=1))
    # VaR90 = shortfall from mean = E[r] - Q10(r)  (paper Section 3.1, Torriani et al. 2008)
    # Always positive; reduction is well-defined even when revenues are always positive
    var_before  = float(np.mean(revenue) - np.percentile(revenue, 10))
    var_after   = float(np.mean(hedged)  - np.percentile(hedged,  10))
    he_sd  = (sd_before  - sd_after)  / sd_before  if sd_before  > 1e-10 else 0.0
    he_var = (var_before - var_after) / var_before  if var_before > 1e-10 else 0.0
    return he_sd, he_var


# ─────────────────────────────────────────────────────────────────────────────
# MAIN ANALYSIS
# ─────────────────────────────────────────────────────────────────────────────
def run():
    print("Loading data...")
    yield_raw  = load_yield_data()
    temp_data  = load_temp_data()
    years      = list(range(OBS_START, OBS_END + 1))

    results = []

    for region in REGIONS:
        print(f"\n{'='*65}")
        print(f"  Region {region}")
        print(f"{'='*65}")

        # ── Yield data ─────────────────────────────────────────────────────
        reg_y = (yield_raw[yield_raw["reg"] == region]
                 .set_index("year").sort_index()["yield_wt"])
        reg_y.index = reg_y.index.astype(int)
        reg_y = reg_y[(reg_y.index >= OBS_START) & (reg_y.index <= OBS_END)]
        if len(reg_y) < 10:
            print(f"  Insufficient yield observations ({len(reg_y)}). Skipping.")
            continue

        yield_dt, trend_order, trend_beta = detrend_yields(reg_y)
        # Revenue: yield (dt/ha) × 0.1 (t/dt) × price (€/t) = €/ha
        revenue_series = yield_dt * 0.1 * WHEAT_PRICE
        print(f"  Yield years: {int(reg_y.index.min())}-{int(reg_y.index.max())} "
              f"(N={len(reg_y)})  |  trend model: {trend_order}  "
              f"slope: {trend_beta[1]:+.3f} dt/ha/yr")

        # ── Temperature data ───────────────────────────────────────────────
        if region not in temp_data:
            print(f"  No temperature data for region {region}. Skipping.")
            continue
        t_df = temp_data[region]

        # ── Load NN-OU model ───────────────────────────────────────────────
        nn_pkl_path = os.path.join(
            NN_PKL_DIR, f"ou_nn_region_{region}_calib_end_{CALIB_END_STR}.pkl"
        )
        alaton_path = os.path.join(ALATON_DIR, f"alaton_model_{region}.pkl")
        if not os.path.exists(nn_pkl_path):
            print(f"  NN PKL not found: {nn_pkl_path}. Skipping.")
            continue
        if not os.path.exists(alaton_path):
            print(f"  Alaton PKL not found: {alaton_path}. Skipping.")
            continue

        with open(nn_pkl_path,  "rb") as f: nn_pkl     = pickle.load(f)
        with open(alaton_path,  "rb") as f: alaton_pkl = pickle.load(f)
        print(f"  NN PKL keys: {list(nn_pkl.keys())}")
        nn_model = RegionNNModel(region, nn_pkl, alaton_pkl)
        arch     = nn_pkl["nn_architecture"]
        print(f"  NN-OU: hidden={arch['hidden']} layers={arch['n_layers']} "
              f"act={arch['activation']} vol_mult={nn_model.vol_mult:.3f} "
              f"t_df={nn_model.t_df:.1f}")

        # ── Process each index type ────────────────────────────────────────
        for index_type in ["HDD", "CDD"]:
            print(f"\n  [{index_type}]")

            # Build monthly index matrix over all observation years
            idx_matrix = build_index_matrix(t_df, years, CANDIDATE_MONTHS, T_REF, index_type)

            # Identify overlapping years between yield and temperature data
            common_years = sorted(
                set(yield_dt.index.tolist()) & set(idx_matrix.index.tolist())
            )
            if len(common_years) < 10:
                print(f"    Fewer than 10 overlapping years. Skipping.")
                continue

            yield_common   = yield_dt.loc[common_years]
            revenue_common = revenue_series.loc[common_years].values
            idx_common     = idx_matrix.loc[common_years]

            # Select best accumulation month
            best_m, best_r, opt_type, all_corrs = select_best_month(yield_common, idx_common)
            if best_m is None:
                print(f"    No month with significant correlation (p<0.10). Skipping.")
                print(f"    Best unsignificant corrs: " +
                      ", ".join(f"m{m}:r={v[0]:+.2f}(p={v[1]:.2f})"
                                for m, v in sorted(all_corrs.items(),
                                key=lambda x: abs(x[1][0]), reverse=True)[:3]))
                continue
            print(f"    Best month: {best_m:2d}  |  r = {best_r:+.3f}  "
                  f"|  option = {opt_type}")

            # Print top-3 months by |r| for transparency
            ranked = sorted(all_corrs.items(), key=lambda x: abs(x[1][0]), reverse=True)[:3]
            for m, (r, p) in ranked:
                print(f"      month {m:2d}: r={r:+.3f}  p={p:.3f}")

            # Realised historical index for the best month
            idx_hist = idx_common[best_m].values
            strike   = float(np.nanmean(idx_hist))
            print(f"    Strike (long-run mean): {strike:.1f} degree-days")

            # Realised historical payoffs
            pay_hist = realised_payoffs(idx_hist, strike, opt_type)
            print(f"    Mean realised payoff: {np.mean(pay_hist):.2f} °C-days "
                  f"(SD: {np.std(pay_hist):.2f})")

            # Fair premium via NN-OU Monte Carlo
            print(f"    Computing fair premium ({N_SIMS:,} sims × {len(common_years)} yrs)...")
            fair_prem = compute_fair_premium(
                nn_model, common_years, best_m, strike, opt_type,
                N_SIMS, T_REF, index_type
            )
            # Convert to €/ha: payoff is in °C-days; 1 contract = €1/°C-day (paper convention)
            # For comparability with the paper we report the premium in its natural unit
            print(f"    Fair premium: {fair_prem:.2f} °C-days (expected payoff)")

            # Optimal hedge ratios
            z_sd  = hedge_ratio_sd(revenue_common, pay_hist)
            z_var = hedge_ratio_var(revenue_common, pay_hist, fair_prem)
            print(f"    z*_SD  = {z_sd:.3f}  |  z*_VaR = {z_var:.3f}")

            # Hedging effectiveness under each z*
            he_sd_sd,  he_var_sd  = hedging_effectiveness(
                revenue_common, pay_hist, fair_prem, z_sd)
            he_sd_var, he_var_var = hedging_effectiveness(
                revenue_common, pay_hist, fair_prem, z_var)

            # Revenue risk measures without insurance
            sd_no_ins  = float(np.std(revenue_common, ddof=1))
            # VaR90 = E[revenue] - Q10(revenue): shortfall from mean (paper Section 3.1)
            var_no_ins = float(np.mean(revenue_common) - np.percentile(revenue_common, 10))

            results.append({
                "region":       region,
                "index_type":   index_type,
                "best_month":   int(best_m),
                "pearson_r":    round(best_r, 3),
                "option_type":  opt_type,
                "strike_dddays": round(strike, 1),
                "fair_premium": round(fair_prem, 2),
                "z_star_sd":    round(z_sd, 3),
                "z_star_var":   round(z_var, 3),
                # Risk measures WITHOUT insurance
                "sd_no_ins_eur_ha":  round(sd_no_ins, 2),
                "var90_no_ins_eur_ha": round(var_no_ins, 2),
                # Hedging effectiveness — SD-optimised contracts
                "he_sd_pct_sdopt":  round(he_sd_sd * 100, 1),
                "he_var_pct_sdopt": round(he_var_sd * 100, 1),
                # Hedging effectiveness — VaR90-optimised contracts
                "he_sd_pct_varopt":  round(he_sd_var * 100, 1),
                "he_var_pct_varopt": round(he_var_var * 100, 1),
                "n_years":      len(common_years),
            })

    # ── Print output table (mirroring paper Table II) ──────────────────────
    if not results:
        print("\nNo results produced. Check PKL paths and data availability.")
        return pd.DataFrame()

    df_out = pd.DataFrame(results)

    print("\n\n" + "="*100)
    print("TABLE — Hedging Effectiveness of Temperature Index-Based Insurance")
    print("        French Winter Wheat, Regions {}, T_REF={}°C, Price={}€/t".format(
        REGIONS, T_REF, WHEAT_PRICE))
    print("="*100)

    HDR = ("{:<8} {:<6} {:>6} {:<5} {:>7} {:>7} {:>7} {:>7}"
           "  |  {:>9} {:>8}  |  {:>9} {:>8}  |  N")
    SEP = "-"*100
    print(HDR.format(
        "Region", "Index", "Month", "Opt", "Strike", "Prem", "z*_SD", "z*_VaR",
        "SD €/ha", "HE_SD%",
        "VaR90 €/ha", "HE_VaR%"
    ))
    print(SEP)

    for idx_type in ["HDD", "CDD"]:
        sub = df_out[df_out["index_type"] == idx_type]
        if sub.empty:
            continue
        print(f"\n  {idx_type}")
        for _, r in sub.iterrows():
            print(
                f"  {int(r.region):<6} {r.index_type:<6} {r.best_month:>6} "
                f"{r.option_type:<5} {r.strike_dddays:>7.1f} {r.fair_premium:>7.2f} "
                f"{r.z_star_sd:>7.3f} {r.z_star_var:>7.3f}"
                f"  |  {r.sd_no_ins_eur_ha:>9.2f} {r.he_sd_pct_sdopt:>8.1f}%"
                f"  |  {r.var90_no_ins_eur_ha:>9.2f} {r.he_var_pct_varopt:>8.1f}%"
                f"  |  {int(r.n_years)}"
            )

    print(SEP)
    print("Notes: HE_SD% reported under z*_SD (variance-minimising contracts).")
    print("       HE_VaR% reported under z*_VaR (VaR90-minimising contracts).")
    print("       Each effectiveness measure uses its own independently optimised z* (paper Table II).")
    print("       Strike = long-run mean index (degree-days). Premium = NN-OU E[payoff].")
    print("       SD and VaR90 of revenue in euros/ha (MM-detrended yields at final-year level).")

    # Save to CSV
    os.makedirs("Outputs", exist_ok=True)
    out_path = "Outputs/hedging_effectiveness_results.csv"
    df_out.to_csv(out_path, index=False)
    print(f"\nFull results saved → {out_path}")
    return df_out


if __name__ == "__main__":
    run()