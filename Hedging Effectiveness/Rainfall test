# SECTION 3: INDEX COMPUTATION
# ═══════════════════════════════════════════════════════════════════════════════

def compute_temp_index(temp_df, year, months, index_type, t_ref=T_REF):
    """
    Compute temperature index over a potentially cross-year window.
    Months >= 10 are taken from year-1 (Oct–Dec sowing period),
    months < 10 from the current year (Jan–Jul growing/harvest).
    """
    prior_months   = [m for m in months if m >= 10]
    current_months = [m for m in months if m < 10]

    frames = []
    if prior_months:
        mask = ((temp_df.index.year == year - 1) &
                temp_df.index.month.isin(prior_months))
        frames.append(temp_df.loc[mask, "V"].values)
    if current_months:
        mask = ((temp_df.index.year == year) &
                temp_df.index.month.isin(current_months))
        frames.append(temp_df.loc[mask, "V"].values)

    if not frames:
        return np.nan
    T = np.concatenate(frames)
    if len(T) == 0:
        return np.nan

    if index_type == "HDD":
        return float(np.nansum(np.maximum(t_ref - T, 0)))
    elif index_type == "CDD":
        return float(np.nansum(np.maximum(T - t_ref, 0)))
    else:   # CAT
        return float(np.nansum(T))


def compute_rain_index(rain_df, year, months, index_type, p_ref=None):
    """
    RAI: cumulative precipitation over window (analogous to CAT).
    DRY: cumulative rainfall deficit below p_ref (analogous to HDD).
    WET: cumulative excess above p_ref (analogous to CDD).

    Cross-year windows (e.g. Oct–Jul) handled by splitting into
    prior-year Oct–Dec and current-year Jan–Jul.
    """
    # Split months into prior-year (Oct–Dec) and current-year (Jan–Sep)
    prior_months   = [m for m in months if m >= 10]
    current_months = [m for m in months if m < 10]

    frames = []
    if prior_months:
        mask = ((rain_df.index.year == year - 1) &
                rain_df.index.month.isin(prior_months))
        frames.append(rain_df.loc[mask, "V"].values)
    if current_months:
        mask = ((rain_df.index.year == year) &
                rain_df.index.month.isin(current_months))
        frames.append(rain_df.loc[mask, "V"].values)

    if not frames:
        return np.nan
    P = np.concatenate(frames)
    if len(P) == 0:
        return np.nan

    if index_type == "RAI":
        return float(np.nansum(P))
    elif index_type == "DRY":
        ref = p_ref if p_ref is not None else float(np.mean(P))
        return float(np.sum(np.maximum(ref - P, 0)))
    else:   # WET
        ref = p_ref if p_ref is not None else float(np.mean(P))
        return float(np.sum(np.maximum(P - ref, 0)))


def build_temp_vector(temp_df, years, months, index_type):
    return np.array([compute_temp_index(temp_df, yr, months, index_type)
                     for yr in years], dtype=float)


def build_rain_vector(rain_df, years, months, index_type, p_ref=None):
    return np.array([compute_rain_index(rain_df, yr, months, index_type, p_ref)
                     for yr in years], dtype=float)


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 4: CANDIDATE WINDOWS
# ═══════════════════════════════════════════════════════════════════════════════

def temp_candidate_windows():
    specs = []
    for idx_type, pool in [("HDD", HDD_MONTHS), ("CDD", CDD_MONTHS),
                           ("CAT", CAT_MONTHS)]:
        for m in pool:
            specs.append((idx_type, [m]))
        for start in range(len(pool)):
            for length in range(2, MAX_WINDOW + 1):
                if start + length > len(pool):
                    break
                specs.append((idx_type, pool[start:start + length]))
    return specs


def rain_candidate_windows():
    """
    Candidate windows over Oct–Jul (cross-year growing cycle).
    RAI (cumulative precipitation) is the standard OTC rainfall derivative
    index — the direct precipitation analogue of CAT for temperature.
    DRY/WET (deficit/excess around a threshold) are non-standard and excluded.
    """
    pool = RAIN_MONTHS
    specs = []
    for m in pool:
        specs.append(("RAI", [m]))
    for start in range(len(pool)):
        for length in range(2, MAX_WINDOW + 1):
            if start + length > len(pool):
                break
            specs.append(("RAI", pool[start:start + length]))
    return specs


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 5: BEST INDEX SELECTION (Möllmann §2a)
# ═══════════════════════════════════════════════════════════════════════════════

def select_best_temp_index(dt_yields, years, temp_df):
    best = None
    for idx_type, months in temp_candidate_windows():
        idx = build_temp_vector(temp_df, years, months, idx_type)
        valid = ~(np.isnan(idx) | np.isnan(dt_yields))
        if valid.sum() < 8:
            continue
        r, p = stats.spearmanr(dt_yields[valid], idx[valid])
        if best is None or abs(r) > abs(best["corr"]):
            best = {"index_type": idx_type, "months": months,
                    "corr": r, "r_squared": r**2, "p_value": p,
                    "vector": idx}
    return best


def select_best_rain_index(dt_yields, years, rain_df, p_ref):
    best = None
    for idx_type, months in rain_candidate_windows():
        idx = build_rain_vector(rain_df, years, months, idx_type, p_ref)
        valid = ~(np.isnan(idx) | np.isnan(dt_yields))
        if valid.sum() < 8:
            continue
        r, p = stats.spearmanr(dt_yields[valid], idx[valid])
        if best is None or abs(r) > abs(best["corr"]):
            best = {"index_type": idx_type, "months": months,
                    "corr": r, "r_squared": r**2, "p_value": p,
                    "vector": idx}
    return best


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 6: OLS INCREMENTAL R² AND F-TEST (Greene 2012 §5.4)
# ═══════════════════════════════════════════════════════════════════════════════

def ols_r2(y, X):
    """OLS R² for y ~ X (X should include constant column)."""
    valid = ~np.isnan(y)
    for col in range(X.shape[1]):
        valid = valid & ~np.isnan(X[:, col])
    yv, Xv = y[valid], X[valid]
    if len(yv) < X.shape[1] + 2:
        return np.nan, np.nan, len(yv)
    b, res, rank, _ = np.linalg.lstsq(Xv, yv, rcond=None)
    y_hat = Xv @ b
    ss_res = float(np.sum((yv - y_hat)**2))
    ss_tot = float(np.sum((yv - yv.mean())**2))
    r2 = 1.0 - ss_res / ss_tot if ss_tot > 1e-10 else 0.0
    return float(r2), float(ss_res), int(len(yv))


def incremental_f_test(y, X_base, X_full):
    """
    F-test: does adding columns in X_full (vs X_base) significantly improve fit?
    X_base and X_full must both include a constant column.
    Returns: delta_R2, F-statistic, p-value.
    """
    r2_base, ssr_base, n_base = ols_r2(y, X_base)
    r2_full, ssr_full, n_full = ols_r2(y, X_full)

    if np.isnan(r2_base) or np.isnan(r2_full):
        return np.nan, np.nan, np.nan

    n  = n_full
    k_base = X_base.shape[1]   # includes constant
    k_full = X_full.shape[1]
    q  = k_full - k_base        # number of added regressors

    if ssr_full <= 1e-12 or q < 1:
        return r2_full - r2_base, np.nan, np.nan

    # F = [(SSR_base - SSR_full) / q] / [SSR_full / (n - k_full)]
    F = ((ssr_base - ssr_full) / q) / (ssr_full / (n - k_full))
    p_val = 1.0 - stats.f.cdf(F, dfn=q, dfd=n - k_full)

    return float(r2_full - r2_base), float(F), float(p_val)


