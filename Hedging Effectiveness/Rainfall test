HDD_MONTHS  = FULL_SEASON    # cold stress across full season
CDD_MONTHS  = FULL_SEASON    # heat stress across full season
CAT_MONTHS  = FULL_SEASON    # cumulative temp across full season

# Rainfall index candidate months — winter wheat full cycle
# Oct–Jul covers sowing through grain filling
RAIN_MONTHS = list(range(10, 13)) + list(range(1, 8))   # Oct–Jul (cross-year)
MAX_WINDOW  = 5

