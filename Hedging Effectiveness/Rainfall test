def run():
    print("=" * 85)
    print("  RAINFALL vs TEMPERATURE — Yield Impact Analysis")
    print("  French Winter Wheat | 8 NUTS-2 Regions")
    print(f"  Calibration window: {CALIB_START}–{CALIB_END}")
    print(f"  Part 1: Spearman ρ² comparison (Möllmann §2a)")
    print(f"  Part 2: OLS incremental R² + F-test (Greene 2012 §5.4)")
    print("=" * 85)

    yield_raw = load_yield_data()
    temp_data = load_daily_data(TEMP_CSV, value_col_hint="daily_avg_temperature")
    rain_data = load_daily_data(RAIN_CSV, value_col_hint="daily_precipitation_mm")

    os.makedirs(OUTPUT_DIR, exist_ok=True)

    calib_years = list(range(CALIB_START, CALIB_END + 1))
    results = []

    for region in REGIONS:
        print(f"\n{'─'*75}")
        print(f"  Region {region} — {REGION_NAMES.get(region, '?')}")
        print(f"{'─'*75}")

        # ── Yield ─────────────────────────────────────────────────────────────
        ry = (yield_raw[yield_raw["reg"] == region]
              .set_index("year").sort_index()["yield_wt"])
        ry.index = ry.index.astype(int)
        calib = ry[(ry.index >= CALIB_START) & (ry.index <= CALIB_END)]
        if len(calib) < 10:
            print("  Insufficient yield data. Skipping."); continue

        yrs   = calib.index.values.astype(float)
        vals  = calib.values.astype(float)
        dt_y, trend, wald_p = detrend_yield(yrs, vals, final_year=CALIB_END)
        yrs_i = yrs.astype(int)
        print(f"  Yield: N={len(calib)}  trend={trend}  Wald p={wald_p:.4f}")

        if region not in temp_data or region not in rain_data:
            print("  Missing temp or rain data. Skipping."); continue

        tdf = temp_data[region]
        rdf = rain_data[region]

        # Regional long-run daily mean rainfall → P_REF for DRY/WET indices
        rain_calib_mask = (rdf.index.year >= CALIB_START) & (rdf.index.year <= CALIB_END)
        p_ref = float(rdf.loc[rain_calib_mask, "V"].mean())
        print(f"  P_REF (daily mean, calib): {p_ref:.2f} mm/day")

        # ── Part 1: Best index selection ──────────────────────────────────────
        best_temp = select_best_temp_index(dt_y, yrs_i, tdf)
        best_rain = select_best_rain_index(dt_y, yrs_i, rdf, p_ref)

        if best_temp is None or best_rain is None:
            print("  Could not find valid index. Skipping."); continue

        mo_t = "-".join(f"M{m:02d}" for m in best_temp["months"])
        mo_r = "-".join(f"M{m:02d}" for m in best_rain["months"])

        sig_t = ("***" if best_temp["p_value"] < 0.001 else
                 "**" if best_temp["p_value"] < 0.01 else
                 "*" if best_temp["p_value"] < 0.05 else
                 "." if best_temp["p_value"] < 0.10 else "ns")
        sig_r = ("***" if best_rain["p_value"] < 0.001 else
                 "**" if best_rain["p_value"] < 0.01 else
                 "*" if best_rain["p_value"] < 0.05 else
                 "." if best_rain["p_value"] < 0.10 else "ns")

        print(f"\n  Part 1 — Spearman ρ² comparison:")
        print(f"    Temperature  {best_temp['index_type']:<4} {mo_t:<15}  "
              f"ρ={best_temp['corr']:>+.3f}  ρ²={best_temp['r_squared']:.3f}  "
              f"p={best_temp['p_value']:.4f} {sig_t}")
        print(f"    Rainfall     {best_rain['index_type']:<4} {mo_r:<15}  "
              f"ρ={best_rain['corr']:>+.3f}  ρ²={best_rain['r_squared']:.3f}  "
              f"p={best_rain['p_value']:.4f} {sig_r}")

        winner = ("Temperature" if best_temp["r_squared"] >= best_rain["r_squared"]
                  else "Rainfall")
        gap = abs(best_temp["r_squared"] - best_rain["r_squared"])
        print(f"    → {winner} explains more yield variance  "
              f"(Δρ²={gap:.3f})")

        # ── Part 2: Incremental R² ────────────────────────────────────────────
        # Align all three vectors on valid observations
        t_vec = best_temp["vector"]
        r_vec = best_rain["vector"]

        valid = (~np.isnan(dt_y) & ~np.isnan(t_vec) & ~np.isnan(r_vec))
        y_v  = dt_y[valid]
        t_v  = t_vec[valid]
        r_v  = r_vec[valid]
        n_v  = int(valid.sum())

        ones = np.ones(n_v)
        X_null  = np.column_stack([ones])                  # intercept only
        X_temp  = np.column_stack([ones, t_v])             # + temperature
        X_rain  = np.column_stack([ones, r_v])             # + rainfall
        X_both  = np.column_stack([ones, t_v, r_v])        # + both

        r2_null, _, _  = ols_r2(y_v, X_null)
        r2_temp, _, _  = ols_r2(y_v, X_temp)
        r2_rain, _, _  = ols_r2(y_v, X_rain)
        r2_both, _, _  = ols_r2(y_v, X_both)

        # Incremental: does rain add anything beyond temperature?
        dr2_rain_given_temp, F_rain, p_rain = incremental_f_test(
            y_v, X_temp, X_both)

        # Incremental: does temperature add anything beyond rainfall?
        dr2_temp_given_rain, F_temp, p_temp = incremental_f_test(
            y_v, X_rain, X_both)

        print(f"\n  Part 2 — Incremental R² (OLS, n={n_v}):")
        print(f"    R²(intercept only):       {r2_null:.3f}")
        print(f"    R²(temperature only):     {r2_temp:.3f}")
        print(f"    R²(rainfall only):        {r2_rain:.3f}")
        print(f"    R²(temperature+rainfall): {r2_both:.3f}")
        print(f"    ΔR²(rain | temp):         {dr2_rain_given_temp:+.3f}  "
              f"F={F_rain:.2f}  p={p_rain:.4f}"
              + ("  *" if p_rain < 0.05 else "  ." if p_rain < 0.10 else ""))
        print(f"    ΔR²(temp | rain):         {dr2_temp_given_rain:+.3f}  "
              f"F={F_temp:.2f}  p={p_temp:.4f}"
              + ("  *" if p_temp < 0.05 else "  ." if p_temp < 0.10 else ""))

        # Interpretation
        if p_rain < 0.05:
            interp = "Rainfall adds significant explanatory power beyond temperature."
        elif p_rain < 0.10:
            interp = "Rainfall adds marginal explanatory power (p<0.10)."
        else:
            interp = "Rainfall does not significantly improve on temperature alone."
        print(f"    → {interp}")

        results.append({
            "region":               region,
            "region_name":          REGION_NAMES.get(region, "?"),
            "n_calib":              n_v,
            "trend":                trend,
            # Temperature
            "temp_index":           best_temp["index_type"],
            "temp_months":          mo_t,
            "temp_rho":             round(best_temp["corr"], 4),
            "temp_rho2":            round(best_temp["r_squared"], 4),
            "temp_p":               round(best_temp["p_value"], 4),
            # Rainfall
            "rain_index":           best_rain["index_type"],
            "rain_months":          mo_r,
            "rain_rho":             round(best_rain["corr"], 4),
            "rain_rho2":            round(best_rain["r_squared"], 4),
            "rain_p":               round(best_rain["p_value"], 4),
            "p_ref_mm":             round(p_ref, 3),
            # OLS R²
            "r2_temp_only":         round(r2_temp, 4),
            "r2_rain_only":         round(r2_rain, 4),
            "r2_both":              round(r2_both, 4),
            # Incremental
            "delta_r2_rain_given_temp": round(dr2_rain_given_temp, 4),
            "F_rain_given_temp":    round(F_rain, 3) if not np.isnan(F_rain) else np.nan,
            "p_rain_given_temp":    round(p_rain, 4) if not np.isnan(p_rain) else np.nan,
            "delta_r2_temp_given_rain": round(dr2_temp_given_rain, 4),
            "F_temp_given_rain":    round(F_temp, 3) if not np.isnan(F_temp) else np.nan,
            "p_temp_given_rain":    round(p_temp, 4) if not np.isnan(p_temp) else np.nan,
            "rain_sig_beyond_temp": p_rain < 0.05 if not np.isnan(p_rain) else False,
        })

    # ══════════════════════════════════════════════════════════════════════════
    # SUMMARY OUTPUT
    # ══════════════════════════════════════════════════════════════════════════
    if not results:
        print("\nNo results."); return

    df = pd.DataFrame(results)
    SEP = "=" * 100

    print(f"\n\n{SEP}")
    print("  SUMMARY — RAINFALL vs TEMPERATURE YIELD IMPACT")
    print(f"  Calibration {CALIB_START}–{CALIB_END} | "
          f"Index selection: max |Spearman ρ| (Möllmann §2a)")
    print(SEP)

    # Part 1 table
    print(f"\n  PART 1 — Spearman ρ² Comparison")
    hdr = (f"  {'Reg':<5}{'Name':<22}{'Temp index':<22}{'ρ²(T)':>7}"
           f"{'Rain index':<22}{'ρ²(R)':>7}{'Winner':>12}{'Δρ²':>7}")
    print(hdr)
    print(f"  {'─'*95}")
    for _, r in df.iterrows():
        winner = "Temp" if r.temp_rho2 >= r.rain_rho2 else "Rain"
        gap = abs(r.temp_rho2 - r.rain_rho2)
        t_str = f"{r.temp_index} {r.temp_months}"
        rain_str = f"{r.rain_index} {r.rain_months}"
        print(f"  {int(r.region):<5}{r.region_name:<22}{t_str:<22}{r.temp_rho2:>7.3f}"
              f"{rain_str:<22}{r.rain_rho2:>7.3f}{winner:>12}{gap:>7.3f}")

    print(f"\n  Means:  ρ²(temp)={df['temp_rho2'].mean():.3f}  "
          f"ρ²(rain)={df['rain_rho2'].mean():.3f}")

    # Part 2 table
    print(f"\n\n  PART 2 — Incremental R² (does rainfall add beyond temperature?)")
    hdr2 = (f"  {'Reg':<5}{'Name':<22}{'R²(T)':>7}{'R²(R)':>7}{'R²(T+R)':>9}"
            f"{'ΔR²(R|T)':>10}{'F':>7}{'p':>8}{'Sig':>5}")
    print(hdr2)
    print(f"  {'─'*80}")
    for _, r in df.iterrows():
        sig = ("*" if r.p_rain_given_temp < 0.05 else
               "." if r.p_rain_given_temp < 0.10 else "")
        p_str = f"{r.p_rain_given_temp:.4f}" if not pd.isna(r.p_rain_given_temp) else "  nan"
        F_str = f"{r.F_rain_given_temp:.2f}" if not pd.isna(r.F_rain_given_temp) else " nan"
        print(f"  {int(r.region):<5}{r.region_name:<22}"
              f"{r.r2_temp_only:>7.3f}{r.r2_rain_only:>7.3f}{r.r2_both:>9.3f}"
              f"{r.delta_r2_rain_given_temp:>+10.3f}{F_str:>7}{p_str:>8}{sig:>5}")

    n_sig = int(df["rain_sig_beyond_temp"].sum())
    print(f"\n  → Rainfall significant beyond temperature (p<0.05): "
          f"{n_sig}/{len(df)} regions")

    # Pooled Spearman comparison (all regions)
    print(f"\n  Pooled across regions:")
    print(f"    Mean ρ²(temperature): {df['temp_rho2'].mean():.3f}  "
          f"(range {df['temp_rho2'].min():.3f}–{df['temp_rho2'].max():.3f})")
    print(f"    Mean ρ²(rainfall):    {df['rain_rho2'].mean():.3f}  "
          f"(range {df['rain_rho2'].min():.3f}–{df['rain_rho2'].max():.3f})")
    print(f"    Mean R²(both):        {df['r2_both'].mean():.3f}  "
          f"(mean gain from adding rain: "
          f"{df['delta_r2_rain_given_temp'].mean():+.3f})")

    # Methodology
    print(f"\n{SEP}")
    print("METHODOLOGY")
    print(f"  Detrending:    MM-estimator + Wald test (Pelka §2, Finger 2010)")
    print(f"  Index selection: max |Spearman ρ| (Möllmann et al. 2019 §2a)")
    print(f"  Temp indices:  HDD=Σmax(T_REF−T,0)  CDD=Σmax(T−T_REF,0)  CAT=ΣT")
    print(f"  Rain indices:  RAI=ΣP  (cumulative precipitation, standard OTC index)")
    print(f"                 DRY/WET excluded — non-standard, no CME precedent")
    print(f"  Incremental R²: OLS F-test H0: β_rain=0 given temperature (Greene 2012 §5.4)")
    print(f"  All selection on calibration window {CALIB_START}–{CALIB_END} only")

    df.to_csv(f"{OUTPUT_DIR}/rainfall_yield_summary.csv", index=False)
    print(f"\n  Saved → {OUTPUT_DIR}/rainfall_yield_summary.csv")

    return df


