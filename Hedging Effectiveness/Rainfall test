# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 1: DATA LOADING
# ═══════════════════════════════════════════════════════════════════════════════

def load_yield_data():
    df = pd.read_csv(YIELD_CSV)
    df["weighted_yield"] = df["yield"] * df["surf"]
    agg = (df.groupby(["year", "reg"])
             .agg(total_wt=("weighted_yield", "sum"),
                  total_surf=("surf", "sum"))
             .reset_index())
    agg["yield_wt"] = agg["total_wt"] / agg["total_surf"]
    agg["year"] = agg["year"].astype(int)
    return agg[["year", "reg", "yield_wt"]]


def load_daily_data(csv_path, value_col_hint=None):
    """
    Generic loader for daily regional CSVs (temperature or rainfall).
    Expects: date, region_code, <value column>.
    Returns dict: {region_code: DataFrame indexed by date with column 'V'}.
    """
    df = pd.read_csv(csv_path, parse_dates=["date"])

    # Identify value column (not date, not region_code)
    if value_col_hint and value_col_hint in df.columns:
        val_col = value_col_hint
    else:
        candidates = [c for c in df.columns
                      if c not in ("date", "region_code")]
        if not candidates:
            raise ValueError(f"Cannot find value column in {csv_path}")
        val_col = candidates[0]

    out = {}
    for reg in REGIONS:
        sub = df[df["region_code"] == reg][["date", val_col]].copy()
        sub = sub.dropna(subset=["date"]).sort_values("date")
        sub = sub.set_index("date").rename(columns={val_col: "V"})
        out[reg] = sub
    return out


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 2: YIELD DETRENDING (Pelka §2, Finger 2010)
# ═══════════════════════════════════════════════════════════════════════════════

def detrend_yield(years, yields, final_year=None):
    if final_year is None:
        final_year = int(years.max())
    n   = len(years)
    t   = years - years.min()
    t_f = final_year - years.min()

    if USE_OLS_DETREND:
        # Plain OLS — exploratory comparison with MM-estimator
        A_lin  = np.column_stack([np.ones(n), t])
        A_quad = np.column_stack([np.ones(n), t, t**2])
        b_lin,  *_ = np.linalg.lstsq(A_lin,  yields, rcond=None)
        b_quad, *_ = np.linalg.lstsq(A_quad, yields, rcond=None)

        # Wald test on quadratic term via OLS residual variance
        y_hat_quad = A_quad @ b_quad
        resid_quad = yields - y_hat_quad
        n_eff  = n - 3
        se_c   = np.sqrt(np.sum(resid_quad**2) / n_eff *
                         np.linalg.inv(A_quad.T @ A_quad)[2, 2]) if n_eff > 0 else 1e12
        wald_stat = (b_quad[2] / se_c)**2 if se_c > 1e-12 else 0.0
        wald_p    = 1.0 - stats.chi2.cdf(wald_stat, df=1)

        if wald_p < 0.05:
            tv = b_quad[0] + b_quad[1]*t + b_quad[2]*t**2
            tf = b_quad[0] + b_quad[1]*t_f + b_quad[2]*t_f**2
            return yields - tv + tf, "quadratic (OLS)", wald_p
        else:
            tv = b_lin[0] + b_lin[1]*t
            tf = b_lin[0] + b_lin[1]*t_f
            return yields - tv + tf, "linear (OLS)", wald_p

    else:
        # MM-estimator + Wald test (Pelka §2, Finger 2010) — methodological default
        try:
            import statsmodels.api as sm
            from statsmodels.robust.robust_linear_model import RLM

            X_lin  = sm.add_constant(t)
            res_lin = RLM(yields, X_lin,
                          M=sm.robust.norms.TukeyBiweight()).fit()

            X_quad = np.column_stack([np.ones(n), t, t**2])
            res_quad = RLM(yields, X_quad,
                           M=sm.robust.norms.TukeyBiweight()).fit()

            c_se = res_quad.bse[2]
            wald_stat = (res_quad.params[2] / c_se)**2 if c_se > 1e-12 else 0.0
            wald_p = 1.0 - stats.chi2.cdf(wald_stat, df=1)

            if wald_p < 0.05:
                p = res_quad.params
                tv = p[0] + p[1]*t + p[2]*t**2
                tf = p[0] + p[1]*t_f + p[2]*t_f**2
                return yields - tv + tf, "quadratic (MM)", wald_p
            else:
                p = res_lin.params
                tv = p[0] + p[1]*t
                tf = p[0] + p[1]*t_f
                return yields - tv + tf, "linear (MM)", wald_p

        except ImportError:
            A = np.column_stack([np.ones(n), t])
            b, *_ = np.linalg.lstsq(A, yields, rcond=None)
            tv = b[0] + b[1]*t
            tf = b[0] + b[1]*t_f
            return yields - tv + tf, "linear (OLS fallback)", np.nan


