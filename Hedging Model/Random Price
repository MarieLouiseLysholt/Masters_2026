"""
Weather derivative hedging for winter wheat — call on CDD index.
Too much heat during grain filling → yield drops → call pays out.

Research design (now aligned with the uploaded methodologies):
- Detrend yields for technological progress (linear trend; Möllmann et al.)
- Fit a QUANTILE REGRESSION of (detrended) yield on the weather index (tail focus)
- Choose optimal hedge size n* on TRAIN only by minimizing Expected Shortfall (ES)
- Evaluate out-of-sample on TEST: ES-based hedging effectiveness + basis risk reduction
- Report statistical diagnostics (correlation, OLS R², quantile regression estimates)

Premium is fixed at 200 for now.
"""

import numpy as np
import matplotlib.pyplot as plt
import statsmodels.api as sm


# Data

daily_temps = [
    [20,21,22,21,20,22,23,21,20,21,22,21,20,22,23,21,20,21,22,21,20,22,23,21,20,21,22,21,20,21],
    [21,22,21,20,21,22,23,22,21,20,21,22,23,22,21,20,21,22,23,22,21,20,21,22,23,22,21,20,21,22],
    [19,20,21,22,21,20,21,22,21,20,19,20,21,22,21,20,21,22,21,20,19,20,21,22,21,20,21,22,21,20],
    [20,21,20,21,22,21,20,21,22,21,20,21,20,21,22,21,20,21,22,21,20,21,20,21,22,21,20,21,22,21],
    [21,21,22,22,21,21,22,22,21,21,22,22,21,21,22,22,21,21,22,22,21,21,22,22,21,21,22,22,21,21],
    [26,27,28,27,26,28,29,27,26,27,28,27,26,28,29,27,26,27,28,27,26,28,29,27,26,27,28,27,26,27],
    [25,26,27,28,27,26,27,28,27,26,25,26,27,28,27,26,27,28,27,26,25,26,27,28,27,26,27,28,27,26],
    [28,29,30,29,28,29,30,29,28,29,28,29,30,29,28,29,30,29,28,29,28,29,30,29,28,29,30,29,28,29],
    [22,23,22,21,22,23,24,23,22,21,22,23,22,21,22,23,24,23,22,21,22,23,22,21,22,23,24,23,22,21],
    [19,20,22,23,21,20,22,24,22,20,19,20,22,23,21,20,22,24,22,20,19,20,22,23,21,20,22,24,22,20],
    [24,25,24,23,24,25,26,25,24,23,24,25,24,23,24,25,26,25,24,23,24,25,24,23,24,25,26,25,24,23],
    [17,18,19,20,19,18,19,20,19,18,17,18,19,20,19,18,19,20,19,18,17,18,19,20,19,18,19,20,19,18],
    [23,24,25,24,23,25,26,24,23,24,25,24,23,25,26,24,23,24,25,24,23,25,26,24,23,24,25,24,23,24],
    [27,28,27,28,27,28,29,28,27,28,27,28,27,28,29,28,27,28,27,28,27,28,29,28,27,28,27,28,27,28],
    [20,21,22,21,22,21,20,21,22,21,20,21,22,21,22,21,20,21,22,21,20,21,22,21,22,21,20,21,22,21],
]

yield_observed = [
    7.8, 7.6, 7.9, 7.7, 7.5,
    5.2, 5.8, 4.5,
    7.0, 7.4, 6.2,
    8.1, 6.0, 5.0, 7.7,
]

unit_price = 200.0

daily_temps = np.array(daily_temps, dtype=float)
yield_observed = np.array(yield_observed, dtype=float)


# DETREND YIELD (technological trend; linear regression) --

t = np.arange(1, len(yield_observed) + 1)
slope, intercept = np.polyfit(t, yield_observed, 1)
trend = intercept + slope * t

# residuals re-centered to keep yield units
yield_detrended = (yield_observed - trend) + np.mean(yield_observed)

print("\nYield detrending (linear trend removed)")
print(f"Trend slope (tech change per year): {slope:.4f}")


# CALCULATE CDD INDEX

base_temp = 10.0
daily_dd = np.maximum(daily_temps - base_temp, 0)
index = daily_dd.sum(axis=1)

print(f"\nCDD index (base {base_temp}°C)")
print(f"Values: {np.round(index, 1)}")


# OPTION PARAMETERS

K = 370
tick = 5.0
cap = 600

premium = 150  # fixed for now


# -- TRAIN/TEST SPLI

train_years = 10
index_train = index[:train_years]
yield_train = yield_detrended[:train_years]

index_test = index[train_years:]
yield_test = yield_detrended[train_years:]

print(f"\nTrain/Test split: train_years={train_years}, test_years={len(index)-train_years}")


# -- STEP 3: PAYOFF FUNCTION --

def call_payoff_from_index(index_values):
    call_dd = np.minimum(np.maximum(index_values - K, 0), cap - K)
    return tick * call_dd


# -- STEP 4: STATISTICS (TRAIN): OLS + QUANTILE REGRESSION --

X_train = sm.add_constant(index_train)
y_train = yield_train

# OLS
ols = sm.OLS(y_train, X_train).fit()

# Quantile Regression (tail-focused)
tau = 0.30  # consistent with common ES/quantile tail focus in this literature
qr = sm.QuantReg(y_train, X_train).fit(q=tau)

corr_train = np.corrcoef(index_train, y_train)[0, 1]

print("\n--- TRAIN STATISTICS: Yield vs Index ---")
print(f"Correlation (Index, detrended yield): {corr_train:.3f}")
print(f"OLS:  y = a + b*Index  |  b={ols.params[1]:.6f}, p={ols.pvalues[1]:.4f}, R²={ols.rsquared:.3f}")
print(f"QReg (tau={tau:.2f}): y_tau = a + b*Index | b={qr.params[1]:.6f}, p={qr.pvalues[1]:.4f}")

# Simple “tail sensitivity” diagnostic: compare QR slope vs OLS slope
if np.isfinite(ols.params[1]) and abs(ols.params[1]) > 1e-12:
    print(f"Slope ratio (QReg/OLS): {qr.params[1]/ols.params[1]:.3f}")


# -- STEP 5: MONTE CARLO SIMULATION (train + test separately) --

n_sim = 10000

def simulate_from_subset(index_subset, yield_subset, seed, n_sim=10000):
    rng = np.random.default_rng(seed)

    draws = rng.integers(0, len(index_subset), size=n_sim)
    sim_index = index_subset[draws]
    sim_yield = yield_subset[draws]

    # smooth discrete spikes (same structure as your original)
    sim_index = sim_index + rng.normal(0, np.std(index_subset) * 0.1, n_sim)
    sim_yield = sim_yield + rng.normal(0, np.std(yield_subset) * 0.1, n_sim)
    sim_yield = np.maximum(sim_yield, 0)

    sim_payoff = call_payoff_from_index(sim_index)
    sim_rev_no = sim_yield * unit_price
    return sim_rev_no, sim_payoff, sim_index, sim_yield

seed_train = 42
seed_test = 123

sim_rev_no_train, sim_payoff_train, sim_index_train, sim_yield_train = simulate_from_subset(
    index_train, yield_train, seed=seed_train, n_sim=n_sim
)
sim_rev_no_test, sim_payoff_test, sim_index_test, sim_yield_test = simulate_from_subset(
    index_test, yield_test, seed=seed_test, n_sim=n_sim
)


# -- STEP 6: EXPECTED SHORTFALL (ES) + OPTIMISE n ON TRAIN ONLY --

def expected_shortfall(x, alpha=0.30):
    """
    ES of revenue: average of the worst alpha fraction (lower tail).
    """
    q = np.quantile(x, alpha)
    return np.mean(x[x <= q])

alpha_es = 0.30

def objective_es(n):
    sim_rev_yes = sim_rev_no_train + n * sim_payoff_train - n * premium
    # minimize tail risk => minimize ES (lower is worse). Here revenue ES: higher is better.
    # To minimize downside risk, we maximize ES. Equivalent: minimize (-ES).
    return -expected_shortfall(sim_rev_yes, alpha=alpha_es)

n_grid = np.linspace(0, 10, 201)
obj_vals = np.array([objective_es(n) for n in n_grid])
n_contracts = n_grid[np.argmin(obj_vals)]

print(f"\nOptimised on TRAIN only (ES alpha={alpha_es:.2f}): n* = {n_contracts:.3f} (premium={premium:.2f})")


# -- STEP 7: OUT-OF-SAMPLE EVALUATION ON TEST --

sim_rev_no = sim_rev_no_test
sim_payoff = sim_payoff_test
sim_rev_yes = sim_rev_no + n_contracts * sim_payoff - n_contracts * premium

# Risk metrics (TEST)
mean_no, mean_yes = np.mean(sim_rev_no), np.mean(sim_rev_yes)
std_no, std_yes = np.std(sim_rev_no), np.std(sim_rev_yes)
cv_no, cv_yes = std_no / mean_no, std_yes / mean_yes
p5_no, p5_yes = np.percentile(sim_rev_no, 5), np.percentile(sim_rev_yes, 5)
p10_no, p10_yes = np.percentile(sim_rev_no, 10), np.percentile(sim_rev_yes, 10)

# ES metrics (TEST)
es_no = expected_shortfall(sim_rev_no, alpha=alpha_es)
es_yes = expected_shortfall(sim_rev_yes, alpha=alpha_es)

# Hedging Effectiveness (ES-based) and “basis risk reduction” proxy
# HE = 1 - ES_hedged / ES_unhedged (for a loss metric). For revenue ES (higher is better),
# a clean analogous “tail improvement ratio” is:
#   Improvement = (ES_hedged - ES_unhedged) / |ES_unhedged|
he_es = (es_yes - es_no) / (abs(es_no) + 1e-12) * 100

# Another transparent basis-risk proxy: correlation between yield shortfall and payoff (TEST)
# Define shortfall relative to mean revenue (positive = bad outcome)
rev_shortfall_test = np.maximum(np.mean(sim_rev_no) - sim_rev_no, 0)
corr_shortfall_payoff = np.corrcoef(rev_shortfall_test, sim_payoff)[0, 1]

print(f"\nOUT-OF-SAMPLE risk measures (TEST sim, {n_sim} draws)")
print(f"{'Measure':<25} {'No hedge':>12} {'Hedged':>12} {'Change':>12}")
print("-" * 61)
print(f"{'Mean revenue':<25} {mean_no:>12.2f} {mean_yes:>12.2f} {mean_yes-mean_no:>+12.2f}")
print(f"{'Std deviation':<25} {std_no:>12.2f} {std_yes:>12.2f} {(std_yes-std_no)/std_no*100:>+11.1f}%")
print(f"{'Coeff of variation':<25} {cv_no:>12.4f} {cv_yes:>12.4f} {(cv_yes-cv_no)/cv_no*100:>+11.1f}%")
print(f"{'5th percentile':<25} {p5_no:>12.2f} {p5_yes:>12.2f} {p5_yes-p5_no:>+12.2f}")
print(f"{'10th percentile':<25} {p10_no:>12.2f} {p10_yes:>12.2f} {p10_yes-p10_no:>+12.2f}")

print(f"\nTail risk (TEST, ES alpha={alpha_es:.2f})")
print(f"ES (no hedge): {es_no:.2f}")
print(f"ES (hedged):   {es_yes:.2f}")
print(f"ES tail improvement: {he_es:+.2f}%")

print("\nBasis risk diagnostics (TEST)")
print(f"Corr(shortfall, payoff): {corr_shortfall_payoff:.3f}  (higher = payoff tracks bad outcomes better)")
print(f"Basis risk reduction (ES-based): {he_es:+.2f}%  (interpreted as tail improvement vs unhedged)")


# -- STEP 8: YEAR-BY-YEAR (historical, using n* for transparency) --

call_payoff_hist = call_payoff_from_index(index)
rev_no_hist = yield_detrended * unit_price
rev_yes_hist = rev_no_hist + n_contracts * call_payoff_hist - n_contracts * premium

print(f"\n{'Year':<6} {'CDD':<8} {'Yield(dtr)':<10} {'Payoff':<10} {'Rev w/o':<12} {'Rev w/':<12}")
print("-" * 64)
for i in range(len(index)):
    print(f"{i+1:<6} {index[i]:<8.0f} {yield_detrended[i]:<10.2f} {call_payoff_hist[i]:<10.2f} "
          f"{rev_no_hist[i]:<12.2f} {rev_yes_hist[i]:<12.2f}")


# -- STEP 9: PLOTS (OUT-OF-SAMPLE: TEST) --

fig, axes = plt.subplots(2, 2, figsize=(13, 10))
blue, red = "#2C5F8A", "#D4543B"

# (a) simulated revenue densities (TEST)
ax = axes[0, 0]
bins = np.linspace(min(sim_rev_no.min(), sim_rev_yes.min()) - 50,
                   max(sim_rev_no.max(), sim_rev_yes.max()) + 50, 80)
ax.hist(sim_rev_no, bins=bins, alpha=0.4, color=blue, density=True, label="No hedge (TEST)")
ax.hist(sim_rev_yes, bins=bins, alpha=0.4, color=red, density=True,
        label=f"Hedged (TEST, n*={n_contracts:.2f})")
ax.set_xlabel("Revenue (per ha)")
ax.set_ylabel("Density")
ax.set_title(f"OUT-OF-SAMPLE revenue distributions ({n_sim} draws)")
ax.legend()

# (b) CDD index with strike line (historical)
ax = axes[0, 1]
yrs = np.arange(1, len(index) + 1)
colors = [red if c > K else blue for c in index]
ax.bar(yrs, index, color=colors, alpha=0.6)
ax.axhline(K, color="black", ls="--", lw=1.5, label=f"Strike ({K} DD)")
ax.set_xlabel("Year")
ax.set_ylabel("CDD")
ax.set_title("CDD index (red = above strike)")
ax.legend()

# (c) simulated CDF comparison (TEST)
ax = axes[1, 0]
sorted_no = np.sort(sim_rev_no)
sorted_yes = np.sort(sim_rev_yes)
cdf = np.arange(1, n_sim + 1) / n_sim
ax.plot(sorted_no, cdf, color=blue, lw=1.5, label="No hedge (TEST)")
ax.plot(sorted_yes, cdf, color=red, lw=1.5, label="Hedged (TEST)")
ax.axhline(0.05, color="gray", ls=":", lw=0.8)
ax.axhline(0.10, color="gray", ls=":", lw=0.8)
ax.text(sorted_no[0] + 10, 0.06, "5th pctl", fontsize=8, color="gray")
ax.text(sorted_no[0] + 10, 0.11, "10th pctl", fontsize=8, color="gray")
ax.set_xlabel("Revenue (per ha)")
ax.set_ylabel("Cumulative probability")
ax.set_title("OUT-OF-SAMPLE CDF of revenue")
ax.legend()

# (d) summary box (TEST)
ax = axes[1, 1]
ax.axis("off")
summary = (
    f"Premium (assumed):   {premium:.2f}\n"
    f"n* (fit on TRAIN):   {n_contracts:.3f}\n"
    f"ES alpha:            {alpha_es:.2f}\n"
    f"Simulations:         {n_sim}\n"
    f"Train years:         {train_years}\n"
    f"Test years:          {len(index)-train_years}\n"
    f"\n"
    f"Std dev change:      {(std_yes-std_no)/std_no*100:+.1f}%\n"
    f"CV change:           {(cv_yes-cv_no)/cv_no*100:+.1f}%\n"
    f"ES improvement:      {he_es:+.2f}%\n"
    f"Corr(shortfall,pay): {corr_shortfall_payoff:+.3f}\n"
    f"5th pctl shift:      {p5_yes-p5_no:+.2f}\n"
    f"10th pctl shift:     {p10_yes-p10_no:+.2f}\n"
)
ax.text(0.1, 0.5, summary, fontsize=12, family="monospace", va="center",
        bbox=dict(boxstyle="round", facecolor="wheat", alpha=0.3))
ax.set_title("OUT-OF-SAMPLE summary (TEST)")

